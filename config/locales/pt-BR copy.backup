pt-BR:
  activerecord:
    models:
      reservation: "Reserva"
    attributes:
      reservation:
        title: "Título"
        starts_at: "Início"
        ends_at: "Término"
        room: "Sala"
        room_id: "Sala"
        solicitante_id: "Solicitante"
        responsavel_id: "Responsável"
    errors:
      models:
        reservation:
          attributes:
            room:
              required: "deve ser selecionada"
            title:
              blank: "não pode ficar em branco"
            starts_at:
              blank: "não pode ficar em branco"
            ends_at:
              blank: "não pode ficar em branco"
            room_id:
              blank: "não pode ficar em branco"
            solicitante_id:
              blank: "não pode ficar em branco"
            responsavel_id:
              blank: "não pode ficar em branco"
      messages:
        blank: "não pode ficar em branco"
        required: "é obrigatório"
  
  time:
    formats:
      default: "%d/%m/%Y %H:%M"
      short: "%d/%m %H:%M"
      long: "%d de %B de %Y às %H:%M"

  date:
    formats:
      default: "%d/%m/%Y"
      short: "%d/%m"
      long: "%d de %B de %Y"
    day_names:
      - "domingo"
      - "segunda-feira"
      - "terça-feira"
      - "quarta-feira"
      - "quinta-feira"
      - "sexta-feira"
      - "sábado"
    abbr_day_names:
      - "dom"
      - "seg"
      - "ter"
      - "qua"
      - "qui"
      - "sex"
      - "sáb"
    month_names:
      - ""
      - "janeiro"
      - "fevereiro"
      - "março"
      - "abril"
      - "maio"
      - "junho"
      - "julho"
      - "agosto"
      - "setembro"
      - "outubro"
      - "novembro"
      - "dezembro"
    abbr_month_names:
      - ""
      - "jan"
      - "fev"
      - "mar"
      - "abr"
      - "mai"
      - "jun"
      - "jul"
      - "ago"
      - "set"
      - "out"
      - "nov"
      - "dez"
    order:
      - :day
      - :month
      - :year
  datetime:
    distance_in_words:
      half_a_minute: "meio minuto"
      less_than_x_seconds:
        one: "menos de 1 segundo"
        other: "menos de %{count} segundos"
      x_seconds:
        one: "1 segundo"
        other: "%{count} segundos"
      less_than_x_minutes:
        one: "menos de 1 minuto"
        other: "menos de %{count} minutos"
      x_minutes:
        one: "1 minuto"
        other: "%{count} minutos"
      about_x_hours:
        one: "cerca de 1 hora"
        other: "cerca de %{count} horas"
      x_days:
        one: "1 dia"
        other: "%{count} dias"
      about_x_months:
        one: "cerca de 1 mês"
        other: "cerca de %{count} meses"
      x_months:
        one: "1 mês"
        other: "%{count} meses"
      about_x_years:
        one: "cerca de 1 ano"
        other: "cerca de %{count} anos"
      over_x_years:
        one: "mais de 1 ano"
        other: "mais de %{count} anos"
      almost_x_years:
        one: "quase 1 ano"
        other: "quase %{count} anos"

  devise:
    sessions:
      signed_in: "Login efetuado com sucesso."
      signed_out: "Logout efetuado com sucesso."
      already_signed_out: "Logout já realizado."
    failure:
      already_authenticated: "Você já está logado."
      unauthenticated: "Você precisa se logar ou se registrar antes de continuar."
      not_found_in_database: "CPF ou senha inválidos."
      invalid: "CPF ou senha inválidos."
      locked: "Sua conta está bloqueada."
      unconfirmed: "Você precisa confirmar sua conta antes de continuar."
      inactive: "Sua conta ainda não foi ativada."
      timeout: "Sua sessão expirou. Faça login novamente para continuar."
