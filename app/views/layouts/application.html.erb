                <%= image_tag url_for(participant.photo) %>
              <% else %>
                <i class="fa-solid fa-circle-user"></i>
              <% end %>
            </div>
            <div class="profile-info">
              <div><strong><%= participant&.name || current_user.email %></strong></div>
              <div class="muted"><%= current_user.email %></div>
              <div class="muted">Empresa: <%= participant&.grupo_empresa&.nome || "-" %></div>
            </div>
          </div>
          <hr class="pmodal__divider">
          <div class="zoom-block">
            <div class="zoom-title"><i class="fa-solid fa-magnifying-glass"></i> Ajuste de zoom</div>
            <div class="zoom-options" role="group" aria-label="Zoom">
              <button type="button" class="btn-chip" data-zoom="0.7">Pequeno</button>
              <button type="button" class="btn-chip" data-zoom="0.8">Padrão</button>
              <button type="button" class="btn-chip hide-md" data-zoom="1.0">Médio</button>
              <button type="button" class="btn-chip hide-md" data-zoom="1.25">Grande</button>
            </div>
            <small class="muted">Aplica no app (não muda o zoom do navegador).</small>
          </div>
          <% if controller_name == "dashboard" && action_name == "index" %>
            <hr class="pmodal__divider">
            <div class="dashboard-layout-block">
              <div class="zoom-title"><i class="fa-solid fa-table-cells-large"></i> Personalizar dashboard</div>
              <small class="muted">Ative para exibir os controles e arrastar os cards de posicao.</small>
              <button type="button" class="btn-chip btn-chip--wide" id="dashboard-layout-toggle" data-dashboard-layout-toggle="false">
                <i class="fa-solid fa-up-down-left-right"></i>
                <span>Personalizar cards</span>
              </button>
            </div>
          <% end %>
        </div>
        <div class="pmodal__footer">
          <%= button_to destroy_user_session_path,
              method: :delete,
              class: "btn-danger" do %>
            <i class="fa-solid fa-right-from-bracket"></i> Sair
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</body>
