    if (e.key === "Escape" && overlay?.getAttribute("aria-hidden") === "false") closeModal();
  });
  });


  /****/


  document.addEventListener('DOMContentLoaded', () => {
  // ---- refs
  const trigger   = document.getElementById('user-avatar-trigger');
  const modal     = document.getElementById('user-profile-modal');
  if (!modal || !trigger) return; // não logado ou sem avatar

  const backdrop  = document.getElementById('user-profile-backdrop');
  const closeBtn  = document.getElementById('user-profile-close');
  const cancelBtn = document.getElementById('user-profile-cancel');
  const zoomBtns  = modal.querySelectorAll('.btn-chip[data-zoom]');
  const layoutToggleBtn = document.getElementById('dashboard-layout-toggle');
  const dashboardGrid = document.getElementById('dashboard-board-grid');
  const DASHBOARD_LAYOUT_KEY = 'dashboardLayoutEditing';

  // ---- abrir/fechar
  function openModal() {
    modal.classList.add('is-open');
    document.body.classList.add('noscroll');
    highlightCurrentZoom();
    syncDashboardLayoutButton();
  }
  function closeModal() {
    modal.classList.remove('is-open');
    document.body.classList.remove('noscroll');
  }

  trigger.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e)=>{ if(e.key==='Escape' && modal.classList.contains('is-open')) closeModal(); });

  // ---- ZOOM
  const ZOOM_KEY = 'zoomScale';

  function applyZoom(scale) {
    document.documentElement.style.setProperty('--zoom', scale);
    try { localStorage.setItem(ZOOM_KEY, String(scale)); } catch(e) {}
  }

  function getSavedZoom() {
  try {
    const v = parseFloat(localStorage.getItem('zoomScale'));
    return Number.isFinite(v) ? v : 0.8; // â† inicia em Padrão (0.8)
  } catch(e) { return 0.8; }
  }


  function highlightCurrentZoom() {
    const current = getSavedZoom();
    zoomBtns.forEach(btn => {
      const s = parseFloat(btn.dataset.zoom);
      btn.classList.toggle('active', Math.abs(s - current) < 0.001);
    });
  }

  function isDashboardLayoutEditing() {
    try {
      return localStorage.getItem(DASHBOARD_LAYOUT_KEY) === 'true';
    } catch(e) {
      return false;
    }
  }

  function applyDashboardLayoutEditing(enabled) {
    if (!dashboardGrid) return;
    dashboardGrid.classList.toggle('is-layout-editing', enabled);
    try { localStorage.setItem(DASHBOARD_LAYOUT_KEY, String(enabled)); } catch(e) {}
  }

  function syncDashboardLayoutButton() {
    if (!layoutToggleBtn) return;
    const enabled = dashboardGrid?.classList.contains('is-layout-editing');
    layoutToggleBtn.dataset.dashboardLayoutToggle = enabled ? 'true' : 'false';
    layoutToggleBtn.classList.toggle('active', !!enabled);
    layoutToggleBtn.querySelector('span').textContent = enabled ? 'Desativar personalizacao' : 'Personalizar cards';
  }

  // aplica no load
  applyZoom(getSavedZoom());
  applyDashboardLayoutEditing(isDashboardLayoutEditing());
  syncDashboardLayoutButton();

  // clique nas opções
  zoomBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const scale = parseFloat(btn.dataset.zoom);
      applyZoom(scale);
      highlightCurrentZoom();
    });
  });

  layoutToggleBtn?.addEventListener('click', () => {
    const enabled = !(dashboardGrid?.classList.contains('is-layout-editing'));
    applyDashboardLayoutEditing(enabled);
    syncDashboardLayoutButton();
    closeModal();
  });
  });

  (function(){
    const LOADER_DELAY = 2400;
    let showTimer = null;
    const loader = () => document.getElementById('app-loader');

    const show = () => {
      const el = loader();
      if (!el) return;
      el.classList.remove('is-hidden');
      el.classList.add('is-visible');
    };

    const cancelPendingShow = () => {
      if (!showTimer) return;
      clearTimeout(showTimer);
      showTimer = null;
    };

    const scheduleShow = () => {
      cancelPendingShow();
      showTimer = window.setTimeout(() => {
        showTimer = null;
        show();
      }, LOADER_DELAY);
    };

    const hide = () => {
      cancelPendingShow();
      const el = loader();
      if (!el) return;
      el.classList.remove('is-visible');
      el.classList.add('is-hidden');
    };

    if (document.readyState === 'complete') {
      hide();
    } else {
      scheduleShow();
      window.addEventListener('load', hide, { once: true });
    }

    window.addEventListener('pageshow', hide);
    window.addEventListener('beforeunload', scheduleShow);

    document.addEventListener('turbo:load', hide);
    document.addEventListener('turbo:before-visit', scheduleShow);
    document.addEventListener('turbo:render', hide);
    document.addEventListener('turbo:submit-start', scheduleShow);
    document.addEventListener('turbo:submit-end', hide);
  })();

  async function urlBase64ToUint8Array(base64String) {
  const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
  const rawData = atob(base64);
  return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
}

async function enablePushNotifications() {
  if (!("serviceWorker" in navigator) || !("PushManager" in window)) return;

  const perm = await Notification.requestPermission();
  if (perm !== "granted") return;

  const reg = await navigator.serviceWorker.register("/service-worker.js");

  const keyRes = await fetch("/push/vapid_public_key");
  const { publicKey } = await keyRes.json();

  const sub = await reg.pushManager.subscribe({
    userVisibleOnly: true,
    applicationServerKey: await urlBase64ToUint8Array(publicKey),
  });

  await fetch("/push_subscriptions", {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
    body: JSON.stringify({ subscription: sub }),
  });
}

