          <h5 id="user-profile-title">Perfil</h5>
          <button type="button" class="pmodal__close" id="user-profile-close" aria-label="Fechar">✕</button>
        </div>
        <div class="pmodal__body">
          <div class="profile-row">
            <div class="profile-avatar">
