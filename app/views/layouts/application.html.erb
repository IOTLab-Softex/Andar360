<%= javascript_include_tag "https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js" %>
<script>
  function toggleNotificacoesSidebar() {
    const overlay = document.getElementById("notificacoes-overlay");
    const sidebar = document.getElementById("notificacoes-sidebar");

    // Mostra o fundo escuro com fade
    overlay.style.display = "block";
    setTimeout(() => overlay.classList.add("visivel"), 10);

    // Mostra o painel e aplica a classe que desliza ele
    sidebar.style.display = "block";
    setTimeout(() => sidebar.classList.add("aberta"), 10);
  }


  function fecharSidebarNotificacoes(event) {
    const overlay = document.getElementById("notificacoes-overlay");
    const sidebar = document.getElementById("notificacoes-sidebar");

    // Fecha o painel lateral com transição
    sidebar.classList.remove("aberta");

    // Esconde o overlay com fade
    overlay.classList.remove("visivel");

    // Aguarda a transição do painel (deslizar) e então aplica display: none
    sidebar.addEventListener("transitionend", function handleSidebarTransition(e) {
      if (e.propertyName === "right") {
        sidebar.style.display = "none";
        sidebar.removeEventListener("transitionend", handleSidebarTransition);
      }
    });

    // Após fade do overlay, oculta ele também
    setTimeout(() => {
      overlay.style.display = "none";
    }, 300); // Tempo igual ao da transição no CSS
  }





   // Quando a página começar a carregar
    window.addEventListener("DOMContentLoaded", () => {
      document.querySelector(".menu").classList.add("fade-border");
    });

    // Quando a página terminar de carregar tudo
    window.addEventListener("load", () => {
      setTimeout(() => {
        document.querySelector(".menu").classList.remove("fade-border");
  document.querySelector(".menu").classList.add("fade-border-stop");


      }, 1000); // espera 1s para sumir suavemente
    });

    document.addEventListener("DOMContentLoaded", function () {
      const sidebar = document.querySelector(".sidebar");
      const toggleBtn = document.getElementById("toggleSidebarBtn");

      toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("sidebar-hidden");
      });
    });


    document.addEventListener("DOMContentLoaded", function () {
      const toggles = document.querySelectorAll(".submenu-toggle");

      toggles.forEach(toggle => {
        toggle.addEventListener("click", function () {
          const targetSelector = toggle.dataset.target;
          const submenu = document.querySelector(targetSelector);
          const chevron = toggle.querySelector(".chevron-icon");

          if (submenu.style.display === "none" || submenu.style.display === "") {
            submenu.style.display = "block";
            chevron.style.transform = "rotate(180deg)";
          } else {
            submenu.style.display = "none";
            chevron.style.transform = "rotate(0deg)";
          }
        });
      });
    });


  document.addEventListener("DOMContentLoaded", function () {
    const toggle = document.getElementById("toggle-theme");
    const label = document.getElementById("theme-label");
    const root = document.documentElement;

    function updateLabel() {
      const isDark = root.getAttribute("data-theme") === "dark";
      label.textContent = isDark ? "Modo Claro" : "Modo Escuro";
    }

    // Inicializa o label com base no tema salvo
    if (localStorage.getItem("theme") === "dark") {
      root.setAttribute("data-theme", "dark");
    }

    updateLabel();

    toggle.addEventListener("click", () => {
      const isDark = root.getAttribute("data-theme") === "dark";
      root.setAttribute("data-theme", isDark ? "light" : "dark");
      localStorage.setItem("theme", isDark ? "light" : "dark");
      updateLabel();
    });
  });



  document.addEventListener("DOMContentLoaded", function() {
    const userSignedIn = <%= user_signed_in? ? "true" : "false" %>;
    if (!userSignedIn) return;

    function checkImportStatus() {
      fetch("/import_logs/status", {
        headers: { "Accept": "application/json" }
      })
        .then(response => {
          if (!response.ok) return null;
          return response.json();
        })
        .then(data => {
          if (!data) return;

          const progressDiv = document.getElementById("backup-progress");
          if (!progressDiv) return;

          if (data.status === "executando") {
            progressDiv.style.display = "block";
            progressDiv.innerHTML = `⏳ ${data.message}`;
          } else if (data.status === "finalizado") {
            progressDiv.innerHTML = `✅ ${data.message}`;
            setTimeout(() => progressDiv.style.display = "none", 5000);
          } else if (data.status === "erro") {
            progressDiv.innerHTML = `❌ ${data.message}`;
            setTimeout(() => progressDiv.style.display = "none", 8000);
          } else {
            progressDiv.style.display = "none";
          }
        })
        .catch(() => {});
    }

    setInterval(checkImportStatus, 5000);
    checkImportStatus();
  });

  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".abrir-detalhe-notificacao").forEach(btn => {
  btn.addEventListener("click", function () {
    const titulo   = this.dataset.titulo;
    const mensagem = this.dataset.mensagem;
    const data     = this.dataset.data; // <- vem do ERB acima
    const notificationId = this.dataset.notificationId;
    const notificationUrl = this.dataset.notificationUrl;
    const destinationLabel = this.dataset.destinationLabel;

    document.getElementById("modal-titulo").textContent = titulo;
    document.getElementById("modal-mensagem").textContent = mensagem;

    // Se quiser mostrar a data:
    const modal = document.getElementById("modal-detalhe-notificacao");
    let dataEl = modal.querySelector(".modal-data");
    if (!dataEl) {
      dataEl = document.createElement("p");
      dataEl.className = "modal-data";
      modal.querySelector(".modal-conteudo").appendChild(dataEl);
    }
    dataEl.textContent = `📅 ${data}`;

    const actionBtn = document.getElementById("btn-ir-notificacao");
    if (actionBtn) {
      actionBtn.hidden = !notificationUrl || notificationUrl === "#";
      actionBtn.dataset.notificationId = notificationId || "";
      actionBtn.dataset.notificationUrl = notificationUrl || "";
      actionBtn.innerHTML = `<i class="fa-solid fa-arrow-up-right-from-square"></i> ${destinationLabel || "Ir até o detalhe"}`;
    }

    modal.style.display = "flex";
  });
  });

  });

  function fecharModalNotificacao() {
    document.getElementById("modal-detalhe-notificacao").style.display = "none";
  }

  function atualizarBadgeNotificacoes() {
    const badge = document.querySelector(".notification-btn .badge");
    const items = document.querySelectorAll(".notificacoes-lista .notificacao-item");
    const sidebarContent = document.querySelector(".sidebar-conteudo");

    if (badge) {
      if (items.length > 0) {
        badge.textContent = items.length;
      } else {
        badge.remove();
      }
    }

    if (sidebarContent && items.length === 0 && !sidebarContent.querySelector(".sem-notificacoes")) {
      sidebarContent.innerHTML = '<div class="sem-notificacoes">Nenhuma notificação nova</div>';
    }
  }

  async function marcarNotificacaoComoLida(notificationId) {
    if (!notificationId) return;

    const tokenMeta = document.querySelector('meta[name="csrf-token"]');
    await fetch(`/notifications/${notificationId}/marcar_como_lida`, {
      method: "POST",
      headers: {
        "Accept": "application/json",
        "X-CSRF-Token": tokenMeta ? tokenMeta.content : ""
      },
      credentials: "same-origin"
    }).catch(() => {});
  }

  document.addEventListener("DOMContentLoaded", function () {
    const actionBtn = document.getElementById("btn-ir-notificacao");
    if (!actionBtn) return;

    actionBtn.addEventListener("click", async function () {
      const notificationId = this.dataset.notificationId;
      const destinationUrl = this.dataset.notificationUrl;

      await marcarNotificacaoComoLida(notificationId);
      fecharModalNotificacao();

      const item = notificationId ? document.getElementById(`notificacao-${notificationId}`) : null;
      if (item) item.remove();
      atualizarBadgeNotificacoes();

      if (destinationUrl && destinationUrl !== "#") {
        window.location.href = destinationUrl;
      }
    });
  });

   document.addEventListener("DOMContentLoaded", function () {
    const token = document.querySelector('meta[name="csrf-token"]').content;

    // Pega todos os formulários remotos
    document.querySelectorAll('form[data-remote="true"]').forEach(function(form) {
      if (!form.querySelector('input[name="authenticity_token"]')) {
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'authenticity_token';
        hidden.value = token;
        form.appendChild(hidden);
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
  const logo = document.querySelector(".logo-title");

  function updateLogo() {
    if (document.documentElement.getAttribute("data-theme") === "dark") {
      logo.src = "/logo.png";
    } else {
      logo.src = "/logo-dark.png";
    }
  }

  // Atualiza ao carregar
  updateLogo();

  // Atualiza sempre que mudar o tema
  const themeToggle = document.getElementById("toggle-theme");
  if (themeToggle) {
    themeToggle.addEventListener("click", updateLogo);
  }
  });

  document.addEventListener('DOMContentLoaded', function(){
  const wrapper = document.querySelector('.notification-icon-wrapper');
  const nudge   = document.getElementById('notifNudge');
  const bellBtn = wrapper ? wrapper.querySelector('.notification-btn') : null;

  if (!wrapper || !bellBtn) return;

  const SHOW_CLASS = 'show';
  const ATT_CLASS  = 'attention';
  let dismissedThisSession = false; // só controla o balão visual

  // Lê o número de não lidas do badge
  function getUnreadCount() {
    const badge = bellBtn.querySelector('.badge');
    if (!badge) return 0;
    const v = parseInt((badge.textContent || '0').trim(), 10);
    return Number.isNaN(v) ? 0 : v;
  }

  const unreadNow = getUnreadCount();

  // 🔁 chave para guardar o valor anterior no navegador
  const LAST_COUNT_KEY = 'notif_last_unread_count';
  let lastCount = 0;
  try {
    lastCount = parseInt(localStorage.getItem(LAST_COUNT_KEY) || '0', 10);
    if (Number.isNaN(lastCount)) lastCount = 0;
  } catch(e) {
    lastCount = 0;
  }

  // 🔊 som das notificações novas
  const notifSoundSrc = "<%= asset_path('notify_new.mp3') %>";

  function playNotifSound() {
    if (!notifSoundSrc) return;
    try {
      const audio = new Audio(notifSoundSrc);
      audio.volume = 0.9;
      audio.play().catch(() => {
        // se o navegador bloquear autoplay, só ignora
      });
    } catch(e) {}
  }

  // 👉 Regra: só toca quando o número ATUAL for maior que o último salvo
  if (unreadNow > lastCount) {
    playNotifSound();
  }

  // Atualiza o valor salvo para o próximo request
  try {
    localStorage.setItem(LAST_COUNT_KEY, String(unreadNow));
  } catch(e) {}

  // --------- VISUAL (sino piscando + balão) ---------
  function applyVisual(show) {
    if (!nudge) return;
    if (show) {
      bellBtn.classList.add(ATT_CLASS);
      nudge.classList.add(SHOW_CLASS);
    } else {
      bellBtn.classList.remove(ATT_CLASS);
      nudge.classList.remove(SHOW_CLASS);
    }
  }

  function syncVisualInitial() {
    const hasUnread = unreadNow > 0;
    applyVisual(hasUnread && !dismissedThisSession);
  }

  // Ao carregar, já ajusta visual
  syncVisualInitial();

  function dismiss() {
    dismissedThisSession = true;
    applyVisual(false);
  }

  // Clicar no sino → some o destaque e o balão
  bellBtn.addEventListener('click', dismiss);

  // Clicar no X do balão → some também
  nudge?.querySelector('.notif-nudge-close')?.addEventListener('click', (e) => {
    e.stopPropagation();
    dismiss();
  });

  // Se o badge mudar (ex.: limpar todas via Turbo), atualiza SÓ o visual.
  // (não tocamos som aqui pra garantir que ele só toca 1x por "chegada")
  const observer = new MutationObserver(() => {
    const hasUnread = getUnreadCount() > 0;
    if (!hasUnread) {
      applyVisual(false);
    } else if (!dismissedThisSession) {
      applyVisual(true);
    }
  });

  observer.observe(bellBtn, { childList: true, subtree: true, characterData: true });
  });

  /* feedback */


  document.addEventListener("DOMContentLoaded", function(){
  const fab     = document.getElementById("feedback-fab");
  const overlay = document.getElementById("feedback-modal");
  const closeBtn= overlay?.querySelector(".feedback-modal-close");
  const cancel  = overlay?.querySelector(".feedback-cancel");

  function openModal(){
    // Preenche metadados da página
    document.getElementById("feedback_page_title").value = document.title || "";
    document.getElementById("feedback_page_path").value  = window.location.pathname || "";
    document.getElementById("feedback_page_url").value   = window.location.href || "";
    document.getElementById("feedback_user_agent").value = navigator.userAgent || "";

    try {
      const params = Object.fromEntries(new URL(window.location.href).searchParams.entries());
      document.getElementById("feedback_url_params").value = JSON.stringify(params || {});
    } catch(e) {
      document.getElementById("feedback_url_params").value = JSON.stringify({});
    }

    // Captura texto selecionado, se houver
    const sel = window.getSelection ? window.getSelection().toString() : "";
    document.getElementById("feedback_selected_text").value = sel || "";

    overlay.style.display = "block";
  }

  function closeModal(){
    overlay.style.display = "none";
  }

  fab?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);
  cancel?.addEventListener("click", closeModal);

  // Fechar ao clicar fora
  overlay?.addEventListener("click", function(e){
    if (e.target === overlay) closeModal();
  });
  });


  /****/


  document.addEventListener('DOMContentLoaded', () => {
  // ---- refs
  const trigger   = document.getElementById('user-avatar-trigger');
  const modal     = document.getElementById('user-profile-modal');
  if (!modal || !trigger) return; // não logado ou sem avatar

  const backdrop  = document.getElementById('user-profile-backdrop');
  const closeBtn  = document.getElementById('user-profile-close');
  const cancelBtn = document.getElementById('user-profile-cancel');
  const zoomBtns  = modal.querySelectorAll('.btn-chip[data-zoom]');
  const layoutToggleBtn = document.getElementById('dashboard-layout-toggle');
  const dashboardGrid = document.getElementById('dashboard-board-grid');
  const DASHBOARD_LAYOUT_KEY = 'dashboardLayoutEditing';

  // ---- abrir/fechar
  function openModal() {
    modal.classList.add('is-open');
    document.body.classList.add('noscroll');
    highlightCurrentZoom();
    syncDashboardLayoutButton();
  }
  function closeModal() {
    modal.classList.remove('is-open');
    document.body.classList.remove('noscroll');
  }

  trigger.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e)=>{ if(e.key==='Escape' && modal.classList.contains('is-open')) closeModal(); });

  // ---- ZOOM
  const ZOOM_KEY = 'zoomScale';

  function applyZoom(scale) {
    document.documentElement.style.setProperty('--zoom', scale);
    try { localStorage.setItem(ZOOM_KEY, String(scale)); } catch(e) {}
  }

  function getSavedZoom() {
  try {
    const v = parseFloat(localStorage.getItem('zoomScale'));
    return Number.isFinite(v) ? v : 0.8; // ← inicia em Padrão (0.8)
  } catch(e) { return 0.8; }
  }


  function highlightCurrentZoom() {
    const current = getSavedZoom();
    zoomBtns.forEach(btn => {
      const s = parseFloat(btn.dataset.zoom);
      btn.classList.toggle('active', Math.abs(s - current) < 0.001);
    });
  }

  function isDashboardLayoutEditing() {
    try {
      return localStorage.getItem(DASHBOARD_LAYOUT_KEY) === 'true';
    } catch(e) {
      return false;
    }
  }

  function applyDashboardLayoutEditing(enabled) {
    if (!dashboardGrid) return;
    dashboardGrid.classList.toggle('is-layout-editing', enabled);
    try { localStorage.setItem(DASHBOARD_LAYOUT_KEY, String(enabled)); } catch(e) {}
  }

  function syncDashboardLayoutButton() {
    if (!layoutToggleBtn) return;
    const enabled = dashboardGrid?.classList.contains('is-layout-editing');
    layoutToggleBtn.dataset.dashboardLayoutToggle = enabled ? 'true' : 'false';
    layoutToggleBtn.classList.toggle('active', !!enabled);
    layoutToggleBtn.querySelector('span').textContent = enabled ? 'Desativar personalizacao' : 'Personalizar cards';
  }

  // aplica no load
  applyZoom(getSavedZoom());
  applyDashboardLayoutEditing(isDashboardLayoutEditing());
  syncDashboardLayoutButton();

  // clique nas opções
  zoomBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const scale = parseFloat(btn.dataset.zoom);
      applyZoom(scale);
      highlightCurrentZoom();
    });
  });

  layoutToggleBtn?.addEventListener('click', () => {
    const enabled = !(dashboardGrid?.classList.contains('is-layout-editing'));
    applyDashboardLayoutEditing(enabled);
    syncDashboardLayoutButton();
    closeModal();
  });
  });

  (function(){
    const loader = () => document.getElementById('app-loader');
    const show   = () => loader() && loader().classList.remove('is-hidden');
    const hide   = () => {
      if (!loader()) return;
      loader().classList.add('is-hidden');
      // Remove do DOM após o fade
      loader().addEventListener('transitionend', (e)=>{
        if(e.propertyName==='opacity') loader()?.remove();
      }, { once:true });
    };

    // ------------- SEM Turbo (fallback)
    window.addEventListener('load', hide);        // terminou de carregar → some
    window.addEventListener('beforeunload', show);// ao sair/navegar → mostra

    // ------------- COM Turbo (Rails 7+)
    document.addEventListener('turbo:load', hide);        // após render
    document.addEventListener('turbo:before-visit', show);// ao iniciar navegação
    document.addEventListener('turbo:render', show);      // caso mude só o body
    document.addEventListener('turbo:submit-start', show);// submits remotos

    // se sua página inicial vier já pronta do cache, garanta exibição no boot
    document.addEventListener('DOMContentLoaded', show);
  })();

  async function urlBase64ToUint8Array(base64String) {
  const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
  const rawData = atob(base64);
  return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
}

async function enablePushNotifications() {
  if (!("serviceWorker" in navigator) || !("PushManager" in window)) return;

  const perm = await Notification.requestPermission();
  if (perm !== "granted") return;

  const reg = await navigator.serviceWorker.register("/service-worker.js");

  const keyRes = await fetch("/push/vapid_public_key");
  const { publicKey } = await keyRes.json();

  const sub = await reg.pushManager.subscribe({
    userVisibleOnly: true,
    applicationServerKey: await urlBase64ToUint8Array(publicKey),
  });

  await fetch("/push_subscriptions", {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
    body: JSON.stringify({ subscription: sub }),
  });
}

</script>
