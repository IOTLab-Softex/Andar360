  <body>
    <%#<div id="app-loader">
      <div class="app-loader-icon">
        <img src="/loading.gif" alt="Carregando…" />
      </div>
    </div>%>
        <% unless tela_de_alteracao_de_senha? %>
      <% unless (controller_path == "users/registrations" && action_name == "edit") || (controller_path == "devise/passwords" && %w[new edit].include?(action_name)) %>
        <div class="user-info">
          <% if user_signed_in? %>
            <% participant   = current_user.participant %>
            <% notificacoes  = current_user.notifications.nao_lidas.order(created_at: :desc).limit(50) %>

            <% if participant&.photo&.attached? %>
              <%= image_tag url_for(participant.photo), class: "user-avatar", id: "user-avatar-trigger" %>
            <% else %>
              <div class="user-avatar" id="user-avatar-trigger"><i class="fa-solid fa-circle-user"></i></div>
            <% end %>

            <div class="hide-on-mobile user-name">
              Bem-vindo, <%= participant&.name || current_user.email %>
            </div>

            <div class="notification-icon-wrapper">
              <% latest = notificacoes.first %>
              <button class="notification-btn"
                      onclick="toggleNotificacoesSidebar()"
                      data-notif-count="<%= notificacoes.count %>"
                      data-latest-notif-id="<%= latest&.id %>">
                <i class="fa-solid fa-bell"></i>
                <% if notificacoes.any? %>
                  <span class="badge"><%= notificacoes.count %></span>
                <% end %>
              </button>

              <% if notificacoes.any? %>
                <div id="notifNudge" class="notif-nudge" role="status" aria-live="polite">
                  <i class="fa-solid fa-hand-point-right"></i>
                  <span>Você tem <strong><%= notificacoes.count %></strong> notificações</span>
                  <button type="button" class="notif-nudge-close" aria-label="Fechar dica">&times;</button>
                </div>
              <% end %>
            </div>
          <% end %>  <!-- fim do if user_signed_in? -->
        </div>       <!-- fim da div.user-info -->

        <% if user_signed_in? %>
          <div id="notificacoes-overlay" class="notificacoes-overlay" onclick="fecharSidebarNotificacoes(event)"></div>
          <div id="notificacoes-sidebar" class="notificacoes-sidebar">
            <div class="sidebar-header">
              <h3>Notificações</h3>
              <%= button_to "Limpar todas",
                            marcar_todas_como_lidas_notifications_path,
                            method: :post,
                            class: "limpar-todas-btn",
                            remote: true %>
            </div>

            <div class="sidebar-conteudo">
              <% if notificacoes.any? %>
                <ul class="notificacoes-lista">
                  <% notificacoes.each do |n| %>
                    <li id="notificacao-<%= n.id %>" class="notificacao-item">
                      <div class="notificacao-conteudo">
                        <button type="button"
                                class="abrir-detalhe-notificacao"
                                data-notification-id="<%= n.id %>"
                                data-notification-url="<%= n.url.presence || '#' %>"
                                data-destination-label="<%= n.url.to_s.include?('/chamados/') ? 'Ir até o chamado' : 'Ir até o detalhe' %>"
                                data-titulo="<%= n.titulo %>"
                                data-mensagem="<%= n.corpo %>"
                                data-data="<%= l(n.created_at, format: :short) %>">
                          <i class="fa-solid fa-circle-exclamation"></i>
                          <span><%= n.titulo %></span>
                        </button>

                        <%= button_to marcar_como_lida_notification_path(n),
                                      method: :post,
                                      class: "btn-fechar-notificacao" do %>
                          <i class="fa-solid fa-xmark notificacoes-lista-close"></i>
                        <% end %>
                      </div>
                      <br>
                      <small class="notificacao-data">
                        <%= l(n.created_at, format: "%d/%m/%Y %H:%M") %>
                      </small>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <div class="sem-notificacoes">Nenhuma notificação nova</div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>  <!-- fim do unless controller_path == "users/registrations" && action_name == "edit" -->
    <% end %>    <!-- fim do unless tela_de_alteracao_de_senha? -->

    <main>
