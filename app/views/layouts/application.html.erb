    <script>
      (function () {
        const el = document.getElementById('notification-flash');
        if (!el) return;

        const type  = el.dataset.type;   // success / error (visual)
        const sound = el.dataset.sound;  // success / error (som)

        // cor conforme tipo
        el.style.background = (type === 'success') ? '#2e7d32' : '#d32f2f';

        // mapa de sons (ajuste os nomes dos arquivos)
        const soundMap = {
          success: "<%= asset_path('notify_success.mp3') %>",
          error:   "<%= asset_path('notify_error.mp3') %>",
        };

        const soundSrc = soundMap[sound] || soundMap[type];

        if (soundSrc) {
          try {
            const audio = new Audio(soundSrc);
            audio.volume = 0.8;
            audio.play().catch(() => {});
          } catch (e) {}
        }

        // auto-esconde
        setTimeout(() => {
          el.style.transition = 'opacity .5s, transform .5s';
          el.style.opacity = '0';
          el.style.transform = 'translateY(10px)';
          setTimeout(() => el.remove(), 600);
        }, 3800);
      })();
    </script>
