            <i class="fa-solid fa-bars"></i>
          </button>
          <img src="/logo.png" alt="Logo" class="logo-title">
          <h1 class="hide-on-mobile title"><%= page_title %></h1>
        </div>
        <% if page_menu.present? %>
          <div class="fade-border menu">
            <%= page_menu %>
          </div>
        <% end %>
      <% end %>
    </div>
    <nav class="sidebar sidebar-hidden">
      <ul class="sidebar-links">
        <%= sidebar_menu %>
      </ul>
    </nav>
    <!-- 🔹 Aqui começa o “container” com margem lateral -->
    <% if controller_path == "devise/sessions" && %w[new edit].include?(action_name) ||
     controller_path == "users/registrations" && %w[new edit].include?(action_name) ||
     controller_path == "devise/passwords" && %w[new edit].include?(action_name) %>
      <%= yield %>
    <% else %>
      <div class="page-shell">
        <%= yield %>
      </div>
    <% end %>
  </main>
  <div id="backup-progress" style="
  position: fixed;
  bottom: 30px;
  left: 20px;
  background: #ffc107;
  color: #000;
  padding: 10px 15px;
  border-radius: 8px;
  font-weight: bold;
  display: none;
  z-index: 9999;">
    ⏳ Backup em andamento...
  </div>
  <%# Notificação dinâmica com JS externo %>
  <% if flash[:notice] || flash[:alert] %>
    <div id="notification-flash"
       data-type="<%= flash[:notice] ? 'success' : 'error' %>"
       data-sound="<%= flash[:flash_sound].presence || (flash[:notice] ? 'success' : 'error') %>"
       style="position:fixed; bottom:20px; right:15px; background:#2e7d32; color:#fff; padding:12px 20px; border-radius:8px; font-weight:600; box-shadow:0 4px 10px rgba(0,0,0,.2); z-index:9999; display:flex; align-items:center; gap:10px;">
      <% if flash[:notice] %>
        <i class="fa-solid fa-circle-check"></i> <%= flash[:notice] %>
      <% else %>
        <i class="fa-solid fa-triangle-exclamation"></i> <%= flash[:alert] %>
      <% end %>
    </div>
    <script>
      (function () {
        const el = document.getElementById('notification-flash');
        if (!el) return;

        const type  = el.dataset.type;   // success / error (visual)
        const sound = el.dataset.sound;  // success / error (som)

        // cor conforme tipo
        el.style.background = (type === 'success') ? '#2e7d32' : '#d32f2f';

        // mapa de sons (ajuste os nomes dos arquivos)
        const soundMap = {
          success: "<%= asset_path('notify_success.mp3') %>",
          error:   "<%= asset_path('notify_error.mp3') %>",
        };

        const soundSrc = soundMap[sound] || soundMap[type];

        if (soundSrc) {
          try {
            const audio = new Audio(soundSrc);
            audio.volume = 0.8;
            audio.play().catch(() => {});
          } catch (e) {}
        }

        // auto-esconde
        setTimeout(() => {
          el.style.transition = 'opacity .5s, transform .5s';
          el.style.opacity = '0';
          el.style.transform = 'translateY(10px)';
          setTimeout(() => el.remove(), 600);
        }, 3800);
      })();
    </script>
  <% end %>
  <% if user_signed_in? %>
    <% participant = current_user.participant %>
    <div id="user-profile-modal" class="pmodal" aria-hidden="true" role="dialog" aria-modal="true">
