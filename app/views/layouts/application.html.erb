  <body>
    <% login_screen = ["devise/sessions", "users/sessions"].include?(controller_path) %>
    <div id="app-loader">
      <div class="app-loader-icon">
        <img src="/loading.gif" alt="Carregandoâ€¦" />
      </div>
    </div>
        <% unless tela_de_alteracao_de_senha? || login_screen %>
      <% unless (controller_path == "users/registrations" && action_name == "edit") || (controller_path == "devise/passwords" && %w[new edit].include?(action_name)) %>
