  document.addEventListener('DOMContentLoaded', function(){
  const wrapper = document.querySelector('.notification-icon-wrapper');
  const nudge   = document.getElementById('notifNudge');
  const bellBtn = wrapper ? wrapper.querySelector('.notification-btn') : null;

  if (!wrapper || !bellBtn) return;

  const SHOW_CLASS = 'show';
  const ATT_CLASS  = 'attention';

  // LÃª o número de não lidas do badge
  function getUnreadCount() {
    const badge = bellBtn.querySelector('.badge');
    if (!badge) return 0;
    const v = parseInt((badge.textContent || '0').trim(), 10);
    return Number.isNaN(v) ? 0 : v;
  }

  const unreadNow = getUnreadCount();

  // ðŸ” chave para guardar o valor anterior no navegador
  const LAST_COUNT_KEY = 'notif_last_unread_count';
  let lastCount = 0;
  try {
    lastCount = parseInt(localStorage.getItem(LAST_COUNT_KEY) || '0', 10);
    if (Number.isNaN(lastCount)) lastCount = 0;
  } catch(e) {
    lastCount = 0;
  }

  // ðŸ”Š som das notificações novas
  const notifSoundSrc = "<%= asset_path('notify_new.mp3') %>";

  function playNotifSound() {
    if (!notifSoundSrc) return;
    try {
      const audio = new Audio(notifSoundSrc);
      audio.volume = 0.9;
      audio.play().catch(() => {
        // se o navegador bloquear autoplay, só ignora
      });
    } catch(e) {}
  }

  // ðŸ‘‰ Regra: só toca quando o número ATUAL for maior que o Ãºltimo salvo
  if (unreadNow > lastCount) {
    playNotifSound();
  }

  // Atualiza o valor salvo para o próximo request
  try {
    localStorage.setItem(LAST_COUNT_KEY, String(unreadNow));
  } catch(e) {}

  // --------- VISUAL (sino piscando + balão) ---------
  // Persiste quantas não lidas havia quando o usuário abriu o sino pela última vez.
  // O efeito só aparece se chegaram notificações NOVAS desde então.
  const DISMISSED_AT_KEY = 'notif_dismissed_at_count';
  let dismissedAtCount = 0;
  try {
    dismissedAtCount = parseInt(localStorage.getItem(DISMISSED_AT_KEY) || '0', 10);
    if (Number.isNaN(dismissedAtCount)) dismissedAtCount = 0;
  } catch(e) {}

  function applyVisual(show) {
    bellBtn.classList.toggle(ATT_CLASS, show);
    if (nudge) nudge.classList.toggle(SHOW_CLASS, show);
  }

  // Mostra efeito apenas se há mais não lidas do que quando o usuário abriu pela última vez
  applyVisual(unreadNow > dismissedAtCount);

  function dismiss() {
    try { localStorage.setItem(DISMISSED_AT_KEY, String(unreadNow)); } catch(e) {}
    dismissedAtCount = unreadNow;
    applyVisual(false);
  }

  // Clicar no sino â†’ persiste a contagem atual e some o efeito
  bellBtn.addEventListener('click', dismiss);

  // Clicar no X do balão â†’ mesmo comportamento
  nudge?.querySelector('.notif-nudge-close')?.addEventListener('click', (e) => {
    e.stopPropagation();
    dismiss();
  });

  // Se o badge mudar (limpar todas etc.), recalcula
  const observer = new MutationObserver(() => {
    const current = getUnreadCount();
    applyVisual(current > dismissedAtCount);
  });

  observer.observe(bellBtn, { childList: true, subtree: true, characterData: true });
  });

