<style>
  #modal-mensagem{
      color: #ccc !important;
  }
  .notificacao-data {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    color: #7d8491;
  }

  .modal-data {
    font-size: 0.85rem;
    color: #ccc !important;
    margin-top: 8px;
  }


    .notificacoes-lista li {
      list-style: none;
    }


    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }

    .modal-conteudo {
      background: var(--bg-main, #1e2a38);
      padding: 25px;
      border-radius: 12px;
      color: white;
      max-width: 450px;
      width: 90%;
      box-shadow: 0 8px 20px rgba(0,0,0,0.3);
      position: relative;
      animation: fadeIn 0.3s ease;
    }

    .modal-conteudo h2 {
      margin-top: 0;
      margin-bottom: 10px;
    }

    .modal-conteudo p {
      font-size: 15px;
      line-height: 1.4;
      color: white;
    }

    .modal-acoes {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 18px;
    }

    .fechar-modal {
      position: absolute;
      top: 12px;
      right: 12px;
      background: none;
      border: none;
      font-size: 1.4rem;
      color: white;
      cursor: pointer;
    }

    @keyframes fadeIn {
      from { transform: scale(0.95); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }

    .notificacao-conteudo {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #ffffff;
      padding: 10px 12px;
      border-radius: 6px;
      color: white;
    }

    .btn-fechar-notificacao {
      background: none;
      border: none;
      color: #ccc;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .btn-fechar-notificacao:hover {
      color: #ff4d4f;
    }

    .limpar-todas-btn {
      background-color: #ff5c66;
      border: none;
      color: white;
      padding: 8px 11px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 800;
      cursor: pointer;
      margin-bottom: 0;
      line-height: 1;
    }

    .limpar-todas-btn:hover {
      background-color: #d9363e;
    }


    .notification-icon-wrapper {
      position: relative;
      margin-left: 15px;
    }

    .notification-btn {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: var(--foto-user-avatar);
      border: none;
      position: relative;
      cursor: pointer;
      font-size: 20px;
      color: var(--color-text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .notification-btn .badge {
      position: absolute;
      top: -5px;
      right: -5px;
      background: red;
      color: white;
      padding: 3px 6px;
      border-radius: 50%;
      font-size: 12px;
    }

  .notificacoes-sidebar {
    position: fixed;
    inset: 0 0 0 auto;
    right: -390px;
    width: min(390px, 100vw);
    height: -webkit-fill-available;
    background: radial-gradient(circle at 82% 88%, rgba(124, 58, 237, .2) 0 1px, transparent 1px 12px), linear-gradient(160deg, #28105f 0%, #28105f 58%, #28105f 100%);
    border-left: 1px solid rgba(255, 255, 255, .1);
    /* box-shadow: -22px 0 55px rgba(12, 4, 29, .46); */
    transition: right 0.3s ease-in-out;
    z-index: 9999;
    padding: 22px 18px 0;
    overflow: hidden;
    display: none;
    color: #f8f7ff;
    box-sizing: border-box;
}

    .notificacoes-sidebar.aberta {
      right: 0;
    }



    .sidebar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, .12);
      padding-bottom: 18px;
      margin-bottom: 14px;
      color: white;
    }

    .sidebar-header h3 {
      margin: 0;
      font-size: 0;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
    }

    .sidebar-header h3::before {
      content: "\f0f3";
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, .1);
      color: #c7b8ff;
      font-size: 1rem;
    }

    .sidebar-header h3::after {
      content: "Notificações";
      font-size: 1rem;
      color: #fff;
    }

    .fechar-sidebar {
      background: none;
      border: none;
      font-size: 1.4rem;
      cursor: pointer;
    }

    .notificacoes-lista {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      padding-right: 6px;
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, .35) transparent;
    }

    .notificacoes-lista li {
      margin-bottom: 0;
    }

    .sem-notificacoes {
      color: rgba(255, 255, 255, .76);
      background: rgba(255, 255, 255, .08);
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 12px;
      padding: 18px;
      text-align: center;
    }

    .notificacoes-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(0,0,0,0.3);
      z-index: 9998;
       opacity: 0;
      transition: opacity 0.3s ease;
    }

    .notificacoes-overlay.visivel {
      display: block;
      opacity: 1;
    }

    .sidebar-conteudo {
      height: calc(100vh - 92px);
      height: calc(100dvh - 92px);
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .notificacoes-tabs {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }

    .notificacoes-tab {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 7px;
      background: rgba(255, 255, 255, .1);
      color: rgba(255, 255, 255, .86);
      padding: 7px 10px;
      font-size: 11px;
      font-weight: 800;
      line-height: 1;
    }

    .notificacoes-tab.is-active {
      background: #6d45d8;
      color: #fff;
      box-shadow: 0 10px 22px rgba(109, 69, 216, .26);
    }

    .notificacoes-tab-count {
      min-width: 18px;
      height: 18px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, .14);
      font-size: 10px;
    }

    .notificacoes-scroll {
      min-height: 0;
      overflow-y: auto;
      padding: 2px 6px 18px 2px;
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, .35) transparent;
    }

    .notificacao-item {
      --notif-color: #36a8ff;
      position: relative;
      background: #fff;
      color: #141827;
      border: 1px solid rgba(124, 58, 237, .18);
      border-left: 4px solid var(--notif-color);
      border-radius: 8px;
      padding: 18px 14px 14px 78px;
      min-height: 126px;
      box-shadow: 0 12px 26px rgba(10, 8, 28, .22);
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .notificacao-item:nth-child(4n+2) { --notif-color: #5fcf98; }
    .notificacao-item:nth-child(4n+3) { --notif-color: #ff9646; }
    .notificacao-item:nth-child(4n+4) { --notif-color: #7c4ee4; }

    .notificacao-item::before {
      content: "\f05a";
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      position: absolute;
      left: 21px;
      top: 36px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--notif-color);
      color: #fff;
      box-shadow: 0 10px 18px rgba(54, 168, 255, .22);
    }

    .notificacao-item:nth-child(4n+2)::before { content: "\f00c"; }
    .notificacao-item:nth-child(4n+3)::before { content: "\f0d1"; }
    .notificacao-item:nth-child(4n+4)::before { content: "\f0ee"; }

    .notificacao-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 32px rgba(10, 8, 28, .3);
    }

    .notificacao-item--success { --notif-color: #5fcf98; }
    .notificacao-item--warning { --notif-color: #ff9646; }
    .notificacao-item--system { --notif-color: #7c4ee4; }
    .notificacao-item--info { --notif-color: #36a8ff; }

    .notificacao-icon {
      position: absolute;
      left: 21px;
      top: 36px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--notif-color);
      color: #fff;
      box-shadow: 0 10px 18px color-mix(in srgb, var(--notif-color) 34%, transparent);
    }

    .notificacao-icon i {
      font-size: 17px;
    }

    .notificacao-conteudo {
      display: block;
      background: transparent;
      padding: 0;
      color: inherit;
    }

    .notificacao-conteudo .abrir-detalhe-notificacao {
      all: unset;
      cursor: pointer;
      display: block;
      width: 100%;
      padding-right: 30px;
      box-sizing: border-box;
    }

    .notificacao-conteudo .abrir-detalhe-notificacao > i {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--notif-color);
      color: transparent;
      margin: 0 7px 0 0;
      vertical-align: 2px;
    }

    .notificacao-conteudo .abrir-detalhe-notificacao > span {
      display: inline;
      font-size: 13px;
      font-weight: 900;
      line-height: 1.25;
      color: #181b2a;
    }

    .notificacao-conteudo .abrir-detalhe-notificacao::after {
      content: attr(data-mensagem);
      display: block;
      margin: 8px 0 0;
      font-size: 11px;
      line-height: 1.42;
      font-weight: 500;
      color: #697085;
    }

    .notificacao-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--notif-color);
      flex: 0 0 auto;
      margin-top: 4px;
    }

    .notificacao-card-main {
      all: unset;
      cursor: pointer;
      display: block;
      width: 100%;
    }

    .notificacao-card-head {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      padding-right: 28px;
    }

    .notificacao-titulo {
      display: block;
      font-size: 13px;
      font-weight: 900;
      line-height: 1.25;
      color: #181b2a;
    }

    .notificacao-subtitulo {
      display: block;
      margin-top: 2px;
      font-size: 12px;
      font-weight: 800;
      line-height: 1.25;
      color: #2d3144;
    }

    .notificacao-mensagem {
      margin: 8px 0 0;
      font-size: 11px;
      line-height: 1.42;
      color: #697085;
    }

    .notificacao-footer {
      margin-top: 13px;
    }

    .btn-fechar-notificacao {
      position: absolute;
      top: 13px;
      right: 12px;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 50%;
      background: transparent;
      color: #8a90a0;
      cursor: pointer;
      padding: 0;
    }

    .btn-fechar-notificacao:hover {
      background: #f1eef8;
      color: #4b355f;
    }

    .notificacao-item form {
      margin: 0;
    }

    .notificacao-item br {
      display: none;
    }

    .notificacoes-lista-close {
      margin: 0;
      font-size: 13px;
      color: currentColor;
    }

    .notificacoes-preferences {
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, .12);
    padding: 12px 2px 18px;
    position: absolute;
    bottom: 0;
    width: -webkit-fill-available;
    margin-right: 10px;
    }

    .notificacoes-preferences-toggle {
      all: unset;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: rgba(255, 255, 255, .72);
      cursor: pointer;
      font-size: 11px;
      font-weight: 800;
      box-sizing: border-box;
    }

    .notificacoes-preferences-toggle span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .notificacoes-preferences-toggle i:last-child {
      transition: transform .18s ease;
    }

    .notificacoes-preferences.is-open .notificacoes-preferences-toggle i:last-child {
      transform: rotate(90deg);
    }

    .notificacoes-preferences-panel {
      display: none;
      margin-top: 12px;
      padding: 12px;
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 10px;
      background: rgba(255, 255, 255, .08);
    }

    .notificacoes-preferences.is-open .notificacoes-preferences-panel {
      display: grid;
      gap: 10px;
    }

    .notificacoes-pref-option {
      display: flex;
      align-items: center;
      gap: 9px;
      color: rgba(255, 255, 255, .88);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      user-select: none;
    }

    .notificacoes-pref-option input {
      width: 16px;
      height: 16px;
      accent-color: #7c4ee4;
      flex: 0 0 auto;
    }

    .notificacoes-pref-note {
      margin: 2px 0 0;
      color: rgba(255, 255, 255, .58);
      font-size: 10px;
      line-height: 1.35;
    }

    .notificacao-item.is-hidden-by-pref {
      display: none;
    }

    @media (max-width: 520px) {
      .notificacoes-sidebar {
        width: 100vw;
        right: -100vw;
        padding: 18px 14px 0;
      }

      .notificacao-item {
        padding-left: 70px;
      }

      .notificacao-icon {
        left: 18px;
      }
    }

    /* Ping no sino */
  .notification-btn.attention::before {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 4px solid #ffc107;
    opacity: 1;
    animation: pulseBell 1.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes pulseBell{
    0%, 100%{transform:scale(1); opacity:1;}
    50%{transform:scale(1.12); opacity:1;}
  }

  /* Balão apontando para o sino */
  .notif-nudge {
    position: absolute;
    top: 65px;
    left: -129px;
    background: #ffc107;
    color: #222;
    padding: 8px 12px;
    border-radius: 10px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .2);
    z-index: 10000;
    display: none;
    align-items: center;
    gap: .5rem;
    font-weight: 600;
    animation: nudgeIn .18s ease-out, floaty 3s ease-in-out infinite;
}

  .notif-nudge.show{ display:flex; }

  .notif-nudge::after{
      content: "";
    position: absolute;
    top: -5px;           /* posiciona acima do balão */
    left: 149px;          /* centraliza horizontalmente (ajuste conforme precisar) */
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 6px solid #ffc107;  /* seta para baixo (apontando pra cima) */
  }

  .notif-nudge .notif-nudge-close{
    background:transparent;
    border:0;
    margin-left:6px;
    font-size:16px;
    line-height:1;
    cursor:pointer;
  }

  @keyframes nudgeIn{
    from{ transform:translateY(-6px); opacity:0; }
    to  { transform:translateY(0);    opacity:1; }
  }
  @keyframes floaty{
    0%,100%{ transform:translateY(0); }
    50%    { transform:translateY(-9px); }
  }

  /* Responsivo: em telas pequenas, joga o balão para baixo do sino */
  @media (max-width: 520px){
    .notif-nudge {
        top: 66px;
        right: -4px;
        left: -141px;
    }
    .notif-nudge::after{
      top:-6px;
      right:18px;
      left: 159px;
      border-left:6px solid transparent;
      border-right:6px solid transparent;
      border-bottom:6px solid #ffc107;   /* setinha para cima */
    }
  }


.show-sm {
  display: none;
}

  @media (max-width: 992px) {
   
   .hide-sm {
  display: none !important;
}

  }

  /* até 768px (celular): esconda o que marcar com .hide-sm */
  @media (max-width: 768px) {
.hide-sm {
  display: none !important;
}
.show-sm {
  display: table-row !important;
}
  }

  .page-shell {
    /* max-width: 1280px; */
    margin: 9rem auto;
    padding: 0 1.5rem 7rem;
    width: 100%;
    position: absolute;
  }

/* Banner com transição suave */
.banner, .user-info {
  transition:
    transform 0.45s ease,
    opacity 0.45s ease,
    margin-bottom 0.45s ease;
  will-change: transform, opacity, margin-bottom;
}

/* Quando o monitoramento estiver ativo, some o banner com estilo */
.monitoring-on-dashboard .banner,
.monitoring-on-dashboard .user-info,
.monitoring-on-dashboard .marcar-todos-btn
 {
  transform: translateY(-120%);
  opacity: 0;
  margin-bottom: -4rem; /* puxa o conteÃºdo pra cima */
  pointer-events: none;
}


/* Ajusta o conteÃºdo pra ocupar o espaÃ§o do banner que sumiu */
.monitoring-on-dashboard .page-shell {
  margin-top: 0rem;      /* antes era ~9rem */
  transition: margin-top 0.45s ease;
}


  /* em telas bem pequenas, um pouco menos de padding pra caber tudo */
  @media (max-width: 768px){
  .page-shell{
    padding: 0 1rem 2rem;
  }
  }

  /* BotÃ£o flutuante de monitoramento (fica perto do feedback-fab) */
#monitoring-fab {
    display: grid;
    place-items: center;
    width: 75px;
    height: 75px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .25);
    position: relative;
    bottom: auto;
    right: auto;
    border: none;
    margin: 0;
    padding: 0;
    transform: translateY(0) scale(1);
    transform-origin: center;
    transition: transform .18s cubic-bezier(.2, .8, .2, 1), box-shadow .18s cubic-bezier(.2, .8, .2, 1);
    will-change: transform;
    backface-visibility: hidden;
    z-index: 10;
}

#monitoring-fab:hover {
  /* leve subida + scale suave */
  transform: translateY(-2px) scale(1.06);
  box-shadow: 0 14px 32px rgba(0,0,0,.30);
}

@media (max-width: 768px) {
  #monitoring-fab {
    bottom: auto;
    right: auto;
  }
}

</style>

<!DOCTYPE html>
