<p>
  <strong>Nome:</strong>
  <%= @item.nome %>
</p>

<p>
  <strong>Descrição:</strong>
  <%= @item.descricao %>
</p>

<p>
  <strong>Status:</strong>
  <%= @item.status %>
</p>

<% if @item.foto.attached? %>
  <p>
    <strong>Foto:</strong><br>
    <%= image_tag @item.foto.variant(resize_to_limit: [300, 300]) %>
  </p>
<% end %>
