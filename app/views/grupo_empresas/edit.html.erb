<%= form_with model: @grupo_empresa, local: true do |form| %>
<% readonly_for_client = current_user && current_user.role == "client" %>

<div class="form-group-fixed" style="display:flex; justify-content:center; gap:0.75rem;">
  <div class="mt-3 text-center">
    <%= link_to "Cancelar", grupo_empresas_path, class: "btn btn-warning" %>
  </div>
  <div class="mt-3 text-center">
    <%= form.button type: "submit", class: "btn btn-success" do %>
      <i class="fa-solid fa-floppy-disk"></i>
      Salvar alterações
    <% end %>
  </div>
</div>

<br>

<div class="form-group">
  <%= form.label :nome %>
  <%= form.text_field :nome,
        class: "form-control",
        readonly: readonly_for_client %>
</div>

<div class="form-group">
  <%= form.label :cnpj %>
  <%= form.text_field :cnpj,
        class: "form-control",
        placeholder: "Digite o CNPJ",
        readonly: readonly_for_client %>
</div>

<div class="form-group">
  <%= form.label :sala %>
  <%= form.text_field :sala,
        class: "form-control",
        readonly: readonly_for_client %>
</div>

<div class="form-group">
  <%= form.label :andar %>
  <%= form.text_field :andar,
        class: "form-control",
        readonly: readonly_for_client %>
</div>


  <div class="form-group">
    <%= form.label :logo %>
    <%= form.file_field :logo, class: "form-control" %>
  </div>
<div class="form-group">
  <%= label_tag "Subgrupos (Setores)" %>

  <div style="display: flex; gap: 0.5rem; align-items: center;">
    <%= select_tag "subgrupo_list",
      options_from_collection_for_select(@grupo_empresa.sub_grupo_empresas, :id, :nome),
      multiple: true,
      size: 5,
      class: "form-control",
      id: "subgrupo-listbox",
      style: "flex: 1;" %>

    <button type="button" onclick="abrirModalSubgrupo()" class="btn btn-success">+</button>
    <button type="button" onclick="editarSubgrupoSelecionado()" class="btn edit">✎</button>
    <button type="button" onclick="removerSubgrupos()" class="btn btn-warning">–</button>
  </div>

  <!-- JSON com dados dos subgrupos para o JS conseguir preencher o modal -->
  <div id="subgrupos-data"
     data-subgrupos="<%= @grupo_empresa.sub_grupo_empresas
      .select(:id,
              :nome,
              :can_request_purchase,
              :can_approve_purchase,
              :can_buy,
              :can_view_monitoring,
              :can_manage_import_backup,
              :can_support_access,
              :can_manage_items,
          :can_manage_encomendas,
          :can_open_doors)
      .to_json %>">
</div>

</div>


</div>

<% end %>


<!-- Modal customizado -->
<!-- Modal customizado -->
<div id="modal-subgrupo" style="display: none; position: fixed; z-index: 9999; top: 0; left: 0; width: -webkit-fill-available; height: -webkit-fill-available;
  background: rgba(0, 0, 0, 0.5); align-items: center; justify-content: center;">
  <div class="modal-dialog-subgrupo">
    <h3 id="modal-subgrupo-title">Adicionar Subgrupo</h3>

    <%= form_with model: SubGrupoEmpresa.new,
                  url: sub_grupo_empresas_path,
                  method: :post,
                  local: true,
                  authenticity_token: form_authenticity_token,
                  html: { id: "form-subgrupo" } do |f| %>

      <!-- vamos controlar esse _method via JS: "post" p/ criar, "patch" p/ editar -->
      <%= hidden_field_tag :_method, "post", id: "form-subgrupo-method" %>

      <%= f.hidden_field :grupo_empresa_id, value: @grupo_empresa.id %>

      <div class="form-group" style="margin-top: 1rem;">
        <%= f.label :nome, "Nome do Subgrupo" %>
        <%= f.text_field :nome, class: "form-control", required: true, id: "sub_grupo_empresa_nome" %>
      </div>

<% readonly_for_client = current_user && current_user.role == "client" %>

<fieldset class="groupbox-solicitacao-compra"
          style="margin-top: 1rem; padding: 1rem; border: 1px solid #ccc; border-radius: 8px;<%= ' display:none;' if readonly_for_client %>">
  <legend style="font-weight: 600; padding: 0 .5rem;">Solicitação de compras</legend>

  <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: .5rem;">
    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_request_purchase, id: "sub_grupo_empresa_can_request_purchase" %>
      Solicitar compra
    </label>

    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_approve_purchase, id: "sub_grupo_empresa_can_approve_purchase" %>
      Autorizar compra
    </label>

    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_buy, id: "sub_grupo_empresa_can_buy" %>
      Comprador
    </label>
  </div>
</fieldset>

<fieldset class="groupbox-suporte-ti"
          style="margin-top: 1rem; padding: 1rem; border: 1px solid #ccc; border-radius: 8px;<%= ' display:none;' if readonly_for_client %>">
  <legend style="font-weight: 600; padding: 0 .5rem;">Suporte e monitoramento</legend>

  <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: .5rem;">
    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_view_monitoring,
                      id: "sub_grupo_empresa_can_view_monitoring" %>
      Acessar painel de monitoramento
    </label>

    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_support_access,
                      id: "sub_grupo_empresa_can_support_access" %>
      Suporte de acesso
    </label>

    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_manage_import_backup,
                      id: "sub_grupo_empresa_can_manage_import_backup" %>
      Importação/Backup
    </label>
  </div>
</fieldset>

<fieldset class="groupbox-portaria"
          style="margin-top: 1rem; padding: 1rem; border: 1px solid #ccc; border-radius: 8px;<%= ' display:none;' if readonly_for_client %>">
  <legend style="font-weight: 600; padding: 0 .5rem;">Portaria</legend>

  <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: .5rem;">
    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_manage_items,
                      id: "sub_grupo_empresa_can_manage_items" %>
      Controle de objetos
    </label>

    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_manage_encomendas,
                      id: "sub_grupo_empresa_can_manage_encomendas" %>
      Encomendas
    </label>

    <label style="display: flex; align-items: center; gap: .35rem;">
      <%= f.check_box :can_open_doors,
                      id: "sub_grupo_empresa_can_open_doors" %>
      Permissão para abrir portas
    </label>
  </div>
</fieldset>



      <div style="margin-top: 1.5rem;
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-direction: row-reverse;">
        <button type="button" onclick="fecharModalSubgrupo()" class="btn-primary btn">Cancelar</button>
        <%= f.submit "Salvar", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>




<script>
  function atualizarTokenSubgrupo() {
    const form = document.getElementById('form-subgrupo');
    const token = document.querySelector('meta[name="csrf-token"]')?.content;
    const tokenInput = form?.querySelector('input[name="authenticity_token"]');

    if (token && tokenInput) tokenInput.value = token;
  }

  function abrirModalSubgrupo() {
    // modo CRIAR
    const modal = document.getElementById('modal-subgrupo');
    const title = document.getElementById('modal-subgrupo-title');
    const form = document.getElementById('form-subgrupo');
    const methodInput = document.getElementById('form-subgrupo-method');

    // volta para rota de create
    form.action = '/sub_grupo_empresas';
    methodInput.value = 'post';
    atualizarTokenSubgrupo();

    // limpa campos
    document.getElementById('sub_grupo_empresa_nome').value = '';
    document.getElementById('sub_grupo_empresa_can_request_purchase').checked = false;
    document.getElementById('sub_grupo_empresa_can_approve_purchase').checked = false;
    document.getElementById('sub_grupo_empresa_can_buy').checked = false;

const chkMonitoring = document.getElementById('sub_grupo_empresa_can_view_monitoring');
  if (chkMonitoring) chkMonitoring.checked = false;
const chkSupportAccess = document.getElementById('sub_grupo_empresa_can_support_access');
  if (chkSupportAccess) chkSupportAccess.checked = false;
const chkImportBackup = document.getElementById('sub_grupo_empresa_can_manage_import_backup');
  if (chkImportBackup) chkImportBackup.checked = false;
const chkManageItems = document.getElementById('sub_grupo_empresa_can_manage_items');
  if (chkManageItems) chkManageItems.checked = false;
const chkManageEncomendas = document.getElementById('sub_grupo_empresa_can_manage_encomendas');
  if (chkManageEncomendas) chkManageEncomendas.checked = false;
const chkOpenDoors = document.getElementById('sub_grupo_empresa_can_open_doors');
  if (chkOpenDoors) chkOpenDoors.checked = false;

    title.textContent = 'Adicionar Subgrupo';
    modal.style.display = 'flex';
  }

  function editarSubgrupoSelecionado() {
    const listbox = document.getElementById("subgrupo-listbox");
    const selectedId = listbox.value;

    if (!selectedId) {
      alert("Selecione um subgrupo para editar.");
      return;
    }

    const dataElement = document.getElementById("subgrupos-data");
    const subgrupos = JSON.parse(dataElement.dataset.subgrupos || "[]");
    const sg = subgrupos.find(s => String(s.id) === String(selectedId));

    if (!sg) {
      alert("Não foi possível carregar os dados do subgrupo selecionado.");
      return;
    }

    const modal = document.getElementById('modal-subgrupo');
    const title = document.getElementById('modal-subgrupo-title');
    const form = document.getElementById('form-subgrupo');
    const methodInput = document.getElementById('form-subgrupo-method');

    // modo EDITAR
    form.action = `/sub_grupo_empresas/${sg.id}`;
    methodInput.value = 'patch';
    atualizarTokenSubgrupo();

    // preenche campos
    document.getElementById('sub_grupo_empresa_nome').value = sg.nome || '';
    document.getElementById('sub_grupo_empresa_can_request_purchase').checked = !!sg.can_request_purchase;
    document.getElementById('sub_grupo_empresa_can_approve_purchase').checked = !!sg.can_approve_purchase;
    document.getElementById('sub_grupo_empresa_can_buy').checked = !!sg.can_buy;

const chkMonitoring = document.getElementById('sub_grupo_empresa_can_view_monitoring');
if (chkMonitoring) chkMonitoring.checked = !!sg.can_view_monitoring;
const chkSupportAccess = document.getElementById('sub_grupo_empresa_can_support_access');
if (chkSupportAccess) chkSupportAccess.checked = !!sg.can_support_access;
const chkImportBackup = document.getElementById('sub_grupo_empresa_can_manage_import_backup');
if (chkImportBackup) chkImportBackup.checked = !!sg.can_manage_import_backup;
const chkManageItems = document.getElementById('sub_grupo_empresa_can_manage_items');
if (chkManageItems) chkManageItems.checked = !!sg.can_manage_items;
const chkManageEncomendas = document.getElementById('sub_grupo_empresa_can_manage_encomendas');
if (chkManageEncomendas) chkManageEncomendas.checked = !!sg.can_manage_encomendas;
const chkOpenDoors = document.getElementById('sub_grupo_empresa_can_open_doors');
if (chkOpenDoors) chkOpenDoors.checked = !!sg.can_open_doors;

    title.textContent = 'Editar Subgrupo';
    modal.style.display = 'flex';
  }

  function fecharModalSubgrupo() {
    document.getElementById('modal-subgrupo').style.display = 'none';
  }

  // Fechar modal se clicar fora do conteúdo
  window.addEventListener('click', function (e) {
    const modal = document.getElementById('modal-subgrupo');
    if (e.target === modal) {
      fecharModalSubgrupo();
    }
  });

  function removerSubgrupos() {
    const listbox = document.getElementById("subgrupo-listbox");
    const selected = Array.from(listbox.selectedOptions);

    if (selected.length === 0) {
      alert("Selecione pelo menos um subgrupo para remover.");
      return;
    }

    if (!confirm("Deseja realmente remover os subgrupos selecionados?")) {
      return;
    }

    selected.forEach(option => {
      const id = option.value;

      fetch(`/sub_grupo_empresas/${id}`, {
        method: "DELETE",
        headers: {
          "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
          "Content-Type": "application/json"
        }
      })
      .then(response => {
        if (response.ok) {
          option.remove();
        } else {
          alert("Erro ao remover subgrupo " + option.text);
        }
      });
    });
  }
</script>
