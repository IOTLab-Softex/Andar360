<%= form_with url: grupo_empresas_path, method: :get, local: true, class: "filter-form" do %>
  <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; justify-content: center;">
    <div>
      <i class="fa-solid fa-magnifying-glass"></i>
      <%= label_tag :search, "Buscar empresa por nome" %><br>
      <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Digite o nome da empresa" %>
    </div>

    <div style="align-self: flex-end;">
      <%= button_tag type: "submit", class: "btn btn-filter" do %>
        <i class="fa-solid fa-magnifying-glass"></i> Buscar
      <% end %>
    </div>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table-salas">
    <thead>
      <tr>
        <th>Logo</th>
        <th>Nome</th>
        <th class="hide-sm">Sala</th>
        <th class="hide-sm">Andar</th>
        <th>Data de Cadastro</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @grupo_empresas.each do |empresa| %>
        <tr>
          <td style="text-align: center;">
            <% if empresa.logo.attached? %>
              <%= image_tag url_for(empresa.logo), style: "width: 60px; height: 60px; object-fit: contain; background: #fff; border-radius: 6px;" %>
            <% else %>
              <div style="width: 60px; height: 60px; background: #ccc; display: flex; align-items: center; justify-content: center; border-radius: 6px;">
                🏢
              </div>
            <% end %>
          </td>
          <td><strong><%= empresa.nome %></strong></td>
          <td class="hide-sm"><%= empresa.sala.presence || "Não definida" %></td>
          <td class="hide-sm"><%= empresa.andar.presence || "Não definido" %></td>
          <td><%= empresa.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td>
        
            <%= link_to edit_grupo_empresa_path(empresa), class: "btn edit" do %>
              <i class="fa-solid fa-pen-to-square"></i> <div class="hide-sm"> Editar </div>
            <% end %>

            <%= link_to new_formulario_cadastro_path(grupo_empresa_id: empresa.id), class: "btn btn-success", style: "margin-left: 5px;" do %>
    <i class="fa-solid fa-id-badge"></i> <div class="hide-sm"> Cadastrar Acesso </div>
  <% end %>

   <%= link_to participants_path(), class: "btn btn-success", style: "margin-left: 5px;" do %>
    <i class="fa-solid fa-user"></i> <div class="hide-sm"> Gerenciar Funcionários </div>
  <% end %>

          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
