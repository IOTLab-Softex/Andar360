<div class="login-container">
  <div class="login-box">
    <div class="login-header">
      <img src="/logo.png" alt="Logo do Projeto" class="login-logo">
      <h2>Alterar Senha</h2>
    </div>

   <%= form_for(resource, as: resource_name, url: user_registration_path, html: { method: :put }) do |f| %>





      <% if current_user.force_password_change? %>
        <div class="alert alert-warning" style="margin-bottom: 1rem; text-align: center;">
          <strong style="color: #ff0000;">Atenção:</strong> Este é seu primeiro login. Por favor, defina uma nova senha.
        </div>
      <% else %>
        <div class="login-field">
          <%= f.label :current_password, "Senha atual" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "login-input" %>
        </div>
      <% end %>

      <div class="login-field">
        <%= f.label :password, "Nova senha" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "login-input" %>
      </div>

      <div class="login-field">
        <%= f.label :password_confirmation, "Confirme a nova senha" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "login-input" %>
      </div>

      <div class="login-actions">
        <%= f.submit "Salvar nova senha", class: "login-button" %>
      </div>
    <% end %>

  </div>

  <div class="wallpaper"></div>
</div>
