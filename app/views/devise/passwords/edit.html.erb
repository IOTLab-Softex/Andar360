<div class="login-container">
  <div class="logo-mobile">
    <img src="/logo.png" alt="Logo do Projeto" style="width: -webkit-fill-available; filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.6));">
  </div>

  <div class="login-box">
    <div class="login-header">
      <img src="/logo.png" alt="Logo do Projeto" class="login-logo">
      <h2 class="login-h2">Redefinir senha</h2>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "login-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="login-field">
        <%= f.label :password, "Nova senha" do %>
          <i class="fa-solid fa-key"></i> Nova senha
        <% end %>
        <% if @minimum_password_length %>
          <small class="form-text text-muted d-block mb-2">
            Minimo de <%= @minimum_password_length %> caracteres.
          </small>
        <% end %>
        <div class="login-password-wrap">
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "login-input", id: "reset-password-input" %>
          <button type="button" id="toggle-reset-password" class="login-password-toggle" aria-label="Mostrar senha" aria-pressed="false">
            <i class="fa-regular fa-eye" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <div class="login-field">
        <%= f.label :password_confirmation, "Confirmar nova senha" do %>
          <i class="fa-solid fa-shield-halved"></i> Confirmar nova senha
        <% end %>
        <div class="login-password-wrap">
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "login-input", id: "reset-password-confirmation-input" %>
          <button type="button" id="toggle-reset-password-confirmation" class="login-password-toggle" aria-label="Mostrar confirmacao de senha" aria-pressed="false">
            <i class="fa-regular fa-eye" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <div class="login-actions">
        <%= button_tag type: "submit", class: "login-button" do %>
          <i class="fa-solid fa-floppy-disk"></i> Salvar nova senha
        <% end %>
      </div>
    <% end %>

    <div class="login-recovery login-recovery--actions">
      <%= link_to new_session_path(resource_name), class: "login-secondary-button" do %>
        <i class="fa-solid fa-arrow-left"></i> Voltar para o login
      <% end %>
    </div>
  </div>

  <div class="wallpaper">
    <div></div>
  </div>

  <small style="bottom: 0; position: fixed; right: 6px; color: white;">VersÃ£o <%= File.read(Rails.root.join("VERSION")).strip rescue "0.0.1" %></small>
</div>

<style>
  .login-password-wrap {
    position: relative;
  }

  .login-password-wrap .login-input {
    padding-right: 44px;
  }

  .login-password-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color .15s ease, background-color .15s ease;
  }

  .login-password-toggle:hover {
    color: #000;
    background: rgba(148, 163, 184, 0.18);
  }

  .login-recovery--actions {
    margin-top: 16px;
  }

  .login-secondary-button {
    width: 100%;
    min-height: 48px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #f8fafc;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.18);
    transition: transform .16s ease, background-color .16s ease, border-color .16s ease;
  }

  .login-secondary-button:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    color: #ffffff;
    text-decoration: none;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    function bindPasswordToggle(buttonId, inputId, showLabel, hideLabel) {
      const button = document.getElementById(buttonId);
      const input = document.getElementById(inputId);
      if (!button || !input) return;

      button.addEventListener("click", () => {
        const showing = input.type === "text";
        input.type = showing ? "password" : "text";
        button.setAttribute("aria-pressed", String(!showing));
        button.setAttribute("aria-label", showing ? showLabel : hideLabel);
        button.innerHTML = showing
          ? '<i class="fa-regular fa-eye" aria-hidden="true"></i>'
          : '<i class="fa-regular fa-eye-slash" aria-hidden="true"></i>';
      });
    }

    bindPasswordToggle("toggle-reset-password", "reset-password-input", "Mostrar senha", "Ocultar senha");
    bindPasswordToggle("toggle-reset-password-confirmation", "reset-password-confirmation-input", "Mostrar confirmacao de senha", "Ocultar confirmacao de senha");
  });
</script>
