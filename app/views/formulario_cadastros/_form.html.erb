<% if formulario_cadastro.errors.any? %>
      <div class="alert alert-danger mb-3">
        <ul>
          <% formulario_cadastro.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

<div class="form-shell max-w-2xl mx-auto bg-white rounded-xl shadow-md p-6 mt-6">

  <div id="softex-banner" class="flex justify-center mb-4" style="background: #6518ea;">
    <%= image_tag 'softex.png', class: "h-20", id: "softex-logo" %>
  </div>
  <div class="form-group">
    <h2 class="text-2xl font-bold mb-2">Cadastro para Controle de Acesso Facial</h2>
    <p class="mb-4 text-gray-700">
      Em conformidade com a Lei Geral de Proteção de Dados (Lei nº 13.709/2018), informamos que os dados coletados neste formulário serão utilizados exclusivamente para a identificação e controle de acesso ao prédio da Softex Pernambuco, por meio de reconhecimento facial. Os dados biométricos serão armazenados de forma segura e utilizados apenas para a finalidade mencionada, não sendo compartilhados com terceiros sem consentimento expresso, salvo exigência legal.

Ao prosseguir com o cadastro, o usuário compreende e concorda com o tratamento de seus dados conforme estabelecido nesta política.
    </p>
  </div>
  <%= form_with(model: formulario_cadastro, local: true, html: { multipart: true }) do |f| %>
    <%= f.hidden_field :grupo_empresa_id %>
    
    <div class="form-group mb-3">
      <%= f.label :nome, "Nome Completo:" %>
      <%= f.text_field :nome, class: "form-control", required: true %>
    </div>
    <div class="form-group mb-3">
      <%= f.label :cpf, "CPF:" %>
      <%= f.text_field :cpf, class: "form-control", required: true %>
    </div>
    <div class="form-group mb-3">
      <%= f.label :telefone, "Telefone (com DDD):" %>
      <%= f.text_field :telefone, class: "form-control", required: true %>
    </div>
    <div class="form-group mb-3">
      <%= f.label :email, "E-mail:" %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>
    <div class="form-group mb-3">
      <%= f.label :cargo, "Cargo ou Função:" %>
      <%= f.text_field :cargo, class: "form-control", required: true %>
    </div>
    <div class="form-group mb-3">
      <%= f.label :horario_trabalho, "Horário de Trabalho Habitual:" %><br>
      <div class="form-check flex flex-wrap gap-x-4 gap-y-2">
        <% opcoes_horario = ["Manhã", "Tarde", "Noite", "24 horas", "Outro"] %>
        <% selecionados_horario = (formulario_cadastro.horario_trabalho || "").split(",") %>
        <% opcoes_horario.each do |opt| %>
          <div class="checkbox-class flex items-center">
            <%= check_box_tag "formulario_cadastro[horario_trabalho][]", opt, selecionados_horario.include?(opt), id: "horario_#{opt}" %>
            <%= label_tag "horario_#{opt}", opt, class: "mr-3" %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="form-group mb-3">
      <%= f.label :dias_trabalho, "Dias de Trabalho Habitual:", class: "font-bold" %><br>
      <div class="form-check flex flex-wrap gap-x-4 gap-y-2">
        <% opcoes_dias = %w[Segunda Terça Quarta Quinta Sexta Sábado Domingo Feriados Outro] %>
        <% selecionados_dias = (formulario_cadastro.dias_trabalho || "").split(",") %>
        <% opcoes_dias.each do |dia| %>
          <div class="checkbox-class flex items-center">
            <%= check_box_tag "formulario_cadastro[dias_trabalho][]", dia, selecionados_dias.include?(dia), id: "dia_#{dia}" %>
            <%= label_tag "dia_#{dia}", dia, class: "ml-2 font-bold" %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="form-group mb-3">
  <%= f.label :foto, "Anexar a foto por aqui:" %><br>

  <% if formulario_cadastro.persisted? && formulario_cadastro.foto.attached? %>
    <div class="mt-2">
      <%= image_tag formulario_cadastro.foto.variant(resize_to_limit: [240, 240]), class: "rounded shadow", style: "max-width:180px;", id: "foto-preview-existente" %>
    </div>
  <% else %>
    <div class="mt-2">
      <img src="<%= asset_path('unnamed.png') %>" class="rounded-xl shadow" id="foto-preview-existente" style="width: -webkit-fill-available;
    max-height: 28rem;" />
    </div>
  <% end %>

  <small>Você pode fazer upload ou capturar pela câmera. Tamanho máx. 10MB.</small><br>
  <%= f.file_field :foto, accept: "image/*", id: "file_foto_input" %>

  <div class="mt-3">
    <button type="button" class="btn btn-primary" onclick="openCamera()">📸 Capturar com Câmera</button>
  </div>

  <!-- captura por base64 para ActiveStorage -->
  <%= f.hidden_field :foto_base64, id: "foto-base64" %>

  <!-- Preview da foto capturada (substitui a existente quando houver) -->
  <div class="mt-2">
    <img id="foto-preview-capturada" style="max-width: 250px;
    display: block;
    border-radius: 8px;
    box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px;
    width: 261px;
    height: 300px;
    max-height: 300px;" />
  </div>
</div>

<!-- Modal/overlay da câmera -->
<div id="camera-overlay" style="display:none; position:fixed; inset:0; background:#000000cc; z-index:9999; justify-content:center; align-items:center; padding: 42px 12px;">
  <div style="position:relative; max-width: 96vw;">
    <iframe id="camera-frame" src="/camera" style="border: 3px solid #3f3; border-radius: 12px;"></iframe>

    <button type="button" onclick="closeCamera()" style="position:absolute; top:-10px; right:-10px; background:#ff4444; border:none; color:white; font-weight:bold; padding:5px 10px; border-radius:10px;">X</button>
  </div>
</div>

    <div class="form-group mb-3">
      <strong>
        Eu declaro que estou ciente e autorizo o cadastro da biometria facial do colaborador acima, para fins de controle de acesso ao prédio do Softex Pernambuco. Também reconheço minha responsabilidade sobre essa autorização e confirmo que as informações fornecidas são verdadeiras.
      </strong>
      <p class="text-gray-700 mt-1" style="font-size: 0.98em">
        Autorizo a coleta, armazenamento e uso dos meus dados biométricos conforme os termos da Lei Geral de Proteção de Dados (LGPD), ciente de que posso solicitar a revogação desta autorização a qualquer momento, mediante solicitação formal.
        <br>
        <br>
        Declaro, ainda, que a nossa empresa se compromete a comunicar ao Softex Pernambuco o desligamento ou término de vínculo do colaborador, para que seja realizado o cancelamento imediato do acesso biométrico.  
        <br>
        <a href="#" class="text-blue-600 underline">Política de Cadastro Facial para Controle de Acesso</a>
      </p>
      <div class="mt-2">
        <%= f.check_box :concorda_termos, required: true %>
        <%= f.label :concorda_termos, "Declaro que li e concordo com os termos acima." %>
      </div>
    </div>
    <div class="text-end mt-5">
      <%= f.submit formulario_cadastro.new_record? ? "Enviar" : "Atualizar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
<style>
/* ===== Container do formulário ===== */
.form-shell{
  width: min(100%, 720px);
  margin: 24px auto;
  padding: 20px;
}

/* em telas grandes dá um “respiro” */
@media (min-width: 1024px){
  .form-shell{
    margin: 32px auto;
    padding: 24px;
  }
}

/* ===== Alert responsivo ===== */
.alert{
  text-align: center;
  background-color: #d57474;
  min-height: 62px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 14px;
  border-radius: 12px;
}
.alert ul{
  margin: 0;
  padding-left: 18px;
  text-align: left;
}

/* ===== Checkboxes em grid responsivo ===== */
.form-check{
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px 14px;
}
@media (min-width: 520px){
  .form-check{ grid-template-columns: 1fr 1fr; }
}
@media (min-width: 900px){
  .form-check{ grid-template-columns: 1fr 1fr 1fr; }
}
.checkbox-class{
  padding: 8px 10px;
  border-radius: 10px;
}

/* ===== Banner/topo responsivo ===== */
#softex-banner{
  width: 100%;
  margin: 0 auto 14px auto;
  background: white;
  border-radius: 16px;
  box-shadow: 0 4px 32px rgba(0,0,0,0.08);
  position: relative;
  text-align: center;
  padding: 10px 12px;
}

#softex-logo{
  width: 100%;
  max-width: 520px;
  height: auto;
  max-height: 180px;
  object-fit: contain;
  transition: max-height .4s cubic-bezier(.7,.2,.3,1);
}

/* shrink: fica centralizado SEM translateX fixo */
#softex-banner.shrink{
  position: fixed;
  top: 12px;              /* melhor em qualquer tela */
  left: 50%;
  transform: translateX(-50%);
  width: min(100vw, 900px);
  margin: 0;
  border-radius: 0 0 16px 16px;
  box-shadow: 0 2px 18px rgba(0, 0, 0, .15);
  z-index: 999;
  padding: 10px 12px;
}

#softex-banner.shrink #softex-logo{
  max-height: 52px;
}

/* espaço para não “pular” o conteúdo quando shrink ativa */
#banner-spacer{
  height: 0px;
}
#softex-banner.shrink + #banner-spacer{
  height: 78px;
}

/* ===== Preview de foto responsivo ===== */
#foto-preview-existente{
  width: 100%;
  max-width: 520px;
  max-height: 420px;
  object-fit: cover;
  border-radius: 16px;
}

/* preview capturada */
#foto-preview-capturada{
  width: min(100%, 320px) !important;
  height: auto !important;
  max-height: 320px !important;
  display: none;
}

/* ===== Modal câmera responsivo ===== */
#camera-overlay{
  display:none;
  position:fixed;
  inset:0;
  background:#000000cc;
  z-index:9999;
  justify-content:center;
  align-items:center;
  padding: 18px 12px;
}

#camera-frame{
  width: min(96vw, 560px);
  height: min(80vh, 560px);
  max-width: 96vw;
  border-radius: 12px;
}

</style>
<script>
  // ===== Estado global =====
  let photoSource = null;          // null | 'camera' | 'upload'
  let acceptCameraMessages = false; // só aceitar mensagens quando a câmera estiver realmente ativa

  function openCamera() {
    const overlay = document.getElementById("camera-overlay");
    const iframe  = document.getElementById("camera-frame");

    // guarda a src original para reusar depois de um about:blank
    if (iframe && !iframe.dataset.src) iframe.dataset.src = iframe.getAttribute('src');
    if (iframe && iframe.getAttribute('src') === 'about:blank') {
      iframe.setAttribute('src', iframe.dataset.src);
    }

    acceptCameraMessages = true;
    overlay.style.display = "flex";
  }

  function closeCamera() {
    const overlay = document.getElementById("camera-overlay");
    const iframe  = document.getElementById("camera-frame");

    acceptCameraMessages = false; // 🔒 bloqueia mensagens da câmera
    overlay.style.display = "none";

    // mata o conteúdo do iframe para parar setInterval/getUserMedia lá dentro
    if (iframe) iframe.setAttribute('src', 'about:blank');
  }

  // ===== Mensagem vinda do iframe /camera =====
  window.addEventListener("message", function (e) {
    if (!(e.data && e.data.photoBase64)) return;

    // 🔒 se não estiver aceitando mensagens (fechou câmera) ou usuário escolheu upload, ignore
    if (!acceptCameraMessages || photoSource === 'upload') return;

    const base64           = e.data.photoBase64;
    const hiddenBase64     = document.getElementById("foto-base64");
    const fileInput        = document.getElementById("file_foto_input");
    const previewExistente = document.getElementById("foto-preview-existente");
    const previewCapturada = document.getElementById("foto-preview-capturada");

    photoSource = 'camera';

    hiddenBase64.value = base64;
    if (fileInput) fileInput.value = ""; // só limpa o file quando a câmera realmente venceu

    if (previewCapturada) {
      previewCapturada.src = base64;
      previewCapturada.style.display = "block";
    }
    if (previewExistente) previewExistente.style.display = "none";

    closeCamera();
  });

  // ===== Upload substitui e invalida a captura =====
  document.addEventListener('DOMContentLoaded', function () {
    const fileInput        = document.getElementById('file_foto_input');
    const hiddenBase64     = document.getElementById('foto-base64');
    const previewExistente = document.getElementById('foto-preview-existente');
    const previewCapturada = document.getElementById('foto-preview-capturada');

    const defaultPreviewSrc = previewExistente ? previewExistente.src : null;

    function showUploadedPreview(file) {
      if (!file) return;
      if (!file.type.startsWith('image/')) { alert('Por favor, selecione uma imagem.'); fileInput.value = ''; return; }
      if (file.size > 10 * 1024 * 1024)    { alert('Arquivo acima de 10MB.');         fileInput.value = ''; return; }

      // 🚫 a partir daqui, ignore qualquer mensagem de câmera que chegar atrasada
      photoSource = 'upload';
      acceptCameraMessages = false;
      closeCamera(); // garante que o iframe pare de mandar mensagens

      // limpa a captura antiga
      hiddenBase64.value = '';
      if (previewCapturada) {
        previewCapturada.src = '';
        previewCapturada.style.display = 'none';
      }

      // mostra o anexo
      const objectUrl = URL.createObjectURL(file);
      if (previewExistente) {
        previewExistente.src = objectUrl;
        previewExistente.style.display = 'block';
        previewExistente.onload = () => URL.revokeObjectURL(objectUrl);
      }
    }

    fileInput?.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (file) {
        showUploadedPreview(file);
      } else {
        // usuário limpou o input: não restaura captura (foi invalidada),
        // volta para placeholder/preview existente original
        if (photoSource === 'upload') {
          if (previewExistente && defaultPreviewSrc) {
            previewExistente.src = defaultPreviewSrc;
            previewExistente.style.display = 'block';
          }
          if (previewCapturada) {
            previewCapturada.src = '';
            previewCapturada.style.display = 'none';
          }
          photoSource = null;
        }
      }
    });

    // alguns navegadores também disparam 'input'
    fileInput?.addEventListener('input', (e) => {
      const file = e.target.files && e.target.files[0];
      if (file) showUploadedPreview(file);
    });
  });
</script>

