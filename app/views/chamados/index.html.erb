
<div class="table-responsive">
<%# ==== Stats de Chamados (Pendente / Em andamento / Concluído) ==== %>
<% ordem_status = ["Pendente", "Em andamento", "Concluído"] %>
<% cores_por_status = {
  "Pendente"      => "trk--requested",
  "Em andamento"  => "trk--progress",
  "Concluído"     => "trk--done"
} %>

<%
  # usa o escopo já aplicado no controller (admin vê todos, cliente vê só do grupo)
  scope = @chamados || Chamado.all

  raw = scope.group(:status).count

  # Normalização retrocompatível:
  # - "Solicitada" conta como "Pendente"
  # - "Finalizada" e "Concluída/Concluido" contam como "Concluído"
  tot_por_status = {
    "Pendente"      => raw["Pendente"].to_i + raw["Solicitada"].to_i,
    "Em andamento"  => raw["Em andamento"].to_i,
    "Concluído"     => raw["Concluído"].to_i + raw["Concluída"].to_i + raw["Concluido"].to_i + raw["Finalizada"].to_i
  }
  tot_geral = tot_por_status.values.sum
%>


<section class="trk">
  <header class="trk-head">
    <div>
      <h2 class="trk-title"><i class="fa-regular fa-life-ring"></i> Acompanhamento de Chamados</h2>
      <p class="trk-sub">Distribuição por status e progresso geral.</p>
    </div>
    <div class="trk-kpis">
      <div class="kpi">
        <span class="kpi-label">Total</span>
        <span class="kpi-value"><%= tot_geral %></span>
      </div>
      <% ordem_status.each do |st| %>
        <% qt  = tot_por_status[st] || 0 %>
        <% pct = tot_geral.zero? ? 0 : ((qt.to_f / tot_geral) * 100).round %>
        <div class="kpi">
          <span class="kpi-label"><%= st %></span>
          <span class="kpi-chip <%= cores_por_status[st] %>"><%= qt %> <small>(<%= pct %>%)</small></span>
        </div>
      <% end %>
    </div>
  </header>

  <div class="trk-bar" aria-label="Distribuição de chamados por status">
    <% ordem_status.each do |st| %>
      <% qt  = tot_por_status[st] || 0 %>
      <% next if qt.zero? %>
      <% pct = tot_geral.zero? ? 0 : ((qt.to_f / tot_geral) * 100.0) %>
      <% classe = cores_por_status[st] %>
      <% url = url_for(request.params.merge(status: st)) %>
      <a href="<%= url %>"
         class="trk-seg <%= classe %>"
         style="--seg-w: <%= pct %>%"
         title="<%= "#{st}: #{qt} (#{pct.round}%) — clicar filtra" %>">
        <span class="trk-seg-label"><%= st %></span>
      </a>
    <% end %>
    <% if tot_geral.zero? %>
      <div class="trk-empty">Sem dados</div>
    <% end %>
  </div>

  <div class="trk-legend">
    <% ordem_status.each do |st| %>
      <% qt  = tot_por_status[st] || 0 %>
      <% pct = tot_geral.zero? ? 0 : ((qt.to_f / tot_geral) * 100).round %>
      <% url = url_for(request.params.merge(status: st)) %>
      <a class="trk-leg <%= cores_por_status[st] %>" href="<%= url %>">
        <i class="trk-dot"></i> <strong><%= st %></strong>
        <span><%= qt %> • <%= pct %>%</span>
      </a>
    <% end %>
  </div>
</section>




<button type="button" id="filtro-toggle" class="filtro-label" aria-expanded="true" aria-controls="filtros-salas">
  <i class="fa-solid fa-filter"></i>
  Filtro
  <i class="fa-solid fa-chevron-up filtro-chevron" aria-hidden="true"></i>
</button>
<%
  filtros_keys = [:local, :unidade, :status, :prioridade, :responsavel, :password_recovery_support, :data_inicio, :data_fim]
  has_filtros  = filtros_keys.any? { |k| params[k].present? }
%>

<%= form_with url: chamados_path, method: :get, local: true, class: "filtros-form tab-panel", id: "filtros-salas" do %>
  <div class="filtro-row">
    <% scope = @chamados || Chamado.all %>

    <div class="filtro-field">
      <span class="filtro-field-label">Local</span>
      <%= select_tag :local,
            options_for_select(["Todos os locais"] + scope.distinct.pluck(:local), params[:local]),
            class: "form-control" %>
    </div>

    <div class="filtro-field">
      <span class="filtro-field-label">Unidade</span>
      <%= select_tag :unidade,
            options_for_select(["Todas as unidades"] + scope.distinct.pluck(:unidade), params[:unidade]),
            class: "form-control" %>
    </div>

    <div class="filtro-field">
      <span class="filtro-field-label">Status</span>
      <%= select_tag :status,
            options_for_select(["Todos os status", "Pendente", "Em andamento", "Concluído"], params[:status]),
            class: "form-control" %>
    </div>

    <div class="filtro-field">
      <span class="filtro-field-label">Prioridade</span>
      <%= select_tag :prioridade,
            options_for_select(["Todas as prioridades"] + scope.distinct.pluck(:prioridade), params[:prioridade]),
            class: "form-control" %>
    </div>

    <div class="filtro-field">
      <span class="filtro-field-label">Responsável</span>
      <%= select_tag :responsavel,
            options_for_select(["Todos os responsáveis"] + scope.distinct.pluck(:responsavel), params[:responsavel]),
            class: "form-control" %>
    </div>

    <div class="filtro-field">
      <span class="filtro-field-label">Recuperacao</span>
      <%= select_tag :password_recovery_support,
            options_for_select(["Todos", "Solicitou suporte de acesso"], params[:password_recovery_support]),
            class: "form-control" %>
    </div>

    <div class="filtro-field">
      <span class="filtro-field-label">Data início</span>
      <%= text_field_tag :data_inicio, params[:data_inicio], class: "form-control", placeholder: "" %>
    </div>

    <div class="filtro-sep">a</div>

    <div class="filtro-field">
      <span class="filtro-field-label">Data fim</span>
      <%= text_field_tag :data_fim, params[:data_fim], class: "form-control", placeholder: "" %>
    </div>

<div class="filtro-actions">
  <%= button_tag type: "submit", class: "btn btn-success" do %>
    <i class="fa fa-search"></i>
  <% end %>

  <% if has_filtros %>
    <%= link_to chamados_path, class: "btn btn-success", title: "Limpar filtros" do %>
      <i class="fa-solid fa-rotate-left"></i>
    <% end %>
  <% end %>
</div>
  </div>
<% end %>


  <table class="table-salas">
    <thead>
      <tr>
        <th class="hide-sm">OS</th>
        <th>Título</th>
        <th class="hide-sm">Unidade</th>
        <th>Prioridade</th>
        <th>Status</th>
        <th class="hide-sm">Responsável</th>
        <th class="hide-sm">Solicitante</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @chamados.each do |chamado| %>
        <tr>
          <td class="hide-sm"><%= chamado.os %></td>
          <td><%= chamado.titulo %></td>
          <td class="hide-sm"><%= chamado.unidade %></td>
          <td><%= chamado.prioridade %></td>
          <td><%= chamado.status %></td>
          <td><%= chamado.responsavel %></td>
          <td><%= chamado.solicitante&.name %></td>
         <td style="
    display: flex;
    flex-direction: column;
">
          <%= link_to chamado_path(chamado), class: "btn btn-success" do %>
            <i class="fa-solid fa-eye"></i> <div class="hide-sm"> Ver </div>
          <% end %>
          <% if pode_enviar_link_recuperacao_chamado?(chamado, current_user) %>
            <%= button_to send_password_recovery_link_chamado_path(chamado),
                  method: :post,
                  class: "btn btn-primary",
                  form: {
                    class: "form-send-reset-link",
                    data: {
                      record_name: (chamado.solicitante&.name.presence || chamado.titulo.presence || chamado.os),
                      turbo: false
                    },
                    style: "display:inline"
                  } do %>
              <i class="fa-solid fa-paper-plane"></i> <div class="hide-sm"> Enviar redefinicao </div>
            <% end %>
          <% end %>
          <% if pode_editar_chamado?(chamado, current_user) %>
            <%= link_to edit_chamado_path(chamado), class: "edit btn btn-sm btn-outline-secondary" do %>
               <i class="fa-solid fa-pen-to-square"></i> <div class="hide-sm"> Editar </div>
            <% end %>
          <% end %>
          <% if pode_alterar_status_chamado?(chamado, current_user) %>
            <%= button_to change_status_chamado_path(chamado),
                  method: :patch,
                  class: "btn btn-info",
                  form: {
                    class: "form-status-chamado",
                    data:  { status: chamado.status, record_name: (chamado.titulo.presence || chamado.os) }
                  } do %>
              <i class="fa-solid fa-rotate"></i> <div class="hide-sm"> Mudar status </div>
            <% end %>
          <% end %>
          <% if pode_editar_chamado?(chamado, current_user) %>
            <%= button_to chamado_path(chamado),
        method: :delete,
        class: "btn btn-warning",                                # estilo visual
        form: {
          class: "form-excluir-chamado",                         # <- vamos interceptar este form
          data:  { record_name: (chamado.titulo.presence || chamado.os), turbo: false }, # turbo: false evita submit imediato
          style: "display:inline"
        } do %>
    <i class="fa-solid fa-trash-can"></i> <div class="hide-sm"> Excluir </div>
  <% end %>
          <% end %>


        </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<script>
document.addEventListener("submit", async function(e) {
  const form = e.target;
  if (!form.classList.contains("form-send-reset-link")) return;

  e.preventDefault();

  const btn = e.submitter;
  const nome = (btn && btn.dataset.recordName) || form.dataset.recordName || "este usuario";

  if (window.Swal) {
    const res = await Swal.fire({
      title: "Enviar link de redefinicao?",
      html: `Deseja realmente enviar o e-mail de redefinicao para <b>${nome}</b>?`,
      icon: "question",
      showCancelButton: true,
      confirmButtonText: "Sim, enviar",
      cancelButtonText: "Cancelar",
      reverseButtons: true,
      focusCancel: true
    });
    if (res.isConfirmed) form.submit();
  } else {
    if (confirm(`Deseja realmente enviar o e-mail de redefinicao para ${nome}?`)) {
      form.submit();
    }
  }
});

document.addEventListener("submit", async function(e) {
  const form = e.target;
  if (!form.classList.contains("form-excluir-chamado")) return;

  e.preventDefault(); // trava o submit padrão

  // nome do registro (pode vir do form ou do botão clicado)
  const btn = e.submitter; // quem disparou o submit
  const nome = (btn && btn.dataset.recordName) || form.dataset.recordName || "este chamado";

  if (window.Swal) {
    const res = await Swal.fire({
      title: "Excluir chamado?",
      html: `Tem certeza que deseja excluir <b>${nome}</b>?`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: "Sim, excluir",
      cancelButtonText: "Cancelar",
      reverseButtons: true,
      focusCancel: true
    });
    if (res.isConfirmed) form.submit(); // agora deixa enviar
  } else {
    if (confirm(`Tem certeza que deseja excluir ${nome}?`)) {
      form.submit();
    }
  }
});

  (function () {
    if (window.__chamadoStatusModalBound) return;
    window.__chamadoStatusModalBound = true;

    function ensureHiddenInput(form, name, value) {
      let input = form.querySelector(`input[name="${name}"]`);
      if (!input) {
        input = document.createElement("input");
        input.type = "hidden";
        input.name = name;
        form.appendChild(input);
      }
      input.value = value || "";
    }

    async function openStatusModal(form) {
      const statusAtual = (form.dataset.status || "").toString().trim();
      const titulo = form.dataset.recordName || "este chamado";
      const statusOptions = ["Pendente", "Em andamento", "Concluído"];
      const normalized = statusOptions.includes(statusAtual) ? statusAtual : "Pendente";

      if (window.Swal) {
        const modalHtml = `
          <style>
            .swal-status-wrap{display:flex;flex-direction:column;gap:12px;text-align:left;}
            .swal-status-wrap label{font-size:.9rem;color:#3b3b3b;display:block;margin-bottom:6px;}
            .swal-status-wrap .swal2-select,
            .swal-status-wrap .swal2-input,
            .swal-status-wrap .swal2-textarea{
              border:1px solid #d0d7de;
              border-radius:8px;
              padding:10px 12px;
              font-size:.95rem;
              box-sizing:border-box;
              width:100%;
              max-width:100%;
              min-width:0;
              display:block;
            }
            .swal-status-card{
              background:#f7f9fc;
              border:1px dashed #c9d4e3;
              border-radius:10px;
              padding:12px;
              display:flex;
              flex-direction:column;
              gap:10px;
              overflow:hidden;
            }
            .swal-status-card *{box-sizing:border-box;}
            .swal-status-card .swal2-input,
            .swal-status-card .swal2-textarea{margin:0;}
            .swal2-html-container{overflow:visible;max-width:100%;padding-left:12px;padding-right:12px;box-sizing:border-box;}
            .swal2-title{padding-left:12px;padding-right:12px;box-sizing:border-box;max-width:100%;}
          </style>
          <div class="swal-status-wrap">
            <label for="swal-status"><strong>Status</strong></label>
            <select id="swal-status" class="swal2-select" style="width: -webkit-fill-available;">
              ${statusOptions.map(s => `<option value="${s}">${s}</option>`).join("")}
            </select>
            <div id="swal-pendente-fields" class="swal-status-card" style="display:none;">
              <div>
                <label for="swal-observacao"><strong>Observação</strong></label>
                <textarea id="swal-observacao" class="swal2-textarea" rows="3" placeholder="Descreva o motivo"></textarea>
              </div>
              <div>
                <label for="swal-proxima-data"><strong>Próxima data de resolução</strong></label>
                <input id="swal-proxima-data" type="date" class="swal2-input" />
              </div>
            </div>
          </div>
        `;

        const res = await Swal.fire({
          title: "Alterar status",
          html: `Selecione o novo status de <b>${titulo}</b>${modalHtml}`,
          width: 520,
          showCancelButton: true,
          confirmButtonText: "Salvar",
          cancelButtonText: "Cancelar",
          reverseButtons: true,
          focusCancel: true,
          didOpen: () => {
            const select = document.getElementById("swal-status");
            const pendenteFields = document.getElementById("swal-pendente-fields");
            select.value = normalized;
            const toggle = () => {
              pendenteFields.style.display = select.value === "Pendente" ? "block" : "none";
            };
            select.addEventListener("change", toggle);
            toggle();
          },
          preConfirm: () => {
            const status = document.getElementById("swal-status")?.value;
            const observacao = document.getElementById("swal-observacao")?.value?.trim();
            const proximaData = document.getElementById("swal-proxima-data")?.value;
            if (status === "Pendente" && (!observacao || !proximaData)) {
              Swal.showValidationMessage("Observação e próxima data são obrigatórias para Pendente.");
              return false;
            }
            return { status, observacao, proximaData };
          }
        });

        if (res.isConfirmed && res.value?.status) {
          const { status, observacao, proximaData } = res.value;
          ensureHiddenInput(form, "status", status);

          if (status === "Pendente") {
            ensureHiddenInput(form, "observacao", observacao || "");
            ensureHiddenInput(form, "proxima_data", proximaData || "");
          }

          form.submit();
        }
      } else {
        const novo = prompt("Digite o status (Pendente, Em andamento, Concluído):", normalized);
        if (novo && statusOptions.includes(novo)) {
          let observacao = "";
          let proximaData = "";
          if (novo === "Pendente") {
            observacao = prompt("Observação (obrigatória):", "") || "";
            proximaData = prompt("Próxima data de resolução (AAAA-MM-DD):", "") || "";
            if (!observacao || !proximaData) {
              alert("Observação e próxima data são obrigatórias para Pendente.");
              return;
            }
          }
          ensureHiddenInput(form, "status", novo);
          if (novo === "Pendente") {
            ensureHiddenInput(form, "observacao", observacao);
            ensureHiddenInput(form, "proxima_data", proximaData);
          }
          form.submit();
        } else if (novo) {
          alert("Status inválido.");
        }
      }
    }

    document.addEventListener("submit", function (e) {
      const form = e.target;
      if (!form.classList.contains("form-status-chamado")) return;
      e.preventDefault();
      openStatusModal(form);
    });
  })();

function mountTrkBars(){
  document.querySelectorAll(".trk-bar").forEach(bar=>{
    // reset para permitir re-animar em navegações Turbo
    bar.classList.remove("mounted");
    // força reflow para garantir a transição
    void bar.offsetWidth;
    // adiciona a classe que aplica width: var(--seg-w)
    bar.classList.add("mounted");
  });
}

// Suporta páginas com Turbo e sem Turbo
document.addEventListener("DOMContentLoaded", mountTrkBars);
document.addEventListener("turbo:load", mountTrkBars);
// Se usar Turbo Frames, ajuda também:
document.addEventListener("turbo:frame-load", mountTrkBars);


// ======= JS do colapso suave + fecha ao perder foco =======
document.addEventListener('DOMContentLoaded', () => {
  const toggle  = document.getElementById('filtro-toggle');
  const filtros = document.getElementById('filtros-salas');
  if (!toggle || !filtros) return;

  const STORAGE_KEY = 'ui:filtros-chamados-collapsed'; // use uma key diferente

  function isOpen() {
    return !filtros.classList.contains('collapsed');
  }

  function setCollapsed(collapsed, save = true) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (collapsed) {
      const curH = filtros.scrollHeight;
      filtros.style.maxHeight = curH + 'px';
      filtros.offsetHeight;

      filtros.classList.add('collapsed');
      filtros.style.maxHeight = prefersReduced ? '' : '0px';

      toggle.setAttribute('aria-expanded', 'false');
      filtros.setAttribute('aria-hidden', 'true');
      if (save) localStorage.setItem(STORAGE_KEY, '1');
    } else {
      filtros.classList.remove('collapsed');
      filtros.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');

      if (!prefersReduced) {
        filtros.style.maxHeight = '0px';
        filtros.offsetHeight;
        filtros.style.maxHeight = filtros.scrollHeight + 'px';

        const cleanup = () => {
          filtros.style.maxHeight = '';
          filtros.removeEventListener('transitionend', cleanup);
        };
        filtros.addEventListener('transitionend', cleanup);
      } else {
        filtros.style.maxHeight = '';
      }

      if (save) localStorage.removeItem(STORAGE_KEY);
    }
  }

  // ===== estado inicial =====
  const saved = localStorage.getItem(STORAGE_KEY);
  const startCollapsed = saved === '1' || toggle.getAttribute('aria-expanded') === 'false';

  if (startCollapsed) {
    filtros.classList.add('collapsed');
    filtros.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    filtros.style.maxHeight = '0px';
  } else {
    filtros.classList.remove('collapsed');
    filtros.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    filtros.style.maxHeight = '';
  }

  // ===== toggle manual =====
  toggle.addEventListener('click', (ev) => {
    ev.preventDefault();
    setCollapsed(isOpen(), true); // se aberto fecha, se fechado abre
  });

  // ===== abre quando focar dentro =====
  filtros.addEventListener('focusin', () => {
    if (!isOpen()) setCollapsed(false, false);
  });

  // ===== fecha quando sair do foco do painel =====
  filtros.addEventListener('focusout', (ev) => {
    const next = ev.relatedTarget;

    // Se o próximo foco ainda está dentro do painel, não fecha
    if (next && filtros.contains(next)) return;

    // Se foi pro botão do toggle, não fecha (vai ser controlado pelo clique)
    if (next && toggle.contains(next)) return;

    // fecha e salva
    setCollapsed(true, true);
  });

  // ===== fecha ao clicar fora =====
  document.addEventListener('pointerdown', (ev) => {
    if (!isOpen()) return;

    const insideToggle = ev.target.closest('#filtro-toggle');
    const insidePanel  = ev.target.closest('#filtros-salas');
    if (!insideToggle && !insidePanel) {
      setCollapsed(true, true);
    }
  });
});


</script>
