}

.anexo-remover i {
  color: #f88;
}


.modal-custom {
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background-color: rgba(0,0,0,0.4);
}
.modal-dialog {
  background: #fff;
  margin: 10% auto;
  padding: 20px;
  width: 400px;
  border-radius: 6px;
  color: var(--color-btn--text);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

p {
  color: var(--color-btn) !important;
}
</style>


<script>
document.addEventListener('DOMContentLoaded', () => {

  // --- INICIALIZADOR DE TOOLTIPS (SE VOCÊ USAR) ---
  if (typeof bootstrap !== 'undefined') {
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
  }

  // --- LÓGICA DO MODAL DE OCORRÊNCIAS ---
  const modalOcorrencia = document.getElementById('modalOcorrencia');
  if (modalOcorrencia) {
    const formOcorrencia = document.getElementById('formOcorrencia');
    const openBtnOcorrencia = document.getElementById('abrir-modal-ocorrencia');
    const createActionUrl = formOcorrencia.action;

    // Listener para o botão "Registrar Ocorrência"
    openBtnOcorrencia?.addEventListener('click', () => {
      formOcorrencia.reset();
      formOcorrencia.querySelector('input[name="_method"]')?.remove();

      document.getElementById('ocorrencia-modal-title').textContent = "Registrar Ocorrência";
      formOcorrencia.action = createActionUrl;
      document.getElementById('submitOcorrenciaBtn').value = "Registrar";
      document.getElementById('ocorrencia_id').value = "";
      
      modalOcorrencia.style.display = 'block';
    });
  }

  // --- LISTENER GLOBAL PARA CLIQUES (EDITAR/FECHAR MODAIS) ---
  document.addEventListener('click', (e) => {
    // Ação para EDITAR Ocorrência
    const editButton = e.target.closest('.editar-ocorrencia');
    if (editButton) {
      const modalOcorrencia = document.getElementById('modalOcorrencia');
      if (!modalOcorrencia) return;

      const formOcorrencia = document.getElementById('formOcorrencia');
      const ocorrencia = JSON.parse(editButton.dataset.ocorrencia);

      formOcorrencia.querySelector('input[name="_method"]')?.remove();
      
      document.getElementById('ocorrencia-modal-title').textContent = "Editar Ocorrência";
      formOcorrencia.action = `/ocorrencias/${ocorrencia.id}`;
      document.getElementById('submitOcorrenciaBtn').value = "Atualizar";
      document.getElementById('ocorrencia_id').value = ocorrencia.id;

      const methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      methodInput.value = 'patch';
      formOcorrencia.appendChild(methodInput);

      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      let tokenInput = formOcorrencia.querySelector('input[name="authenticity_token"]');
      if (tokenInput) { tokenInput.value = csrfToken; }

      document.getElementById('ocorrencia_data_ocorrencia').value = ocorrencia.data_ocorrencia;
      document.getElementById('ocorrencia_proxima_data').value = ocorrencia.proxima_data;
      document.getElementById('ocorrencia_descricao').value = ocorrencia.descricao;

      modalOcorrencia.style.display = 'block';
    }

    // Ação para FECHAR qualquer modal
    const closeButton = e.target.closest('.close-modal');
    if (closeButton) {
      closeButton.closest('.modal-custom').style.display = 'none';
    }
  });
  
  // Ação para fechar o modal clicando fora dele
  window.addEventListener('click', (e) => {
    if (e.target.matches('.modal-custom')) {
      e.target.style.display = 'none';
    }
  });


  // --- LÓGICA DA PRÉ-VISUALIZAÇÃO DE FOTOS ---
  const input = document.getElementById("fotos-upload");
  if (input) {
    const previewContainer = document.getElementById("fotos-preview");
    let allFiles = [];

    input.addEventListener("change", function () {
      const selectedFiles = Array.from(input.files);
      selectedFiles.forEach(file => {
        allFiles.push(file);
        const reader = new FileReader();
        reader.onload = function (e) {
          const wrapper = document.createElement("div");
          wrapper.className = 'image-thumb';
          
          const img = document.createElement("img");
          img.src = e.target.result;

          const removeBtn = document.createElement("a");
          removeBtn.innerText = "✕";
          removeBtn.className = 'remove-foto-btn';
          removeBtn.href = '#';
          removeBtn.onclick = (event) => {
            event.preventDefault();
            previewContainer.removeChild(wrapper);
            allFiles = allFiles.filter(f => f !== file);
            const dataTransfer = new DataTransfer();
            allFiles.forEach(f => dataTransfer.items.add(f));
            input.files = dataTransfer.files;
          };

          wrapper.appendChild(img);
          wrapper.appendChild(removeBtn);
          previewContainer.appendChild(wrapper);
        };
        reader.readAsDataURL(file);
      });
    });
  }
}); // FIM do DOMContentLoaded

// --- FUNÇÕES GLOBAIS PARA O MODAL DE IMAGEM (fora do DOMContentLoaded) ---
let currentZoom = 1;

function showModal(el) {
  const thumb = el.closest(".image-thumb");
  const image = thumb.querySelector("img");
  const fullUrl = image?.getAttribute("src");

  if (fullUrl) {
    const modal = document.getElementById("modal-image-viewer");
    const modalImg = modal.querySelector("img");
    modalImg.src = fullUrl;
    modalImg.style.transform = "scale(0.5)";
    currentZoom = 0.5;
    modal.style.display = "flex";
  }
}

function hideModal() {
  const modal = document.getElementById("modal-image-viewer");
  if(modal) modal.style.display = "none";
}

const modalImgViewer = document.getElementById("modal-image-viewer");
if (modalImgViewer) {
  modalImgViewer.addEventListener("wheel", function (e) {
    e.preventDefault();
    const modalImg = this.querySelector('img');
    const delta = e.deltaY > 0 ? -0.1 : 0.1;
    currentZoom = Math.max(0.2, Math.min(currentZoom + delta, 5));
    modalImg.style.transform = `scale(${currentZoom})`;
  });
}

// --- Lógica para o Modal: Anexar Arquivos (Geral) ---
  const modalAnexar = document.getElementById('modalAnexarArquivos');
  if (modalAnexar) {
    const openBtnAnexar = document.getElementById('abrir-modal-anexar');
    const closeBtnAnexar = modalAnexar.querySelector('.close-modal');

    openBtnAnexar?.addEventListener('click', () => {
      modalAnexar.style.display = 'block';
    });

    closeBtnAnexar?.addEventListener('click', () => {
      modalAnexar.style.display = 'none';
    });

    window.addEventListener('click', (e) => {
      if (e.target === modalAnexar) {
        modalAnexar.style.display = 'none';
      }
    });
  }

  // --- Lógica para o Modal: Checklist ---
  const modalChecklist = document.getElementById('modalChecklist');
  if (modalChecklist) {
    const openChecklist = document.getElementById('abrir-modal-checklist');
    const closeChecklist = modalChecklist.querySelector('.close-modal');

    openChecklist?.addEventListener('click', () => {
      modalChecklist.style.display = 'block'
    });
    
    closeChecklist?.addEventListener('click', () => {
      modalChecklist.style.display = 'none'
    });

    window.addEventListener('click', (e) => {
      if (e.target === modalChecklist) {
        modalChecklist.style.display = 'none';
      }
    });
  }

  // --- Lógica para o Modal: Ocorrências (Criar e Editar) ---
  const modalOcorrencia = document.getElementById('modalOcorrencia');
  if (modalOcorrencia) {
    const formOcorrencia = document.getElementById('formOcorrencia');
    const modalTitle = document.getElementById('ocorrencia-modal-title');
    const submitBtn = document.getElementById('submitOcorrenciaBtn');
    const ocorrenciaIdInput = document.getElementById('ocorrencia_id');
    const openBtnOcorrencia = document.getElementById('abrir-modal-ocorrencia');
    
    // Guarda a URL original do formulário (para a ação de "criar")
    const createActionUrl = formOcorrencia.action;

    const clearMethodField = () => {
      const existingMethodField = formOcorrencia.querySelector('input[name="_method"]');
      if (existingMethodField) {
        existingMethodField.remove();
      }
    };

    // Listener para o botão "Registrar Ocorrência"
    openBtnOcorrencia?.addEventListener('click', () => {
     
      clearMethodField();

      modalTitle.textContent = "Registrar Ocorrência";
      formOcorrencia.action = createActionUrl; // Restaura a action original de "criar"
      submitBtn.value = "Registrar";
      ocorrenciaIdInput.value = "";
      
      document.querySelectorAll('.checklist-checkbox').forEach(checkbox => {
        checkbox.checked = false;
      });

      modalOcorrencia.style.display = 'block';
    });
  }

  // --- Listener Global para Cliques (Editar Ocorrência e Fechar Modais) ---
  document.addEventListener('click', (e) => {
    // Ação para EDITAR Ocorrência
    const editButton = e.target.closest('.editar-ocorrencia');
if (editButton) {
  const modalOcorrencia = document.getElementById('modalOcorrencia');
  if (!modalOcorrencia) return;

  const formOcorrencia = document.getElementById('formOcorrencia');
  const ocorrencia = JSON.parse(editButton.dataset.ocorrencia);
  const checklistIds = JSON.parse(editButton.dataset.checklist);

  // Limpa o campo de método antigo (_method)
  formOcorrencia.querySelector('input[name="_method"]')?.remove();
  
  // Prepara o formulário para edição
  document.getElementById('ocorrencia-modal-title').textContent = "Editar Ocorrência";
  formOcorrencia.action = `/ocorrencias/${ocorrencia.id}`;
  document.getElementById('submitOcorrenciaBtn').value = "Atualizar";
  document.getElementById('ocorrencia_id').value = ocorrencia.id;

  // Adiciona o campo _method para PATCH
  const methodInput = document.createElement('input');
  methodInput.type = 'hidden';
  methodInput.name = '_method';
  methodInput.value = 'patch';
  formOcorrencia.appendChild(methodInput);

  // *** GARANTE O TOKEN DE SEGURANÇA CORRETO ***
  const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  let tokenInput = formOcorrencia.querySelector('input[name="authenticity_token"]');
  if (tokenInput) {
    tokenInput.value = csrfToken;
  }

  // Preenche os dados
  document.getElementById('ocorrencia_data_ocorrencia').value = ocorrencia.data_ocorrencia;
  document.getElementById('ocorrencia_proxima_data').value = ocorrencia.proxima_data;
  document.getElementById('ocorrencia_descricao').value = ocorrencia.descricao;
  document.querySelectorAll('.checklist-checkbox').forEach(checkbox => {
    const itemId = parseInt(checkbox.id.replace('check_', ''));
    checkbox.checked = checklistIds.includes(itemId);
  });

  modalOcorrencia.style.display = 'block';
}

    // Ação para FECHAR qualquer modal
    if (e.target.matches('.close-modal')) {
      e.target.closest('.modal-custom').style.display = 'none';
    }
  });

  
</script>

