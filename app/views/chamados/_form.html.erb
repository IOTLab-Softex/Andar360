<div id="modal-image-viewer" onclick="hideModal()">
  <span class="close-modal">&times;</span>
  <img src="" alt="Visualizar imagem">
</div>

<%= form_with(model: @chamado, local: true, html: { multipart: true }) do |form| %>

  <!-- BOTÃO SALVAR CENTRALIZADO -->
  <div class="form-group-fixed" style="display:flex; justify-content:center;">
    <div class="mt-3 text-center">
      <%= form.button type: "submit", class: "btn btn-success" do %>
        <i class="fa-solid fa-floppy-disk"></i>
        <%= form.object.persisted? ? "Salvar" : "Criar" %>
      <% end %>
    </div>
  </div>

  <br>

  <!-- DADOS DO CHAMADO (MESMO DESIGN DO SHOW/ MANUTENÇÃO) -->
  <div class="chamado-section section-box">
    <div class="section-header">
      <h5>
        <i class="fa-solid fa-circle-info"></i>
        Dados do chamado
      </h5>
    </div>

    <div class="section-body chamado-grid">
      <div class="chamado-field">
        <span class="label"><%= form.label :os, "OS" %></span>
        <div class="value">
          <%= form.text_field :os, class: "form-control", readonly: true %>
        </div>
      </div>

      <div class="chamado-field">
        <span class="label"><%= form.label :room_id, "Unidade" %></span>
        <div class="value">
          <%= form.collection_select :room_id,
                                     @rooms_disponiveis,
                                     :id, :name,
                                     { prompt: "Selecione uma sala" },
                                     class: "form-control" %>
        </div>
      </div>

      <div class="chamado-field chamado-observacao">
        <span class="label"><%= form.label :titulo, "Título*" %></span>
        <div class="value">
          <%= form.text_field :titulo, class: "form-control" %>
        </div>
      </div>

      <div class="chamado-field">
        <span class="label"><%= form.label :prioridade %></span>
        <div class="value">
          <%= form.select :prioridade,
                          options_for_select(['Muito Baixo', 'Baixo', 'Médio', 'Alto', 'Crítico'], @chamado.prioridade),
                          {},
                          class: "form-control" %>
        </div>
      </div>

      <% if current_user.admin? || current_user.role == "operador" %>
        <div class="chamado-field">
          <span class="label"><%= form.label :status %></span>
          <div class="value">
            <%= form.select :status,
                            options_for_select(['Em andamento', 'Concluído', 'Pendente'], @chamado.status),
                            {},
                            class: "form-control" %>
          </div>
        </div>

        <div class="chamado-field">
          <span class="label"><%= form.label :data_resolucao, "Data de Resolução" %></span>
          <div class="value">
            <%= form.date_field :data_resolucao, class: "form-control" %>
          </div>
        </div>

        <div class="chamado-field">
          <span class="label"><%= form.label :exibir_no_app, "Exibir no App" %></span>
          <div class="value">
            <%= form.select :exibir_no_app,
                            [["Sim", true], ["Não", false]],
                            {},
                            class: "form-control" %>
          </div>
        </div>
      <% end %>

      <div class="chamado-field">
        <span class="label"><%= form.label :local, "Local" %></span>
        <div class="value">
          <%= form.text_field :local, class: "form-control" %>
        </div>
      </div>

      <div class="chamado-field">
        <span class="label"><%= form.label :responsavel, "Responsável" %></span>
        <div class="value">
          <%= form.collection_select :responsavel,
                                     @possiveis_responsaveis,
                                     :name, :name,
                                     { prompt: "Selecione o responsável" },
                                     class: "form-control" %>
        </div>
      </div>

      <div class="chamado-field chamado-observacao">
        <span class="label"><%= form.label :observacao, "Observação" %></span>
        <div class="value">
          <%= form.text_area :observacao, class: "form-control", rows: 4 %>
        </div>
      </div>
    </div>
  </div>

  <!-- FOTOS DO CHAMADO (CARD PRÓPRIO, IGUAL AO SHOW) -->
  <div class="chamado-section section-box">
    <div class="section-header">
      <h5>
        <i class="fa-solid fa-image"></i>
        Fotos do chamado
      </h5>
    </div>

    <div class="section-body">
      <div class="form-group" style="flex: 1;">
        <%= form.label :fotos, "Adicionar fotos" %>
        <%= form.file_field :fotos,
                            multiple: true,
                            style: "color: black;",
                            class: "form-control",
                            id: "fotos-upload" %>
      </div>

      <div class="form-group" style="flex: 1; margin-top: 1rem;">
        <label>Fotos para adicionar</label>
        <div id="fotos-preview"
             style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;"></div>
      </div>

      <% if form.object.persisted? && form.object.fotos.attached? %>
        <div class="form-group" style="flex: 1; margin-top: 1rem;">
          <label>Fotos existentes</label>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
            <% form.object.fotos.each do |foto| %>
              <div class="image-thumb">
                <%= image_tag url_for(foto), data: { full: url_for(foto) } %>

                <%= link_to remove_foto_chamado_path(form.object, foto_id: foto.signed_id),
                            method: :delete,
                            data: { confirm: "Remover esta foto?" },
                            class: "remove-foto-btn" do %>
                  ✕
                <% end %>

                <div class="overlay-eye" onclick="showModal(this)">
                  <i class="fa-solid fa-eye"></i>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

<% end %>



<% if @chamado.persisted? %>
  <div class="chamado-section section-box">
    <div class="section-header">
      <h5>
        <i class="fa fa-paperclip"></i>
        Anexos
      </h5>

      <button id="abrir-modal-anexar" type="button" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-paperclip"></i> Novo Anexo
      </button>
    </div>

    <div class="section-body lista-anexos">
      <% any = false %>

      <%# 1) Arquivos anexados diretamente no Chamado %>
      <% @chamado.arquivos_anexos_chamado.each do |anexo| %>
        <% any = true %>
        <div class="anexo-item">
          <div class="anexo-info">
            <%= link_to url_for(anexo.arquivo), target: "_blank", class: "anexo-link" do %>
              <i class="fa fa-download"></i> <%= anexo.nome %>
            <% end %>
          </div>

          <%= button_to chamado_arquivos_anexos_chamado_path(@chamado, anexo),
              method: :delete,
              data: { confirm: "Remover este anexo?" },
              class: "anexo-remover" do %>
            ✕
          <% end %>
        </div>
      <% end %>

      <%# 2) Arquivos anexados nas Ocorrências do Chamado %>
      <% @chamado.ocorrencias.order(created_at: :desc).each do |oc| %>
        <% if oc.arquivos.attached? %>
          <div class="subsection-header mt-2">
            <small>
              <i class="fa fa-history"></i>
              Ocorrência em <%= oc.data_ocorrencia.strftime("%d/%m/%Y") %>
            </small>
          </div>

          <% oc.arquivos.each do |blob| %>
            <% any = true %>
            <div class="anexo-item">
              <div class="anexo-info">
                <%= link_to url_for(blob), target: "_blank", class: "anexo-link" do %>
                  <i class="fa fa-download"></i> <%= blob.filename.to_s %>
                <% end %>
              </div>

              <%= button_to "✕",
                  remover_arquivo_ocorrencia_path(oc, blob_signed_id: blob.signed_id),
                  method: :delete,
                  data: { confirm: "Remover este arquivo da ocorrência?" },
                  class: "anexo-remover" %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% unless any %>
        <p class="text-muted text-center">Nenhum anexo encontrado.</p>
      <% end %>
    </div>
  </div>
<% end %>



