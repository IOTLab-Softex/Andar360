<style>
.image-thumb {
  position: relative;
  display: inline-block;
  width: 150px;
  height: 150px;
  border-radius: 8px;
  border: 1px solid #ccc;
  overflow: hidden;
}

.image-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8px;
}

.overlay-eye {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 8px;
  background-color: rgba(0, 0, 0, 0.4);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
  cursor: pointer;
}

.overlay-eye i {
  font-size: 1.8rem;
}

.overlay-eye:hover {
  background-color: rgba(0, 0, 0, 0.6);
}


.image-thumb:hover .overlay-eye {
  opacity: 1;
}

.remove-foto-btn {
  position: absolute;
  top: 4px;
  right: 6px;
  background: #f44336;
  color: white;
  border-radius: 50%;
  padding: 0 6px;
  text-decoration: none;
  font-weight: bold;
  z-index: 2;
}

#modal-image-viewer {
    position: fixed;
    top: 0;
    left: 0;
    width: -webkit-fill-available;
    height: -webkit-fill-available;
    background: rgba(0, 0, 0, 0.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

#modal-image-viewer img {
  max-width: none;
  max-height: none;
  width: auto;
  height: auto;
  border-radius: 12px;
  transition: transform 0.2s ease;
  transform-origin: center center;
}


#modal-image-viewer .close-modal {
  position: absolute;
  top: 20px;
  right: 30px;
  color: white;
  font-size: 2rem;
  cursor: pointer;
}



.lista-anexos {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.anexo-item {
  display: flex;
  align-items: center;
  background-color: #3b6ea5;
  padding: 0.5rem 1rem;
  border-radius: 5px;
  color: #fff;
  justify-content: space-between;
  margin-bottom: 10px;
}

.anexo-link {
  color: white;
  text-decoration: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.5rem; /* espaço entre ícone e texto */
}

.anexo-link i {
  font-size: 1rem;
}

.anexo-remover {
  background: none;
  border: none;
  color: #fff;
  font-size: 1.1rem;
  padding-left: 1rem; /* GAP do botão em relação ao nome */
