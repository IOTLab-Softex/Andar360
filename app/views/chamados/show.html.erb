<div class="device-form" style="display: flex; flex-wrap: wrap; gap: 1rem;">
<div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>OS:</strong><br>
    <%= @chamado.os %>
  </div>
</div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>Unidade:</strong><br>
    <%= @chamado.room&.name %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 2;">
    <strong>Título:</strong><br>
    <%= @chamado.titulo %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>Prioridade:</strong><br>
    <%= @chamado.prioridade %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>Status:</strong><br>
    <%= @chamado.status %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>Data Resolução:</strong><br>
    <%= l(@chamado.data_resolucao) if @chamado.data_resolucao %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>Exibir no App:</strong><br>
    <%= @chamado.exibir_no_app ? 'Sim' : 'Não' %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>Local:</strong><br>
    <%= @chamado.local %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 30%;">
  <div style="flex: 1;">
    <strong>Responsável:</strong><br>
    <%= @chamado.responsavel %>
  </div>

  </div>
  <div class="form-group" style="flex: 1 1 100%;">
  <div style="flex: 1 1 100%;">
    <strong>Observação:</strong><br>
    <%= simple_format(@chamado.observacao) %>
  </div>
  </div>
</div>

<% if @chamado.fotos.attached? %>
  <div class="device-form" style="margin-top: 2rem;">
    <strong>Fotos:</strong>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem;">
      <% @chamado.fotos.each do |foto| %>
        <div class="image-thumb">
          <%= image_tag url_for(foto), data: { full: url_for(foto) } %>
          <div class="overlay-eye" onclick="showModal(this)">
            <i class="fa-solid fa-eye"></i>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Modal para visualizar imagens -->
<div id="modal-image-viewer" onclick="hideModal()">
  <span class="close-modal">&times;</span>
  <img src="" alt="Visualizar imagem">
</div>
<hr>
<!-- Seção de Anexos -->
<% if @chamado.persisted? %>
  <div class="form-group">
    <div class="section-header">
      <h5><i class="fa fa-paperclip"></i> Anexos</h5>
    </div>
    <div class="section-body lista-anexos">
      <% any = false %>

      <% @chamado.arquivos_anexos_chamado.each do |anexo| %>
        <% any = true %>
        <div class="anexo-item">
          <div class="anexo-info">
            <%= link_to url_for(anexo.arquivo), target: "_blank", class: "anexo-link" do %>
              <i class="fa fa-download"></i> <%= anexo.nome %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% @chamado.ocorrencias.order(created_at: :desc).each do |oc| %>
        <% if oc.arquivos.attached? %>
          <div class="subsection-header mt-2">
            <small><i class="fa fa-history"></i> Ocorrência em <%= l(oc.data_ocorrencia) %></small>
          </div>
          <% oc.arquivos.each do |blob| %>
            <% any = true %>
            <div class="anexo-item">
              <div class="anexo-info">
                <%= link_to url_for(blob), target: "_blank", class: "anexo-link" do %>
                  <i class="fa fa-download"></i> <%= blob.filename.to_s %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% unless any %>
        <p class="text-muted text-center">Nenhum anexo encontrado.</p>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Seção do histórico de ocorrências -->
<% if @chamado.persisted? %>
  <%= render 'ocorrencias/ocorrencia_section', parent: @chamado, somente_visualizacao: true%>
<% end %>


