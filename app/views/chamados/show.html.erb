  <div class="chamado-section section-box">
    <div class="section-header">
      <h5>
        <i class="fa-solid fa-circle-info"></i>
        Dados do chamado
      </h5>
    </div>

    <div class="section-body chamado-grid">
      <div class="chamado-field">
        <span class="label">OS:</span>
        <span class="value"><%= @chamado.os %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Unidade:</span>
        <span class="value"><%= @chamado.room&.name %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Título:</span>
        <span class="value"><%= @chamado.titulo %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Prioridade:</span>
        <span class="value badge-prioridade prioridade-<%= @chamado.prioridade.to_s.parameterize %>">
          <%= @chamado.prioridade %>
        </span>
      </div>

      <div class="chamado-field">
        <span class="label">Status:</span>
        <span class="value badge-status status-<%= @chamado.status.to_s.parameterize %>">
          <%= @chamado.status %>
        </span>
      </div>

      <div class="chamado-field">
        <span class="label">Data resolução:</span>
        <span class="value"><%= l(@chamado.data_resolucao) if @chamado.data_resolucao %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Exibir no App:</span>
        <span class="value"><%= @chamado.exibir_no_app ? 'Sim' : 'Não' %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Local:</span>
        <span class="value"><%= @chamado.local %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Responsável:</span>
        <span class="value"><%= @chamado.responsavel %></span>
      </div>

      <div class="chamado-field chamado-observacao">
        <span class="label">Observação:</span>
        <div class="value">
          <%= simple_format(@chamado.observacao.presence || "—") %>
        </div>
      </div>
    </div>
  </div>

  <% if @chamado.fotos.attached? %>
    <div class="section-box">
      <div class="section-header">
        <h5>
          <i class="fa-solid fa-image"></i>
          Fotos
        </h5>
      </div>
      <div class="section-body fotos-grid">
        <% @chamado.fotos.each do |foto| %>
          <div class="image-thumb">
            <%= image_tag url_for(foto), data: { full: url_for(foto) } %>
            <div class="overlay-eye" onclick="showModal(this)">
              <i class="fa-solid fa-eye"></i>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Modal para visualizar imagens -->
  <div id="modal-image-viewer" onclick="hideModal()">
    <span class="close-modal">&times;</span>
    <img src="" alt="Visualizar imagem">
  </div>

  <% if @chamado.persisted? %>
    <div class="section-box">
      <div class="section-header">
        <h5><i class="fa fa-paperclip"></i> Anexos</h5>
      </div>
      <div class="section-body lista-anexos">
        <% any = false %>

        <% @chamado.arquivos_anexos_chamado.each do |anexo| %>
          <% any = true %>
          <div class="anexo-item">
            <div class="anexo-info">
              <%= link_to url_for(anexo.arquivo), target: "_blank", class: "anexo-link" do %>
                <i class="fa fa-download"></i> <%= anexo.nome %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% @chamado.ocorrencias.order(created_at: :desc).each do |oc| %>
          <% if oc.arquivos.attached? %>
            <div class="subsection-header mt-2">
              <small><i class="fa fa-history"></i> Ocorrência em <%= l(oc.data_ocorrencia) %></small>
            </div>
            <% oc.arquivos.each do |blob| %>
              <% any = true %>
              <div class="anexo-item">
                <div class="anexo-info">
                  <%= link_to url_for(blob), target: "_blank", class: "anexo-link" do %>
                    <i class="fa fa-download"></i> <%= blob.filename.to_s %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>

        <% unless any %>
          <p class="text-muted text-center">Nenhum anexo encontrado.</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @chamado.persisted? %>
    <div class="section-box">
      <div class="section-header">
        <h5><i class="fa fa-clock-rotate-left"></i> Histórico de ocorrências</h5>
      </div>
      <div class="section-body">
        <%= render 'ocorrencias/ocorrencia_section',
                  parent: @chamado,
                  somente_visualizacao: true %>
      </div>
    </div>
  <% end %>



