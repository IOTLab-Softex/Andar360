<%# === GRÁFICO / KPIs DE COMPRAS === %>
<%
  # Mesma lógica de cálculo usada no controller, mas reaproveitando a lista já filtrada
  calc_total = lambda do |sc|
    if sc.valor_estimado.present?
      sc.valor_estimado
    else
      sc.itens.to_a.sum do |it|
        if it.total.present?
          it.total
        else
          (it.quantidade || 0) * (it.valor_unitario || 0)
        end
      end
    end
  end

  # Monta o hash por mês baseado em @solicitacao_compras filtradas
  grouped = @solicitacao_compras.group_by do |sc|
    (sc.data_solicitacao || sc.created_at.to_date).beginning_of_month
  end

  compras_por_mes = grouped.transform_values { |regs| regs.sum { |sc| calc_total.call(sc).to_f } }
  compras_por_mes = compras_por_mes.sort.to_h

  meses_ordenados = compras_por_mes.keys.sort
  total_valor     = compras_por_mes.values.sum.to_f

  # ==== KPIs extras de status ====
  total_regs = @solicitacao_compras.size

  autorizadas      = 0
  pendentes_aut    = 0
  rejeitadas       = 0

  compradas        = 0
  aguardando_comp  = 0
  canceladas_comp  = 0

  total_autorizado_valor = 0.0
  total_comprado_valor   = 0.0

  @solicitacao_compras.each do |sc|
    status_auth   = sc.status_autorizacao.presence || "pendente"
    status_compra = sc.status_compra.presence     || "aguardando"
    valor_sc      = calc_total.call(sc).to_f

    case status_auth
    when "autorizado"
      autorizadas += 1
      total_autorizado_valor += valor_sc
    when "rejeitado"
      rejeitadas += 1
    else
      pendentes_aut += 1
    end

    case status_compra
    when "comprado"
      compradas += 1
      total_comprado_valor += valor_sc
    when "cancelado"
      canceladas_comp += 1
    else
      aguardando_comp += 1
    end
  end

  pct_autorizadas = total_regs.zero? ? 0 : (autorizadas * 100.0 / total_regs)
%>

<section class="trk trk--compras">
  <!-- Sparkline REAL de compras, com fundo decorativo -->
  <% valores = meses_ordenados.map { |mes| (compras_por_mes[mes] || 0).to_f } %>
  <% max_valor = valores.max || 0 %>
  <% max_valor = 1 if max_valor.zero? %>
  <% width  = 100.0 %>
  <% height = 30.0 %>
  <% step = valores.size <= 1 ? 0 : (width / (valores.size - 1)) %>
  <% points = valores.each_with_index.map do |v, i|
        x = (step * i).round(2)
        y = (height - (v / max_valor * height)).round(2)
        "#{x},#{y}"
      end.join(" ") %>
  <div class="trk-sparkline trk-sparkline--kpi trk-sparkline--compras-bg" aria-hidden="true">
    <!-- Triângulo de luz no fundo -->
    <!-- Linha do sparkline por cima -->
    <% if valores.any? && valores.sum > 0 %>
      <svg class="trk-sparkline-chart"
       viewBox="0 0 <%= width %> <%= height %>"
       preserveAspectRatio="none">
        <!-- 🌈 Definição do degradê -->
        <defs>
          <linearGradient id="sparkFillGradient" x1="0" y1="0" x2="0" y2="1">
            <!-- topo mais forte -->
            <stop offset="0%" stop-color="rgba(124, 58, 237, 0.40)" />
            <!-- meio -->
            <stop offset="50%" stop-color="rgba(124, 58, 237, 0.22)" />
            <!-- embaixo transparente -->
            <stop offset="100%" stop-color="rgba(124, 58, 237, 0.00)" />
          </linearGradient>
        </defs>
        <!-- Área preenchida -->
        <polygon class="trk-sparkline-fill"
             points="0,<%= height %> <%= points %> <%= width %>,<%= height %>"
             fill="url(#sparkFillGradient)"></polygon>
        <!-- Linha -->
        <polyline class="trk-sparkline-line"
              points="<%= points %>"></polyline>
      </svg>
    <% end %>
  </div>
  <header class="trk-head">
    <div>
      <h2 class="trk-title">
        <i class="fa-solid fa-cart-shopping"></i>
        Resumo de Solicitações de Compra
      </h2>
      <p class="trk-sub">
        Valor total e distribuição por mês (considerando os filtros atuais).
      </p>
    </div>
        <div class="trk-kpis">
      <div class="kpi">
        <span class="kpi-label">Solicitações</span>
        <span class="kpi-value"><%= @total_solicitacoes %></span>
      </div>

      <div class="kpi">
        <span class="kpi-label">Valor total</span>
        <span class="kpi-chip trk--done">
          <%= number_to_currency(total_valor, unit: "R$ ") %>
        </span>
      </div>

      <div class="kpi">
        <span class="kpi-label">Ticket médio</span>
        <span class="kpi-chip trk--progress">
          <%= number_to_currency(@ticket_medio_compras, unit: "R$ ") %>
        </span>
      </div>

      <!-- 🔹 Novo KPI: Autorização -->
      <div class="kpi kpi--compact">
        <span class="kpi-label">Autorização</span>
        <span class="kpi-chip trk--progress">
          <strong><%= autorizadas %></strong> aut. 
          • <%= pendentes_aut %> pend. 
          • <%= rejeitadas %> rej.
          <% unless total_regs.zero? %>
            &nbsp;(<%= pct_autorizadas.round %>% aut.)
          <% end %>
        </span>
      </div>

      <!-- 🔹 Novo KPI: Status da compra -->
      <div class="kpi kpi--compact">
        <span class="kpi-label">Status da compra</span>
        <span class="kpi-chip">
          <strong><%= compradas %></strong> comp.
          • <%= aguardando_comp %> aguard.
          • <%= canceladas_comp %> canc.
        </span>
      </div>

      <!-- 🔹 Opcional: resumo de valor autorizado/comprado -->
      <div class="kpi kpi--mini">
        <span class="kpi-label">Valor autorizado</span>
        <span class="kpi-chip trk--done">
          <%= number_to_currency(total_autorizado_valor, unit: "R$ ") %>
        </span>
      </div>

      <div class="kpi kpi--mini">
        <span class="kpi-label">Valor comprado</span>
        <span class="kpi-chip trk--done">
          <%= number_to_currency(total_comprado_valor, unit: "R$ ") %>
        </span>
      </div>
    </div>

  </header>
  <% if @filter_di.present? && @filter_df.present? && @filter_di == @filter_di.beginning_of_month && @filter_df == @filter_df.end_of_month %>
    <% label_filtro = @filter_di.strftime("%m/%Y") %>
    <div style="margin-top: 4px; font-size: .78rem; color: #A9A4BD;">
      <span style="
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:2px 10px;
      border-radius:999px;
      border:1px solid rgba(124,58,237,.35);
      background:rgba(15,10,35,.85);
    ">
        <i class="fa-solid fa-filter"></i>
        Mostrando somente <strong style="margin-left:4px;"><%= label_filtro %></strong>
        <%= link_to "limpar", solicitacao_compras_path, style: "margin-left:8px; font-size:.72rem; text-decoration:underline; color:#A9A4BD;" %>
      </span>
    </div>
  <% end %>
  <div class="trk-bar" aria-label="Distribuição de compras por mês">
    <% meses_ordenados.each do |mes_key| %>
      <% valor = compras_por_mes[mes_key] || 0 %>
      <% next if valor.to_f.zero? %>
      <% pct = total_valor.zero? ? 0 : (valor.to_f / total_valor * 100.0) %>
      <% label =
          begin
            mes_key.to_date.strftime("%m/%Y")
          rescue
            mes_key.strftime("%m/%Y")
          end %>
      <div class="trk-seg trk--progress" style="--seg-w: <%= pct %>%"
           title="<%= "#{label}: #{number_to_currency(valor, unit: 'R$ ')} (#{pct.round}%)" %>">
        <span class="trk-seg-label">
          <%= label %>
        </span>
      </div>
    <% end %>
    <% if total_valor.zero? %>
      <div class="trk-empty">Sem dados de compras para o período selecionado</div>
    <% end %>
  </div>
  <div class="trk-legend">
    <% meses_ordenados.each do |mes_key| %>
      <% valor = compras_por_mes[mes_key] || 0 %>
      <% next if valor.to_f.zero? %>
      <% pct = total_valor.zero? ? 0 : (valor.to_f / total_valor * 100.0).round %>
      <% mes_inicio = mes_key.to_date.beginning_of_month %>
      <% mes_fim    = mes_key.to_date.end_of_month %>
      <% label =
      begin
        mes_key.to_date.strftime("%m/%Y")
      rescue
        mes_key.strftime("%m/%Y")
      end %>
      <% is_active =
         @filter_di.present? && @filter_df.present? &&
         @filter_di == mes_inicio && @filter_df == mes_fim %>
      <div class="trk-leg trk--progress <%= 'is-active' if is_active %>"
         data-month-start="<%= mes_inicio.strftime('%Y-%m-%d') %>"
         data-month-end="<%= mes_fim.strftime('%Y-%m-%d') %>">
        <i class="trk-dot"></i>
        <strong><%= label %></strong>
        <span>
          <%= number_to_currency(valor, unit: "R$ ") %> • <%= pct %>% 
        </span>
      </div>
    <% end %>
  </div>
</section>
<button type="button"
        id="filtro-toggle"
        class="filtro-label"
        aria-expanded="true"
        aria-controls="filtros-salas">
  <i class="fa-solid fa-filter"></i>
  Filtro
  <%# 👉 Se tiver qualquer data aplicada, mostra o intervalo aqui %>
  <% if @filter_di.present? || @filter_df.present? %>
    <% label_filtro =
         if @filter_di.present? && @filter_df.present?
           "#{@filter_di.strftime('%d/%m/%Y')} a #{@filter_df.strftime('%d/%m/%Y')}"
         elsif @filter_di.present?
           "a partir de #{@filter_di.strftime('%d/%m/%Y')}"
         else
           "até #{@filter_df.strftime('%d/%m/%Y')}"
         end %>
    <span class="filtro-pill">
      <i class="fa-solid fa-calendar-day"></i>
      <%= label_filtro %>
    </span>
  <% end %>
  <i class="fa-solid fa-chevron-up filtro-chevron" aria-hidden="true"></i>
</button>
<%= form_with url: solicitacao_compras_path,
              method: :get,
              local: true,
              class: "filtros-form tab-panel",
              id: "filtros-salas" do %>
  <div style="margin-bottom: 20px; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));">
    <% base_scope = SolicitacaoCompra.all %>

    <!-- Setor -->
    <div>
      <label for="setor">Setor</label>
      <%= select_tag :setor,
          options_for_select(
            ["Todos os setores"] +
              base_scope.
                select(:setor).
                where.not(setor: [nil, ""]).
                distinct.
                order(:setor).
                pluck(:setor),
            params[:setor]
          ),
          class: "form-control",
          include_blank: false,
          id: "setor" %>
    </div>

    <!-- Colaborador -->
    <div>
      <label for="colaborador">Colaborador(a)</label>
      <%= select_tag :colaborador,
          options_for_select(
            ["Todos os colaboradores"] +
              base_scope.
                select(:colaborador).
                where.not(colaborador: [nil, ""]).
                distinct.
                order(:colaborador).
                pluck(:colaborador),
            params[:colaborador]
          ),
          class: "form-control",
          include_blank: false,
          id: "colaborador" %>
    </div>

    <!-- Forma de pagamento -->
    <div>
      <label for="forma_pagamento">Forma de pagamento</label>
      <%= select_tag :forma_pagamento,
          options_for_select(
            ["Todas as formas"] +
              base_scope.
                select(:forma_pagamento).
                where.not(forma_pagamento: [nil, ""]).
                distinct.
                order(:forma_pagamento).
                pluck(:forma_pagamento),
            params[:forma_pagamento]
          ),
          class: "form-control",
          id: "forma_pagamento" %>
    </div>

    <!-- Status de autorização / Status de compra -->
    <div class="status-filter">
      <div class="status-field">
        <label for="status_autorizacao">Autorização</label>
        <%= select_tag :status_autorizacao,
            options_for_select(
              [
                ["Todas",      "todos"],
                ["Pendente",   "pendente"],
                ["Autorizado", "autorizado"],
                ["Rejeitado",  "rejeitado"]
              ],
              params[:status_autorizacao].presence || "todos"
            ),
            class: "form-control",
            id: "status_autorizacao" %>
      </div>
      <div class="status-field">
        <label for="status_compra">Compra</label>
        <%= select_tag :status_compra,
            options_for_select(
              [
                ["Todas",      "todos"],
                ["Aguardando", "aguardando"],
                ["Comprado",   "comprado"],
                ["Cancelado",  "cancelado"]
              ],
              params[:status_compra].presence || "todos"
            ),
            class: "form-control",
            id: "status_compra" %>
      </div>
    </div>

    <!-- Ordem -->
    <div>
      <label for="ordem">Ordem</label>
      <%= select_tag :ordem,
          options_for_select(
            [
              ["Mais recentes primeiro", "desc"],
              ["Mais antigos primeiro",  "asc"]
            ],
            params[:ordem].presence || "desc"
          ),
          class: "form-control",
          id: "ordem" %>
    </div>

    <!-- Período -->
    <div class="date-range-filter">
      <div class="date-field">
        <label for="data_inicio">De</label>
        <%= date_field_tag :data_inicio,
            params[:data_inicio],
            class: "form-control",
            id: "data_inicio" %>
      </div>
      <div class="date-field">
        <label for="data_fim">Até</label>
        <%= date_field_tag :data_fim,
            params[:data_fim],
            class: "form-control",
            id: "data_fim" %>
      </div>
    </div>

    <!-- Botões -->
    <div style="display:flex;align-items: stretch;gap:8px;padding: 15px;">
      <%= button_tag type: "submit", class: "btn btn-success" do %>
        <i class="fa fa-search"></i> <span class="hide-sm">Filtrar</span>
      <% end %>
      <%= link_to solicitacao_compras_path, class: "btn btn-success" do %>
        <i class="fa-solid fa-rotate-left"></i> Limpar
      <% end %>
    </div>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table-salas">
    <thead>
      <tr>
        <th class="hide-sm">#</th>
        <th>Colaborador(a)</th>
        <th class="hide-sm">Setor</th>
        <th>Data da Solicitação</th>
        <th class="hide-sm">Valor Estimado</th>
        <th class="hide-sm">Status Autorização</th>
        <th class="hide-sm">Status Compra</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @solicitacao_compras.each do |s| %>
        <tr>
          <td class="hide-sm"><%= s.id %></td>
          <td><%= s.colaborador %></td>
          <td class="hide-sm"><%= s.setor %></td>
          <td>
            <%= (s.data_solicitacao || s.created_at.to_date).strftime("%d/%m/%Y") %>
          </td>
          <td class="hide-sm">
            <% linha_total =
                if s.valor_estimado.present?
                  s.valor_estimado
                else
                  s.itens.to_a.sum do |it|
                    if it.total.present?
                      it.total
                    else
                      (it.quantidade || 0) * (it.valor_unitario || 0)
                    end
                  end
                end %>
            <%= number_to_currency(linha_total, unit: "R$ ") %>
          </td>
          <td class="hide-sm">
            <% status_auth = s.status_autorizacao || "pendente" %>
            <% case status_auth %>
            <% when "autorizado" %>
              <span class="status-pill status-pill--ok">
                <i class="fa-solid fa-circle-check"></i>
                <span>Autorizado</span>
              </span>
            <% when "rejeitado" %>
              <span class="status-pill status-pill--danger">
                <i class="fa-solid fa-circle-xmark"></i>
                <span>Rejeitado</span>
              </span>
            <% else %> <%# pendente ou nil %>
              <span class="status-pill status-pill--warn">
                <i class="fa-solid fa-clock"></i>
                <span>Pendente</span>
              </span>
            <% end %>
          </td>
          <td class="hide-sm">
            <% status_compra = s.status_compra || "aguardando" %>
            <% case status_compra %>
            <% when "comprado" %>
              <span class="status-pill status-pill--ok">
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Comprado</span>
              </span>
            <% when "cancelado" %>
              <span class="status-pill status-pill--danger">
                <i class="fa-solid fa-ban"></i>
                <span>Cancelado</span>
              </span>
            <% else %> <%# aguardando ou nil %>
              <span class="status-pill status-pill--neutral">
                <i class="fa-solid fa-hourglass-half"></i>
                <span>Aguardando</span>
              </span>
            <% end %>
          </td>
          <td style="display: flex; flex-direction: column; gap: 4px;">
            <%= link_to s, class: "btn btn-success" do %>
              <i class="fa-solid fa-eye"></i>
              <div class="hide-sm">Ver</div>
            <% end %>
            <%# 🔹 Botões de status da COMPRA (comprado / cancelado) %>
            <% if can_current_user_buy?(s) %>
              <% unless s.comprado? %>
                <%= button_to marcar_comprado_solicitacao_compra_path(s),
            method: :patch,
            class: "btn btn-success",
            form: { data: { turbo_confirm: "Marcar esta solicitação como COMPRADA?" } } do %>
                  <i class="fa-solid fa-cart-shopping"></i>
                  <div class="hide-sm">Comprado</div>
                <% end %>
              <% end %>
              <% unless s.cancelado? %>
                <button type="button"
              class="btn btn-warning"
              data-url="<%= cancelar_compra_solicitacao_compra_path(s) %>"
              data-id="<%= s.id %>">
                  <i class="fa-solid fa-ban"></i>
                  <div class="hide-sm">Compra cancelada</div>
                </button>
              <% end %>
            <% end %>
            <% can_edit =
     if admin?
       true                       # admin/operador pode sempre editar
     else
       !s.autorizado? && owns_solicitacao?(s)
     end
%>

<% can_destroy =
     if admin?
       true                       # admin/operador pode sempre excluir
     else
       owns_solicitacao?(s) && (!s.autorizado? || s.cancelado?)
     end
%>

            <% if can_edit %>
              <%= link_to edit_solicitacao_compra_path(s),
      class: "edit btn btn-sm btn-outline-secondary" do %>
                <i class="fa-solid fa-pen-to-square"></i>
                <div class="hide-sm">Editar</div>
              <% end %>
            <% end %>
            <% if can_destroy %>
              <button type="button"
    class="btn btn-warning btn-open-delete"
    data-url="<%= solicitacao_compra_path(s) %>"
    data-id="<%= s.id %>"
    data-colaborador="<%= s.colaborador %>"
    data-setor="<%= s.setor %>"
    data-data="<%= (s.data_solicitacao || s.created_at.to_date).strftime("%d/%m/%Y") %>"
    data-valor="<%= number_to_currency(linha_total, unit: 'R$ ') %>">
                <i class="fa-solid fa-trash-can"></i>
                <div class="hide-sm">Excluir</div>
              </button>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<!-- 🌌 Modal de confirmação de exclusão -->
<div id="delete-modal" class="modal-backdrop" hidden>
  <div class="modal-dialog">
    <div class="modal-header">
      <h2>
        <i class="fa-solid fa-triangle-exclamation"></i>
        Confirmar exclusão
      </h2>
      <button type="button" class="modal-close" data-modal-close>&times;</button>
    </div>
    <div class="modal-body">
      <p class="modal-warning">
        Tem certeza que deseja excluir esta solicitação de compra?<br>
        <strong>Esta ação não poderá ser desfeita.</strong>
      </p>
      <dl class="confirm-dl">
        <div>
          <dt>ID</dt>
          <dd id="del-sc-id"></dd>
        </div>
        <div>
          <dt>Colaborador</dt>
          <dd id="del-sc-colaborador"></dd>
        </div>
        <div>
          <dt>Setor</dt>
          <dd id="del-sc-setor"></dd>
        </div>
        <div>
          <dt>Data</dt>
          <dd id="del-sc-data"></dd>
        </div>
        <div>
          <dt>Valor</dt>
          <dd id="del-sc-valor"></dd>
        </div>
      </dl>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-modal-close>
        <i class="fa-solid fa-arrow-left"></i>
        Nâo
      </button>
      <!-- Form que envia o DELETE -->
      <form id="delete-form" action="" method="post" data-turbo="true" style="display:inline;">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit" class="btn btn-danger">
          <i class="fa-solid fa-trash-can"></i>
          Sim
        </button>
      </form>
    </div>
  </div>
</div>
<!-- 🟥 Modal de cancelamento de compra -->
<div id="cancel-modal" class="modal-backdrop" hidden>
  <div class="modal-dialog">
    <div class="modal-header">
      <h2>
        <i class="fa-solid fa-ban"></i>
        Cancelar compra
      </h2>
      <button type="button" class="modal-close" data-modal-close>&times;</button>
    </div>
    <div class="modal-body">
      <p class="modal-warning">
        Informe o motivo do cancelamento da compra.<br>
        <strong>Esse motivo ficará registrado junto à solicitação.</strong>
      </p>
      <form id="cancel-form" action="" method="post" data-turbo="true">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <div class="form-group">
          <label for="cancel-motivo" style="color:white; font-size:.85rem;">
            Motivo do cancelamento
          </label>
          <textarea name="motivo_cancelamento_compra"
                    id="cancel-motivo"
                    rows="4"
                    class="form-control"
                    required
                    placeholder="Descreva o motivo do cancelamento..."></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-modal-close>
            <i class="fa-solid fa-arrow-left"></i>
            Voltar
          </button>
          <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-ban"></i>
            Confirmar cancelamento
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<script>
  function initLegendMonthFilter(){
    const form        = document.getElementById('filtros-salas');
    const dataInicio  = document.getElementById('data_inicio');
    const dataFim     = document.getElementById('data_fim');

    if (!form || !dataInicio || !dataFim) return;

    document.querySelectorAll('.trk-legend .trk-leg').forEach(leg => {
      leg.style.cursor = 'pointer';

      leg.addEventListener('click', (ev) => {
        ev.preventDefault();

        const start = leg.dataset.monthStart;
        const end   = leg.dataset.monthEnd;
        if (!start || !end) return;

        // preenche os filtros
        dataInicio.value = start;
        dataFim.value    = end;

        // opcional: destacar o mês selecionado
        document.querySelectorAll('.trk-legend .trk-leg')
          .forEach(l => l.classList.remove('is-active'));
        leg.classList.add('is-active');

        // envia o formulário (mantém a experiência Rails bonitinha)
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.submit();
        }
      });
    });
  }


    function mountTrkBars(){
      document.querySelectorAll(".trk-bar").forEach(bar=>{
        bar.classList.remove("mounted");
        void bar.offsetWidth;
        bar.classList.add("mounted");
      });
    }


    function initDeleteModal(){
      const modal      = document.getElementById('delete-modal');
      if (!modal) return;

      const idEl       = document.getElementById('del-sc-id');
      const colabEl    = document.getElementById('del-sc-colaborador');
      const setorEl    = document.getElementById('del-sc-setor');
      const dataEl     = document.getElementById('del-sc-data');
      const valorEl    = document.getElementById('del-sc-valor');
      const form       = document.getElementById('delete-form');

      function openModalFromButton(btn){
        const url  = btn.dataset.url;
        const id   = btn.dataset.id;
        const col  = btn.dataset.colaborador;
        const set  = btn.dataset.setor;
        const data = btn.dataset.data;
        const val  = btn.dataset.valor;

        if (idEl)    idEl.textContent    = '#' + id;
        if (colabEl) colabEl.textContent = col || '-';
        if (setorEl) setorEl.textContent = set || '-';
        if (dataEl)  dataEl.textContent  = data || '-';
        if (valorEl) valorEl.textContent = val || '-';

        if (form && url){
          form.action = url;
        }

        modal.hidden = false;
        modal.classList.add('is-open');
        document.body.classList.add('modal-open');
      }

      function closeModal(){
        modal.classList.remove('is-open');
        modal.hidden = true;
        document.body.classList.remove('modal-open');
      }

      // 🔗 Clique nos botões "Excluir" da tabela
      document.querySelectorAll('.btn-open-delete').forEach(btn=>{
        btn.addEventListener('click', ()=> openModalFromButton(btn));
      });

      // ❌ Botões que fecham o modal
      modal.querySelectorAll('[data-modal-close]').forEach(btn=>{
        btn.addEventListener('click', closeModal);
      });

      // Clique no backdrop fecha
      modal.addEventListener('click', (ev)=>{
        if (ev.target === modal){
          closeModal();
        }
      });

      // Esc fecha
      document.addEventListener('keydown', (ev)=>{
        if (ev.key === 'Escape' && modal.classList.contains('is-open')){
          closeModal();
        }
      });
    }

    // 🔹 Primeiro carregamento “normal”
        document.addEventListener("DOMContentLoaded", function(){
      mountTrkBars();
      initDeleteModal();
      initCancelModal();
      initLegendMonthFilter();
    });

    document.addEventListener("turbo:load", function(){
      mountTrkBars();
      initDeleteModal();
      initCancelModal();
      initLegendMonthFilter();
    });

    document.addEventListener("turbo:frame-load", function(){
      mountTrkBars();
      initDeleteModal();
      initCancelModal();
      initLegendMonthFilter();
    });



    // ======= JS do colapso suave do filtro =======
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('filtro-toggle');
      const filtros = document.getElementById('filtros-salas');
      if (!toggle || !filtros) return;

      const STORAGE_KEY = 'ui:filtros-solicitacao-compra-collapsed';

      const saved = localStorage.getItem(STORAGE_KEY);
      const startCollapsed = saved === '1' || toggle.getAttribute('aria-expanded') === 'false';

      function setCollapsed(collapsed, save = true) {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (collapsed) {
          const curH = filtros.scrollHeight;
          filtros.style.maxHeight = curH + 'px';
          filtros.offsetHeight;
          if (prefersReduced) {
            filtros.classList.add('collapsed');
            filtros.style.maxHeight = '';
          } else {
            filtros.classList.add('collapsed');
            filtros.style.maxHeight = '0px';
          }
          toggle.setAttribute('aria-expanded', 'false');
          filtros.setAttribute('aria-hidden', 'true');
          if (save) localStorage.setItem(STORAGE_KEY, '1');
        } else {
          filtros.classList.remove('collapsed');
          filtros.setAttribute('aria-hidden', 'false');
          toggle.setAttribute('aria-expanded', 'true');
          const targetH = filtros.scrollHeight;
          if (prefersReduced) {
            filtros.style.maxHeight = '';
          } else {
            filtros.style.maxHeight = '0px';
            filtros.offsetHeight;
            filtros.style.maxHeight = targetH + 'px';
          }
          const cleanup = () => {
            filtros.style.maxHeight = '';
            filtros.removeEventListener('transitionend', cleanup);
          };
          filtros.addEventListener('transitionend', cleanup);
          if (save) localStorage.removeItem(STORAGE_KEY);
        }
      }

      if (startCollapsed) {
        filtros.classList.add('collapsed');
        filtros.setAttribute('aria-hidden', 'true');
        toggle.setAttribute('aria-expanded', 'false');
        filtros.style.maxHeight = '0px';
      } else {
        filtros.classList.remove('collapsed');
        filtros.setAttribute('aria-hidden', 'false');
        toggle.setAttribute('aria-expanded', 'true');
        filtros.style.maxHeight = '';
      }

      toggle.addEventListener('click', (ev) => {
        ev.preventDefault();
        const isCollapsed = filtros.classList.contains('collapsed');
        setCollapsed(!isCollapsed, true);
      });

      document.querySelectorAll('#filtros-salas input, #filtros-salas select, #filtros-salas textarea').forEach(el => {
        el.addEventListener('focus', () => setCollapsed(false, false));
      });
    });

    //modal de cancelar compra

        function initCancelModal(){
      const modal = document.getElementById('cancel-modal');
      if (!modal) return;

      const form     = document.getElementById('cancel-form');
      const textarea = document.getElementById('cancel-motivo');

      function openModalFromButton(btn){
        const url = btn.dataset.url;

        if (form && url){
          form.action = url;              // PATCH /solicitacao_compras/:id/cancelar_compra
        }

        if (textarea){
          textarea.value = '';           // limpa texto antigo
          // foca depois de abrir
          setTimeout(() => textarea.focus(), 50);
        }

        modal.hidden = false;
        modal.classList.add('is-open');
        document.body.classList.add('modal-open');
      }

      function closeModal(){
        modal.classList.remove('is-open');
        modal.hidden = true;
        document.body.classList.remove('modal-open');
      }

      // 🔗 Botões "Compra cancelada" na tabela
      document.querySelectorAll('.btn-open-cancel').forEach(btn => {
        btn.addEventListener('click', () => openModalFromButton(btn));
      });

      // ❌ Botões que fecham o modal (tem data-modal-close)
      modal.querySelectorAll('[data-modal-close]').forEach(btn => {
        btn.addEventListener('click', closeModal);
      });

      // Clique no fundo fecha
      modal.addEventListener('click', (ev) => {
        if (ev.target === modal){
          closeModal();
        }
      });

      // ESC fecha
      document.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape' && modal.classList.contains('is-open')){
          closeModal();
        }
      });
    }
</script>
