<div class="device-form" style="margin-top: 2rem;">
  <p><strong>Início:</strong> <%= l(@reservation.starts_at, format: :long) %></p>
  <p><strong>Término:</strong> <%= l(@reservation.ends_at, format: :long) %></p>
  <p><strong>Sala:</strong> <%= @reservation.room.name %></p>

  <p><strong>Status:</strong>
    <% if @reservation.cancelada_em.present? %>
      ⛔ Cancelada em <%= l(@reservation.cancelada_em, format: :short) %>
    <% elsif @reservation.finalizada_em.present? %>
      ✔️ Encerrada em <%= l(@reservation.finalizada_em, format: :short) %>
    <% else %>
      🟢 Ativa
    <% end %>
  </p>
</div>

<h2 class="subtitle" style="margin-top: 2rem;">Solicitante / Responsável</h2>
<div class="rooms">
  <% [
    { id: @reservation.solicitante_id, role: "Solicitante" },
    { id: @reservation.responsavel_id, role: "Responsável" }
  ].each do |entry| %>
    <% participant = Participant.find_by(id: entry[:id]) %>
    <% if participant %>
      <% accessed = AccessLog.exists?(participant_id: participant.id, reservation_id: @reservation.id) %>
      <div class="participant-card <%= 'participant-accessed' if accessed %>">
        <div class="participant-photo">
          <div class="photo-wrapper" style="position: relative; display: inline-block;">
            <% if participant.photo.attached? %>
              <%= image_tag url_for(participant.photo), class: "participant-img" %>
            <% else %>
              <div class="participant-placeholder">Sem Foto</div>
            <% end %>
            <% if accessed %>
              <div class="icon-visto-acesso">
                <div class="face-viewfinder">
                  <div class="face">
                    <div class="eye left"></div>
                    <div class="eye right"></div>
                    <div class="mouth"></div>
                  </div>
                  <div class="corner top-left"></div>
                  <div class="corner top-right"></div>
                  <div class="corner bottom-left"></div>
                  <div class="corner bottom-right"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="participant-info">
          <strong><%= participant.name %> — <%= entry[:role] %></strong><br>
          CPF: <%= participant.cpf %><br>
          Tel: <%= participant.telefone %><br>
          <% if participant.email.present? %>Email: <%= participant.email %><br><% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<h2 class="subtitle" style="margin-top: 2rem;">Participantes</h2>
<div class="rooms">
  <% extras = @participants.reject { |p| [@reservation.solicitante_id, @reservation.responsavel_id].include?(p.id) } %>
  <% if extras.any? %>
    <% extras.each do |p| %>
      <% accessed = AccessLog.exists?(participant_id: p.id, reservation_id: @reservation.id) %>
      <div class="participant-card <%= 'participant-accessed' if accessed %>">
        <div class="participant-photo">
          <div class="photo-wrapper" style="position: relative; display: inline-block;">
            <% if p.photo.attached? %>
              <%= image_tag url_for(p.photo), class: "participant-img" %>
            <% else %>
              <div class="participant-placeholder">Sem Foto</div>
            <% end %>
            <% if accessed %>
              <div class="icon-visto-acesso">
                <div class="face-viewfinder">
                  <div class="face">
                    <div class="eye left"></div>
                    <div class="eye right"></div>
                    <div class="mouth"></div>
                  </div>
                  <div class="corner top-left"></div>
                  <div class="corner top-right"></div>
                  <div class="corner bottom-left"></div>
                  <div class="corner bottom-right"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="participant-info">
          <strong><%= p.name %> — Participante</strong><br>
          CPF: <%= p.cpf %><br>
          Tel: <%= p.telefone %><br>
          <% if p.email.present? %>Email: <%= p.email %><br><% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p style="color: #000; text-align: center;">Nenhum participante extra registrado.</p>
  <% end %>
</div>
