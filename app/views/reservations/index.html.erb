<div style="text-align: right; margin-bottom: 1rem;">
  <div style="display: inline-flex; align-items: center; gap: .5rem;">
<label for="viewSwitchBtn" style="margin:0;font-weight: 500;color: var(--color-btn);">
      Visualização:
    </label>

    <div class="view-dropdown" id="viewSwitch">
      <button type="button" id="viewSwitchBtn" class="btn btn-light view-trigger">
        <i class="fa-solid fa-display"></i>
        <span id="currentViewLabel">Cards</span>
        <i class="fa-solid fa-caret-down" style="margin-left:.25rem;"></i>
      </button>

      <div class="view-menu" id="viewMenu">
        <button type="button" class="view-option" data-view="cards">
          <i class="fa-solid fa-id-card"></i> Cards
        </button>
        <button type="button" class="view-option" data-view="table">
          <i class="fa-solid fa-table"></i> Tabela
        </button>
        <button type="button" class="view-option" data-view="calendar">
          <i class="fa-solid fa-calendar"></i> Calendário
        </button>
      </div>
    </div>
  </div>
</div>


<!-- FILTROS -->
<div id="reservationsFilters" class="filter-form">
  <div>
    <label for="filterEmpresa" class="form-label">Empresa</label>
    <select id="filterEmpresa" class="form-control" style="min-width:180px">
      <option value="">Todas</option>
      <% @reservations.map(&:grupo_empresa).compact.uniq.each do |emp| %>
        <option value="<%= emp.nome %>"><%= emp.nome %></option>
      <% end %>
    </select>
  </div>

  <div>
    <label for="filterSala" class="form-label">Sala</label>
    <select id="filterSala" class="form-control" style="min-width:160px">
      <option value="">Todas</option>
      <% @reservations.map(&:room).compact.uniq.each do |room| %>
        <option value="<%= room.name %>"><%= room.name %></option>
      <% end %>
    </select>
  </div>

  <div>
    <label for="filterStatus" class="form-label">Status</label>
    <select id="filterStatus" class="form-control" style="min-width:160px">
      <option value="">Todos</option>
      <option value="ativa">Ativa</option>
      <option value="encerrada">Encerrada</option>
      <option value="cancelada">Cancelada</option>
    </select>
  </div>

  <div>
    <label for="filterInicio" class="form-label">Início (de)</label>
    <input id="filterInicio" type="datetime-local" class="form-control">
  </div>

  <div>
    <label for="filterFim" class="form-label">Início (até)</label>
    <input id="filterFim" type="datetime-local" class="form-control">
  </div>

  <div style="flex:1; min-width:220px;">
    <label for="filterBusca" class="form-label">Buscar (título/empresa/sala)</label>
    <input id="filterBusca" type="text" class="form-control" placeholder="Digite para filtrar...">
  </div>

  <div style="display:flex; gap:.5rem;">
    <button id="filterLimpar" class="btn btn-secondary" type="button">Limpar</button>
  </div>
</div>

<!-- VIEW: CARDS -->
<div class="rooms" id="reservationsCards">
  <% if @reservations.any? %>
    <% minhas_reservas = @reservations.select { |r| r.grupo_empresa_id == current_user.participant&.grupo_empresa_id } %>
    <% outras_reservas = @reservations.reject { |r| r.grupo_empresa_id == current_user.participant&.grupo_empresa_id } %>

    <% grouped_reservas = {
      'Ativas' => minhas_reservas.select { |r| r.cancelada_em.blank? && r.finalizada_em.blank? },
      'Encerradas' => minhas_reservas.select { |r| r.finalizada_em.present? },
      'Canceladas' => minhas_reservas.select { |r| r.cancelada_em.present? }
    } %>

    <% if grouped_reservas.values.flatten.any? %>
      <div class="reservation-section">
        <h2 class="section-title">Minhas Reservas</h2>
        <% grouped_reservas.each do |status_label, reservas| %>
          <% if reservas.any? %>
            <div class="reservation-group">
              <h3 class="group-title"><%= status_label %></h3>
              <div class="reservation-list">
                <% reservas.each do |reservation| %>
                  <% background = reservation.room.photo.attached? ? "--bg-url: url(#{url_for(reservation.room.photo)});" : "background-color: #ccc;" %>
                  <div class="reservation-card" style="<%= background %>">
                    <div class="reservation-header">
                      <strong>Empresa:</strong> <%= reservation.grupo_empresa&.nome || "Não informado" %><br>
                      <% if reservation.grupo_empresa&.logo&.attached? %>
                        <%= image_tag reservation.grupo_empresa.logo, alt: "Logo da empresa", style: "max-height: 40px; margin: 5px 0;" %>
                      <% end %><br>
                      Nome da Reserva: <strong><%= reservation.title %></strong><br>
                      Sala: <%= reservation.room.name %><br>
                      Início: <%= l(reservation.starts_at, format: :short) %><br>
                      Fim: <%= l(reservation.ends_at, format: :short) %><br>

                      <% if reservation.cancelada_em.present? %>
                        <span class="status cancelado">⛔ Cancelada em <%= l(reservation.cancelada_em, format: :short) %></span>
                      <% elsif reservation.finalizada_em.present? %>
                        <span class="status encerrada">✔️ Encerrada em <%= l(reservation.finalizada_em, format: :short) %></span>
                      <% else %>
                        <span class="status ativa">🟢 Ativa</span><br>
                        <span id="status-<%= reservation.id %>" class="tag <%= reservation.sent_to_facial? ? 'success' : 'warning' %>">
                          <%= reservation.sent_to_facial? ? 'Participantes já enviados' : 'Aguardando envio' %>
                        </span>
                      <% end %>
                    </div>
                    <div class="reservation-actions">
                      <% if reservation.finalizada_em.blank? && reservation.cancelada_em.blank? %>
                        <%= link_to edit_reservation_path(reservation), class: "btn edit" do %>
                          <i class="fa-solid fa-pen"></i> Editar
                        <% end %>
                      <% end %>
                      <%= link_to reservation_path(reservation), class: "btn btn-success" do %>
                        <i class="fa-solid fa-eye"></i> Ver
                      <% end %>
                      <% if reservation.finalizada_em.blank? && reservation.cancelada_em.blank? %>
                        <%= button_to reservation_path(reservation),
                            method: :delete,
                            data: { confirm: "Tem certeza que deseja cancelar esta reserva?" },
                            class: "btn btn-warning",
                            form: { style: "display: contents;" } do %>
                          <i class="fa-solid fa-rectangle-xmark"></i> Cancelar
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if outras_reservas.any? %>
      <div class="reservation-section">
        <h2 class="section-title">Outras Reservas</h2>
        <% outras_reservas.group_by(&:grupo_empresa).each do |empresa, reservas| %>
          <div class="reservation-group">
            <h3 class="group-title">
              Empresa: <%= empresa&.nome || "Não informado" %>
              <% if empresa&.logo&.attached? %>
                <%= image_tag empresa.logo, alt: "Logo da empresa", style: "max-height: 40px; margin-left: 10px;" %>
              <% end %>
            </h3>
            <div class="reservation-list">
              <% reservas.each do |reservation| %>
                <% background = reservation.room.photo.attached? ? "--bg-url: url(#{url_for(reservation.room.photo)});" : "background-color: #ccc;" %>
                <div class="reservation-card" style="<%= background %>">
                  <div class="reservation-header">
                    Nome da Reserva: <strong><%= reservation.title %></strong><br>
                    Sala: <%= reservation.room.name %><br>
                    Início: <%= l(reservation.starts_at, format: :short) %><br>
                    Fim: <%= l(reservation.ends_at, format: :short) %><br>

                    <% if reservation.cancelada_em.present? %>
                      <span class="status cancelado">⛔ Cancelada em <%= l(reservation.cancelada_em, format: :short) %></span>
                    <% elsif reservation.finalizada_em.present? %>
                      <span class="status encerrada">✔️ Encerrada em <%= l(reservation.finalizada_em, format: :short) %></span>
                    <% else %>
                      <span class="status ativa">🟢 Ativa</span><br>
                      <span id="status-<%= reservation.id %>" class="tag <%= reservation.sent_to_facial? ? 'success' : 'warning' %>">
                        <%= reservation.sent_to_facial? ? 'Participantes já enviados' : 'Aguardando envio' %>
                      </span>
                    <% end %>
                  </div>
                  <div class="reservation-actions">
                    <% if reservation.finalizada_em.blank? && reservation.cancelada_em.blank? %>
                      <%= link_to edit_reservation_path(reservation), class: "btn edit" do %>
                        <i class="fa-solid fa-pen"></i> Editar
                      <% end %>
                    <% end %>
                    <%= link_to reservation_path(reservation), class: "btn btn-success" do %>
                      <i class="fa-solid fa-eye"></i> Ver
                    <% end %>
                    <% if reservation.finalizada_em.blank? && reservation.cancelada_em.blank? %>
                      <%= button_to reservation_path(reservation),
                          method: :delete,
                          data: { confirm: "Tem certeza que deseja cancelar esta reserva?" },
                          class: "btn btn-warning",
                          form: { style: "display: contents;" } do %>
                        <i class="fa-solid fa-rectangle-xmark"></i> Cancelar
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p style="text-align: center; color: #000;">Nenhuma reserva cadastrada.</p>
  <% end %>
</div>

<!-- VIEW: TABELA -->
<table id="reservationsTable" style="width: 100%; display: none;">
  <thead>
    <tr>
      <th class="hide-sm">Empresa</th>
      <th class="hide-sm">Nome Reserva</th>
      <th>Sala</th>
      <th>Início</th>
      <th>Fim</th>
      <th>Status</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @reservations.each do |reservation| %>
      <% status =
           if reservation.cancelada_em.present?
             'cancelada'
           elsif reservation.finalizada_em.present?
             'encerrada'
           else
             'ativa'
           end %>

      <tr
        data-empresa="<%= reservation.grupo_empresa&.nome.to_s %>"
        data-sala="<%= reservation.room&.name.to_s %>"
        data-status="<%= status %>"
        data-inicio="<%= reservation.starts_at&.iso8601 %>"
        data-fim="<%= reservation.ends_at&.iso8601 %>"
        data-busca="<%= [reservation.title, reservation.grupo_empresa&.nome, reservation.room&.name].compact.join(' ').downcase %>"
      >
        <td class="hide-sm"><%= reservation.grupo_empresa&.nome || "Não informado" %></td>
        <td class="hide-sm"><%= reservation.title %></td>
        <td><%= reservation.room&.name %></td>
        <td><%= l(reservation.starts_at, format: :short) %></td>
        <td><%= l(reservation.ends_at, format: :short) %></td>
        <td>
          <% if status == 'cancelada' %>
            ⛔ Cancelada
          <% elsif status == 'encerrada' %>
            ✔️ Encerrada
          <% else %>
            🟢 Ativa
          <% end %>
        </td>
        <td class="reservationsTableAction">
          <% if status == 'ativa' %>
            <%= link_to edit_reservation_path(reservation), class: "btn edit", style: "display:inline-block;" do %>
              <i class="fa-solid fa-pen"></i>
            <% end %>
          <% end %>
          <%= link_to reservation_path(reservation), class: "btn btn-success", style: "display:inline-block;" do %>
            <i class="fa-solid fa-eye"></i>
          <% end %>
          <% if status == 'ativa' %>
            <%= button_to reservation_path(reservation),
                  method: :delete,
                  data: { confirm: "Tem certeza que deseja cancelar esta reserva?" },
                  class: "btn btn-warning",
                  style: "display: flow-root",
                  form: { style: "display: contents;" } do %>
              <i class="fa-solid fa-rectangle-xmark"></i>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<!-- VIEW: CALENDÁRIO -->
<div id="reservationsCalendar" class="calendar-wrapper" style="display:none;">
  <div class="calendar-header">
    <div class="calendar-room">
      <select id="calendarRoomSelect" class="form-control">
        <option value="">Todas as salas</option>
        <% @reservations.map(&:room).compact.uniq.each do |room| %>
          <option value="<%= room.name %>"><%= room.name %></option>
        <% end %>
      </select>
    </div>

    <div class="calendar-nav">
      <button id="calendarPrev" class="btn btn-light" type="button">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <span id="calendarCurrentMonth"></span>
      <button id="calendarNext" class="btn btn-light" type="button">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <div id="calendarGrid" class="calendar-grid"></div>

  <div class="calendar-legend">
    <span><span class="cal-dot cal-ativa"></span> Ativa</span>
    <span><span class="cal-dot cal-encerrada"></span> Encerrada</span>
    <span><span class="cal-dot cal-cancelada"></span> Cancelada</span>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  // ===== STATUS AUTO UPDATE =====
  const reservationIds = <%= raw @reservations.map(&:id).to_json %>;

  function updateStatuses() {
    reservationIds.forEach(id => {
      fetch(`/reservations/${id}/status`)
        .then(r => r.json())
        .then(data => {
          const el = document.getElementById(`status-${id}`);
          if (!el) return;
          if (data.sent_to_facial) {
            el.textContent = "Participantes já enviados";
            el.classList.remove("warning");
            el.classList.add("success");
          } else {
            el.textContent = "Aguardando envio";
            el.classList.remove("success");
            el.classList.add("warning");
          }
        })
        .catch(() => {});
    });
  }
  setInterval(updateStatuses, 15000);

  // ===== FILTROS TABELA =====
  const table   = document.getElementById("reservationsTable");
  const tbody   = table ? table.querySelector("tbody") : null;
  const $emp    = document.getElementById("filterEmpresa");
  const $sala   = document.getElementById("filterSala");
  const $stat   = document.getElementById("filterStatus");
  const $ini    = document.getElementById("filterInicio");
  const $fim    = document.getElementById("filterFim");
  const $busca  = document.getElementById("filterBusca");
  const $limpar = document.getElementById("filterLimpar");

  if (tbody) {
    const saved = JSON.parse(localStorage.getItem("reservationsFilters") || "{}");
    if (saved.empresa) $emp.value = saved.empresa;
    if (saved.sala)    $sala.value = saved.sala;
    if (saved.status)  $stat.value = saved.status;
    if (saved.inicio)  $ini.value = saved.inicio;
    if (saved.fim)     $fim.value = saved.fim;
    if (saved.busca)   $busca.value= saved.busca;

    function salvaEstado() {
      localStorage.setItem("reservationsFilters", JSON.stringify({
        empresa: $emp.value,
        sala:    $sala.value,
        status:  $stat.value,
        inicio:  $ini.value,
        fim:     $fim.value,
        busca:   $busca.value.trim()
      }));
    }

    function passaFiltros(tr) {
      const emp    = tr.dataset.empresa || "";
      const sala   = tr.dataset.sala || "";
      const status = tr.dataset.status || "";
      const inicio = tr.dataset.inicio ? new Date(tr.dataset.inicio) : null;
      const busca  = tr.dataset.busca || "";

      if ($emp.value && emp !== $emp.value) return false;
      if ($sala.value && sala !== $sala.value) return false;
      if ($stat.value && status !== $stat.value) return false;

      if ($ini.value) {
        const dtIni = new Date($ini.value);
        if (!inicio || inicio < dtIni) return false;
      }
      if ($fim.value) {
        const dtFim = new Date($fim.value);
        if (!inicio || inicio > dtFim) return false;
      }

      const txt = ($busca.value || "").trim().toLowerCase();
      if (txt && !busca.includes(txt)) return false;

      return true;
    }

    function aplicaFiltros() {
      salvaEstado();
      Array.from(tbody.querySelectorAll("tr")).forEach(tr => {
        tr.style.display = passaFiltros(tr) ? "" : "none";
      });
    }

    [$emp, $sala, $stat, $ini, $fim, $busca].forEach(el => {
      if (!el) return;
      el.addEventListener("input", aplicaFiltros);
      el.addEventListener("change", aplicaFiltros);
    });

    if ($limpar) {
      $limpar.addEventListener("click", () => {
        $emp.value = "";
        $sala.value = "";
        $stat.value = "";
        $ini.value = "";
        $fim.value = "";
        $busca.value = "";
        aplicaFiltros();
      });
    }

    aplicaFiltros();
  }

  // ===== VIEW SWITCH (Dropdown) =====
  const viewSwitch       = document.getElementById("viewSwitch");
  const viewBtn          = document.getElementById("viewSwitchBtn");
  const viewMenu         = document.getElementById("viewMenu");
  const viewLabel        = document.getElementById("currentViewLabel");
  const filtersContainer = document.getElementById("reservationsFilters");
  const cardsContainer   = document.getElementById("reservationsCards");
  const tableContainer   = document.getElementById("reservationsTable");
  const calendarContainer= document.getElementById("reservationsCalendar");
  const VIEW_KEY         = "reservationsViewMode";

  // ===== DADOS CALENDÁRIO =====
const calendarData = <%= raw @reservations.map { |r|
  {
    id: r.id,
    room: r.room&.name,
    room_id: r.room_id,
    status: (r.cancelada_em.present? ? 'cancelada' : (r.finalizada_em.present? ? 'encerrada' : 'ativa')),
    starts_at: r.starts_at.iso8601,
    ends_at:   r.ends_at.iso8601
  }
}.to_json %>;


  const calendarGrid       = document.getElementById("calendarGrid");
  const calendarMonthLabel = document.getElementById("calendarCurrentMonth");
  const roomSelect         = document.getElementById("calendarRoomSelect");
  const prevBtn            = document.getElementById("calendarPrev");
  const nextBtn            = document.getElementById("calendarNext");
  const filterSalaSelect   = document.getElementById("filterSala");

  let current = new Date();

const today = new Date();
today.setHours(0, 0, 0, 0);

function overlapsDay(ev, dayStart, dayEnd) {
  const evStart = new Date(ev.starts_at);
  const evEnd   = new Date(ev.ends_at);
  return evStart <= dayEnd && evEnd >= dayStart;
}

  function overlapsDay(ev, dayStart, dayEnd) {
    const evStart = new Date(ev.starts_at);
    const evEnd   = new Date(ev.ends_at);
    return evStart <= dayEnd && evEnd >= dayStart;
  }

  function renderCalendar() {
    if (!calendarGrid || !calendarMonthLabel) return;

    const year        = current.getFullYear();
    const month       = current.getMonth();
    const firstDay    = new Date(year, month, 1);
    const lastDay     = new Date(year, month + 1, 0);
    const startWeekday= firstDay.getDay(); // 0=Dom

    calendarMonthLabel.textContent = firstDay.toLocaleDateString("pt-BR", {
      month: "long",
      year: "numeric"
    });

    calendarGrid.innerHTML = "";

    const weekdays = ["Dom","Seg","Ter","Qua","Qui","Sex","Sáb"];
    weekdays.forEach(label => {
      const div = document.createElement("div");
      div.className = "cal-weekday";
      div.textContent = label;
      calendarGrid.appendChild(div);
    });

    const roomFilter = roomSelect ? roomSelect.value : "";

    for (let i = 0; i < startWeekday; i++) {
      const empty = document.createElement("div");
      empty.className = "cal-day cal-empty";
      calendarGrid.appendChild(empty);
    }

    for (let day = 1; day <= lastDay.getDate(); day++) {
  const cell = document.createElement("div");
  cell.className = "cal-day";

  const dayNumber = document.createElement("div");
  dayNumber.className = "cal-day-number";
  dayNumber.textContent = day;
  cell.appendChild(dayNumber);

  // 👉 Se o dia atual do loop for o "hoje" REAL, marca a célula
  const isToday =
    today.getFullYear() === year &&
    today.getMonth()    === month &&
    today.getDate()     === day;

  if (isToday) {
    cell.classList.add("cal-today");
  }


  const badgeWrap = document.createElement("div");
  badgeWrap.className = "cal-badges";

  const dayStart = new Date(year, month, day, 0, 0, 0);
  const dayEnd   = new Date(year, month, day, 23, 59, 59);

  // Filtra eventos que pegam esse dia
  const events = calendarData.filter(ev => {
    if (roomFilter && ev.room !== roomFilter) return false;
    return overlapsDay(ev, dayStart, dayEnd);
  });

  const counts = { ativa:0, encerrada:0, cancelada:0 };
  events.forEach(ev => {
    if (counts[ev.status] !== undefined) counts[ev.status]++;
  });

  if (counts.ativa) {
    const b = document.createElement("span");
    b.className = "cal-badge cal-badge-ativa";
    b.textContent = counts.ativa;
    badgeWrap.appendChild(b);
  }
  if (counts.encerrada) {
    const b = document.createElement("span");
    b.className = "cal-badge cal-badge-encerrada";
    b.textContent = counts.encerrada;
    badgeWrap.appendChild(b);
  }
  if (counts.cancelada) {
    const b = document.createElement("span");
    b.className = "cal-badge cal-badge-cancelada";
    b.textContent = counts.cancelada;
    badgeWrap.appendChild(b);
  }

  cell.appendChild(badgeWrap);

  // 👉 Só deixa clicável se:
  // - tiver pelo menos 1 reserva
  // - e uma sala tiver sido escolhida no calendário (roomFilter)
  if (events.length > 0 && roomFilter) {
    cell.classList.add("cal-day--has-events");

    cell.addEventListener("click", () => {
      // pega o room_id a partir do primeiro evento (todos são da mesma sala no filtro)
      const first = events[0];
      const roomId = first.room_id;
      if (!roomId) return;

      const dateParam = dayStart.toISOString().slice(0, 10); // YYYY-MM-DD
      // redireciona para /rooms/:id/reservations?date=YYYY-MM-DD
      window.location.href = `/rooms/${roomId}/reservations?date=${dateParam}`;
    });
  }

  calendarGrid.appendChild(cell);
}

  }

  function setButtonLabel(mode) {
    if (!viewLabel) return;
    if (mode === "table") {
      viewLabel.textContent = "Tabela";
    } else if (mode === "calendar") {
      viewLabel.textContent = "Calendário";
    } else {
      viewLabel.textContent = "Cards";
    }
  }

  function updateActiveOption(mode) {
    if (!viewMenu) return;
    viewMenu.querySelectorAll(".view-option").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.view === mode);
    });
  }

  function applyView(mode) {
    if (!cardsContainer || !tableContainer || !calendarContainer) return;

    cardsContainer.style.display    = (mode === "cards")    ? "flex"  : "none";
    tableContainer.style.display    = (mode === "table")    ? "table" : "none";
    calendarContainer.style.display = (mode === "calendar") ? "block" : "none";

    // filtros: some no calendário
    if (filtersContainer) {
      filtersContainer.style.display = (mode === "calendar") ? "none" : "flex";
    }

    setButtonLabel(mode);
    updateActiveOption(mode);

    if (mode === "calendar") {
      renderCalendar();
    }
  }

  function closeViewMenu() {
    if (viewMenu) viewMenu.classList.remove("open");
  }

  // view inicial
  const initialView = localStorage.getItem(VIEW_KEY) || "cards";
  applyView(initialView);

  // abrir/fechar menu
  if (viewBtn && viewMenu) {
    viewBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      viewMenu.classList.toggle("open");
    });
  }

  // seleção de opção
  if (viewMenu) {
    viewMenu.addEventListener("click", function (e) {
      const btn = e.target.closest(".view-option[data-view]");
      if (!btn) return;
      const mode = btn.dataset.view;
      localStorage.setItem(VIEW_KEY, mode);
      applyView(mode);
      closeViewMenu();
    });
  }

  // clique fora fecha menu
  document.addEventListener("click", function (e) {
    if (!viewSwitch) return;
    if (!viewSwitch.contains(e.target)) {
      closeViewMenu();
    }
  });

  // navegação mês calendário
  if (prevBtn && nextBtn) {
    prevBtn.addEventListener("click", () => {
      current = new Date(current.getFullYear(), current.getMonth() - 1, 1);
      renderCalendar();
    });
    nextBtn.addEventListener("click", () => {
      current = new Date(current.getFullYear(), current.getMonth() + 1, 1);
      renderCalendar();
    });
  }

  if (roomSelect) {
    roomSelect.addEventListener("change", renderCalendar);
  }
  // Quando escolher sala no filtro principal, já alterna para o calendário daquela sala
if (filterSalaSelect && roomSelect) {
  filterSalaSelect.addEventListener("change", function () {
    const salaNome = this.value;

    if (salaNome) {
      // define a view como calendário
      localStorage.setItem(VIEW_KEY, "calendar");
      applyView("calendar");

      // seleciona a mesma sala no dropdown do calendário
      roomSelect.value = salaNome;
      renderCalendar();
    }
  });
}

});
</script>

