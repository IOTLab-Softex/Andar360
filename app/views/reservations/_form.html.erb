function selectAllAvailableParticipants() {
  const checkboxes = Array.from(document.querySelectorAll("#participant-list input[type='checkbox']"))
    .filter(cb => !cb.checked && !cb.disabled);

  checkboxes.forEach(cb => {
    cb.checked = true;
    toggleParticipant(cb);
  });
}




let bulkSelectionMode = false; // adicione fora da função, no topo do <script> se ainda não existir

function toggleSelectAllCheckbox(masterCheckbox) {
  const checkboxes = Array.from(document.querySelectorAll("#participant-list input[type='checkbox']"))
    .filter(cb => !cb.disabled); // apenas os disponíveis

  const total = checkboxes.length;
  let i = 0;

  bulkSelectionMode = true; // evita renderizações múltiplas

  function clicarUmPorUm() {
if (i >= total) {
  bulkSelectionMode = false;
  renderParticipantList(); // <- restaura a lista com ocultação normal
  return;
}


    const cb = checkboxes[i];
    const deveMarcar = masterCheckbox.checked;

    if (cb.checked !== deveMarcar) {
      cb.checked = deveMarcar;
      cb.dispatchEvent(new Event("change")); // dispara onchange (chama toggleParticipant)
    }

    i++;
    setTimeout(clicarUmPorUm, 20); // próximo clique após 20ms
  }

  clicarUmPorUm();
}

function getSelectedParticipantIds() {
  return {
    solicitante: document.querySelector('input[name="reservation[solicitante_id]"]')?.value || null,
    responsavel: document.querySelector('input[name="reservation[responsavel_id]"]')?.value || null,
    participantes: Array.from(
      document.querySelectorAll('input[name="reservation[participant_ids][]"]')
    ).map(p => p.value)
  };
}



</script>
