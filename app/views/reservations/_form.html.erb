<script>





function loadRoomReservations(roomId) {
  const container = document.getElementById("room-reservations");
  container.innerHTML = "<p>Carregando reservas...</p>";

  fetch(`/rooms/${roomId}/reservations/json`)

    .then(response => response.json())
    .then(reservations => {
      if (reservations.length === 0) {
        container.innerHTML = "<p>✅ Nenhuma reserva nesta sala.</p>";
        return;
      }

      const html = reservations.map(r => `
  <div class="reserva-card" style="background: #cecece; border-left: 3px solid #555; padding: 6px; margin-bottom: 5px; border-radius: 4px;">
    <span><strong>${r.starts_at} - ${r.ends_at}</strong></span>
  </div>
`).join("");


      container.innerHTML = `
        <h4 style="margin-top: 1rem;">📅 Reservas desta sala:</h4>
        ${html}
      `;
    })
    .catch(err => {
      console.error("Erro ao carregar reservas:", err);
      container.innerHTML = "<p style='color: red;'>Erro ao carregar reservas.</p>";
    });
}

document.addEventListener("DOMContentLoaded", function() {





  const form = document.getElementById('reservation-form');

  if (form) {
    form.addEventListener('ajax:success', function(event) {
  const detail = event.detail;
  const data = detail[0];

  if (data && data.success) {
   
    showNotification("✅ Reserva criada com sucesso!", { bg: "#52c41a" });

    // Redireciona para a URL informada no JSON, se existir
    if (data.redirect_url) {
      window.location.href = data.redirect_url;
    } else {
      window.location.reload();
    }
  }
});


    form.addEventListener('ajax:error', function(event) {
      const detail = event.detail;
      const xhr = detail[0];

      let errorMessage = "Erro ao criar a reserva.";

      if (xhr && xhr.error) {
        errorMessage = xhr.error;
      }
      showNotification("Erro ao salvar reserva." + errorMessage);

      
    });
  }
});


document.addEventListener("turbo:load", function() {


let unavailableRanges = [];
  let currentRoomId = null;

  // Inicializar o calendário corretamente
  const now = new Date();

const startPicker = flatpickr("#starts_at_picker", {
  enableTime: true,
  dateFormat: "Y-m-d H:i",
  time_24hr: true,
  locale: "pt",
  minDate: "today",
  defaultHour: now.getHours(),      // 👈 define hora atual
  defaultMinute: now.getMinutes(),  // 👈 define minuto atual
  disable: [],
  onChange: function(selectedDates) {
    document.getElementById('starts_at_hidden').value = selectedDates[0].toISOString();
  }
});

const endPicker = flatpickr("#ends_at_picker", {
  enableTime: true,
  dateFormat: "Y-m-d H:i",
  time_24hr: true,
  locale: "pt",
  minDate: "today",
  defaultHour: now.getHours(),
  defaultMinute: now.getMinutes(),
  disable: [],
  onChange: function(selectedDates) {
    document.getElementById('ends_at_hidden').value = selectedDates[0].toISOString();
  }
});




  // Carregar reservas e verificar conflitos
  function loadBlockedDates(roomId) {
  if (!roomId) return;

  fetch(`/rooms/${roomId}/reservations.json`)
    .then(response => response.json())
    .then(data => {
      unavailableRanges = data.map(res => ({
        from: res.starts_at,
        to: res.ends_at
      }));

      startPicker.set('disable', unavailableRanges);
      endPicker.set('disable', unavailableRanges);

      // 🔥 Agora SIM chama o checkConflict depois de carregar
      setTimeout(checkConflict, 100);
    })
    .catch(err => console.error("Erro ao buscar reservas:", err));
}


function checkConflict() {
  const startsAt = startPicker.selectedDates[0];
  const endsAt = endPicker.selectedDates[0];

  if (!startsAt || !endsAt || unavailableRanges.length === 0) return;

  const startTime = startsAt.getTime();
  const endTime = endsAt.getTime();

  for (const range of unavailableRanges) {
    const rangeStart = new Date(range.from).getTime();
    const rangeEnd = new Date(range.to).getTime();

    if ((startTime >= rangeStart && startTime < rangeEnd) ||
        (endTime > rangeStart && endTime <= rangeEnd) ||
        (startTime <= rangeStart && endTime >= rangeEnd)) {
     
      showNotification("⚠️ Já existe uma reserva nesse horário!", { bg: "#ffc107" });

      return;
    }
  }
}


  // Quando selecionar uma sala
  document.querySelectorAll('input[name="reservation[room_id]"]').forEach(radio => {
  radio.addEventListener('change', function() {
    currentRoomId = this.value;
    loadBlockedDates(currentRoomId);

    // Depois de carregar bloqueios, aguarda e revalida conflito
    setTimeout(checkConflict, 500); // espera meio segundo para garantir que as datas foram carregadas
  });
});


});





function scrollRooms(direction) {
  const scrollWrapper = document.getElementById('room-scroll-wrapper');
  const scrollAmount = 250; // Quanto vai rolar cada vez

  if (direction === 'left') {
    scrollWrapper.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  } else if (direction === 'right') {
    scrollWrapper.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  }
}

function openParticipantModal(role) {
  
  document.getElementById("current-role").value = role;
  document.getElementById('participantModal').style.display = 'block';
  document.getElementById('participantModalOverlay').style.display = 'block';

  const participantList = document.getElementById("participant-list");
  const displayInfo = document.getElementById("role-display-info");

  participantList.style.display = "block";
if (role === "participantes") {
  displayInfo.textContent = "Selecione os participantes da reunião:";
} else {
  displayInfo.textContent = `Selecione o ${role} da reunião (somente um):`;
}
renderParticipantList();

}








function closeParticipantModal() {
  const modal = document.getElementById('participantModal');
  const overlay = document.getElementById('participantModalOverlay');
  if (modal && overlay) {
    modal.style.display = 'none';
    overlay.style.display = 'none';
  }
}


function toggleParticipant(checkbox) {
  const id = checkbox.value;
  const name = checkbox.getAttribute("data-name");
  const role = document.getElementById("current-role").value;

  const hiddenContainer = document.getElementById(`${role}-hidden`);
  const resumoContainer = document.getElementById(`selecionado-${role}`);
  const displayContainer = document.getElementById(`${role}-display`); // ✅ este é no formulário principal

  
  if (role === "solicitante" || role === "responsavel") {
    const existingInput = document.querySelector(`input[name="reservation[${role}_id]"]`);
    const currentId = existingInput?.value;

    if (checkbox.checked && id !== currentId) {
      // Marca novo
      document.querySelectorAll(`#participantModal input[type=checkbox]`).forEach(cb => {
        if (cb !== checkbox) cb.checked = false;
      });

     // Atualiza hidden field
// Atualiza hidden field
const inputName = (role === "solicitante" || role === "responsavel") ? `reservation[${role}_id]` : `reservation[participant_ids][]`;
hiddenContainer.innerHTML = `<input type="hidden" name="${inputName}" value="${id}" data-name="${name}">`;

displayContainer.innerHTML = `<div class="participant-tag">${name}</div>`;

resumoContainer.innerHTML = `
  <label>
    <input type="checkbox" checked data-name="${name}" value="${id}" onchange="toggleParticipant(this)">
    ${name}
  </label>
`;

// 🔥 FORÇA RE-RENDER IMEDIATA após DOM ter os dados
setTimeout(() => {
  renderParticipantList();
}, 50);





    } else {
      // Desmarca
      checkbox.checked = false;
      hiddenContainer.innerHTML = ``;
      resumoContainer.innerHTML = ``;
      displayContainer.innerHTML = ``;
    }
  } else {
    const inputId = `participant-hidden-${id}`;

    if (checkbox.checked) {
      if (!document.getElementById(inputId)) {
        const hidden = document.createElement("input");
        hidden.type = "hidden";
        hidden.name = "reservation[participant_ids][]";
        hidden.value = id;
        hidden.id = inputId;
        hidden.setAttribute("data-name", name);
        hiddenContainer.appendChild(hidden);

        const div = document.createElement("div");
        div.id = `resumo-participante-${id}`;
        div.innerHTML = `
          <label>
            <input type="checkbox" checked data-name="${name}" value="${id}" onchange="toggleParticipant(this)">
            ${name}
          </label>
        `;
        resumoContainer.appendChild(div);

        // ✅ Também adiciona no form principal (participantes-display)
        const participantDiv = document.createElement("div");
        participantDiv.id = `participant-display-${id}`;
        participantDiv.className = "participant-tag";
        participantDiv.innerText = name;
        displayContainer.appendChild(participantDiv);
      }
    } else {
      document.getElementById(inputId)?.remove();
      document.getElementById(`resumo-participante-${id}`)?.remove();
      document.getElementById(`participant-display-${id}`)?.remove();
    }
  }

 
if (!bulkSelectionMode) {
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      renderParticipantList();
    });
  });
}

updateFormDisplays();


}




function renderParticipantList() {
  const selectedSubgrupoId = document.getElementById("participant-subgroup-filter")?.value;
  const selectedGroupId = document.getElementById("participant-group-filter")?.value;
  const role = document.getElementById("current-role").value;
  const listContainer = document.getElementById("participant-list");
  const participantsData = JSON.parse(listContainer.dataset.participants || "[]");

  const filterInput = document.getElementById("participant-search")?.value?.toLowerCase() || "";
  let filterType = "name";
  if (/^\d+$/.test(filterInput)) filterType = "cpf";

  // ✅ pega os IDs selecionados corretamente
  const { solicitante, responsavel, participantes } = getSelectedParticipantIds();

  listContainer.innerHTML = "";

  participantsData.forEach(({ id, name, cpf, grupo_empresa_id, sub_grupo_empresa_id }) => {
    const idStr = String(id);

    // Filtros
    if (selectedGroupId && String(grupo_empresa_id) !== selectedGroupId) return;
    if (selectedSubgrupoId && String(sub_grupo_empresa_id) !== selectedSubgrupoId) return;

    const field = filterType === "cpf" ? cpf : name;
    if (filterInput && !field?.toLowerCase().includes(filterInput)) return;

    const isSolicitante = idStr === solicitante;
    const isResponsavel = idStr === responsavel;
    const isParticipante = participantes.includes(idStr);

    // 🔥 Oculta se já está selecionado em outro papel
   if (!bulkSelectionMode) {
  if (
    (role === "solicitante" && (isSolicitante || isResponsavel || isParticipante)) ||
    (role === "responsavel" && (isSolicitante || isResponsavel || isParticipante)) ||
    (role === "participantes" && (isSolicitante || isResponsavel || isParticipante))
  ) return;
}



    // Cria item da lista
    const label = document.createElement("label");
    label.className = "participant-label";

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.value = idStr;
    checkbox.setAttribute("data-name", name);
    checkbox.checked = false;
    checkbox.onchange = () => toggleParticipant(checkbox);

    label.appendChild(checkbox);
    label.append(` ${name}`);
    listContainer.appendChild(label);
  });

  // Controle do botão "Selecionar todos"
  const selectAllBtnContainer = document.getElementById("select-all-participants-container");
  if (selectAllBtnContainer) {
    selectAllBtnContainer.style.display = (role === "participantes") ? "block" : "none";
  }

  const selectAllCheckbox = document.getElementById("select-all-checkbox");
  if (selectAllCheckbox) selectAllCheckbox.checked = false;

  // Bloquear seleção cruzada
  ["solicitante", "responsavel", "participantes"].forEach(section => {
    const container = document.getElementById(`selecionado-${section}`);
    const checkboxes = container.querySelectorAll("input[type='checkbox']");
    checkboxes.forEach(cb => {
      cb.disabled = section !== role;
    });
  });

  console.log("IDs atuais:", getSelectedParticipantIds());

}










