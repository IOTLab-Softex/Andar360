<div class="rooms">

  <% if @reservations.any? %>
    <% minhas_reservas = @reservations.select { |r| r.grupo_empresa_id == current_user.participant&.grupo_empresa_id } %>
    <% outras_reservas = @reservations.reject { |r| r.grupo_empresa_id == current_user.participant&.grupo_empresa_id } %>

    <% if minhas_reservas.any? %>
      <div style="width: 100%; border-bottom: 2px solid #ccc; margin: 2rem 0 1rem; padding-bottom: 0.5rem;">
        <h2 style="margin: 0; padding-left: 1rem;">Minhas Reservas</h2>
      </div>

      <div class="reservation-list">
        <% minhas_reservas.each do |reservation| %>
          <% background = @room.photo.attached? ? "--bg-url: url(#{url_for(@room.photo)});" : "background-color: #ccc;" %>

          <div class="reservation-card" style="<%= background %>">
            <%# ... todo o conteúdo do card ... %>
            <div class="reservation-header">
              <% if reservation.grupo_empresa.present? %>
                <div class="empresa-info" style="margin-top: 0.5rem;">
                  <strong>Empresa:</strong> <%= reservation.grupo_empresa.nome %><br>
                  <% if reservation.grupo_empresa&.logo&.attached? %>
                    <%= image_tag reservation.grupo_empresa.logo, alt: "Logo da empresa", style: "max-height: 60px;" %>
                  <% end %>
                </div>
              <% end %>

              <strong>Nome da Reserva: <%= reservation.title %></strong><br>
              Início: <%= l(reservation.starts_at, format: :short) %><br>
              Fim: <%= l(reservation.ends_at, format: :short) %><br>

              <% if reservation.cancelada_em.present? %>
                <span class="status cancelado">⛔ Cancelada em <%= l(reservation.cancelada_em, format: :short) %></span>
              <% elsif reservation.finalizada_em.present? %>
                <span class="status encerrada">✔️ Encerrada em <%= l(reservation.finalizada_em, format: :short) %></span>
              <% else %>
                <span class="status ativa">🟢 Ativa</span><br>
                 <%# Status de envio dos participantes %>
              <span id="status-<%= reservation.id %>" class="tag <%= reservation.sent_to_facial? ? 'success' : 'warning' %>">
                <%= reservation.sent_to_facial? ? 'Participantes já enviados' : 'Aguardando envio' %>
              </span>
              <% end %>

             

            </div>

            <div class="reservation-actions">
              <%= link_to "Ver", reservation_path(reservation), class: "btn reservation" %>
              <% if reservation.finalizada_em.blank? && reservation.cancelada_em.blank? %>
              <%= link_to "Editar", edit_reservation_path(reservation), class: "btn edit" %>
              <% end %>


              <% if reservation.cancelada_em.blank? && reservation.finalizada_em.blank? %>
                <%= button_to "Cancelar", cancel_reservation_path(reservation),
                    method: :delete,
                    data: { confirm: "Tem certeza que deseja cancelar esta reserva?" },
                    class: "btn cancel",
                    form: { style: "display: contents;" } %>
              <% end %>

              <%= button_to "Excluir", reservation_path(reservation),
                  method: :delete,
                  data: { confirm: "Tem certeza que deseja excluir permanentemente esta reserva?" },
                  class: "btn delete",
                  form: { style: "display: contents;" } %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if outras_reservas.any? %>
    <% if current_user&.admin? %>
      <div style="width: 100%;
    border-bottom: 2px solid #ccc;
    margin: -1rem 0 1rem;">
        <h2 style="margin: 0; padding-left: 1rem;">Outras Reservas</h2>
      </div>

      <div class="reservation-list">
        <% outras_reservas.each do |reservation| %>
          <% background = @room.photo.attached? ? "--bg-url: url(#{url_for(@room.photo)});" : "background-color: #ccc;" %>

          <div class="reservation-card" style="<%= background %>">
            <%# ... repetir o mesmo conteúdo acima ... %>
            <div class="reservation-header">
              <% if reservation.grupo_empresa.present? %>
                <div class="empresa-info" style="margin-top: 0.5rem;">
                  <strong>Empresa:</strong> <%= reservation.grupo_empresa.nome %><br>
                  <% if reservation.grupo_empresa&.logo&.attached? %>
                    <%= image_tag reservation.grupo_empresa.logo, alt: "Logo da empresa", style: "max-height: 60px;" %>
                  <% end %>
                </div>
              <% end %>

              <strong>Nome da Reserva: <%= reservation.title %></strong><br>
              Início: <%= l(reservation.starts_at, format: :short) %><br>
              Fim: <%= l(reservation.ends_at, format: :short) %><br>

              <% if reservation.cancelada_em.present? %>
                <span class="status cancelado">⛔ Cancelada em <%= l(reservation.cancelada_em, format: :short) %></span>
              <% elsif reservation.finalizada_em.present? %>
                <span class="status encerrada">✔️ Encerrada em <%= l(reservation.finalizada_em, format: :short) %></span>
              <% else %>
                <span class="status ativa">🟢 Ativa</span>
              <% end %>
            </div>

            <div class="reservation-actions">
              <% if current_user&.admin? %>
                <%= link_to "Ver", reservation_path(reservation), class: "btn reservation" %>
                <%= link_to "Editar", edit_reservation_path(reservation), class: "btn edit" %>

                <% if reservation.cancelada_em.blank? && reservation.finalizada_em.blank? %>
                  <%= button_to "Cancelar", cancel_reservation_path(reservation),
                      method: :delete,
                      data: { confirm: "Tem certeza que deseja cancelar esta reserva?" },
                      class: "btn cancel",
                      form: { style: "display: contents;" } %>
                <% end %>

                <%= button_to "Excluir", reservation_path(reservation),
                    method: :delete,
                    data: { confirm: "Tem certeza que deseja excluir permanentemente esta reserva?" },
                    class: "btn delete",
                    form: { style: "display: contents;" } %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
  
  <% end %>
  <% end %>
</div>
