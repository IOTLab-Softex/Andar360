<div class="settings-container">
  <%= form_with model: @setting, local: true do |f| %>
    <%= f.hidden_field :grupo_empresa_id %>

    <!-- NAV ABAS -->
    <div class="tabs-nav" role="tablist" aria-label="Configurações">
      <button class="tab-link active" data-tab="tab-sistema"   role="tab" aria-selected="true">
        <i class="fa-solid fa-gear"></i> Sistema
      </button>
      <button class="tab-link"        data-tab="tab-reservas"  role="tab" aria-selected="false">
        <i class="fa-solid fa-calendar-check"></i> Reservas
      </button>
      <button class="tab-link"        data-tab="tab-turnos"    role="tab" aria-selected="false">
        <i class="fa-solid fa-clock"></i> Limites por turno
      </button>
      <button class="tab-link" data-tab="tab-push" role="tab" aria-selected="false">
  <i class="fa-solid fa-bell"></i> Push
</button>
      <button class="tab-link" data-tab="tab-camera" role="tab" aria-selected="false">
        <i class="fa-solid fa-camera"></i> Camera
      </button>

      <button class="tab-link"        data-tab="tab-email"     role="tab" aria-selected="false">
        <i class="fa-solid fa-envelope"></i> E-mail (SMTP)
      </button>
      <button class="tab-link" data-tab="tab-participantes" role="tab" aria-selected="false">
        <i class="fa-solid fa-users"></i> Participantes
      </button>
      <button class="tab-link" data-tab="tab-ai-agent" role="tab" aria-selected="false">
        <i class="fa-solid fa-wand-magic-sparkles"></i> Agente IA
      </button>
    </div>

    <div class="tabs-panels settings-form">
      <!-- ===== ⚙️ SISTEMA ===== -->
      <section id="tab-sistema" class="tab-panel active" role="tabpanel">
        <h2 class="subtitle mt-1 mb-3"><i class="fa-solid fa-gear me-2"></i> Sistema</h2>

        <div class="form-group">
          <label><i class="fa-solid fa-folder-open me-2"></i> Diretório de Backup do Icontrol</label>
          <%= f.text_field :backup_dir, class: "form-control", placeholder: "Ex: C:\\temp\\" %>
          <small class="form-text text-muted">Informe o caminho onde os dados do Icontrol serão extraídos.</small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-plug me-2"></i> Frequência de verificação dos dispositivos</label>
          <div class="d-flex gap-2">
            <%= f.number_field :tempo_verificacao_online, class: "form-control", min: 1, max: 10, step: 1 %>
            <%= f.select :tempo_verificacao_online_unidade, ["minutos", "segundos"], class: "form-control" %>
          </div>
          <small class="form-text text-muted">Verifica se os dispositivos de reconhecimento facial estão online (entre 1 e 10).</small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-clock me-2"></i> Horário da rotina de importação</label>
          <%= f.time_field :horario_rotina_importacao, class: "form-control" %>
          <small class="form-text text-muted">Hora programada para iniciar a rotina de extração do Icontrol (formato HH:MM).</small>
        </div>

        <div class="form-check form-group mb-3">
          <%= f.check_box :login_weather_card_enabled, class: "form-check-input", id: "setting_login_weather_card_enabled" %>
          <label class="form-check-label" for="setting_login_weather_card_enabled">
            <i class="fa-solid fa-cloud-sun me-2"></i> Exibir card do clima na tela de login
          </label>
          <small class="form-text text-muted d-block">
            Quando habilitado, um card de clima aparece junto aos cards de anuncios no rodape da tela de login.
          </small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-location-dot me-2"></i> Local do clima no login</label>
          <div class="d-flex gap-2">
            <%= f.text_field :login_weather_city, class: "form-control", placeholder: "Ex: Recife" %>
            <%= f.number_field :login_weather_latitude, class: "form-control", step: "0.000001", placeholder: "Latitude" %>
            <%= f.number_field :login_weather_longitude, class: "form-control", step: "0.000001", placeholder: "Longitude" %>
          </div>
          <small class="form-text text-muted">Padrao: Recife (-8.047562, -34.877003). O clima e carregado pelo navegador usando Open-Meteo.</small>
        </div>

      </section>

      <!-- ===== 📅 RESERVAS ===== -->
      <section id="tab-reservas" class="tab-panel" role="tabpanel" hidden>
        <h2 class="subtitle mt-4 mb-3"><i class="fa-solid fa-calendar-check me-2"></i> Reservas</h2>

        <div class="form-check form-group mb-3">
          <%= f.check_box :require_room_rules_ack, class: "form-check-input", id: "setting_require_room_rules_ack" %>
          <label class="form-check-label" for="setting_require_room_rules_ack">
            Exigir que o usuário aceite as regras antes de reservar
          </label>
          <small class="form-text text-muted d-block">
            Quando habilitado, o formulário de reserva mostrará a regra da sala solicitando o aceite obrigatório.
          </small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-calendar-check me-2"></i> Frequência de checagem de reservas</label>
          <div class="d-flex gap-2">
            <%= f.number_field :tempo_checagem_reservas, class: "form-control", min: 2, max: 10, step: 1 %>
            <%= f.select :tempo_checagem_reservas_unidade, ["minutos", "segundos"], class: "form-control" %>
          </div>
          <small class="form-text text-muted">Intervalo para buscar novas reservas (entre 2 e 10).</small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-user-check me-2"></i> Frequência de checagem de acesso</label>
          <div class="d-flex gap-2">
            <%= f.number_field :tempo_checagem_acesso, class: "form-control", min: 10, max: 20, step: 1 %>
            <%= f.select :tempo_checagem_acesso_unidade, ["segundos", "minutos"], class: "form-control" %>
          </div>
          <small class="form-text text-muted">Intervalo para verificar se o solicitante/responsável acessou a sala (entre 10 e 20).</small>
        </div>
      </section>

      <!-- ===== ⏰ LIMITES POR TURNO ===== -->
      <section id="tab-turnos" class="tab-panel" role="tabpanel" hidden>
        <h2 class="subtitle mt-4 mb-3"><i class="fa-solid fa-clock me-2"></i> Limite de Horas por Turno</h2>

        <div class="form-group">
          <label><i class="fa-solid fa-sun me-2"></i> Limite para turno da manhã</label>
          <%= f.time_field :limite_horas_turno_reservas_manha, class: "form-control" %>
          <small class="form-text text-muted">Defina o tempo máximo permitido para reservas pela manhã.</small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-cloud-sun me-2"></i> Limite para turno da tarde</label>
          <%= f.time_field :limite_horas_turno_reservas_tarde, class: "form-control" %>
          <small class="form-text text-muted">Defina o tempo máximo permitido para reservas pela tarde.</small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-moon me-2"></i> Limite para turno da noite</label>
          <%= f.time_field :limite_horas_turno_reservas_noite, class: "form-control" %>
          <small class="form-text text-muted">Defina o tempo máximo permitido para reservas à noite.</small>
        </div>
      </section>

      <!-- ===== 📨 E-MAIL (SMTP) ===== -->
      <section id="tab-email" class="tab-panel" role="tabpanel" hidden>
        <h2 class="subtitle mt-4 mb-3"><i class="fa-solid fa-envelope me-2"></i> E-mail (SMTP)</h2>

        <div class="form-group">
          <label>Remetente (From)</label>
          <%= f.email_field :smtp_from_email, class: "form-control", placeholder: "ex.: infraestrutura@softexpe.org.br" %>
          <small class="form-text text-muted">De onde os e-mails serão enviados (precisa ser compatível com o servidor SMTP).</small>
        </div>

        <div class="form-group">
          <label>Reply-To (opcional)</label>
          <%= f.email_field :smtp_reply_to, class: "form-control", placeholder: "ex.: suporte@seu-dominio.com" %>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label>Servidor SMTP</label>
              <%= f.text_field :smtp_address, class: "form-control", placeholder: "smtp.gmail.com / smtp.office365.com / mail.seu-dominio.com" %>
            </div>
          </div>
          <div class="col-md-3">
            <div class="form-group">
              <label>Porta</label>
              <%= f.number_field :smtp_port, class: "form-control", min: 1, max: 65535, value: (@setting.smtp_port || 587) %>
            </div>
          </div>
          <div class="col-md-3">
            <div class="form-group">
              <label>Domínio (opcional)</label>
              <%= f.text_field :smtp_domain, class: "form-control", placeholder: "gmail.com / seu-dominio.com" %>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label>Usuário</label>
              <%= f.text_field :smtp_username, class: "form-control", placeholder: "e-mail de login do SMTP" %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label>Senha</label>
              <div class="input-group">
                <%= f.password_field :smtp_password, class: "form-control", placeholder: "Deixe em branco para manter a atual", id: "smtp_password_field" %>
                <button class="btn btn-outline-secondary" type="button" aria-label="Mostrar/ocultar senha"
                        onclick="(function(){const f=document.getElementById('smtp_password_field'); f.type = (f.type==='password'?'text':'password');})();">
                  <i class="fa-solid fa-eye"></i>
                </button>
              </div>
              <small class="form-text text-muted">Se usar Gmail/Workspace, use <strong>Senha de App</strong> (16 dígitos), não a senha normal.</small>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Autenticação</label>
          <%= f.select :smtp_authentication, [["plain","plain"],["login","login"],["cram_md5","cram_md5"]],
                {}, class: "form-control" %>
          <small class="form-text text-muted d-block mt-2">
            <strong>plain</strong>: envia usuário e senha já dentro do túnel TLS (com STARTTLS ativo). Compatível com Gmail, Office 365 e a maioria dos provedores.<br>
            <strong>login</strong>: variação baseada em Base64 (AUTH LOGIN). Compatível com Office 365/cPanel; costuma funcionar no Gmail também.<br>
            <strong>cram_md5</strong>: desafio-resposta. Poucos provedores suportam (não funciona no Gmail/Workspace).
          </small>
        </div>

        <div class="form-check mt-2">
          <%= f.check_box :smtp_enable_starttls_auto, class: "form-check-input", id: "setting_smtp_enable_starttls_auto", checked: (@setting.smtp_enable_starttls_auto != false) %>
          <label class="form-check-label" for="setting_smtp_enable_starttls_auto">Ativar STARTTLS</label>
          <small class="form-text text-muted d-block">
            <strong>STARTTLS</strong> promove a conexão para TLS na porta 587. Mantenha ligado para Gmail, Office 365 e cPanel.
          </small>
        </div>

        <details class="mt-2">
          <summary class="text-muted"><i class="fa-solid fa-lightbulb me-1"></i> Dicas rápidas por provedor</summary>
          <ul class="small mb-0 mt-2">
            <li><strong>Gmail/Workspace</strong>: <code>smtp.gmail.com</code>, porta <code>587</code>, <code>plain</code>, STARTTLS ✓, usuário = e-mail completo, senha = <em>Senha de app</em> (16 dígitos; exige 2FA).</li>
            <li><strong>Office 365</strong>: <code>smtp.office365.com</code>, porta <code>587</code>, <code>login</code> ou <code>plain</code>, STARTTLS ✓. Necessário “SMTP AUTH” habilitado.</li>
            <li><strong>cPanel</strong>: <code>mail.seu-dominio.com</code>, porta <code>587</code>, <code>login</code>, STARTTLS ✓.</li>
          </ul>
        </details>

        <hr class="my-4">

        <h3 class="subtitle mb-3"><i class="fa-solid fa-key me-2"></i> Recuperacao de senha</h3>

        <div class="form-check form-group mb-3">
          <%= f.check_box :password_recovery_test_mode, class: "form-check-input", id: "setting_password_recovery_test_mode" %>
          <label class="form-check-label" for="setting_password_recovery_test_mode">
            Ativar modo teste para links de recuperacao
          </label>
          <small class="form-text text-muted d-block">
            Em modo teste o e-mail usa o dominio local. Desativado, ele usa o dominio publico configurado.
          </small>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label>Dominio em modo teste</label>
              <%= f.text_field :password_recovery_test_host, class: "form-control", placeholder: "localhost:3000" %>
              <small class="form-text text-muted">Exemplo: <code>localhost:3000</code> ou <code>http://localhost:3000</code>.</small>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label>Dominio em modo producao</label>
              <%= f.text_field :password_recovery_live_host, class: "form-control", placeholder: "andar360.ddns.net" %>
              <small class="form-text text-muted">Exemplo: <code>andar360.ddns.net</code> ou <code>https://andar360.ddns.net</code>.</small>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Rota do link de recuperacao</label>
          <%= f.text_field :password_recovery_link_path, class: "form-control", placeholder: "/users/password/edit" %>
          <small class="form-text text-muted">
            Essa rota precisa existir. O token de redefinicao sera anexado automaticamente ao final do link.
          </small>
        </div>

        <div class="form-group">
          <label>Tempo para expirar o link de recuperacao</label>
          <div class="d-flex gap-2">
            <%= f.number_field :password_recovery_expiration_minutes, class: "form-control", min: 1, step: 1, placeholder: "360" %>
            <%= f.select :password_recovery_expiration_unit,
                  [["Minutos", "minutes"], ["Segundos", "seconds"]],
                  { selected: (@setting.password_recovery_expiration_unit.presence || "minutes") },
                  class: "form-control" %>
          </div>
          <small class="form-text text-muted">
            Defina o valor e escolha a unidade. Esse mesmo prazo sera usado na validade real do token e no texto padrao do e-mail.
          </small>
        </div>

        <div class="form-group">
          <label>Assunto do e-mail</label>
          <%= f.text_field :password_recovery_email_subject, class: "form-control", placeholder: "Recuperacao de senha - Andar360" %>
        </div>

        <div class="form-group">
          <label>Corpo do e-mail em HTML</label>
          <%= f.text_area :password_recovery_email_html,
                class: "form-control",
                rows: 14,
                value: @setting.password_recovery_email_html_or_default,
                placeholder: "<h2>Recuperacao de senha</h2><p>Ola, {{user_name}}</p><a href='{{reset_url}}'>Redefinir senha</a>" %>
          <small class="form-text text-muted d-block">
            Variaveis disponiveis: <code>{{reset_url}}</code>, <code>{{user_name}}</code>, <code>{{user_email}}</code>, <code>{{app_name}}</code>, <code>{{recovery_host}}</code> e <code>{{reset_expiration}}</code>.
          </small>
        </div>

        <div class="form-group">
          <label>Preview do link gerado</label>
          <input type="text" class="form-control" id="password_recovery_link_preview" value="<%= @setting.password_recovery_url('__TOKEN__') %>" readonly>
          <small class="form-text text-muted">
            O preview acompanha o modo teste, o dominio escolhido e a rota configurada acima.
          </small>
        </div>
      </section>

      <!-- ===== 🔔 PUSH NOTIFICATIONS ===== -->
<section id="tab-push" class="tab-panel" role="tabpanel" hidden>
  <h2 class="subtitle mt-4 mb-3">
    <i class="fa-solid fa-bell me-2"></i> Notificação Push (Web Push)
  </h2>

  <div class="form-group">
    <label><i class="fa-solid fa-at me-2"></i> VAPID Subject</label>
    <%= f.text_field :vapid_subject,
          class: "form-control",
          placeholder: "mailto:suporte@seu-dominio.com",
          value: (@setting.vapid_subject.presence || "mailto:suporte@seu-dominio.com") %>
    <small class="form-text text-muted">
      Recomendado: <code>mailto:...</code> ou a URL do seu site.
    </small>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="form-group">
        <label><i class="fa-solid fa-key me-2"></i> VAPID Public Key</label>
        <%= f.text_area :vapid_public_key, class: "form-control", rows: 3, readonly: true %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <label><i class="fa-solid fa-lock me-2"></i> VAPID Private Key</label>
        <%= f.text_area :vapid_private_key, class: "form-control", rows: 3, readonly: true %>
        <small class="form-text text-muted">
          ⚠️ Chave privada: mantenha restrita (apenas admin).
        </small>
      </div>
    </div>
  </div>




  <small class="form-text text-muted d-block mt-2">
    Depois de gerar, seus navegadores vão usar a <strong>Public Key</strong> para registrar o Push.
    O servidor usa a <strong>Private Key</strong> para enviar notificações.
  </small>
</section>

      <section id="tab-camera" class="tab-panel" role="tabpanel" hidden>
        <h2 class="subtitle mt-4 mb-3"><i class="fa-solid fa-camera me-2"></i> Ajuste da Camera Facial</h2>
        <p class="form-text text-muted mb-3">
          Os ajustes finos da camera ficam dentro do modal de preview, para voce calibrar vendo o resultado em tempo real.
        </p>
        <div class="settings-actions mt-3">
          <button type="button" id="open-camera-tuning-preview" class="btn btn-outline-secondary">
            <i class="fa-solid fa-camera me-2"></i> Abrir Preview da Camera
          </button>
        </div>
        <small class="form-text text-muted d-block mt-2">
          Quando houver valores salvos aqui, a camera do participante usara essas configuracoes no lugar do padrao interno.
        </small>
      </section>

      <!-- ===== 👥 PARTICIPANTES ===== -->
      <section id="tab-participantes" class="tab-panel" role="tabpanel" hidden>
        <h2 class="subtitle mt-1 mb-3"><i class="fa-solid fa-users me-2"></i> Participantes</h2>

        <hr class="my-4">

        <h3 class="subtitle mb-2"><i class="fa-solid fa-users-slash me-2"></i> Zona de Perigo</h3>
        <p class="form-text text-muted mb-3">
          Participantes vinculados a reservas ou chamados não serão excluídos.
        </p>
        <button type="button" id="btn-delete-all-participants" class="btn btn-danger">
          <i class="fa-solid fa-trash me-2"></i> Excluir todos os participantes
        </button>
      </section>

      <section id="tab-ai-agent" class="tab-panel" role="tabpanel" hidden>
        <h2 class="subtitle mt-1 mb-3"><i class="fa-solid fa-wand-magic-sparkles me-2"></i> Agente IA</h2>

        <div class="form-check form-group mb-3">
          <%= f.check_box :ai_agent_enabled, class: "form-check-input", id: "setting_ai_agent_enabled" %>
          <label class="form-check-label" for="setting_ai_agent_enabled">
            Ativar agente IA
          </label>
          <small class="form-text text-muted d-block">
            Quando ativado, usuários logados poderão abrir o chat do agente pelo botão flutuante.
          </small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-key me-2"></i> Token da API</label>
          <%= f.password_field :ai_agent_api_token,
                class: "form-control",
                placeholder: @setting.ai_agent_api_token.present? ? "Token já configurado. Deixe em branco para manter." : "Cole o token da API" %>
          <small class="form-text text-muted">
            O token é usado no servidor para consultar a API da OpenAI. Deixe em branco para manter o token atual.
          </small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-microchip me-2"></i> Modelo</label>
          <%= f.text_field :ai_agent_model,
                class: "form-control",
                value: @setting.ai_agent_model_or_default,
                placeholder: "gpt-4o-mini" %>
          <small class="form-text text-muted">
            Informe o modelo configurado na sua conta. Exemplo: <code>gpt-4o-mini</code>.
          </small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-volume-high me-2"></i> Voz da OpenAI</label>
          <div class="d-flex gap-2 align-items-center">
            <%= f.select :ai_agent_voice,
                  options_for_select(Setting::AI_AGENT_VOICES.map { |voice| [voice.titleize, voice] }, @setting.ai_agent_voice_or_default),
                  {},
                  class: "form-control",
                  id: "setting_ai_agent_voice" %>
            <button type="button" id="preview-ai-agent-voice" class="btn btn-outline-secondary" title="Ouvir previa da voz">
              <i class="fa-solid fa-play me-1"></i> Previa
            </button>
          </div>
          <small class="form-text text-muted">
            Usada no modo conversa para ler as respostas do agente com voz da OpenAI.
          </small>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-scroll me-2"></i> Prompt do agente</label>
          <%= f.text_area :ai_agent_prompt,
                class: "form-control",
                rows: 10,
                value: @setting.ai_agent_prompt_or_default %>
          <small class="form-text text-muted">
            Este prompt orienta o comportamento do agente. A ferramenta inicial disponível é: cadastrar reserva de sala.
          </small>
        </div>
      </section>

    </div>

    <!-- AÇÕES -->
    <div class="settings-actions text-end mt-4">
  <%= button_tag type: "submit", class: "btn btn-primary px-4" do %>
    <i class="fa-solid fa-floppy-disk me-2"></i> Salvar Configurações
  <% end %>
</div>

<div id="settings-camera-preview-overlay" hidden style="position:fixed; inset:0; z-index:10050; background:rgba(5,10,20,.78); backdrop-filter:blur(6px); padding:16px; transition:background-color .18s ease, backdrop-filter .18s ease;">
  <div class="settings-camera-preview-layout" style="display:grid; grid-template-columns:minmax(0, 860px) minmax(280px, 320px); gap:16px; width:min(96vw,1220px); max-height:calc(100vh - 32px); margin:0 auto;">
    <div style="position:relative; width:100%; height:min(calc(100vh - 32px), 760px); padding:14px; border-radius:22px; background:linear-gradient(180deg, rgba(27, 35, 48, 0.96), rgba(14, 19, 28, 0.98)); box-shadow:0 30px 80px rgba(0,0,0,.45); border:1px solid rgba(255,255,255,.12); overflow:hidden;">
      <iframe id="settings-camera-preview-frame" src="/camera" allow="camera *" style="display:block; width:100%; height:100%; border:1px solid rgba(148,163,184,.28); border-radius:18px; background:#05070b;"></iframe>
      <button type="button" id="close-camera-tuning-preview" style="position:absolute; top:10px; right:10px; width:42px; height:42px; border-radius:999px; border:1px solid rgba(255,255,255,.16); background:rgba(15,23,42,.82); color:#fff; font-size:26px; line-height:1; cursor:pointer;">&times;</button>
    </div>
    <div class="settings-camera-panel">
