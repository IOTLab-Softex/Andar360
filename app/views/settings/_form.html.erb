<script>
  (function(){
    const KEY = "settingsActiveTab";
    const nav = document.querySelector('.tabs-nav');
    const links = Array.from(document.querySelectorAll('.tab-link'));
    const panels = Array.from(document.querySelectorAll('.tab-panel'));

    function activate(id){
      links.forEach(btn=>{
        const on = btn.dataset.tab === id;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach(p=>{
        p.hidden = (p.id !== id);
        p.classList.toggle('active', p.id === id);
      });
      try { localStorage.setItem(KEY, id); } catch(e){}
       const testBar = document.getElementById('test-email-bar');
  if (testBar) testBar.style.display = (id === 'tab-email') ? 'flex' : 'none';
    }

    // restaura aba
    let initial = null;
    try { initial = localStorage.getItem(KEY); } catch(e){}
    if (!initial || !document.getElementById(initial)) initial = 'tab-sistema';
    activate(initial);

    // click
    nav.addEventListener('click', (e)=>{
      const btn = e.target.closest('.tab-link');
      if (!btn) return;
      e.preventDefault();
      activate(btn.dataset.tab);
    });

    // acessibilidade com setas
    nav.addEventListener('keydown', (e)=>{
      const idx = links.findIndex(b=>b.classList.contains('active'));
      if (e.key === 'ArrowRight'){
        const next = links[(idx+1)%links.length];
        next.focus(); activate(next.dataset.tab);
      } else if (e.key === 'ArrowLeft'){
        const prev = links[(idx-1+links.length)%links.length];
        prev.focus(); activate(prev.dataset.tab);
      }
    });
  })();

  (function(){
    const button = document.getElementById('preview-ai-agent-voice');
    const select = document.getElementById('setting_ai_agent_voice');
    let audio = null;

    if (!button || !select) return;

    button.addEventListener('click', function(){
      const originalHtml = button.innerHTML;
      const voice = select.value;

      if (audio) {
        audio.pause();
        audio = null;
      }

      button.disabled = true;
      button.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Gerando...';

      fetch('/ai_agent/speech', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'audio/mpeg',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        body: JSON.stringify({
          voice: voice,
          text: 'Ola, eu sou o agente IA do Andar360. Esta e uma previa da voz selecionada.'
        })
      })
        .then(function(response){
          if (!response.ok) throw new Error('speech_failed');
          return response.blob();
        })
        .then(function(blob){
          const url = URL.createObjectURL(blob);
          audio = new Audio(url);
          audio.onended = function(){
            URL.revokeObjectURL(url);
            button.disabled = false;
            button.innerHTML = originalHtml;
          };
          audio.onerror = function(){
            URL.revokeObjectURL(url);
            throw new Error('audio_play_failed');
          };
          return audio.play();
        })
        .catch(function(){
          button.disabled = false;
          button.innerHTML = originalHtml;
          alert('Nao foi possivel gerar a previa da voz. Verifique o token da API do Agente IA.');
        });
    });
  })();

  (function(){
    const overlay = document.getElementById('settings-camera-preview-overlay');
    const openBtn = document.getElementById('open-camera-tuning-preview');
    const closeBtn = document.getElementById('close-camera-tuning-preview');
    const frame = document.getElementById('settings-camera-preview-frame');
    const summary = document.getElementById('settings-camera-preview-summary');
    if (!overlay || !openBtn || !closeBtn || !frame) return;

    const selectors = {
      minRatio: '#setting_camera_min_ratio',
      maxRatio: '#setting_camera_max_ratio',
      scoreThreshold: '#setting_camera_score_threshold',
      goodScore: '#setting_camera_good_score',
      minZoom: '#setting_camera_min_zoom',
      maxZoom: '#setting_camera_max_zoom',
      zoomWidthFactor: '#setting_camera_zoom_width_factor',
      zoomHeightFactor: '#setting_camera_zoom_height_factor',
      blurStrength: '#setting_camera_blur_strength',
      blurSaturation: '#setting_camera_blur_saturation',
      focusInnerRadius: '#setting_camera_focus_inner_radius',
      focusOuterRadius: '#setting_camera_focus_outer_radius',
      autoCaptureEnabled: '#setting_camera_auto_capture_enabled',
      meshStyle: '#setting_camera_mesh_style'
    };

    function payloadFromForm() {
      const payload = {};
      Object.entries(selectors).forEach(([key, selector]) => {
        const el = document.querySelector(selector);
        if (!el) return;
        if (el.type === 'checkbox') payload[key] = el.checked;
        else if (el.tagName === 'SELECT') payload[key] = el.value;
        else payload[key] = Number(el.value);
      });
      return payload;
    }

    function syncSliderValues() {
      document.querySelectorAll('[data-camera-value-target]').forEach((el) => {
        const target = document.getElementById(el.dataset.cameraValueTarget);
        if (!target) return;
        const precision = Number(el.dataset.cameraPrecision || 0);
        const numericValue = Number(el.value);
        const min = Number(el.min || 0);
        const max = Number(el.max || 100);
        const percent = max > min ? ((numericValue - min) / (max - min)) * 100 : 0;
        el.style.setProperty('--range-fill', `${Math.min(100, Math.max(0, percent))}%`);
        target.textContent = Number.isFinite(numericValue) ? numericValue.toFixed(precision) : el.value;
      });
    }

    function syncPreview() {
      syncSliderValues();
      const payload = payloadFromForm();
      frame.contentWindow?.postMessage({ type: 'camera-tuning', payload: payload }, '*');
      if (summary) {
        summary.textContent =
          `minRatio=${payload.minRatio?.toFixed(2)} | maxRatio=${payload.maxRatio?.toFixed(2)} | ` +
          `scoreThreshold=${payload.scoreThreshold?.toFixed(2)} | goodScore=${payload.goodScore?.toFixed(2)} | ` +
          `minZoom=${payload.minZoom?.toFixed(2)} | maxZoom=${payload.maxZoom?.toFixed(2)} | ` +
          `zoomWidthFactor=${payload.zoomWidthFactor?.toFixed(2)} | zoomHeightFactor=${payload.zoomHeightFactor?.toFixed(2)} | ` +
          `blurStrength=${payload.blurStrength} | blurSaturation=${payload.blurSaturation?.toFixed(2)} | ` +
          `focusInnerRadius=${payload.focusInnerRadius} | focusOuterRadius=${payload.focusOuterRadius} | ` +
          `autoCaptureEnabled=${payload.autoCaptureEnabled} | meshStyle=${payload.meshStyle}`;
      }
    }

    openBtn.addEventListener('click', () => {
      overlay.hidden = false;
      document.body.classList.add('v-no-scroll');
      syncPreview();
    });

    closeBtn.addEventListener('click', () => {
      overlay.hidden = true;
      overlay.classList.remove('flash-mode');
      document.body.classList.remove('v-no-scroll');
    });

    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) {
        overlay.hidden = true;
        overlay.classList.remove('flash-mode');
        document.body.classList.remove('v-no-scroll');
      }
    });

    window.addEventListener('message', (event) => {
      if (!event.data || event.source !== frame.contentWindow) return;
      if (event.data.type === 'camera-light-state') {
        overlay.classList.toggle('flash-mode', !!event.data.lowLight);
      }
    });

    Object.values(selectors).forEach((selector) => {
      const el = document.querySelector(selector);
      if (!el) return;
      el.addEventListener('input', syncPreview);
      el.addEventListener('change', syncPreview);
    });

    frame.addEventListener('load', () => {
      overlay.classList.remove('flash-mode');
      syncPreview();
    });
    syncSliderValues();
  })();

  (function(){
    const preview = document.getElementById('password_recovery_link_preview');
    const testMode = document.getElementById('setting_password_recovery_test_mode');
    const testHost = document.getElementById('setting_password_recovery_test_host');
    const liveHost = document.getElementById('setting_password_recovery_live_host');
    const pathField = document.getElementById('setting_password_recovery_link_path');
    if (!preview || !testMode || !testHost || !liveHost || !pathField) return;

    function normalizeHost(host, fallback, test) {
      const value = (host || fallback || '').trim().replace(/\/+$/, '');
      if (!value) return test ? 'http://localhost:3000' : 'https://andar360.ddns.net';
      if (/^https?:\/\//i.test(value)) return value;
      return test ? `http://${value}` : `https://${value}`;
    }

    function normalizePath(path) {
      const value = (path || '/users/password/edit').trim();
      if (!value) return '/users/password/edit';
      return value.startsWith('/') ? value : `/${value}`;
    }

    function syncRecoveryPreview() {
      const usingTestMode = !!testMode.checked;
      const host = usingTestMode
        ? normalizeHost(testHost.value, 'localhost:3000', true)
        : normalizeHost(liveHost.value, 'andar360.ddns.net', false);
      const path = normalizePath(pathField.value);
      preview.value = `${host}${path}?reset_password_token=__TOKEN__`;
    }

    [testMode, testHost, liveHost, pathField].forEach((el) => {
      el.addEventListener('input', syncRecoveryPreview);
      el.addEventListener('change', syncRecoveryPreview);
    });

    syncRecoveryPreview();
  })();

  (function(){
    const btn = document.getElementById('btn-delete-all-participants');
    if (!btn) return;

    btn.addEventListener('click', function() {
      if (!confirm('Tem certeza? Todos os participantes sem reservas ou chamados serão excluídos permanentemente. Esta ação não pode ser desfeita.')) return;

      const modal   = document.getElementById('delete-all-modal');
      const bar     = document.getElementById('delete-all-bar');
      const barText = document.getElementById('delete-all-bar-text');
      const msg     = document.getElementById('delete-all-modal-msg');

      modal.style.display = 'flex';
      let progress = 0;

      const tick = setInterval(() => {
        if (progress < 85) {
          progress += (85 - progress) * 0.12 + Math.random() * 3;
          progress = Math.min(progress, 85);
          bar.style.width = progress.toFixed(1) + '%';
          barText.textContent = Math.round(progress) + '%';
        }
      }, 350);

      fetch('<%= delete_all_participants_path %>', {
        method: 'DELETE',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      })
      .then(r => r.ok ? r.json() : r.json().then(e => Promise.reject(e)))
      .then(data => {
        clearInterval(tick);
        bar.style.width = '100%';
        barText.textContent = '100%';
        msg.textContent = data.message || 'Concluído!';
        setTimeout(() => { modal.style.display = 'none'; }, 900);
      })
      .catch(err => {
        clearInterval(tick);
        modal.style.display = 'none';
        alert('Erro: ' + (err.message || JSON.stringify(err)));
      });
    });
  })();
</script>
