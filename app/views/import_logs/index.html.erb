
<%= form_with url: import_logs_path, method: :get, local: true, class: "filter-form" do %>
    <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; flex-wrap: wrap;">
      <div>
        <%= label_tag :data, "Data da Importação" %><br>
       <%= select_tag :data,
  options_for_select(
    [["Todas", ""]] + @datas_disponiveis.map { |d| [d.strftime("%d/%m/%Y"), d.to_s] },
    params[:data]
  ),
  class: "form-control" %>


      </div>
  
      <div>
        <%= label_tag :filtro, "Tipo" %><br>
        <%= select_tag :filtro,
          options_for_select([
            ["Todos", ""],
            ["Somente Erros", "erro"],
            ["Somente Sucesso", "sucesso"]
          ], params[:filtro]),
          class: "form-control" %>
      </div>
  
      <div style="align-self: flex-end;">
        <%= submit_tag "Filtrar", class: "btn btn-filter" %>
      </div>
     

    </div>
  <% end %>
 <div style="text-align: center; padding-top: 10px;">
 <button id="clear-logs-btn" class="btn btn-danger">
  🗑️ Limpar logs da data filtrada
</button>

</div>

  <% total_sucesso = @import_logs.count { |log| !(log.dados_incompletos || log.sem_foto || log.status == 'erro') } %>
<% total_erro = @import_logs.count { |log| log.dados_incompletos || log.sem_foto || log.status == 'erro' } %>

<div style="text-align: center; margin-bottom: 1rem;">
  <span style="font-size: 1.2rem; margin-right: 2rem;">
    ✔️ Sucesso: <strong><%= total_sucesso %></strong>
  </span>
  <span style="font-size: 1.2rem;">
    ⚠️ Erros: <strong><%= total_erro %></strong>
  </span>
</div>


<div class="rooms">
  <table class="table table-salas">
    <thead class="table-secondary text-dark">
      <tr>
        <th>Status</th>
        <th>Nome</th>
        <th>CPF</th>
        <th class="hide-sm">Mensagem</th>
        <th class="hide-sm">Registrado em</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @import_logs.empty? %>
        <tr>
          <td colspan="6" style="text-align:center; padding:1rem; font-style:italic; color:#888;">
            Nenhum log encontrado.
          </td>
        </tr>
      <% else %>
        <% @import_logs.each do |log| %>
          <% is_error = log.dados_incompletos || log.sem_foto || log.status == 'erro' %>

          <% participant = nil %>
          <% if log.cpf.present? && log.cpf != "Desconhecido" %>
            <% participant = Participant.find_by(cpf: log.cpf) %>
          <% end %>
          <% if participant.nil? %>
            <% participant = Participant.where("LOWER(name) = ?", log.nome.downcase).first %>
          <% end %>

          <tr style="background: <%= is_error ? '#ffe6e6' : '#e0ffe6' %>;">
            <td style="text-align: center; width: 10%;">
              <% if is_error %>
                <span title="Erro na importação" style="font-size: 1.2rem;">⚠️</span>
              <% else %>
                <span title="Importado com sucesso" style="font-size: 1.2rem;">✔️</span>
              <% end %>
            </td>
            <td><%= log.nome %></td>
            <td><%= log.cpf %></td>
            <td class="hide-sm"><%= truncate(log.mensagem, length: 80) %></td>
            <td class="hide-sm"><%= log.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            <td>
              <% if is_error && participant.present? %>
                <%= link_to edit_participant_path(participant), class: 'btn-dash btn btn-sm btn-warning', title: "Ajustar usuário", onclick: 'event.stopPropagation();' do %>
                  <i class="fa-solid fa-pen-to-square"></i>
                <% end %>
              <% elsif is_error %>
                <span style="color: #b00; font-size: 0.85rem;">Não encontrado</span>
              <% else %>
                <span style="color: #28a745;">Sucesso</span>
              <% end %>
            </td>
          </tr>

          <%# Exibe tags de erro abaixo da linha, se necessário — opcional e estilizado %>
          <% if is_error %>
            <tr>
              <td colspan="6" style="padding: 0.3rem 1rem; background: #fff5f5; font-size: 0.85rem; border-top: none;">
                <% if log.dados_incompletos %>
                  <span class="participant-tag">Dados incompletos</span>
                <% end %>
                <% if log.sem_foto %>
                  <span class="participant-tag">Sem foto</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>


<form id="clear-logs-form" action="<%= clear_all_import_logs_path %>" method="post" style="display: none;">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <input type="hidden" name="_method" value="delete">
  <input type="hidden" name="data" value="<%= params[:data] %>">
</form>

<script>
  document.getElementById("clear-logs-btn").addEventListener("click", function (e) {
    e.preventDefault();
    Swal.fire({
      title: 'Tem certeza?',
      text: "Deseja apagar os logs de <%= params[:data].presence || 'TODAS as datas' %>? Esta ação não poderá ser desfeita.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#aaa',
      confirmButtonText: 'Sim, apagar!',
      cancelButtonText: 'Cancelar'
    }).then((result) => {
      if (result.isConfirmed) {
        document.getElementById("clear-logs-form").submit();
      }
    });
  });
</script>
