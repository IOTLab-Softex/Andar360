<h1 class="subtitle">Logs de Importação</h1>

<%= form_with url: import_logs_path, method: :get, local: true, class: "filter-form" do %>
    <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; flex-wrap: wrap;">
      <div>
        <%= label_tag :data, "Data da Importação" %><br>
        <%= select_tag :data,
          options_for_select([["Todas", ""]] + @datas_disponiveis.map { |d| [d.strftime("%d/%m/%Y"), d] }, params[:data]),
          class: "form-control" %>
      </div>
  
      <div>
        <%= label_tag :filtro, "Tipo" %><br>
        <%= select_tag :filtro,
          options_for_select([
            ["Todos", ""],
            ["Somente Erros", "erro"],
            ["Somente Sucesso", "sucesso"]
          ], params[:filtro]),
          class: "form-control" %>
      </div>
  
      <div style="align-self: flex-end;">
        <%= submit_tag "Filtrar", class: "btn btn-filter" %>
      </div>
    </div>
  <% end %>
  
  
  <% total_sucesso = @import_logs.count { |log| !(log.dados_incompletos || log.sem_foto || log.status == 'erro') } %>
<% total_erro = @import_logs.count { |log| log.dados_incompletos || log.sem_foto || log.status == 'erro' } %>

<div style="text-align: center; margin-bottom: 1rem;">
  <span style="font-size: 1.2rem; margin-right: 2rem;">
    ✔️ Sucesso: <strong><%= total_sucesso %></strong>
  </span>
  <span style="font-size: 1.2rem;">
    ⚠️ Erros: <strong><%= total_erro %></strong>
  </span>
</div>


<div class="rooms">
  <% @import_logs.each do |log| %>
    <% is_error = log.dados_incompletos || log.sem_foto || log.status == 'erro' %>

    <% participant = nil %>
    <% if log.cpf.present? && log.cpf != "Desconhecido" %>
      <% participant = Participant.find_by(cpf: log.cpf) %>
    <% end %>

    <% if participant.nil? %>
      <% participant = Participant.where("LOWER(name) = ?", log.nome.downcase).first %>
    <% end %>

    <div class="participant-card" style="background: <%= is_error ? '#ffe6e6' : '#e0ffe6' %>;">
      <div class="participant-photo">
        <div class="photo-wrapper" style="font-size: 2rem;">
          <% if is_error %>
            ⚠️
          <% else %>
            ✔️
          <% end %>
        </div>
      </div>

      <div class="participant-info">
        <strong style="color: var(--color-btn--text);"><%= log.nome %></strong><br>
        CPF: <%= log.cpf %><br>
        Status: <%= log.status.capitalize %><br>
        <span style="font-size: 0.9rem;">Mensagem: <%= truncate(log.mensagem, length: 100) %></span><br><br>

        <% if log.dados_incompletos %>
          <span class="participant-tag">Dados incompletos</span>
        <% end %>

        <% if log.sem_foto %>
          <span class="participant-tag">Sem foto</span>
        <% end %>

        <div style="font-size: 0.8rem; margin-top: 0.5rem; color: #666;">
          Registrado em: <%= log.created_at.strftime("%d/%m/%Y %H:%M") %>
        </div>

        <% if is_error && participant.present? %>
          <div style="margin-top: 0.5rem;">
            <%= link_to edit_participant_path(participant), class: "btn edit" do %>
              <i class="fa-solid fa-pen-to-square"></i> Ajustar Usuário
            <% end %>
          </div>
        <% elsif is_error %>
          <div style="margin-top: 0.5rem; color: #b00; font-size: 0.85rem;">
            ⚠️ Participante não encontrado
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>


