<style>
  .rooms {
    overflow: hidden;
    transition: height 0.4s ease;
    height: 0;
  }

  .rooms.collapsed {
    height: 0 !important;
  }

  .rooms.expanded {
    /* apenas usado no load inicial para abrir automaticamente */
  }

  .rooms.auto-height {
    height: auto !important;
  }

  .rooms.hidden {
    display: none !important;
  }
</style>
<div id="dashboard-page-marker"></div>
<% manut_last = @manutencao_programadas.map(&:updated_at).compact.max&.to_i || 0 %>
<% cham_last  = @chamados.map(&:updated_at).compact.max&.to_i || 0 %>
<% rooms_last = @rooms.map(&:updated_at).compact.max&.to_i || 0 %>
<% total_chamados = (@chamados_counts || {}).values.sum rescue 0 %>
<div id="dashboard-snapshot"
     data-hash="<%= [manut_last, cham_last, rooms_last, total_chamados].join('-') %>"></div>
<%= audio_tag "notify_new.mp3",
      id: "notify-new",
      preload: "auto",
      style: "display:none;" %>
<%= render "dashboard/kpis" %>
<div class="board-grid" id="dashboard-board-grid" data-save-url="<%= update_dashboard_card_order_path %>">
  <% Array(@dashboard_card_order).each do |card_id| %>
    <% case card_id %>
    <% when "chamados" %>
      <section id="card-chamados" class="board-card col-12 col-6" data-card-id="chamados">
        <%= render "dashboard/chamados", chamados: @chamados %>
      </section>
    <% when "manutencoes" %>
      <section id="card-manutencoes" class="board-card col-12 col-6" data-card-id="manutencoes">
        <%= render "dashboard/manutencoes",
              manutencoes: @manutencao_programadas,
              ack_ns: @ack_ns, avisos_tokens: @avisos_tokens, avisos: @avisos_manutencao %>
      </section>
    <% when "salas" %>
      <% if current_user.admin? || current_user.role == "operador" %>
        <section id="card-salas" class="board-card col-12 col-6" data-card-id="salas">
          <%= render "dashboard/salas", rooms: @rooms %>
        </section>
      <% end %>
    <% when "espacos" %>
      <section id="card-espacos" class="board-card col-12 col-6" data-card-id="espacos">
        <%= render "dashboard/espacos_comuns", rooms: @rooms.select(&:espaco_comun?) %>
      </section>
    <% end %>
  <% end %>
</div>
<% if @avisos_manutencao.present? %>
  <div id="modalAvisos"
       class="modal-custom"
       style="display:none;"
       data-items="<%= (@avisos_tokens || []).to_json %>"
data-ns="<%= @ack_ns %>">
    <div class="modal-dialog" style="max-width: 600px;">
      <div class="modal-content">
        <div class="modal-header">
          <h5 style="color: black !important;"><i class="fa-solid fa-triangle-exclamation"></i> Atenção: Manutenções Próximas</h5>
          <button type="button" class="close-modal" onclick="document.getElementById('modalAvisos').style.display = 'none'">&times;</button>
        </div>
        <div class="modal-body">
          <% @avisos_manutencao.each do |m| %>
            <div class="mb-4 p-3" style="border-left: 4px solid #007bff; background: #f8f9fa; border-radius: 4px;">
              <p class="p"><strong class="strong">Data Prevista:</strong> <%= m.data_prevista.strftime('%d/%m/%Y') %></p>
              <p class="p"><strong class="strong">Título:</strong> <%= m.titulo %></p>
              <p class="p"><strong class="strong">Periodicidade:</strong> <%= m.periodicidade.presence || 'Não definida' %></p>
              <p class="p"><strong class="strong">Local:</strong> <%= m.local.presence || '-' %></p>
              <p class="p"><strong class="strong">Observação:</strong><br>
                <%= m.observacao.presence || 'Nenhuma observação' %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
      <div class="text-end mt-3">
        <button class="btn btn-secondary" onclick="document.getElementById('modalAvisos').style.display = 'none'">
          OK, Entendi
        </button>
      </div>
    </div>
  </div>
<% end %>
<%= render "shared/push_permission_modal" %>
