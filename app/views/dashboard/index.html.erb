<style>
  .rooms {
    overflow: hidden;
    transition: height 0.4s ease;
    height: 0;
  }

  .rooms.collapsed {
    height: 0 !important;
  }

  .rooms.expanded {
    /* apenas usado no load inicial para abrir automaticamente */
  }

  .rooms.auto-height {
    height: auto !important;
  }

  .rooms.hidden {
    display: none !important;
  }
</style>

<%# --- CARDS (DASHBOARD) --- %>
<div class="kpi-grid">
<% if current_user.admin? || current_user.role == "operador" %>
  <%= kpi_card("fa-solid fa-helmet-safety", "Próximas Manutenções",
               @kpis[:manutencoes_pendentes], "Próximas a partir de hoje") %>
<% end %>
<%= kpi_card("fa-solid fa-calendar-check", "Reservas hoje",
             @kpis[:reservas_hoje],
             (@kpis[:reservas_series_label] || nil),
             sparkline: @kpis[:reservas_series]) %>


  <%= kpi_card("fa-solid fa-chart-line", "Ocupação (estimativa)",
               "#{@kpis[:ocupacao_hoje]}%", "Sobre total de unidades") %>

<%= kpi_card("fa-solid fa-ticket", "Chamados abertos",
             @chamados_counts[:total_abertos],
             "Críticos abertos: #{@chamados_counts[:criticos_abertos]}") %>


  <%# ---- Card de Feedbacks: só para admin ---- %>
<% if current_user.admin? %>
  <%= kpi_card(
        "fa-solid fa-comments",
        "Feedbacks pendentes",
        (@kpis[:feedbacks_pendentes] || 0),
        "Total: #{@kpis[:feedbacks_total] || 0} • 7d: #{@kpis[:feedbacks_7d] || 0}",
        url: feedbacks_path
      ) %>
<% end %>


<% if current_user.admin? || current_user.client? %>
  <%= kpi_card(
        "fa-solid fa-user-pen",
        (current_user.client? ? "Cadastros pendentes (Aguardando...)" : "Cadastros pendentes"),
        (@kpis[:fc_pendentes] || 0),
        "Aguardando aprovação",
        sparkline: @kpis[:fc_series]
      ) %>
<% end %>


  <%# ---- Card de Encomendas: para qualquer usuário que tenha grupo_empresa ---- %>
 <% if @kpis.key?(:encomendas_pendentes) %>
  <% titulo_encomendas =
      (@kpis[:encomendas_label] == "todas" ?
        "Encomendas na Portaria" :
        "Encomendas para você (Portaria)") %>

  <%= kpi_card("fa-solid fa-box",
               titulo_encomendas,
               @kpis[:encomendas_pendentes],
               "Últimos 7d: #{@kpis[:encomendas_7d] || 0}") %>
<% end %>

</div>

<div class="board-grid">
  <section id="card-manutencoes" class="board-card col-12 col-6">
    <%= render "dashboard/manutencoes",
          manutencoes: @manutencao_programadas,
          ack_ns: @ack_ns, avisos_tokens: @avisos_tokens, avisos: @avisos_manutencao %>
  </section>

  <section id="card-chamados" class="board-card col-12 col-6">
    <%= render "dashboard/chamados", chamados: @chamados %>
  </section>

  <% if current_user.admin? || current_user.role == "operador" %>
    <section id="card-salas" class="board-card col-12 col-6">
      <%= render "dashboard/salas", rooms: @rooms %>
    </section>
  <% end %>

  <section id="card-espacos" class="board-card col-12 col-6">
    <%= render "dashboard/espacos_comuns", rooms: @rooms.select(&:espaco_comun?) %>
  </section>
</div>






<% if @avisos_manutencao.present? %>
  <div id="modalAvisos"
       class="modal-custom"
       style="display:none;"
       data-items="<%= (@avisos_tokens || []).to_json %>"
data-ns="<%= @ack_ns %>">
    <div class="modal-dialog" style="max-width: 600px;">
      <div class="modal-content">
        <div class="modal-header">
          <h5 style="color: var(--color-btn);"><i class="fa-solid fa-triangle-exclamation"></i> Atenção: Manutenções Próximas</h5>
          <button type="button" class="close-modal" onclick="document.getElementById('modalAvisos').style.display = 'none'">&times;</button>
        </div>
        <div class="modal-body">
          <% @avisos_manutencao.each do |m| %>
            <div class="mb-4 p-3" style="border-left: 4px solid #007bff; background: #f8f9fa; border-radius: 4px;">
              <p class="p"><strong class="strong">Data Prevista:</strong> <%= m.data_prevista.strftime('%d/%m/%Y') %></p>
              <p class="p"><strong class="strong">Título:</strong> <%= m.titulo %></p>
              <p class="p"><strong class="strong">Periodicidade:</strong> <%= m.periodicidade.presence || 'Não definida' %></p>
              <p class="p"><strong class="strong">Local:</strong> <%= m.local.presence || '-' %></p>
              <p class="p"><strong class="strong">Observação:</strong><br>
                <%= m.observacao.presence || 'Nenhuma observação' %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
      <div class="text-end mt-3">
        <button class="btn btn-secondary" onclick="document.getElementById('modalAvisos').style.display = 'none'">
          OK, Entendi
        </button>
      </div>
    </div>
  </div>
<% end %>
<style>
  .strong {
    color: black;
  }
  .p {
    color: black !important;
  }
    #modalAvisos.modal-custom {
      position: fixed;
    z-index: 9999;
    top: 0;
    left: 0;
    width: -webkit-fill-available;
    height: -webkit-fill-available;
    background: rgba(0, 0, 0, 0.7);
    display: flex
;
    align-items: center;
    justify-content: center;

    }
    #modalAvisos .modal-dialog {
      background: #fff;
      border-radius: 10px;
      padding: 20px;
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.4);
      animation: fadeInScale 0.3s ease-out;
      position: absolute;
      color: var(--color-btn--text);

    }

    #modalAvisos .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #ddd;
    }

    #modalAvisos .modal-header h5 {
      margin: 0;
    }

    #modalAvisos .close-modal {
      background: none;
      border: none;
      font-size: 1.5rem;
      color: #333;
      cursor: pointer;
    }

    @keyframes fadeInScale {
      from {
        opacity: 0;
        transform: scale(0.92);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

     /* GRID de cards (lado a lado no desktop, empilha no mobile) */
  .board-grid{
    display:grid; gap:16px;
    grid-template-columns: repeat(12, 1fr);
    margin-top: 1rem;
  }
  .col-12{grid-column: span 12;}
  @media (min-width: 992px){ .col-6{grid-column: span 6;} }
  @media (min-width: 1400px){ .col-4{grid-column: span 4;} }

  .board-card{
    background: var(--color-card);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 14px;
    box-shadow: 0 6px 18px rgba(0,0,0,.18);
    overflow: hidden;
  }
  /* Faz o h2 do partial parecer cabeçalho do card */
  .board-card .subtitle{
    display:flex; align-items:center; gap:.6rem;
    justify-content: space-between;
    margin:0; padding:12px 16px;
    background: rgba(255,255,255,.03);
    border-bottom: 1px solid rgba(255,255,255,.06);
    cursor: pointer;
  }
  .board-card .rooms{ padding: 12px; }

  /* Não esticar os itens do grid: cada card fica só com a própria altura */
.board-grid { align-items: start; }

/* (opcional) garante que um card específico não estique */
.board-card { align-self: start; }

/* (opcional) zera espaço interno quando estiver colapsado/hidden */
.rooms.collapsed,
.rooms.hidden {
  height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* 1) Trilhas do grid encolhíveis (mantém 50/50 sempre) */
.board-grid{
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(12, minmax(0, 1fr)); /* <- antes era 1fr puro */
  align-items: start;
}

/* 2) Cada card pode encolher sem empurrar a coluna vizinha */
.board-card{ align-self: start; min-width: 0; }

/* 3) Quando colapsado, o conteúdo não participa do layout */
.rooms{ overflow: hidden; contain: layout paint; }
.rooms.collapsed,
.rooms.hidden{
  height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  content-visibility: hidden;   /* não mede conteúdo fechado */
  contain: size layout;         /* isola do cálculo de tamanho */
}

/* 4) Tabelas largas: rolagem interna ao card (não estoura a coluna) */
.board-card .rooms:not(.collapsed){ overflow-x: auto; }
.board-card .rooms table{ width: 100%; table-layout: fixed; }
.board-card .rooms th,
.board-card .rooms td{ white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

/* ocultar tabelas para mibile */

@media (max-width: 992px) {
  .table-salas .hide-md { display: none; }
}

/* até 768px (celular): esconda o que marcar com .hide-sm */
@media (max-width: 768px) {
  .table-salas .hide-sm { display: none; }
}

/*********/
</style>
<script>
  function toggleSection(id, headerElement) {
    const section = document.getElementById(id);
    const icon = headerElement.querySelector("i");
    const isCollapsed = section.classList.contains('collapsed');

    if (isCollapsed) {
      // EXPANDIR
      section.classList.remove("collapsed", "hidden");
      headerElement.classList.remove("collapsed");
      section.style.height = section.scrollHeight + "px";

      section.addEventListener("transitionend", function handler() {
        section.style.height = "auto";
        section.removeEventListener("transitionend", handler);
      });

      localStorage.setItem(`section-${id}`, 'expanded');
    } else {
      // RECOLHER
      section.style.height = section.scrollHeight + "px";

      requestAnimationFrame(() => {
        section.style.height = "0px";
      });

      section.addEventListener("transitionend", function handler() {
        section.classList.add("collapsed", "hidden");
        section.style.height = null;
        section.removeEventListener("transitionend", handler);
      });

      headerElement.classList.add("collapsed");
      localStorage.setItem(`section-${id}`, 'collapsed');
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".rooms").forEach((section) => {
      const id = section.id;
      const savedState = localStorage.getItem(`section-${id}`);
      const header = document.querySelector(`h2[onclick*="${id}"]`);

      if (savedState === 'collapsed') {
        section.classList.add("collapsed", "hidden");
        if (header) header.classList.add("collapsed");
      } else {
        // estado padrão é expandido
        section.classList.remove("collapsed", "hidden");
        if (header) header.classList.remove("collapsed");
        section.style.height = section.scrollHeight + "px";
        setTimeout(() => section.style.height = "auto", 400);
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
  const modal = document.getElementById('modalAvisos');
  if (!modal) return;

  // Limpa chaves legadas globais (compatibilidade)
  localStorage.removeItem('modalAvisosOculto');
  localStorage.removeItem('modalAvisosOcultoKey');

  // Namespace por usuário (ex.: "u12")
  const ns = modal.dataset.ns || '';

  // Utilitário de chave namespaced
  const k = (tok) => `${ns}:manutAck:${tok}`;

  // Lê tokens passados pelo backend
  let tokens = [];
  try { tokens = JSON.parse(modal.dataset.items || "[]"); } catch(e) { tokens = []; }
  if (!tokens.length) return;

  // Compat: se existir ACK antigo sem namespace, migra p/ namespaced
  tokens.forEach((t) => {
    const oldKey = `manutAck:${t}`;
    if (localStorage.getItem(oldKey) === '1' && localStorage.getItem(k(t)) !== '1') {
      localStorage.setItem(k(t), '1');
      localStorage.removeItem(oldKey);
    }
  });

  // Verifica se há pelo menos um token ainda não reconhecido p/ ESTE usuário
  const isAcked = (t) => localStorage.getItem(k(t)) === '1';
  const algumPendente = tokens.some((t) => !isAcked(t));

  if (algumPendente) {
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('active'), 50);
  }

  // Botão "OK, Entendi" → marca ACK para TODOS os tokens atuais (apenas p/ ESTE usuário)
  modal.querySelector('.btn.btn-secondary')?.addEventListener('click', () => {
    modal.classList.remove('active');
    setTimeout(() => {
      modal.style.display = 'none';
      tokens.forEach((t) => localStorage.setItem(k(t), '1'));
    }, 300);
  });

  // Botão fechar (X) → fecha sem ACK (volta em próximo load se ainda houver pendente)
  modal.querySelector('.close-modal')?.addEventListener('click', () => {
    modal.classList.remove('active');
    setTimeout(() => { modal.style.display = 'none'; }, 300);
  });
  });



  document.querySelectorAll(".marcar-todos-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const tipo = btn.dataset.tipo;
      const linhas = document.querySelectorAll(`tr[id^="${tipo}-"]`);
      const ids = [];

      linhas.forEach((linha) => {
        const idMatch = linha.id.match(/(\d+)$/);
        if (linha.querySelector(".dot-ativo") && idMatch) {
          ids.push(idMatch[1]);
          linha.classList.remove("linha-atualizada");
          const dot = linha.querySelector(".dot-ativo");
          if (dot) dot.remove();
        }
      });

      // Envia para o backend
      if (ids.length > 0) {
        fetch("/marcar_todos_como_visualizados", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
          },
          body: JSON.stringify({ tipo, ids })
        });
      }

      // Atualiza ícone do botão
      const icon = btn.querySelector(".fa-eye");
      if (icon) {
        icon.classList.add("fa-eye-slash");
        icon.classList.remove("fa-eye");
      }

      // Esconde o botão e o dot principal do título
      const header = btn.closest("h2");
      const dotHeader = header?.querySelector(".dot-ativo");
      if (dotHeader) dotHeader.remove();
      btn.remove();
    });
  });
</script>
