  .rooms.collapsed,
  .rooms.hidden{
  height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  content-visibility: hidden;   /* não mede conteúdo fechado */
  contain: size layout;         /* isola do cálculo de tamanho */
  }

  /* 4) Tabelas largas: rolagem interna ao card (não estoura a coluna) */
  .board-card .rooms:not(.collapsed){ overflow-x: auto; }
  .board-card .rooms table{ width: 100%; table-layout: fixed; }
