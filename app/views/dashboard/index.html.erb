</style>
<script>
  function toggleSection(id, headerElement) {
    const section = document.getElementById(id);
    const icon = headerElement.querySelector("i");
    const isCollapsed = section.classList.contains('collapsed');

    if (isCollapsed) {
      // EXPANDIR
      section.classList.remove("collapsed", "hidden");
      headerElement.classList.remove("collapsed");
      section.style.height = section.scrollHeight + "px";

      section.addEventListener("transitionend", function handler() {
        section.style.height = "auto";
        section.removeEventListener("transitionend", handler);
      });

      localStorage.setItem(`section-${id}`, 'expanded');
    } else {
      // RECOLHER
      section.style.height = section.scrollHeight + "px";

      requestAnimationFrame(() => {
        section.style.height = "0px";
      });

      section.addEventListener("transitionend", function handler() {
        section.classList.add("collapsed", "hidden");
        section.style.height = null;
        section.removeEventListener("transitionend", handler);
      });

      headerElement.classList.add("collapsed");
      localStorage.setItem(`section-${id}`, 'collapsed');
    }
  }

    // função global para (re)inicializar o estado das .rooms
  // função global para (re)inicializar o estado das .rooms
  window.initDashboardRooms = function() {
  const firstRun = !document.body.dataset.roomsInitialized; // true só na 1ª vez

  document.querySelectorAll(".rooms").forEach((section) => {
    const id = section.id;
    if (!id) return;

    const savedState = localStorage.getItem(`section-${id}`);
    const header = document.querySelector(`h2[onclick*="${id}"]`);

    // na primeira passada, desliga a animação
    if (firstRun) {
      section.classList.add("no-anim");
    }

    const wantCollapsed = (savedState === 'collapsed');

    if (wantCollapsed) {
      // manter fechado
      section.classList.add("collapsed", "hidden");
      if (header) header.classList.add("collapsed");
      section.style.height = "0px";
    } else {
      // manter aberto
      section.classList.remove("collapsed", "hidden");
      if (header) header.classList.remove("collapsed");

      // se for primeiro load: sem animação → direto auto
      // se for chamado depois (refresh live), aí pode animar se quiser
      section.style.height = "auto";
    }

    // depois de aplicar o estado no primeiro load, reativa animação
    if (firstRun) {
      requestAnimationFrame(() => {
        section.classList.remove("no-anim");
      });
    }
  });

  // marca que já inicializou uma vez
  document.body.dataset.roomsInitialized = "1";
  };


  // roda ao carregar a página normalmente e com Turbo
  document.addEventListener("DOMContentLoaded", window.initDashboardRooms);
  document.addEventListener("turbo:load", window.initDashboardRooms);


  // helper global de cookie
  function setCookie(name, value, days) {
    let expires = "";
    if (days) {
      const date = new Date();
      date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
      expires = "; expires=" + date.toUTCString();
    }
    document.cookie = name + "=" + (value || "") + expires + "; path=/";
  }

  // função global para ligar os botões "Marcar todas como vistas"
  window.initMarkAllButtons = function() {
    document.querySelectorAll(".marcar-todos-btn").forEach((btn) => {
      // evita duplicar listener quando a função é chamada várias vezes
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";

      btn.addEventListener("click", (e) => {
        e.preventDefault();

        const tipo = btn.dataset.tipo; // "chamado" ou "manutencao"
        const linhas = document.querySelectorAll(`tr[id^="${tipo}-"]`);
        const ids = [];
        const timestampSeconds = Math.floor(Date.now() / 1000);

        linhas.forEach((linha) => {
          const idMatch = linha.id.match(/(\d+)$/);
          if (!idMatch) return;

          const id = idMatch[1];
          ids.push(id);

          // 1. Salva o cookie (bate com o helper visualizado_pelo_usuario?)
          setCookie(`${tipo}-${id}`, timestampSeconds, 365);

          // 2. Remove classes de destaque da linha
          linha.classList.remove(
            "linha-atualizada",
            "table-success",
            "table-warning",
            "bg-success-subtle"
          );

          // 3. Remove o pontinho, se tiver
          const dot = linha.querySelector(".dot-ativo");
          if (dot) dot.remove();
        });

        // 4. Backend opcional (log/audit)
        if (ids.length > 0) {
          fetch("/marcar_todos_como_visualizados", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
            },
            body: JSON.stringify({ tipo, ids })
          }).catch((e) => console.error("Erro no backend:", e));
        }

        // 5. Atualiza botão e remove dot do título
        const icon = btn.querySelector("i");
        if (icon) {
          icon.classList.remove("fa-eye");
          icon.classList.add("fa-check");
        }
        btn.innerText = "Vistas!";
        btn.disabled = true;
        setTimeout(() => btn.remove(), 800);

        const header = btn.closest("h2");
        const dotHeader = header?.querySelector(".dot-ativo");
        if (dotHeader) dotHeader.remove();
      });
    });
  };

  // roda no load normal / navegação Turbo
  document.addEventListener("DOMContentLoaded", window.initMarkAllButtons);
  document.addEventListener("turbo:load", window.initMarkAllButtons);

  window.initDashboardCardOrdering = function() {
    const grid = document.getElementById("dashboard-board-grid");
    if (!grid) return;

    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content;
    let draggedCard = null;
    let dragGhost = null;
    let dragOffsetX = 0;
    let dragOffsetY = 0;
    let ghostTargetX = 0;
    let ghostTargetY = 0;
    let ghostCurrentX = 0;
    let ghostCurrentY = 0;
    let ghostAnimationFrame = null;

    function saveOrder() {
      const order = Array.from(grid.querySelectorAll(".board-card[data-card-id]"))
        .map((card) => card.dataset.cardId)
        .filter(Boolean);

      fetch(grid.dataset.saveUrl, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": csrfToken
        },
        credentials: "same-origin",
        body: JSON.stringify({ order: order })
      }).catch(() => {});
    }

    function pointerPosition(event) {
      if (event.touches && event.touches[0]) {
        return { x: event.touches[0].clientX, y: event.touches[0].clientY };
      }
      if (event.changedTouches && event.changedTouches[0]) {
        return { x: event.changedTouches[0].clientX, y: event.changedTouches[0].clientY };
      }
      return { x: event.clientX, y: event.clientY };
    }

    function renderGhost() {
      if (!dragGhost) return;
      ghostCurrentX += (ghostTargetX - ghostCurrentX) * 0.28;
      ghostCurrentY += (ghostTargetY - ghostCurrentY) * 0.28;
      dragGhost.style.transform = `translate3d(${ghostCurrentX}px, ${ghostCurrentY}px, 0)`;

      if (Math.abs(ghostTargetX - ghostCurrentX) > 0.5 || Math.abs(ghostTargetY - ghostCurrentY) > 0.5) {
        ghostAnimationFrame = requestAnimationFrame(renderGhost);
      } else {
        ghostCurrentX = ghostTargetX;
        ghostCurrentY = ghostTargetY;
        dragGhost.style.transform = `translate3d(${ghostCurrentX}px, ${ghostCurrentY}px, 0)`;
        ghostAnimationFrame = null;
      }
    }

    function moveGhost(clientX, clientY) {
      ghostTargetX = clientX - dragOffsetX;
      ghostTargetY = clientY - dragOffsetY;
      if (!ghostAnimationFrame) {
        ghostAnimationFrame = requestAnimationFrame(renderGhost);
      }
    }

    function reorderFromPointer(clientY) {
      if (!draggedCard) return;

      const otherCards = Array.from(grid.querySelectorAll(".board-card[data-card-id]"))
        .filter((card) => card !== draggedCard);

      let targetCard = null;
      for (const card of otherCards) {
        const rect = card.getBoundingClientRect();
        const middleY = rect.top + rect.height / 2;
        if (clientY < middleY) {
          targetCard = card;
          break;
        }
      }

      otherCards.forEach((card) => card.classList.remove("drag-over"));

      if (targetCard) {
        targetCard.classList.add("drag-over");
        if (targetCard.previousElementSibling !== draggedCard) {
          targetCard.insertAdjacentElement("beforebegin", draggedCard);
        }
      } else {
        const lastCard = otherCards[otherCards.length - 1];
        if (lastCard && lastCard.nextElementSibling !== draggedCard) {
          lastCard.insertAdjacentElement("afterend", draggedCard);
        }
      }
    }

    function finishDrag() {
      if (!draggedCard) return;
      draggedCard.classList.remove("dragging");
      document.body.classList.remove("dashboard-card-dragging");
      grid.querySelectorAll(".board-card.drag-over").forEach((item) => item.classList.remove("drag-over"));
      if (dragGhost) {
        dragGhost.remove();
        dragGhost = null;
      }
      if (ghostAnimationFrame) {
        cancelAnimationFrame(ghostAnimationFrame);
        ghostAnimationFrame = null;
      }
      draggedCard = null;
      saveOrder();
      document.removeEventListener("mousemove", handlePointerMove);
      document.removeEventListener("mouseup", handlePointerUp);
      document.removeEventListener("touchmove", handlePointerMove);
      document.removeEventListener("touchend", handlePointerUp);
      document.removeEventListener("touchcancel", handlePointerUp);
    }

    function handlePointerMove(event) {
      if (!draggedCard) return;
      if (event.cancelable) event.preventDefault();
      const { x, y } = pointerPosition(event);
      moveGhost(x, y);
      reorderFromPointer(y);
    }

    function handlePointerUp() {
      finishDrag();
    }

    function bindCard(card) {
      if (!card || card.dataset.dragBound === "1") return;
      card.dataset.dragBound = "1";

      const subtitle = card.querySelector(".subtitle");
      if (subtitle && !subtitle.querySelector(".card-drag-handle")) {
        const handle = document.createElement("button");
        handle.type = "button";
        handle.className = "card-drag-handle";
        handle.title = "Segure e arraste para mover o card";
        handle.setAttribute("aria-label", "Mover card");
        handle.innerHTML = '<i class="fa-solid fa-up-down-left-right"></i>';

        handle.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
        });

        handle.addEventListener("mousedown", (event) => {
          event.preventDefault();
          event.stopPropagation();
          const rect = card.getBoundingClientRect();
          const handleRect = handle.getBoundingClientRect();
          const { x, y } = pointerPosition(event);
          draggedCard = card;
          card.classList.add("dragging");
          document.body.classList.add("dashboard-card-dragging");
          dragOffsetX = Math.min(handleRect.width / 2, 18);
          dragOffsetY = Math.min(y - rect.top, 28);

          dragGhost = card.cloneNode(true);
          dragGhost.classList.add("dashboard-drag-ghost");
          dragGhost.classList.remove("dragging", "drag-over");
          dragGhost.removeAttribute("id");
          dragGhost.style.width = `${rect.width}px`;
          document.body.appendChild(dragGhost);
          ghostCurrentX = x - dragOffsetX;
          ghostCurrentY = y - dragOffsetY;
          dragGhost.style.transform = `translate3d(${ghostCurrentX}px, ${ghostCurrentY}px, 0)`;
          moveGhost(x, y);

          document.addEventListener("mousemove", handlePointerMove);
          document.addEventListener("mouseup", handlePointerUp);
        });

        handle.addEventListener("touchstart", (event) => {
          event.preventDefault();
          event.stopPropagation();
          const rect = card.getBoundingClientRect();
          const handleRect = handle.getBoundingClientRect();
          const { x, y } = pointerPosition(event);
          draggedCard = card;
          card.classList.add("dragging");
          document.body.classList.add("dashboard-card-dragging");
          dragOffsetX = Math.min(handleRect.width / 2, 18);
          dragOffsetY = Math.min(y - rect.top, 28);

          dragGhost = card.cloneNode(true);
          dragGhost.classList.add("dashboard-drag-ghost");
          dragGhost.classList.remove("dragging", "drag-over");
          dragGhost.removeAttribute("id");
          dragGhost.style.width = `${rect.width}px`;
          document.body.appendChild(dragGhost);
          ghostCurrentX = x - dragOffsetX;
          ghostCurrentY = y - dragOffsetY;
          dragGhost.style.transform = `translate3d(${ghostCurrentX}px, ${ghostCurrentY}px, 0)`;
          moveGhost(x, y);

          document.addEventListener("touchmove", handlePointerMove, { passive: false });
          document.addEventListener("touchend", handlePointerUp);
          document.addEventListener("touchcancel", handlePointerUp);
        });

        subtitle.appendChild(handle);
      }
    }

    grid.querySelectorAll(".board-card[data-card-id]").forEach(bindCard);
  };

  document.addEventListener("DOMContentLoaded", window.initDashboardCardOrdering);
  document.addEventListener("turbo:load", window.initDashboardCardOrdering);







  document.addEventListener('DOMContentLoaded', () => {
  const wrap = document.querySelector('.kpi-scroll-wrap');
  const grid = document.querySelector('.kpi-grid');

  if (!grid) return;

  // Para acessibilidade e performance: só ativa setas se wrapper existir
  const prevBtn = wrap?.querySelector('.kpi-prev') ?? null;
  const nextBtn = wrap?.querySelector('.kpi-next') ?? null;

  // função utilitária para verificar overflow horizontal
  function hasOverflowX(el) {
    return el.scrollWidth > el.clientWidth + 1; // margem pequena
  }

  // atualiza estado das setas (desabilita quando no começo/fim)
  function updateArrows() {
    if (!prevBtn || !nextBtn) return;
    const maxScrollLeft = grid.scrollWidth - grid.clientWidth;
    prevBtn.disabled = grid.scrollLeft <= 2;
    nextBtn.disabled = grid.scrollLeft >= maxScrollLeft - 2;
  }

  // rola por um "passo" — largura do primeiro card (ou fallback)
  function scrollStep(direction = 1) {
    const firstCard = grid.querySelector('.kpi-grid > *') || grid.children[0];
    let step = 240; // fallback
    if (firstCard) {
      const style = window.getComputedStyle(firstCard);
      const marginRight = parseFloat(style.marginRight || 0);
      step = Math.ceil(firstCard.getBoundingClientRect().width + marginRight);
    }
    grid.scrollBy({ left: step * direction, behavior: 'smooth' });
  }

  // attach button handlers
  if (prevBtn) prevBtn.addEventListener('click', () => { scrollStep(-1); });
  if (nextBtn) nextBtn.addEventListener('click', () => { scrollStep(1); });

  // update arrow state on scroll & resize
  grid.addEventListener('scroll', () => updateArrows());
  window.addEventListener('resize', () => {
    // espera o resize estabilizar
    setTimeout(() => updateArrows(), 120);
  });

  // inicializa visibilidade: se não overflow, esconde as setas
  if (wrap && (prevBtn && nextBtn)) {
    if (!hasOverflowX(grid)) {
      prevBtn.style.display = 'none';
      nextBtn.style.display = 'none';
    } else {
      prevBtn.style.display = '';
      nextBtn.style.display = '';
      // garantir estado inicial das setas
      updateArrows();
    }
  }

  // opcional: animação de entrada apenas quando o grid estiver visível (poll curto)
  // garante que as cards disparem a animação após estarem renderizados
  setTimeout(() => {
    grid.querySelectorAll(':scope > *').forEach((card) => {
      // forçar recomposição para garantir animação
      card.style.opacity = '';
      card.style.transform = '';
    });
  }, 50);
  });


    (function() {
    function onReady(fn) {
      if (document.readyState === "complete" || document.readyState === "interactive") {
        fn();
      } else {
        document.addEventListener("DOMContentLoaded", fn);
      }
      document.addEventListener("turbo:load", fn);
    }

    // chave de persistência (pode trocar o nome se quiser)
    const LIVE_KEY = "dashboard-live-enabled";

    // ---------- SOM E SNAPSHOT ----------
    let lastSnapshot = null;

    function getCurrentSnapshot() {
      const el = document.getElementById("dashboard-snapshot");
      if (!el) return "";
      return el.dataset.hash || "";
    }

    function playNotifySound() {
      const audio = document.getElementById("notify-new");
      if (!audio) return;
      try {
        audio.currentTime = 0;
        audio.play().catch(() => {});
      } catch (e) {
        console.warn("[dashboard-live] erro ao tocar som:", e);
      }
    }

    function checkSnapshotChange() {
      const current = getCurrentSnapshot();
      if (!current) return;

      if (lastSnapshot && current !== lastSnapshot) {
        // houve mudança → toca som
        playNotifySound();
      }
      lastSnapshot = current;
    }
    // -------------------------------------

    // -------------------------------------

    // Fallback simples para processar <turbo-stream> mesmo sem Turbo
    function applyTurboStreamManualmente(html) {
      const template = document.createElement('template');
      template.innerHTML = html.trim();

      const streams = template.content.querySelectorAll('turbo-stream');
      if (!streams.length) {
        console.warn("[dashboard-live] nenhum <turbo-stream> encontrado na resposta");
        return;
      }

      streams.forEach((stream) => {
        const action = stream.getAttribute('action') || 'replace';
        const targetId = stream.getAttribute('target');
        if (!targetId) return;

        const target = document.getElementById(targetId);
        if (!target) {
          console.warn("[dashboard-live] target não encontrado:", targetId);
          return;
        }

        const tmpl = stream.querySelector('template');
        if (!tmpl) return;

        const newHTML = tmpl.innerHTML.trim();

        if (action === 'replace') {
          // substitui o elemento inteiro
          target.outerHTML = newHTML;
        } else if (action === 'update') {
          // só atualiza o conteúdo interno
          target.innerHTML = newHTML;
        } else if (action === 'remove') {
          target.remove();
        } else if (action === 'append') {
          target.insertAdjacentHTML('beforeend', newHTML);
        } else if (action === 'prepend') {
          target.insertAdjacentHTML('afterbegin', newHTML);
        } else {
          console.warn("[dashboard-live] ação turbo-stream não tratada:", action);
        }
      });
          // depois de aplicar os turbo-streams, re-inicializa as rooms
    if (window.initDashboardRooms) {
      window.initDashboardRooms();
    }

    // re-liga os botões "marcar todas"
    if (window.initMarkAllButtons) {
      window.initMarkAllButtons();
    }
    }

    onReady(function() {
            const marker = document.getElementById("dashboard-page-marker");
      if (!marker) {
        console.log("[dashboard-live] marker não encontrado, não é a página de dashboard");
        return;
      }

      // todos os botões que controlam o monitoramento
      const toggleButtons = Array.from(
        document.querySelectorAll('[data-monitor-toggle="dashboard"]')
      );

      if (toggleButtons.length === 0) {
        console.log("[dashboard-live] nenhum botão de monitoramento encontrado");
        return;
      }

      console.log("[dashboard-live] inicializado");

      const REFRESH_MS = 15000;
      let liveEnabled = false;
      let timer = null;
      const body = document.body;

      // atualiza texto/ícone de TODOS os botões
      function updateButtonsUI() {
        toggleButtons.forEach((btn) => {
          const variant = btn.dataset.monitorVariant || "full"; // "full" ou "fab"

          if (liveEnabled) {
            // MODO LIGADO → ícone pause
            if (variant === "fab") {
              btn.innerHTML = '<i class="fa-solid fa-pause"></i>';
            } else {
              btn.innerHTML =
                '<i class="fa-solid fa-pause"></i> Desativar monitoramento em tempo real';
            }
            btn.classList.remove("btn-secondary");
            btn.classList.add("btn-success");
          } else {
            // MODO DESLIGADO → ícone play
            if (variant === "fab") {
              btn.innerHTML = '<i class="fa-solid fa-play"></i>';
            } else {
              btn.innerHTML =
                '<i class="fa-solid fa-play"></i> Ativar monitoramento em tempo real';
            }
            btn.classList.remove("btn-success");
            btn.classList.add("btn-secondary");
          }
        });
      }

      // ao carregar a página, restaura o estado salvo
      const savedLive = localStorage.getItem(LIVE_KEY);
      if (savedLive === "1") {
        liveEnabled = true;
        startLive(); // vai chamar updateButtonsUI por dentro
      } else {
        liveEnabled = false;
        updateButtonsUI();
      }


      function doRefresh() {
        console.log("[dashboard-live] fazendo refresh…");
        fetch("<%= refresh_dashboard_path %>", {
          headers: { "Accept": "text/vnd.turbo-stream.html" }
        })
          .then(resp => {
            console.log("[dashboard-live] status response:", resp.status);
            return resp.text();
          })
                    .then(html => {
            console.log("[dashboard-live] tamanho do turbo-stream:", html.length);
            if (!html.trim()) {
              console.warn("[dashboard-live] resposta vazia do refresh");
              return;
            }

            if (window.Turbo && Turbo.renderStreamMessage) {
              console.log("[dashboard-live] usando Turbo.renderStreamMessage");
              Turbo.renderStreamMessage(html);

              // depois do Turbo aplicar os streams, re-inicializa
              if (window.initDashboardRooms) {
                window.initDashboardRooms();
              }
              if (window.initMarkAllButtons) {
                window.initMarkAllButtons();
              }
              if (window.initDashboardCardOrdering) {
                window.initDashboardCardOrdering();
              }
            } else {
              console.warn("[dashboard-live] Turbo não disponível, aplicando fallback manual");
              applyTurboStreamManualmente(html);
            }

            // depois de atualizar o DOM, verifica se mudou o snapshot
            checkSnapshotChange();
          })

          .catch(err => console.error("[dashboard-live] erro no refresh:", err));
      }

                       function startLive() {
        if (timer) return;

        console.log("[dashboard-live] startLive");

        // guarda snapshot atual como "antes da atualização"
        lastSnapshot = getCurrentSnapshot();

        liveEnabled = true;
        updateButtonsUI();

        // 🔹 marca o body para esconder banner/menu com animação
        if (body) body.classList.add("monitoring-on-dashboard");

        // persiste estado ligado
        localStorage.setItem(LIVE_KEY, "1");

        doRefresh(); // primeira atualização imediata
        timer = setInterval(doRefresh, REFRESH_MS);
      }

      function stopLive() {
        console.log("[dashboard-live] stopLive");
        if (timer) {
          clearInterval(timer);
          timer = null;
        }

        liveEnabled = false;
        updateButtonsUI();

        // 🔹 tira a classe pra trazer o banner/menu de volta
        if (body) body.classList.remove("monitoring-on-dashboard");

        // persiste estado desligado
        localStorage.setItem(LIVE_KEY, "0");
      }




      // todos os botões (inline + FAB) passam a ligar/desligar
      toggleButtons.forEach((btn) => {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          console.log("[dashboard-live] botão clicado; liveEnabled =", liveEnabled);
          if (liveEnabled) {
            stopLive();
          } else {
            startLive();
          }
        });
      });


      document.addEventListener("turbo:before-cache", function() {
        if (timer) clearInterval(timer);
        timer = null;
      }, { once: true });
    });
  })();
</script>
<script>
  (function(){
  const MODAL_KEY = "pushModalDismissed";
  const DURATION_DAYS = 7;
  const REOPEN_MS = 1200; // tempo pra reabrir se tentarem fechar sem "Agora não"

  function now() { return Date.now(); }

  function setDismiss(days){
    try{ localStorage.setItem(MODAL_KEY, String(now() + days*24*60*60*1000)); }catch(e){}
  }

  function isDismissed(){
    try{
      const v = parseInt(localStorage.getItem(MODAL_KEY) || "0", 10);
      return v && now() < v;
    }catch(e){ return false; }
  }

  function openModal(modal){
    modal.hidden = false;
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden","false");
    document.body.classList.add("modal-open");
  }

  function closeModal(modal){
    modal.classList.remove("is-open");
    modal.hidden = true;
    modal.setAttribute("aria-hidden","true");
    document.body.classList.remove("modal-open");
  }

  async function urlBase64ToUint8Array(base64String) {
    const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
    const rawData = atob(base64);
    return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
  }

  async function isPushActive() {
    if (!("Notification" in window)) return false;
    if (Notification.permission !== "granted") return false;
    if (!("serviceWorker" in navigator) || !("PushManager" in window)) return false;

    try{
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.getSubscription();
      return !!sub;
    }catch(e){ return false; }
  }

  async function enablePush(statusEl){
    if (!("Notification" in window)) {
      statusEl.textContent = "Seu navegador não suporta notificações.";
      return false;
    }
    if (Notification.permission === "denied") {
      statusEl.textContent = "Notificações BLOQUEADAS. Clique no cadeado do site e permita Notificações.";
      return false;
    }

    const perm = await Notification.requestPermission();
    if (perm !== "granted") {
      statusEl.textContent = "Permissão não concedida.";
      return false;
    }

    await navigator.serviceWorker.register("/service-worker.js");
    const readyReg = await navigator.serviceWorker.ready;

    const keyRes = await fetch("/push/vapid_public_key");
    if (!keyRes.ok) {
  const txt = await keyRes.text().catch(()=> "");
  statusEl.textContent = `Falha ao obter VAPID Public Key (${keyRes.status}).`;
  console.warn("[push] /push/vapid_public_key erro:", keyRes.status, txt);
  return false;
}
const { publicKey } = await keyRes.json();


    let sub = await readyReg.pushManager.getSubscription();
    if (!sub) {
      sub = await readyReg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: await urlBase64ToUint8Array(publicKey)
      });
    }

    const resp = await fetch("/push_subscriptions", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ subscription: sub })
    });

    if (!resp.ok) {
  const txt = await resp.text().catch(()=> "");
  statusEl.textContent = `Permissão OK, mas o servidor recusou (${resp.status}).`;
  console.warn("[push] /push_subscriptions erro:", resp.status, txt);
  return false;
}


    const confirmSub = await readyReg.pushManager.getSubscription();
    if (!confirmSub) {
      statusEl.textContent = "Permissão ok, mas assinatura Push não ficou ativa.";
      return false;
    }

    statusEl.textContent = "Notificações ativadas ✅";
    return true;
  }

  async function init(){
    const marker = document.getElementById("dashboard-page-marker");
    if (!marker) return;

    const modal = document.getElementById("push-permission-modal");
    if (!modal) return;

    const statusEl  = document.getElementById("push-modal-status");
    const enableBtn = document.getElementById("btn-enable-push");
    const notNowBtn = document.getElementById("btn-push-not-now");
    const backdrop  = modal.querySelector("[data-push-backdrop]");

    // já ativou? não abre
    if (await isPushActive()) return;

    // clicou "Agora não"? respeita
    if (isDismissed()) return;

    // abre sempre
    openModal(modal);

    // função "insistir": se tentar fechar, reabre
    function insist(msg){
      statusEl.textContent = msg || "Para fechar, ative as notificações ou clique em “Agora não”.";
      // se por algum motivo fechou, reabre
      setTimeout(() => {
        if (modal.hidden) openModal(modal);
      }, REOPEN_MS);
    }

    // Clicar fora => NÃO fecha, só insiste
    backdrop?.addEventListener("click", (e)=>{
      e.preventDefault();
      insist();
    });

    // X => NÃO fecha
    modal.querySelectorAll("[data-push-close]").forEach(btn=>{
      btn.addEventListener("click", (e)=>{
        e.preventDefault();
        insist();
      });
    });

    // ESC => NÃO fecha
    document.addEventListener("keydown", (e)=>{
      if (e.key === "Escape" && !modal.hidden) {
        e.preventDefault();
        insist();
      }
    });

    // "Agora não" => fecha e salva
    notNowBtn?.addEventListener("click", ()=>{
      setDismiss(DURATION_DAYS);
      closeModal(modal);
    });

    // "Ativar" => ativa, se ok fecha e não pergunta mais
    enableBtn?.addEventListener("click", async ()=>{
  enableBtn.disabled = true;
  enableBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Ativando...';

  try{
    const ok = await enablePush(statusEl);

    if (ok) {
      setDismiss(3650);
      closeModal(modal);
      return;
    }

    // ❗ NÃO chama insist aqui — deixa o enablePush mostrar o erro real
    enableBtn.disabled = false;
    enableBtn.innerHTML = '<i class="fa-solid fa-bell"></i> Ativar';
  } catch(err){
    statusEl.textContent = "Falha ao ativar push. Veja o Console (F12) para detalhes.";
    enableBtn.disabled = false;
    enableBtn.innerHTML = '<i class="fa-solid fa-bell"></i> Ativar';
    console.error("[push] erro:", err);
  }
});

  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("turbo:load", init);
})();

</script>
  <script>
  function initCommonRoomsCarousel() {
    document.querySelectorAll("#comuns-section.common-stack-carousel[data-common-carousel='true']").forEach((container) => {
      if (container.dataset.commonCarouselBound === "true") return;

      const cards = Array.from(container.querySelectorAll(".common-stack-card"));
      if (!cards.length) return;

      container.dataset.commonCarouselBound = "true";

      const shell = container.querySelector(".common-stack-carousel__shell");
      const prevButton = container.querySelector("[data-common-prev]");
      const nextButton = container.querySelector("[data-common-next]");
      let activeIndex = 0;
      let wheelLocked = false;
      let touchStartX = null;
      const positionClasses = [
        "common-stack-card--far-left",
        "common-stack-card--left",
        "common-stack-card--active",
        "common-stack-card--right",
        "common-stack-card--far-right",
        "isHidden"
      ];

      function relativePosition(index) {
        const count = cards.length;
        let diff = index - activeIndex;
        const half = Math.floor(count / 2);

        if (diff > half) diff -= count;
        if (diff < -half) diff += count;

        return diff;
      }

      function applyClasses() {
        cards.forEach((card, index) => {
          const diff = relativePosition(index);
          card.classList.remove(...positionClasses);

          if (diff === 0) {
            card.classList.add("common-stack-card--active");
          } else if (diff === -1) {
            card.classList.add("common-stack-card--left");
          } else if (diff === 1) {
            card.classList.add("common-stack-card--right");
          } else if (diff === -2 && cards.length > 4) {
            card.classList.add("common-stack-card--far-left");
          } else if (diff === 2 && cards.length > 4) {
            card.classList.add("common-stack-card--far-right");
          } else {
            card.classList.add("isHidden");
          }
        });
      }

      function move(direction) {
        activeIndex = (activeIndex + direction + cards.length) % cards.length;
        applyClasses();
      }

      prevButton?.addEventListener("click", () => move(-1));
      nextButton?.addEventListener("click", () => move(1));

      shell?.addEventListener("wheel", (event) => {
        if (cards.length <= 1) return;

        event.preventDefault();
        if (wheelLocked) return;

        const delta = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
        if (Math.abs(delta) < 10) return;

        wheelLocked = true;
        move(delta > 0 ? 1 : -1);

        window.setTimeout(() => {
          wheelLocked = false;
        }, 420);
      }, { passive: false });

      shell?.addEventListener("touchstart", (event) => {
        touchStartX = event.touches[0]?.clientX ?? null;
      }, { passive: true });

      shell?.addEventListener("touchmove", (event) => {
        if (touchStartX === null || wheelLocked) return;

        const currentX = event.touches[0]?.clientX;
        if (typeof currentX !== "number") return;

        const deltaX = touchStartX - currentX;
        if (Math.abs(deltaX) < 24) return;

        wheelLocked = true;
        move(deltaX > 0 ? 1 : -1);
        touchStartX = currentX;

        window.setTimeout(() => {
          wheelLocked = false;
        }, 420);
      }, { passive: true });

      shell?.addEventListener("touchend", () => {
        touchStartX = null;
      }, { passive: true });

      applyClasses();
    });
  }

  document.addEventListener("DOMContentLoaded", initCommonRoomsCarousel);
  document.addEventListener("turbo:load", initCommonRoomsCarousel);
</script>
