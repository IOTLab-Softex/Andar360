  display: grid;
  gap: 16px;
  grid-template-columns: repeat(12, minmax(0, 1fr)); /* <- antes era 1fr puro */
  align-items: start;
  }

  /* 2) Cada card pode encolher sem empurrar a coluna vizinha */
  .board-card{ align-self: start; min-width: 0; }

  /* 3) Quando colapsado, o conteúdo não participa do layout */
