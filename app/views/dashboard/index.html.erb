  .board-card .rooms{ padding: 12px; }

  /* Não esticar os itens do grid: cada card fica só com a própria altura */
  .board-grid { align-items: start; }

  /* (opcional) garante que um card específico não estique */
  .board-card { align-self: start; }

  /* (opcional) zera espaço interno quando estiver colapsado/hidden */
  .rooms.collapsed,
  .rooms.hidden {
  height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  }

  /* 1) Trilhas do grid encolhíveis (mantém 50/50 sempre) */
