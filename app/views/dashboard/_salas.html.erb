<h2 class="subtitle collapsed" onclick="toggleSection('salas-section', this)">
  SALAS <i class="fa-solid fa-angle-down"></i>
</h2>

<div id="salas-section" class="rooms collapsed">
  <table class="table table-salas">
    <thead class="table-secondary text-dark">
      <tr>
        <th>Nome</th>
        <th>Inquilino</th>
        <th class="hide-sm">CNPJ do Inquilino</th>
        <th class="hide-sm">Grupo</th>
        <th class="hide-sm">Alugado</th>
        <th>Ações</th>
      </tr>
    </thead>

    <tbody>
      <% salas_visiveis = rooms.reject(&:espaco_comun) %>

      <% if salas_visiveis.any? %>
        <% salas_visiveis.each do |room| %>
          <tr>
            
            <td>
  <strong style="color: var(--color-btn) !important;">
    <%= room.name %>
  </strong>
</td>

            
            <td><%= room.dados_do_inquilino.presence || "-" %></td>
            <td class="hide-sm"><%= room.dados_do_inquilino[%r{\d{2}\.?\d{3}\.?\d{3}/?\d{4}-?\d{2}}] || "-" %></td>
            <td class="hide-sm"><%= room.grupo.presence || "-" %></td>
            <td class="hide-sm"><%= room.alugado? ? "Sim" : "Não" %></td>
            <td>
              <% if operador_ou_admin? %>
                <%= link_to room_path(room), class: 'btn-dash btn btn-success', onclick: 'event.stopPropagation();' do %>
                 <i class="fa-solid fa-eye"></i>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr class="show-sm">
          <td colspan="3" style="text-align:center; padding:1rem; font-style:italic; color:#888;">
            Nenhuma sala cadastrada.
          </td>
        </tr>
         <tr class="hide-sm">
          <td colspan="6" style="text-align:center; padding:1rem; font-style:italic; color:#888;">
            Nenhuma sala cadastrada.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

