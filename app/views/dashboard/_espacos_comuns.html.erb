<h2 class="subtitle" onclick="toggleSection('comuns-section', this)">
  ESPAÇOS COMUNS <i class="fa-solid fa-angle-down"></i>
</h2>

<div id="comuns-section" class="rooms common-stack-carousel" data-common-carousel="true" data-visible="3">
  <% if rooms.blank? %>
    <div style="text-align:center; padding:1rem; font-style:italic; color:#888;">
      Nenhum espaço comum cadastrado.
    </div>
  <% else %>
    <div class="common-stack-carousel__shell">
      <button type="button" class="common-stack-carousel__nav common-stack-carousel__nav--prev" aria-label="Ver espaco anterior" data-common-prev>
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div class="common-stack-carousel__track">
        <% rooms.each do |room| %>
          <% if room.photo.attached? %>
            <% bg_url = rails_blob_url(room.photo, only_path: true) %>
            <% background = "--bg-url: url('#{bg_url}');" %>
          <% else %>
            <% background = "--bg-url: none; background-color: black;" %>
          <% end %>

          <%= link_to room_reservations_path(room), class: "room-card-link common-stack-card isHidden", data: { common_card_link: true } do %>
            <div class="room-card" style="<%= background %>">
              <div class="room-header">
  <strong><%= room.name %> <i class="fa-solid fa-arrow-up-right-from-square room-link-icon"></i></strong><br>
  <% if room.dados_do_inquilino.present? %>
   <% if current_user&.admin? %>
    <span class="text-inquilino">INQUILINO: <%= room.dados_do_inquilino %></span>
    <% end %>
  <% else %>
    RESERVAS: <%= room.reservations.count.to_s.rjust(2, "0") %>
  <% end %>
</div>

              <div class="room-actions">
                <% if current_user&.admin? %>
                  <%= button_to edit_room_path(room), method: :get,
                        class: 'btn edit_room',
                        form: { data: { turbo: false } },
                        onclick: 'event.stopPropagation();' do %>
                    <i class="fa-solid fa-pen-to-square"></i> <div class="hide-sm"> EDITAR </div>
                  <% end %>
                <% end %>

                <% if current_user&.admin? || current_user&.operador? %>
                  <%= button_to open_door_room_path(room), method: :post,
                        class: 'btn open-door',
                        form: { data: { turbo: false } },
                        onclick: 'event.stopPropagation();' do %>
                    <i class="fa-solid fa-door-open me-2"></i> <div class="hide-sm"> ABRIR PORTA</div>
                  <% end %>
                <% end %>

                <% if current_user&.admin? %>
                  <%= button_to room_path(room), method: :delete,
                        data: { confirm: 'Tem certeza que deseja excluir esta sala e todas as reservas associadas?' },
                        class: 'btn btn-warning',
                        style: 'font-size: 15px; height: 51px; border: solid 2px;',
                        onclick: 'event.stopPropagation();' do %>
                    <i class="fa-solid fa-trash"></i> <div class="hide-sm"> EXCLUIR</div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <button type="button" class="common-stack-carousel__nav common-stack-carousel__nav--next" aria-label="Ver proximo espaco" data-common-next>
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  <% end %>
</div>

<style>
  #comuns-section.common-stack-carousel {
    padding: 1rem 0 0;
  }

  #comuns-section.common-stack-carousel .common-stack-carousel__shell {
    position: relative;
    width: min(100%, 72rem);
    min-height: 31rem;
    margin: 0 auto;
    padding: 0 3.25rem;
    overflow: hidden;
    user-select: none;
  }

  #comuns-section.common-stack-carousel .common-stack-carousel__track {
    position: relative;
    height: 29rem;
    overflow: hidden;
    touch-action: pan-y;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, .9) 14%,
      #000 24%,
      #000 76%,
      rgba(0, 0, 0, .9) 86%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, .9) 14%,
      #000 24%,
      #000 76%,
      rgba(0, 0, 0, .9) 86%,
      transparent 100%
    );
  }

  #comuns-section.common-stack-carousel .common-stack-carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: rgba(17, 17, 17, .78);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: opacity .2s ease, transform .2s ease, background .2s ease;
  }

  #comuns-section.common-stack-carousel .common-stack-carousel__nav:hover {
    background: rgba(17, 17, 17, .92);
    transform: translateY(-50%) scale(1.05);
  }

  #comuns-section.common-stack-carousel .common-stack-carousel__nav:disabled {
    opacity: .35;
    cursor: default;
  }

  #comuns-section.common-stack-carousel .common-stack-carousel__nav--prev {
    left: 0;
  }

  #comuns-section.common-stack-carousel .common-stack-carousel__nav--next {
    right: 0;
  }

  #comuns-section.common-stack-carousel .common-stack-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(31rem, 72vw);
    max-width: 44rem;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(.55);
    transition:
      transform .7s cubic-bezier(.22, 1, .36, 1),
      opacity .45s ease,
      filter .55s ease;
    will-change: transform, opacity;
  }

  #comuns-section.common-stack-carousel .common-stack-card .room-card {
    width: 100%;
    max-width: 100%;
    min-height: 24rem;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: none !important;
    transition: transform .35s ease;
  }

  #comuns-section.common-stack-carousel .common-stack-card .room-card:hover {
    transform: translateY(-4px);
    box-shadow: none !important;
    filter: none !important;
  }

  #comuns-section.common-stack-carousel .common-stack-card .room-header {
    transition: transform .45s ease, opacity .45s ease;
  }

  #comuns-section.common-stack-carousel .common-stack-card .room-actions {
    transition: transform .45s ease, opacity .45s ease;
  }

  #comuns-section.common-stack-carousel .common-stack-card.isHidden {
    opacity: 0;
    pointer-events: none;
  }

  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-left {
    opacity: 1;
    z-index: 1;
    transform: translate(calc(-50% - 24rem), calc(-50% + 1.6rem)) scale(.68);
    filter: brightness(.45) saturate(.78);
  }

  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--left {
    opacity: 1;
    z-index: 2;
    transform: translate(calc(-50% - 13.5rem), calc(-50% + .8rem)) scale(.83);
    filter: brightness(.62) saturate(.84);
  }

  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--active {
    opacity: 1;
    z-index: 4;
    pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
    filter: brightness(1) saturate(1);
  }

  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--right {
    opacity: 1;
    z-index: 2;
    pointer-events: auto;
    transform: translate(calc(-50% + 13.5rem), calc(-50% + .8rem)) scale(.83);
    filter: brightness(.62) saturate(.84);
  }

  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-right {
    opacity: 1;
    z-index: 1;
    transform: translate(calc(-50% + 24rem), calc(-50% + 1.6rem)) scale(.68);
    filter: brightness(.45) saturate(.78);
  }

  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-left .room-actions,
  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--left .room-actions,
  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--right .room-actions,
  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-right .room-actions {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-left .room-header,
  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--left .room-header,
  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--right .room-header,
  #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-right .room-header {
    opacity: .96;
  }

  @media (max-width: 768px) {
    #comuns-section.common-stack-carousel .common-stack-carousel__shell {
      width: 100%;
      min-height: 22rem;
      padding: 0 1.5rem;
    }

    #comuns-section.common-stack-carousel .common-stack-carousel__track {
      height: 20.5rem;
    }

    #comuns-section.common-stack-carousel .common-stack-card {
      width: min(16.5rem, 78vw);
      max-width: 16.5rem;
    }

    #comuns-section.common-stack-carousel .common-stack-card .room-card {
      min-height: 17.5rem;
      border-radius: 20px;
    }

    #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-left,
    #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--far-right {
      opacity: 0;
      pointer-events: none;
    }

    #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--left {
      opacity: .9;
      transform: translate(calc(-50% - 7.2rem), calc(-50% + .75rem)) scale(.68);
      filter: brightness(.52) saturate(.8);
    }

    #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--right {
      opacity: .9;
      transform: translate(calc(-50% + 7.2rem), calc(-50% + .75rem)) scale(.68);
      filter: brightness(.52) saturate(.8);
    }

    #comuns-section.common-stack-carousel .common-stack-carousel__nav {
      width: 2.2rem;
      height: 2.2rem;
    }
  }

  @media (max-width: 480px) {
    #comuns-section.common-stack-carousel .common-stack-carousel__shell {
      min-height: 19rem;
      padding: 0 1.2rem;
    }

    #comuns-section.common-stack-carousel .common-stack-carousel__track {
      height: 17.5rem;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, .9) 10%,
        #000 18%,
        #000 82%,
        rgba(0, 0, 0, .9) 90%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, .9) 10%,
        #000 18%,
        #000 82%,
        rgba(0, 0, 0, .9) 90%,
        transparent 100%
      );
    }

    #comuns-section.common-stack-carousel .common-stack-card {
      width: min(14.5rem, 78vw);
      max-width: 14.5rem;
    }

    #comuns-section.common-stack-carousel .common-stack-card .room-card {
      min-height: 15rem;
      width: 100% !important;
      font-size: 14px;
      border-radius: 18px;
    }

    #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--left {
      opacity: .82;
      transform: translate(calc(-50% - 5.6rem), calc(-50% + .7rem)) scale(.62);
      filter: brightness(.48) saturate(.78);
    }

    #comuns-section.common-stack-carousel .common-stack-card.common-stack-card--right {
      opacity: .82;
      transform: translate(calc(-50% + 5.6rem), calc(-50% + .7rem)) scale(.62);
      filter: brightness(.48) saturate(.78);
    }

    #comuns-section.common-stack-carousel .common-stack-carousel__nav {
      width: 1.9rem;
      height: 1.9rem;
    }
  }

  #comuns-section.common-stack-carousel .common-stack-card .room-link-icon {
  font-size: 0.65em;
  opacity: 0.7;
  vertical-align: middle;
  margin-left: 4px;
  transition: opacity .3s ease, transform .3s ease;
}

#comuns-section.common-stack-carousel .common-stack-card.common-stack-card--active .room-card:hover .room-link-icon {
  opacity: 1;
  transform: translate(2px, -2px);
}
</style>
