<%# Coleção apenas com chamados não concluídos %>
<% chamados_abertos = chamados.reject { |c| c.status.to_s.downcase == "concluído" } %>

<h2 class="subtitle collapsed" onclick="toggleSection('chamados-section', this)">
  <%= (current_user.admin? || current_user.role == "operador") ? "CHAMADOS" : "MEUS CHAMADOS" %>
  <i class="fa-solid fa-angle-down"></i>

  <% if chamados_abertos.any? && chamados_abertos.any? { |m| m.atualizada_recentemente? && !visualizado_pelo_usuario?("chamado", m) } %>
    <span class="dot-ativo" title="Há atualizações não visualizadas"></span>
    <button class="btn btn-sm btn-secondary mb-2 marcar-todos-btn" data-tipo="chamado">
      <i class="fa-solid fa-eye" style="transform: rotate(360deg);"></i> Marcar todas como vistas
    </button>
  <% end %>
</h2>

<div id="chamados-section" class="rooms collapsed">
  <table class="table table-salas">
    <thead class="table-secondary text-dark">
      <tr>
        <th>Solicitante</th>
        <th class="hide-sm">Empresa Solicitante</th>
        <th class="hide-sm">Unidade</th>
        <th>Título</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if chamados_abertos.empty? %>
        <tr>
          <td colspan="7" class="text-center text-muted">Sem chamados abertos</td>
        </tr>
      <% else %>
        <% chamados_abertos.each do |chamado| %>
          <tr class="<%= classe_linha_atualizada(chamado, 'chamado') %>" id="chamado-<%= chamado.id %>">
            <td style="display: flex; align-items: center; gap: .5rem;">
              <% if chamado.solicitante&.photo&.attached? %>
                <%= image_tag url_for(chamado.solicitante.photo),
                  style: "max-width:65px;max-height:45px;border-radius:12%;object-fit:cover;border:1px solid #ccc;" %>
              <% else %>
                <div style="max-width:65px;max-height:45px;border-radius:12%;object-fit:cover;border:1px solid #ccc;"></div>
              <% end %>
              <%= chamado.solicitante&.name || chamado.solicitante_nome || "Desconhecido" %>
            </td>
            <td class="hide-sm"><%= chamado.solicitante&.grupo_empresa&.nome || "-" %></td>
            <td class="hide-sm"><%= chamado.room&.name || "Sem unidade" %></td>
            <td><%= chamado.titulo %></td>
            <td>
              <%= link_to chamado_path(chamado), class: 'btn btn-sm btn-success', onclick: 'event.stopPropagation();' do %>
                <i class="fa-solid fa-eye"></i>
              <% end %>
              <% if operador_ou_admin? %>
                <%= link_to edit_chamado_path(chamado), class: 'btn btn-sm edit', onclick: 'event.stopPropagation();' do %>
                  <i class="fa-solid fa-pen-to-square"></i>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

