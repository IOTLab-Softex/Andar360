

<%= form_with model: @device, local: true, class: 'device-form' do |form| %>
  <div class="form-group">
    <%= form.label :name, "Nome do Dispositivo" %>
    <%= form.text_field :name, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :ip, "Endereço IP" %>
    <%= form.text_field :ip, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :user, "Usuário" %>
    <%= form.text_field :user, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :password, "Senha" %>
    <%= form.password_field :password, class: 'form-control' %>
  </div>

  
  <div class="form-actions">
    <%= form.submit "Salvar Dispositivo", class: 'btn submit' %>
  </div>
<% end %>
