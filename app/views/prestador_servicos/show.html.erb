

<div class="form-group" style="text-align:center; margin-top: .5rem;">
  <%= link_to "Editar", edit_prestador_servico_path(@prestador_servico), class: "btn btn-primary" %>
  <%= link_to "Voltar", prestador_servicos_path, class: "btn btn-secondary" %>
  <%= button_to "Excluir", @prestador_servico, method: :delete,
        data: { confirm: "Remover este prestador?" },
        class: "btn btn-outline-danger" %>
</div>

<div class="form-group" style="display:flex; flex-wrap:wrap; gap:1rem; margin-top:1rem;">
  <!-- Coluna da foto -->
  <div style="flex: 1 1 220px; max-width: 320px;">
    <label>Foto</label>
    <div class="image-thumb mt-2 ro-box" style="display:grid; place-items:center; padding:.75rem;">
      <% if @prestador_servico.foto&.attached? %>
        <%= image_tag url_for(@prestador_servico.foto), class: "img-fluid", style: "max-height:320px; object-fit:cover; border-radius:8px;" %>
      <% else %>
        <%= image_tag "silhueta.png", class: "img-fluid", style: "max-height:320px; object-fit:contain; opacity:.8;" %>
      <% end %>
    </div>
  </div>

  <!-- Coluna dos dados -->
  <div style="flex: 2 1 500px;">
    <!-- linha 1 -->
    <div style="display:flex; gap:1rem; flex-wrap:wrap;">
      <div style="flex:1;">
        <label>Nome</label>
        <div class="ro-box"><%= @prestador_servico.nome.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Publicado no app</label>
        <div class="ro-chip"><%= @prestador_servico.publicado_no_app.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Bloqueado</label>
        <div class="ro-chip <%= @prestador_servico.bloqueado == "Sim" ? "danger" : "success" %>">
          <%= @prestador_servico.bloqueado.presence || "—" %>
        </div>
      </div>
    </div>

    <!-- linha 2 docs -->
    <div style="display:flex; gap:1rem; margin-top:1rem; flex-wrap:wrap;">
      <div style="flex:1;">
        <label>CPF</label>
        <div class="ro-box"><%= @prestador_servico.cpf.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>RG</label>
        <div class="ro-box"><%= @prestador_servico.rg.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Outro documento</label>
        <div class="ro-box"><%= @prestador_servico.outro_documento.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Idoso ou PNE</label>
        <div class="ro-chip"><%= @prestador_servico.idoso_ou_pne.presence || "—" %></div>
      </div>
    </div>

    <!-- linha 3 contatos -->
    <div style="display:flex; gap:1rem; margin-top:1rem; flex-wrap:wrap;">
      <div style="flex:1;">
        <label>Fone 1</label>
        <div class="ro-box"><%= @prestador_servico.fone1.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Fone 2</label>
        <div class="ro-box"><%= @prestador_servico.fone2.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>WhatsApp</label>
        <div class="ro-box"><%= @prestador_servico.whatsapp.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>E-mail</label>
        <div class="ro-box"><%= @prestador_servico.email.presence || "—" %></div>
      </div>
    </div>

    <!-- site -->
    <div style="margin-top:1rem;">
      <label>Site</label>
      <div class="ro-box">
        <% if @prestador_servico.site.present? %>
          <%= link_to @prestador_servico.site, @prestador_servico.site, target: "_blank", rel: "noopener" %>
        <% else %>
          —
        <% end %>
      </div>
    </div>

    <hr>

    <h5>Dados do Veículo</h5>
    <div style="display:flex; gap:1rem; flex-wrap:wrap;">
      <div style="flex:1;">
        <label>Tipo de veículo</label>
        <div class="ro-box"><%= @prestador_servico.tipo_veiculo.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Placa</label>
        <div class="ro-box"><%= @prestador_servico.placa.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Fabricante</label>
        <div class="ro-box"><%= @prestador_servico.fabricante.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Modelo</label>
        <div class="ro-box"><%= @prestador_servico.modelo.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>Cor</label>
        <div class="ro-box"><%= @prestador_servico.cor.presence || "—" %></div>
      </div>
    </div>

    <hr>

    <h5>Dados da Empresa</h5>
    <div style="display:flex; gap:1rem; flex-wrap:wrap;">
      <div style="flex:1;">
        <label>Nome fantasia</label>
        <div class="ro-box"><%= @prestador_servico.nome_fantasia.presence || "—" %></div>
      </div>
      <div style="flex:1;">
        <label>CNPJ</label>
        <div class="ro-box"><%= @prestador_servico.cnpj.presence || "—" %></div>
      </div>
    </div>

    <div style="display:flex; gap:1rem; margin-top:1rem; flex-wrap:wrap;">
      <div style="flex:1;">
        <label>Serviços</label>
        <div class="ro-box ro-multiline"><%= simple_format(@prestador_servico.servicos.presence || "—") %></div>
      </div>
      <div style="flex:1;">
        <label>Observação</label>
        <div class="ro-box ro-multiline"><%= simple_format(@prestador_servico.observacao.presence || "—") %></div>
      </div>
    </div>
  </div>
</div>

<style>
/* “Readonly box” que imita um form-control, mas só exibe texto */
.ro-box{
  background: rgba(0,0,0,.03);
  border: 1px solid rgba(0,0,0,.15);
  border-radius: .5rem;
  padding: .55rem .7rem;
  min-height: 38px;
  display: flex; align-items: center;
  color: var(--color-text, #335570);
}
.ro-multiline{ display:block; min-height:auto; }

.ro-chip{
  display:inline-flex; align-items:center; justify-content:center;
  border:1px solid rgba(0,0,0,.15);
  background: rgba(0,0,0,.03);
  border-radius: 999px;
  min-height: 38px; padding: .25rem .7rem; font-weight: 600;
}
.ro-chip.success{ border-color: rgba(25,135,84,.35); background: rgba(25,135,84,.08); }
.ro-chip.danger{  border-color: rgba(220,53,69,.35); background: rgba(220,53,69,.08); }
.form-group{
text-align: center;
    margin-top: .5rem;
    display: flex
;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;

}
</style>
