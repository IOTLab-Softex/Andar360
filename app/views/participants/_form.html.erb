<%= form_with(model: participant, local: true) do |form| %>

  <!-- BOTÃO SALVAR CENTRALIZADO FIXO (igual chamado) -->
  <div class="form-group-fixed" style="display:flex; justify-content:center;">
    <div class="mt-3 text-center">
      <%= form.submit participant.new_record? ? "Criar Participante" : "Atualizar Participante",
                     class: "btn btn-success" %>
    </div>
  </div>

  <br>

  <!-- CARD: DADOS DO PARTICIPANTE (MESMO ESTILO DO CHAMADO) -->
  <div class="chamado-section section-box">
    <div class="section-header">
      <h5>
        <i class="fa-solid fa-user"></i>
        Dados do participante
      </h5>
    </div>

    <div class="section-body chamado-grid">

      <div class="chamado-field">
        <span class="label">
          <%= form.label :name do %>
            <i class="fa-solid fa-font-awesome"></i> Nome
          <% end %>
        </span>
        <div class="value">
          <%= form.text_field :name, class: "form-control" %>
          <small class="form-text text-muted">Digite o nome completo do usuário.</small>
        </div>
      </div>

      <div class="chamado-field">
        <span class="label">
          <%= form.label :cpf do %>
            <i class="fa-solid fa-address-card"></i> CPF
          <% end %>
        </span>
        <div class="value">
          <%= form.text_field :cpf, class: "form-control" %>
          <small class="form-text text-muted">Informe o CPF válido do usuário.</small>
        </div>
      </div>

      <div class="chamado-field">
        <span class="label">
          <%= form.label :telefone do %>
            <i class="fa-solid fa-phone"></i> Telefone
          <% end %>
        </span>
        <div class="value">
          <%= form.text_field :telefone, class: "form-control" %>
          <small class="form-text text-muted">Informe um número de telefone para contato.</small>
        </div>
      </div>

      <div class="chamado-field">
        <span class="label">
          <%= form.label :email do %>
            <i class="fa-solid fa-envelope"></i> Email
          <% end %>
        </span>
        <div class="value">
          <%= form.email_field :email, class: "form-control" %>
          <small class="form-text text-muted">E-mail de contato (Recomendado).</small>
        </div>
      </div>

    </div>
  </div>

  <!-- CARD: EMPRESA E SETOR (MESMO VISUAL DO CHAMADO) -->
  <div class="chamado-section section-box">
    <div class="section-header">
      <h5>
        <i class="fa-solid fa-building"></i>
        Empresa e Setor
      </h5>
    </div>

    <div class="section-body chamado-grid">

      <div class="chamado-field">
        <span class="label">
          <%= form.label :grupo_empresa_id do %>
            <i class="fa-solid fa-group-arrows-rotate"></i> Grupo Empresa
          <% end %>
        </span>
        <div class="value">
          <%= form.collection_select :grupo_empresa_id,
                                     scoped_grupo_empresas,
                                     :id, :nome,
                                     { prompt: "Selecione uma empresa" },
                                     { class: "form-control", id: "grupo_empresa_select" } %>
          <small class="form-text text-muted">
            Selecione a empresa à qual o usuário pertence.
          </small>
        </div>
      </div>

      <div class="chamado-field">
        <span class="label">
          <%= form.label :sub_grupo_empresa_id do %>
            <i class="fa-solid fa-group-arrows-rotate"></i> Setor (Subgrupo da empresa)
          <% end %>
        </span>
        <div class="value">
          <%= form.select :sub_grupo_empresa_id,
                          [],
                          { prompt: "Selecione um setor" },
                          class: "form-control", id: "subgrupo_select" %>
          <small class="form-text text-muted">
            Escolha o setor (subgrupo) correspondente à empresa.
          </small>
        </div>
      </div>

    </div>
  </div>

  <!-- CARD: ACESSO AO SISTEMA (SÓ ADMIN) -->
  <% if current_user.admin? %>
    <div class="chamado-section section-box">
      <div class="section-header">
        <h5>
          <i class="fa-solid fa-user-lock"></i>
          Acesso ao sistema
        </h5>
      </div>

      <div class="section-body">

        <div class="form-group">
          <label>
            <%= check_box_tag :criar_usuario,
                              "1",
                              participant.user&.can_access_andar360?,
                              id: "criar_usuario_checkbox",
                              onclick: "togglePermissoes()" %>
            Conceder acesso ao Andar360
          </label>
        </div>

          <div id="aponti-tv-access-wrap" <%= 'hidden' unless participant.aponti_tv_eligible? %>>
            <label>
              <%= form.check_box :can_access_aponti_tv, id: "participant_aponti_tv_access", onchange: "togglePermissoes()" %>
              Conceder acesso ao Aponti TV
            </label>
            <small class="form-text text-muted">Permite entrar no Aponti TV com a conta e senha do Andar360.</small>
          </div>
        <div class="form-group" id="permissoes_wrap" style="display: none;">
          <%= label_tag :user_role, "Permissão de Acesso" %>
          <%= select_tag :user_role,
                         options_for_select([["Admin", "admin"],
                                             ["Client", "client"],
                                             ["Operador", "operador"]],
                                            participant.user&.role),
                         class: "form-control" %>
          <%= hidden_field_tag :senha_gerada, "", id: "senha_gerada_input" %>
        </div>

        <div class="form-group" id="senha_wrap" style="display: none;">
          <label>Senha gerada:</label>
          <div id="senha_gerada_label"></div>

          <label style="margin-top: 10px;">
            <%= check_box_tag :manter_senha,
                              "1",
                              participant.user&.encrypted_password.present?,
                              id: "manter_senha_checkbox" %>
            Manter senha atual
          </label>
        </div>

      </div>
    </div>
  <% end %>

  <!-- CARD: FOTO / RECONHECIMENTO FACIAL (MESMO CARD STYLE) -->
  <div class="chamado-section section-box">
    <div class="section-header">
      <h5>
        <i class="fa-solid fa-camera"></i>
        Foto do participante
      </h5>
    </div>

    <div class="section-body">
      <div class="form-group">
        <%= form.label :photo_base64 do %>
          <i class="fa-solid fa-camera"></i> Foto
        <% end %><br>

        <input type="file"
               accept="image/*"
               onchange="handleImageUpload(event)"
               style="margin-bottom: 10px;" />
        <div id="image-feedback" style="color: #f66; margin-bottom: 5px;"></div>

        <div style="margin-bottom: 10px;">
          <img id="photo-preview"
               style="max-width: 150px; max-height: 300px; display: none;" />
        </div>

        <%= form.hidden_field :photo_base64, id: "photo-base64" %>

        <button type="button" class="btn submit" onclick="openCamera()">
          Capturar com Câmera
        </button><br>

        <small class="form-text text-muted">
          Anexe ou capture uma foto nítida do rosto do usuário (tamanho ideal: 150x300px).
        </small>
        <br><br>

        <small class="small-alert form-text text-muted">
          <i class="fa-solid fa-circle-exclamation"></i>
          A foto será usada para reconhecimento facial. Garanta que o rosto esteja visível,
          centralizado e com boa iluminação.
        </small>
      </div>
    </div>
  </div>

<% end %>

<!-- SOBREPOSIÇÃO DA CÂMERA (MANTIDO IGUAL) -->
<div id="camera-overlay" style="display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(7, 11, 18, 0.82);
    backdrop-filter: blur(6px);
    transition: background-color .18s ease, backdrop-filter .18s ease;
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 16px;
    overflow: hidden;">
  <div id="camera-overlay-layout" style="display: grid;
      grid-template-columns: minmax(0, 860px);
      gap: 0;
      width: min(96vw, 900px);
      max-height: calc(100vh - 32px);
      align-items: start;">
    <div style="position: relative;
        width: 100%;
        height: min(calc(100vh - 32px), 760px);
        max-height: calc(100vh - 32px);
        padding: 14px;
        border-radius: 22px;
        background: linear-gradient(180deg, rgba(27, 35, 48, 0.96), rgba(14, 19, 28, 0.98));
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.12);
        overflow: hidden;">
      <iframe id="camera-frame"
              src="/camera"
              allow="camera *"
              style="display: block;
                width: 100%;
                height: 100%;
                border: 1px solid rgba(148, 163, 184, 0.28);
                border-radius: 18px;
                background: #05070b;
                box-shadow: inset 0 0 0 1px rgba(255,255,255,.04);"></iframe>
      <button type="button"
              onclick="closeCamera()"
              style="position: absolute;
                top: 10px;
                right: 10px;
                width: 42px;
                height: 42px;
                background: rgba(15, 23, 42, 0.82);
                border: 1px solid rgba(255, 255, 255, 0.16);
                color: white;
                font-size: 26px;
                line-height: 1;
                border-radius: 999px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);">
        &times;
      </button>
    </div>
  </div>
</div>



<script>

function setParticipantCameraOverlayFlashMode(enabled) {
  const overlay = document.getElementById("camera-overlay");
  if (!overlay) return;
  overlay.style.background = enabled ? "#ffffff" : "rgba(7, 11, 18, 0.82)";
  overlay.style.backdropFilter = enabled ? "none" : "blur(6px)";
}

document.addEventListener("DOMContentLoaded", () => {
  const cpfInput = document.querySelector("input[name='participant[cpf]']");

  cpfInput?.addEventListener("input", function (e) {
    let value = e.target.value.replace(/\D/g, ""); // Remove tudo que não for número
    if (value.length > 11) value = value.slice(0, 11);

    if (value.length > 9) {
      value = `${value.slice(0, 3)}.${value.slice(3, 6)}.${value.slice(6, 9)}-${value.slice(9)}`;
    } else if (value.length > 6) {
      value = `${value.slice(0, 3)}.${value.slice(3, 6)}.${value.slice(6)}`;
    } else if (value.length > 3) {
      value = `${value.slice(0, 3)}.${value.slice(3)}`;
    }

    e.target.value = value;
  });
});



document.addEventListener("DOMContentLoaded", () => {
  const input = document.querySelector("input[name='participant[telefone]']");

  input?.addEventListener("input", function (e) {
    let value = e.target.value.replace(/\D/g, "");
    if (value.length > 11) value = value.slice(0, 11);

    if (value.length > 6) {
      value = `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
    } else if (value.length > 2) {
      value = `(${value.slice(0, 2)}) ${value.slice(2)}`;
    } else if (value.length > 0) {
      value = `(${value}`;
    }

    e.target.value = value;
  });
});



function openCamera() {
const overlay = document.getElementById("camera-overlay");
overlay.style.display = "flex";
overlay.style.position = "fixed";
setParticipantCameraOverlayFlashMode(false);
}

function closeCamera() {
document.getElementById("camera-overlay").style.display = "none";
setParticipantCameraOverlayFlashMode(false);
}

// Recebe base64 do iframe
window.addEventListener("message", function (e) {
if (e.data.photoBase64) {
  const base64 = e.data.photoBase64;
  document.getElementById("photo-base64").value = base64;

  // Atualiza preview
  document.getElementById("photo-preview")?.remove();
  const img = document.createElement("img");
  img.src = base64;
  img.id = "photo-preview";
  img.style.maxWidth = "150px";
  img.style.maxHeight = "300px";
  document.getElementById("photo-base64").insertAdjacentElement("beforebegin", img);

  closeCamera();
  return;
}

const frame = document.getElementById("camera-frame");
if (e.data?.type === "camera-light-state" && e.source === frame?.contentWindow) {
  setParticipantCameraOverlayFlashMode(!!e.data.lowLight);
}
});

  document.addEventListener("DOMContentLoaded", () => {
    const checkbox = document.getElementById("criar_usuario_checkbox");
    if (checkbox && checkbox.checked) {
      togglePermissoes();
    }
  });


</script>
<script defer src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
async function handleImageUpload(event) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = async function (e) {
    const base64 = e.target.result;

    const img = new Image();
    img.src = base64;
    img.onload = async () => {
      // cria canvas proporcional 150x300
      const canvas = document.createElement("canvas");
      canvas.width = 150;
      canvas.height = 300;
      const ctx = canvas.getContext("2d");
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

      // Verifica rosto na imagem
      await faceapi.nets.tinyFaceDetector.loadFromUri('/models/tiny_face_detector');
      const detections = await faceapi.detectAllFaces(canvas, new faceapi.TinyFaceDetectorOptions());

      const preview = document.getElementById("photo-preview");
      const feedback = document.getElementById("image-feedback");

      if (detections.length === 0) {
        feedback.textContent = "Nenhum rosto detectado na imagem.";
        preview.style.display = "none";
        return;
      }

      const { width, height } = detections[0].box;
      const ratioW = width / canvas.width;
      const ratioH = height / canvas.height;

      if (ratioW < 0.1 || ratioH < 0.1) {
        feedback.textContent = "Rosto muito distante.";
        preview.style.display = "none";
        return;
      }

      if (ratioW > 0.8 || ratioH > 0.8) {
        feedback.textContent = "Rosto muito próximo.";
        preview.style.display = "none";
        return;
      }

      feedback.textContent = "";
      preview.src = canvas.toDataURL("image/png");
      preview.style.display = "block";
      document.getElementById("photo-base64").value = canvas.toDataURL("image/png");
    };
  };
  reader.readAsDataURL(file);
}

function togglePermissoes() {
  const checked = document.getElementById("criar_usuario_checkbox").checked;
  document.getElementById("permissoes_wrap").style.display = checked ? "block" : "none";
  const anyAccess = checked || document.getElementById("participant_aponti_tv_access")?.checked;
  document.getElementById("senha_wrap").style.display = anyAccess ? "block" : "none";

  const manterSenha = document.getElementById("manter_senha_checkbox")?.checked;

  if (anyAccess && !manterSenha) {
    const senha = Math.random().toString(36).slice(-8) + Math.floor(Math.random() * 10);
    document.getElementById("senha_gerada_label").textContent = senha;
    document.getElementById("senha_gerada_input").value = senha;
  } else if (anyAccess && manterSenha) {
    document.getElementById("senha_gerada_label").textContent = "(senha mantida)";
    document.getElementById("senha_gerada_input").value = ""; // não envia nova senha
  } else {
    document.getElementById("senha_gerada_label").textContent = "";
    document.getElementById("senha_gerada_input").value = "";
  }
}

 document.addEventListener("DOMContentLoaded", () => {
    const checkbox = document.getElementById("criar_usuario_checkbox");
    const manterSenhaCheckbox = document.getElementById("manter_senha_checkbox");

    if (checkbox && checkbox.checked) {
      togglePermissoes();
    }

    if (manterSenhaCheckbox) {
      manterSenhaCheckbox.addEventListener("change", togglePermissoes);
    }
  });


  document.addEventListener("DOMContentLoaded", function () {
  const empresaSelect = document.getElementById("grupo_empresa_select");
  const subgrupoSelect = document.getElementById("subgrupo_select");
  const apontiWrap = document.getElementById("aponti-tv-access-wrap");
  const apontiCheckbox = document.getElementById("participant_aponti_tv_access");
  function atualizarAcessoApontiTv() {
    const enabled = subgrupoSelect.selectedOptions[0]?.dataset.apontiTv === "true";
    if (apontiWrap) apontiWrap.hidden = !enabled;
    if (apontiCheckbox && !enabled) apontiCheckbox.checked = false;
    if (document.getElementById("criar_usuario_checkbox")) togglePermissoes();
  }
  subgrupoSelect?.addEventListener("change", atualizarAcessoApontiTv);
  let initialSubgroupLoad = true;

  if (empresaSelect) {
    empresaSelect.addEventListener("change", function () {
      const empresaId = this.value;

      subgrupoSelect.innerHTML = '<option value="">Carregando...</option>';
      if (apontiWrap) apontiWrap.hidden = true;
      const requestedCompany = empresaId;

      fetch(`/sub_grupo_empresas/por_empresa/${empresaId}`)
        .then(response => response.json())
        .then(data => {
          if (empresaSelect.value !== requestedCompany) return;
          subgrupoSelect.innerHTML = '<option value="">Selecione um setor</option>';
          data.forEach(sub => {
            const option = document.createElement("option");
            option.value = sub.id;
            option.textContent = sub.nome;
            option.dataset.apontiTv = String(sub.can_access_aponti_tv === true);
            subgrupoSelect.appendChild(option);
          });

          // Marca como selecionado se já tiver valor salvo no form
          const selectedId = "<%= @participant.sub_grupo_empresa_id %>";
          if (initialSubgroupLoad && selectedId) {
            subgrupoSelect.value = selectedId;
          }
          initialSubgroupLoad = false;
          atualizarAcessoApontiTv();

        })
        .catch(() => {
          subgrupoSelect.innerHTML = '<option value="">Erro ao carregar setores</option>';
          atualizarAcessoApontiTv();
        });
    });

    // 👉 dispara o carregamento se já tiver uma empresa selecionada
    if (empresaSelect.value) {
      const event = new Event('change');
      empresaSelect.dispatchEvent(event);
    }
  }
});



</script>


