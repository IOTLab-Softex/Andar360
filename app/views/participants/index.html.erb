<!-- app/views/participants/index.html.erb -->
<style>
  /* Esconde a coluna quando a viewport for menor que o breakpoint */
  @media (max-width: 1200px){ .hide-xl { display:none !important; } } /* desktops menores */
  @media (max-width: 992px) { .hide-lg { display:none !important; } }  /* laptop/tablet landscape */
  @media (max-width: 768px) { .hide-md { display:none !important; } }  /* tablet/phone */
  @media (max-width: 576px) { .hide-sm { display:none !important; } }  /* phone pequeno */
  @media (max-width: 420px) { .hide-xs { display:none !important; } }  /* muito pequeno */
  @media (max-width: 576px){
    table.rtable th:not(.keep-sm),
    table.rtable td:not(.keep-sm){
      display: none !important;
    }
  }

    .hidden { display: none !important; }

    .kebab-wrapper { position: relative; z-index: 20; }
    .kebab-menu[hidden]{ display:none !important; }
.kebab-menu {
    position: absolute;
    right: 30px;
    top: -11px;
    background: var(--color-btn--text);
    color: var(--color-btn);
    border-radius: 8px;
    min-width: 180px;
    box-shadow: 0 8px 24px #00000040;
    overflow: hidden;
    z-index: 9999;
}
    .kebab-menu .menu-item { display:block; width:100%; text-align:left; padding:.6rem 1rem; background:transparent; border:none; cursor:pointer; }
    .kebab-menu .menu-item:hover { background:#3c2c47; color:#ff944d; }

    /* Seleção em massa */
    .selection-table .sel-cell{ display:none; }                     /* escondida por padrão */
    .selection-table.table--select .sel-cell{ display:table-cell !important; } /* aparece no modo seleção */

    .th-actions{

    display: flex
    ;
        justify-content: space-between;
        align-items: center;

    }
      /* ---------- Tabs responsivos (desktop centraliza, mobile rola) ---------- */
  .tabs {
    position: sticky;                 /* opcional: fica sempre visível no topo */
    top: 0;                           /* ajuste conforme seu header */
    z-index: 0;
    display: flex;
    gap: .8rem;
    padding: .5rem 1rem;
    margin: 12px auto -8px auto;
    border-radius: 16px 16px 0 0;

    /* rolagem horizontal quando precisar */
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;

    /* desktop: centralizado quando couber */
    justify-content: center;

    /* esconder scrollbars (sem quebrar acessibilidade) */
    scrollbar-width: none;            /* Firefox */
  }
  .tabs::-webkit-scrollbar { display: none; } /* WebKit */

  .tabs a {
    flex: 0 0 auto;                   /* não quebrar linha; cada aba tem largura mínima do conteúdo */
    min-width: max-content;           /* evita quebra estranha de texto */
    scroll-snap-align: start;

    /* tipografia/padding fluidos para caber melhor em telas pequenas */
    font-size: clamp(.9rem, 2.5vw, 1.15rem);
    padding: clamp(6px, 1.4vw, 10px) clamp(12px, 3vw, 28px) 8px clamp(12px, 3vw, 28px);

    border-radius: 18px 18px 0 0;
    background: var(--color-btn--text);
    color: var(--color-btn);
    font-weight: 600;
    text-decoration: none;
    transition: background .2s, color .2s, box-shadow .2s, transform .15s;

  }

  .tabs a.active {
    background: #ff8c42;
    color: #222;
    font-weight: 800;
    z-index: 2;
  }

  .tab-badge{
  margin-left: .15rem;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: .78em;
  font-weight: 800;
  line-height: 1.2;
  background: var(--color-accent);
  color: inherit;
  }

  .tabs a.active .tab-badge{
  background: rgba(0,0,0,.18);
  }
  .tabs a:not(.active):hover {
    background: #3c2c47;
    color: #ff944d;
  }

  /* em telas pequenas, alinhar à esquerda para a faixa rolável começar do início */
  @media (max-width: 700px) {
    .tabs { justify-content: flex-start; padding: .5rem .75rem; gap: .5rem; }
  }

  /* (opcional) sombras nas bordas para indicar que dá pra rolar */
  .tabs {
    mask-image: linear-gradient(to right, transparent 0, black 12px, black calc(100% - 12px), transparent 100%);
  }
  @supports not (mask-image: linear-gradient(black, black)) {
    /* fallback simples: sem máscara */
  }




      /* modal da foto */

      .photo-modal[hidden] { display: none !important; }

  .photo-modal {
    position: fixed; inset: 0; z-index: 2000;
    display: grid; place-items: center;
  }
  .photo-modal__backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,.6);
    backdrop-filter: blur(2px);
  }
  .photo-modal__dialog {
    position: relative;
    max-width: 90vw; max-height: 90vh;
    background: #111; border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0,0,0,.5);
    padding: 10px 10px 14px;
    display: grid; gap: 8px; justify-items: center;
  }
  .photo-modal__close {
    position: absolute; top: 4px; right: 8px;
    border: none; background: transparent; color: #fff;
    font-size: 26px; cursor: pointer; line-height: 1;
    padding: 2px 6px;
  }
  #photo-modal-img {
    max-width: 95vw;
      max-height: 77vh;
      object-fit: contain;
      border-radius: 10px;
      width: 29rem;
  }
  .photo-modal__caption {
    color: #ddd; font-size: .95rem; text-align: center;
    max-width: 80vw;
    overflow-wrap: anywhere;
  }

  .p-name { display: inline-flex; align-items: center; gap: .45rem; }

  .access-icon { font-size: .95rem; opacity: .95; }
  .access-icon--on { color: #22c55e; }       /* verde */
  .access-icon--blocked { color: #ef4444; }  /* vermelho */
  .access-icon--pending { color: #f59e0b; }  /* amarelo */

  /* ====== Collapsible filtro (igual Chamados) ====== */
.filtro-label{
 
  display:flex;
  justify-content: space-between;
  align-items:center;
  gap:.75rem;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(22,18,33,.55);
  color: var(--color-text, #f1f1ff);
  padding: .75rem 1rem;
  border-radius: 14px;
  cursor:pointer;
  transition: transform .15s ease, background .2s ease, border-color .2s ease;
  user-select:none;
}

.filtro-label:hover{
  background: rgba(22,18,33,.72);
  border-color: rgba(124,58,237,.35);
}

.filtro-chevron{
  transition: transform .2s ease;
}

/* gira quando colapsado */
.filtro-label[aria-expanded="false"] .filtro-chevron{
  transform: rotate(180deg);
}

/* painel do filtro (form) */
.filtros-form {
    margin-top: 1px;
    overflow: visible;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, .10);
    background: var(--color-bg-table-salas);
    transition: max-height .25s ease;
}

/* fechado */
.filtros-form.collapsed{
  border-color: rgba(255,255,255,.06);
  overflow: hidden;
}

/* seu grid/linha interna (você já tem) */
.filtro-row{
  display:flex;
  flex-wrap:wrap;
  gap: 1rem;
  padding: 1rem;
  justify-content:center;
}

.filtro-field{
  min-width: 190px;
  flex: 1 1 190px;
}

.filtro-field-label{
  display:block;
  font-size: .82rem;
  opacity: .85;
  margin-bottom: .35rem;
}

.filtro-actions{
  display:flex;
  gap: .5rem;
  align-items:flex-end;
  padding-top: .15rem;
}

/* quando o painel estiver "fechado de verdade", some com o conteúdo */
/* quando o FORM estiver "fechado de verdade", some com o conteúdo */
.filtros-form.is-collapsed-done{
  border: 0 !important;
  padding: 0 !important;
  margin-top: 0 !important;
  max-height: 0 !important;
  overflow: hidden !important;
}

.filtros-form.is-collapsed-done .filtro-row{
  display: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

.filtros-form .choices {
  margin-bottom: 0;
}

.filtros-form .choices__list--dropdown,
.filtros-form .choices__list[aria-expanded] {
  display: none;
  z-index: 10050;
}

.filtros-form .choices__list--dropdown.is-active,
.filtros-form .choices__list[aria-expanded].is-active {
  display: block;
}

.filtros-form .choices__list--dropdown .choices__list,
.filtros-form .choices__list[aria-expanded] .choices__list {
  max-height: 260px;
}


</style>
<button type="button"
        id="filtro-toggle"
        class="filtro-label"
        aria-expanded="true"
        aria-controls="filtros-participants">
  <span style="display:flex; align-items:center; gap:.6rem;">
    <i class="fa-solid fa-filter"></i>
    Filtro
  </span>
  <i class="fa-solid fa-chevron-up filtro-chevron" aria-hidden="true"></i>
</button>
<%
  filtros_keys = [:grupo_empresa_id, :sub_grupo_empresa_id, :user_access, :user_block, :password_recovery_support, :search]
  has_filtros  = filtros_keys.any? { |k| params[k].present? }
%>
<%= form_with url: participants_path, method: :get, local: true,
              class: "filtros-form", id: "filtros-participants" do %>
  <%= hidden_field_tag :tab, params[:tab] %>
  <div class="filtro-row">
    <div class="filtro-field">
      <span class="filtro-field-label">Grupo Empresa</span>
      <%= select_tag :grupo_empresa_id,
            options_for_select([["TODOS", ""]] + scoped_grupo_empresas.order(:nome).map { |g| [g.nome, g.id] }, @selected_grupo_empresa_id),
            class: "form-control", id: "grupo_empresa_filter" %>
    </div>
    <div class="filtro-field">
      <span class="filtro-field-label">Setor (Sub Grupos)</span>
      <%= select_tag :sub_grupo_empresa_id,
            options_for_select([["TODOS", ""]], params[:sub_grupo_empresa_id]),
            class: "form-control", id: "subgrupo_filter" %>
    </div>
    <div class="filtro-field">
      <span class="filtro-field-label">Acesso ao sistema</span>
      <%= select_tag :user_access,
            options_for_select([["TODOS", ""], ["Somente com acesso", "with_user"], ["Somente sem acesso", "without_user"]], params[:user_access]),
            class: "form-control" %>
    </div>
    <div class="filtro-field">
      <span class="filtro-field-label">Status do acesso</span>
      <%= select_tag :user_block,
            options_for_select([["TODOS", ""], ["Bloqueados", "blocked"], ["Desbloqueados", "unblocked"]], params[:user_block]),
            class: "form-control" %>
    </div>
    <div class="filtro-field">
      <span class="filtro-field-label">Recuperacao</span>
      <%= select_tag :password_recovery_support,
            options_for_select([["TODOS", ""], ["Solicitaram suporte", "requested"]], params[:password_recovery_support]),
            class: "form-control" %>
    </div>
    <div class="filtro-field">
      <span class="filtro-field-label">Buscar por nome/CPF</span>
      <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Digite nome ou CPF" %>
    </div>
    <div class="filtro-actions">
      <%= button_tag type: "submit", class: "btn btn-success", title: "Filtrar" do %>
        <i class="fa fa-search"></i>
      <% end %>
      <% if has_filtros %>
        <%= link_to participants_path(tab: params[:tab]), class: "btn btn-success", title: "Limpar filtros" do %>
          <i class="fa-solid fa-rotate-left"></i>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
<%
  tab_params = {
    grupo_empresa_id: @selected_grupo_empresa_id,
    sub_grupo_empresa_id: params[:sub_grupo_empresa_id],
    search: params[:search],
    user_access: params[:user_access],
    user_block: params[:user_block],
    password_recovery_support: params[:password_recovery_support]
  }.compact
%>
<div class="tabs">
  <%= link_to participants_path(tab_params.merge(tab: 'ativos')), class: params[:tab] == 'ativos' ? 'active' : '' do %>
    <i class="fa-solid fa-users"></i> Usuários
    <span class="tab-badge"><%= @count_ativos.to_i %></span>
  <% end %>
  <%= link_to participants_path(tab_params.merge(tab: 'pendentes')), class: params[:tab] == 'pendentes' ? 'active' : '' do %>
    <i class="fa-solid fa-clock"></i> Pendentes
    <span class="tab-badge"><%= @count_pendentes.to_i %></span>
  <% end %>
  <%= link_to participants_path(tab_params.merge(tab: 'aprovacoes')), class: params[:tab] == 'aprovacoes' ? 'active' : '' do %>
    <i class="fa-solid fa-hourglass-half"></i> Aguardando aprovação
    <span class="tab-badge"><%= @count_aprovacoes.to_i %></span>
  <% end %>
  <%= link_to participants_path(tab_params.merge(tab: 'reprovados')), class: params[:tab] == 'reprovados' ? 'active' : '' do %>
    <i class="fa-solid fa-circle-xmark"></i> Reprovados
    <span class="tab-badge"><%= @count_reprovados.to_i %></span>
  <% end %>
  <% if current_user.admin? %>
    <%= link_to participants_path(tab_params.merge(tab: 'excluidos')), class: params[:tab] == 'excluidos' ? 'active' : '' do %>
      <i class="fa-solid fa-trash"></i> Excluídos
      <span class="tab-badge"><%= @count_excluidos.to_i %></span>
    <% end %>
  <% end %>
</div>
<% if params[:tab] == 'aprovacoes' %>
  <!-- Form único para enviar para approve ou reject (definimos a action via JS) -->
  <%= form_with url: bulk_approve_formulario_cadastros_path, method: :post, local: true, id: "bulk-form" do %>
    <%= hidden_field_tag :authenticity_token,
      form_authenticity_token(form_options: { action: bulk_approve_formulario_cadastros_path }),
      id: "bulk-csrf" %>
    <%= hidden_field_tag :_csrf_reject,
      form_authenticity_token(form_options: { action: bulk_reject_formulario_cadastros_path }),
      id: "bulk-csrf-reject" %>
    <div id="bulk-toolbar"
         class="hidden"
         data-approve-url="<%= bulk_approve_formulario_cadastros_path %>"
         data-reject-url="<%= bulk_reject_formulario_cadastros_path %>"
         style="display:flex; gap:.6rem; align-items:center; justify-content:space-between; background: #ff8c42; color: var(--color-btn); padding:.6rem .9rem; border-radius: 10px; margin-bottom: .8rem;">
      <div>
        <strong id="selected-count">0</strong> selecionado(s)
      </div>
      <div style="display:flex; gap:.4rem; flex-wrap:wrap;">
        <button type="button" id="btn-bulk-approve" class="btn btn-success">✅ Aprovar selecionados</button>
        <button type="button" id="btn-bulk-reject"  class="btn btn-warning">❌ Reprovar selecionados</button>
      </div>
      <input type="hidden" name="motivo" id="bulk-motivo">
    </div>
    <table id="participantsTable" class="rtable  selection-table" style="width: 100%;">
      <thead>
        <tr>
          <th class="sel-cell" style="display:none; width:36px; text-align:center;">
            <input type="checkbox" id="check-all">
          </th>
          <th class="col-foto keep-sm">Foto</th>
          <th class="col-nome keep-sm">Nome</th>
          <th class="col-cpf hide-md">CPF</th>
          <th class="col-fone hide-lg">Telefone</th>
          <th class="col-email">Email</th>
          <th class="col-cargo hide-md">Cargo</th>
          <th class="col-dias hide-md">Dias</th>
          <th class="col-horario hide-lg">Horário</th>
          <th class="th-actions keep-sm">
            <span>Ações</span>
            <div class="kebab-wrapper">
              <button id="aprovacoes-kebab" type="button" class="btn" title="Mais opções" style="padding:6px 10px;font-size: 1rem;">⋮</button>
              <div id="aprovacoes-menu" class="kebab-menu" hidden>
                <button type="button" class="menu-item js-toggle-selection">Selecionar</button>
                <button type="button" class="menu-item js-select-all hidden">Selecionar todos</button>
                <button type="button" class="menu-item js-clear-selection hidden">Limpar seleção</button>
              </div>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <% if (@formularios_pendentes || []).any? %>
          <% @formularios_pendentes.each do |f| %>
            <tr>
              <td class="sel-cell" style="display:none; text-align:center;">
                <input type="checkbox" class="row-check" name="ids[]" value="<%= f.id %>">
              </td>
              <td>
                <% if f.foto&.attached? %>
                  <% preview_url  = url_for(f.foto) %>
                  <% download_url = rails_blob_url(f.foto, disposition: "attachment") %>
                  <% filename     = f.foto.filename.to_s %>
                  <a href="#"
     class="js-show-photo"
     data-src="<%= preview_url %>"
     data-download="<%= download_url %>"
     data-filename="<%= filename %>"
     data-alt="Foto de <%= f.nome %>">
                    <img src="<%= preview_url %>"
         alt="Foto"
         style="width:50px;height:50px;border-radius:50%;object-fit:cover;">
                  </a>
                <% else %>
                  Sem Foto
                <% end %>
              </td>
              <td><%= f.nome %></td>
              <td><%= f.cpf %></td>
              <td><%= f.telefone %></td>
              <td><%= f.email.presence || "-" %></td>
              <td><%= f.cargo.presence || "-" %></td>
              <td><%= f.dias_trabalho.to_s.presence || "-" %></td>
              <td><%= f.horario_trabalho.to_s.presence || "-" %></td>
              <td style="display:flex; gap:.5rem; flex-wrap: wrap;">
                <% if current_user.admin? || current_user.operador? %>
                  <button type="button"
            class="btn btn-success js-approve-one"
            title="Aprovar"
            style= "width: -webkit-fill-available; text-align: center;"
            data-id="<%= f.id %>">
                    <i class="fa-solid fa-check"></i><div class="hide-sm">Aprovar</div>
                  </button>
                  <button type="button"
            class="btn btn-warning js-reject-one"
            title="Reprovar"
            style= "width: -webkit-fill-available; text-align: center;"
            data-id="<%= f.id %>"
            data-default-motivo="Reprovado pelo administrador">
                    <i class="fa-solid fa-ban"></i><div class="hide-sm">Reprovar</div>
                  </button>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="10" style="text-align:center; padding: 1rem;">Nenhum pré-cadastro pendente.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% elsif params[:tab] == 'reprovados' %>
  <table id="participantsTable" class="rtable  selection-table" style="width: 100%;">
    <thead>
      <tr>
        <!-- mantém a sel-cell oculta para bater estrutura -->
        <th class="sel-cell" style="display:none; width:36px; text-align:center;"></th>
        <th class="col-foto keep-sm">Foto</th>
        <th class="col-nome keep-sm" >Nome</th>
        <th class="col-cpf hide-md">CPF</th>
        <th class="col-fone hide-lg">Telefone</th>
        <th class="col-email">Email</th>
        <th class="col-cargo hide-md">Cargo</th>
        <th>Motivo da reprovação</th>
        <th class="th-actions keep-sm">
          <span>Ações</span>
          <!-- kebab “fantasma” só para preservar o mesmo layout/altura -->
        </th>
      </tr>
    </thead>
    <tbody>
      <% if (@formularios_reprovados || []).any? %>
        <% @formularios_reprovados.each do |f| %>
          <tr>
            <td class="sel-cell" style="display:none;"></td>
            <td>
              <% if f.foto&.attached? %>
                <img src="<%= url_for(f.foto) %>" alt="Foto" style="width:50px;height:50px;border-radius:50%;">
              <% else %>Sem Foto<% end %>
            </td>
            <td><%= f.nome %></td>
            <td><%= f.cpf %></td>
            <td><%= f.telefone %></td>
            <td><%= f.email.presence || "-" %></td>
            <td><%= f.cargo.presence || "-" %></td>
            <td><%= f.motivo_reprovacao.presence || "-" %></td>
            <td>
              <%= link_to edit_formulario_cadastro_path(f),
                    class: "btn edit",
                    title: "Editar",
                    style: "width: -webkit-fill-available; text-align: center;" do %>
                <i class="fa-solid fa-pen-to-square"></i><div class="hide-sm">EDITAR</div>
              <% end %>
              <%= button_to reenviar_para_aprovacao_formulario_cadastro_path(f),
                    method: :post,
                    class: "btn btn-success",
                    title: "Reenviar para aprovação",
                    style: "width: -webkit-fill-available; text-align: center;",
                    data: { confirm: "Enviar novamente este pré-cadastro para aprovação?" } do %>
                <i class="fa-solid fa-arrows-rotate"></i><div class="hide-sm">Reenviar para aprovação</div>
              <% end %>
              <% if current_user.admin? %>
                <%= button_to formulario_cadastro_path(f),
                      method: :delete,
                      class: "btn btn-warning",
                      title: "Excluir",
                      style: "width: -webkit-fill-available; text-align: center;",
                      data: { confirm: "Deseja excluir este pré-cadastro reprovado?" } do %>
                  <i class="fa-solid fa-trash"></i><div class="hide-sm">Excluir</div>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="9" style="text-align:center; padding: 1rem;">Nenhum pré-cadastro reprovado.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <!-- Lista de PARTICIPANTES (seu código original, sem mexer no CSS) -->
  <table id="participantsTable" class="rtable" style="width: 100%;">
    <thead>
      <tr>
        <th class="col-foto keep-sm">Foto</th>
        <th class="col-nome keep-sm">Nome</th>
        <th class="col-cpf hide-md">CPF</th>
        <th class="col-fone hide-lg">Telefone</th>
        <th class="col-email">Email</th>
        <th class="th-actions keep-sm">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% (@participants || []).each do |participant| %>
        <% password_recovery_chamado = @password_recovery_chamados_by_participant&.[](participant.id) %>
        <tr>
          <td>
            <% if participant.photo.attached? %>
              <img src="<%= url_for(participant.photo) %>" alt="Foto" style="width: 50px; height: 50px; border-radius: 50%;">
            <% else %>
              Sem Foto
