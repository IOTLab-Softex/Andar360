<!-- app/views/participants/index.html.erb -->
<%= form_with url: participants_path, method: :get, local: true, class: "filter-form" do %>
  <%= hidden_field_tag :tab, params[:tab] %>
  <div style="    display: flex
;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    justify-content: center;">
    <div>
      <i class="fa-solid fa-filter"></i>
      <%= label_tag :grupo_empresa_id, "Grupo Empresa" %><br>
      <% if current_user.admin? || current_user.operador? %>
        <%= select_tag :grupo_empresa_id,
      options_for_select(
        [["TODOS", ""]] + GrupoEmpresa.all.map { |g| [g.nome, g.id] },
        params[:grupo_empresa_id]
      ),
      class: "form-control" %>
      <% else %>
        <% empresa = current_user.participant&.grupo_empresa %>
        <% if empresa.present? %>
          <%= select_tag :grupo_empresa_id,
        options_for_select([[empresa.nome, empresa.id]], empresa.id),
        class: "form-control",
        disabled: true %>
        <% else %>
          <%= select_tag :grupo_empresa_id,
        options_for_select([["Nenhuma empresa", ""]], ""),
        class: "form-control",
        disabled: true %>
        <% end %>
      <% end %>
    </div>
    <div>
      <%= label_tag :sub_grupo_empresa_id, "Setor (Sub Grupos Empresa)" %><br>
      <%= select_tag :sub_grupo_empresa_id, 
    options_for_select([["TODOS", ""]], params[:sub_grupo_empresa_id]),
    class: "form-control", id: "subgrupo_filter" %>
    </div>
    <div>
      <%= label_tag :search, "Buscar por nome ou CPF" %><br>
      <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Digite nome ou CPF" %>
    </div>
    <div style="align-self: flex-end;">
      <%= submit_tag "Filtrar", class: "btn btn-filter" %>
    </div>
  </div>
<% end %>

<div class="tabs">
  <%= link_to "Usuários", participants_path(tab: 'ativos'), class: params[:tab] == 'ativos' ? 'active' : '' %>
  <%= link_to "Pendentes", participants_path(tab: 'pendentes'), class: params[:tab] == 'pendentes' ? 'active' : '' %>
  <%= link_to "Aguardando aprovação", participants_path(tab: 'aprovacoes'), class: params[:tab] == 'aprovacoes' ? 'active' : '' %>
  <%= link_to "Reprovados", participants_path(tab: 'reprovados'), class: params[:tab] == 'reprovados' ? 'active' : '' %>
  <% if current_user.admin? %>
    <%= link_to "Excluídos", participants_path(tab: 'excluidos'), class: params[:tab] == 'excluidos' ? 'active' : '' %>
  <% end %>
</div>
<% if params[:tab] == 'aprovacoes' %>
  <!-- Form único para enviar para approve ou reject (definimos a action via JS) -->
  <%= form_with url: bulk_approve_formulario_cadastros_path, method: :post, local: true, id: "bulk-form" do %>
    <%= hidden_field_tag :authenticity_token,
      form_authenticity_token(form_options: { action: bulk_approve_formulario_cadastros_path }),
      id: "bulk-csrf" %>
    <%= hidden_field_tag :_csrf_reject,
      form_authenticity_token(form_options: { action: bulk_reject_formulario_cadastros_path }),
      id: "bulk-csrf-reject" %>
    <div id="bulk-toolbar"
         class="hidden"
         data-approve-url="<%= bulk_approve_formulario_cadastros_path %>"
         data-reject-url="<%= bulk_reject_formulario_cadastros_path %>"
         style="display:flex; gap:.6rem; align-items:center; justify-content:space-between; background: #ff8c42; color: var(--color-btn); padding:.6rem .9rem; border-radius: 10px; margin-bottom: .8rem;">
      <div>
        <strong id="selected-count">0</strong> selecionado(s)
      </div>
      <div style="display:flex; gap:.4rem; flex-wrap:wrap;">
        <button type="button" id="btn-bulk-approve" class="btn btn-success">✅ Aprovar selecionados</button>
        <button type="button" id="btn-bulk-reject"  class="btn btn-warning">❌ Reprovar selecionados</button>
      </div>
      <input type="hidden" name="motivo" id="bulk-motivo">
    </div>
    <table id="participantsTable" class="rtable  selection-table" style="width: 100%;">
      <thead>
        <tr>
          <th class="sel-cell" style="display:none; width:36px; text-align:center;">
            <input type="checkbox" id="check-all">
          </th>
          <th class="col-foto keep-sm">Foto</th>
          <th class="col-nome keep-sm">Nome</th>
          <th class="col-cpf hide-md">CPF</th>
          <th class="col-fone hide-lg">Telefone</th>
          <th class="col-email">Email</th>
          <th class="col-cargo hide-md">Cargo</th>
          <th class="col-dias hide-md">Dias</th>
          <th class="col-horario hide-lg">Horário</th>
          <th class="th-actions keep-sm">
            <span>Ações</span>
            <div class="kebab-wrapper">
              <button id="aprovacoes-kebab" type="button" class="btn" title="Mais opções" style="padding:6px 10px;font-size: 1rem;">⋮</button>
              <div id="aprovacoes-menu" class="kebab-menu" hidden>
                <button type="button" class="menu-item js-toggle-selection">Selecionar</button>
                <button type="button" class="menu-item js-select-all hidden">Selecionar todos</button>
                <button type="button" class="menu-item js-clear-selection hidden">Limpar seleção</button>
              </div>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <% if (@formularios_pendentes || []).any? %>
          <% @formularios_pendentes.each do |f| %>
            <tr>
              <td class="sel-cell" style="display:none; text-align:center;">
                <input type="checkbox" class="row-check" name="ids[]" value="<%= f.id %>">
              </td>
              <td>
                <% if f.foto&.attached? %>
                  <% preview_url  = url_for(f.foto) %>
                  <% download_url = rails_blob_url(f.foto, disposition: "attachment") %>
                  <% filename     = f.foto.filename.to_s %>
                  <a href="#"
     class="js-show-photo"
     data-src="<%= preview_url %>"
     data-download="<%= download_url %>"
     data-filename="<%= filename %>"
     data-alt="Foto de <%= f.nome %>">
                    <img src="<%= preview_url %>"
         alt="Foto"
         style="width:50px;height:50px;border-radius:50%;object-fit:cover;">
                  </a>
                <% else %>
                  Sem Foto
                <% end %>
              </td>
              <td><%= f.nome %></td>
              <td><%= f.cpf %></td>
              <td><%= f.telefone %></td>
              <td><%= f.email.presence || "-" %></td>
              <td><%= f.cargo.presence || "-" %></td>
              <td><%= f.dias_trabalho.to_s.presence || "-" %></td>
              <td><%= f.horario_trabalho.to_s.presence || "-" %></td>
              <td style="display:flex; gap:.5rem; flex-wrap: wrap;">
                <% if current_user.admin? || current_user.operador? %>
                  <button type="button"
            class="btn btn-success js-approve-one"
            style= "width: -webkit-fill-available; text-align: center;"
            data-id="<%= f.id %>">
                    <i class="fa-solid fa-check"></i> Aprovar
                  </button>
                  <button type="button"
            class="btn btn-warning js-reject-one"
            style= "width: -webkit-fill-available; text-align: center;"
            data-id="<%= f.id %>"
            data-default-motivo="Reprovado pelo administrador">
                    <i class="fa-solid fa-ban"></i> Reprovar
                  </button>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="10" style="text-align:center; padding: 1rem;">Nenhum pré-cadastro pendente.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% elsif params[:tab] == 'reprovados' %>
  <table id="participantsTable" class="rtable  selection-table" style="width: 100%;">
    <thead>
      <tr>
        <!-- mantém a sel-cell oculta para bater estrutura -->
        <th class="sel-cell" style="display:none; width:36px; text-align:center;"></th>
        <th class="col-foto keep-sm">Foto</th>
        <th class="col-nome keep-sm" >Nome</th>
        <th class="col-cpf hide-md">CPF</th>
        <th class="col-fone hide-lg">Telefone</th>
        <th class="col-email">Email</th>
        <th class="col-cargo hide-md">Cargo</th>
        <th>Motivo da reprovação</th>
        <th class="th-actions keep-sm">
          <span>Ações</span>
          <!-- kebab “fantasma” só para preservar o mesmo layout/altura -->
        </th>
      </tr>
    </thead>
    <tbody>
      <% if (@formularios_reprovados || []).any? %>
        <% @formularios_reprovados.each do |f| %>
          <tr>
            <td class="sel-cell" style="display:none;"></td>
            <td>
              <% if f.foto&.attached? %>
                <img src="<%= url_for(f.foto) %>" alt="Foto" style="width:50px;height:50px;border-radius:50%;">
              <% else %>Sem Foto<% end %>
            </td>
            <td><%= f.nome %></td>
            <td><%= f.cpf %></td>
            <td><%= f.telefone %></td>
            <td><%= f.email.presence || "-" %></td>
            <td><%= f.cargo.presence || "-" %></td>
            <td><%= f.motivo_reprovacao.presence || "-" %></td>
            <td>
              <%= link_to edit_formulario_cadastro_path(f),
                    class: "btn edit",
                    style: "width: -webkit-fill-available; text-align: center;" do %>
                <i class="fa-solid fa-pen-to-square"></i> Editar
              <% end %>
              <%= button_to reenviar_para_aprovacao_formulario_cadastro_path(f),
                    method: :post,
                    class: "btn btn-success",
                    style: "width: -webkit-fill-available; text-align: center;",
                    data: { confirm: "Enviar novamente este pré-cadastro para aprovação?" } do %>
                <i class="fa-solid fa-arrows-rotate"></i> Reenviar para aprovação
              <% end %>
              <% if current_user.admin? %>
                <%= button_to formulario_cadastro_path(f),
                      method: :delete,
                      class: "btn btn-warning",
                      style: "width: -webkit-fill-available; text-align: center;",
                      data: { confirm: "Deseja excluir este pré-cadastro reprovado?" } do %>
                  <i class="fa-solid fa-trash"></i> Excluir
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="9" style="text-align:center; padding: 1rem;">Nenhum pré-cadastro reprovado.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <!-- Lista de PARTICIPANTES (seu código original, sem mexer no CSS) -->
  <table id="participantsTable" class="rtable" style="width: 100%;">
    <thead>
      <tr>
        <th class="col-foto keep-sm">Foto</th>
        <th class="col-nome keep-sm">Nome</th>
        <th class="col-cpf hide-md">CPF</th>
        <th class="col-fone hide-lg">Telefone</th>
        <th class="col-email">Email</th>
        <th class="th-actions keep-sm">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% (@participants || []).each do |participant| %>
        <tr>
          <td>
            <% if participant.photo.attached? %>
              <img src="<%= url_for(participant.photo) %>" alt="Foto" style="width: 50px; height: 50px; border-radius: 50%;">
            <% else %>
              Sem Foto
            <% end %>
          </td>
          <td><%= participant.name %></td>
          <td><%= participant.cpf %></td>
          <td><%= participant.telefone %></td>
          <td><%= participant.email.presence || "-" %></td>
          <td>
            <% if params[:tab] == 'excluidos' %>
              <%= button_to resgatar_participant_path(participant), method: :post, class: "btn btn-success", data: { confirm: "Deseja resgatar este participante?" } do %>
                <i class="fa-solid fa-rotate-left"></i> Resgatar
              <% end %>
              <%= button_to participant_path(participant),
                    method: :delete,
                    data: { confirm: "Tem certeza que deseja excluir este participante? Esta ação não poderá ser desfeita!" },
                    class: "btn btn-warning",
                    form: { style: "display: contents;" } do %>
                <i class="fa-solid fa-user-xmark"></i> Excluir
              <% end %>
            <% else %>
              <% if participant.solicitacao_exclusao_pendente.blank? %>
                <%= link_to edit_participant_path(participant), class: "btn edit", style: "width: -webkit-fill-available; text-align: center;" do %>
                  <i class="fa-solid fa-user-pen"></i> Editar
                <% end %>
                <% if current_user.admin? %>
                  <%= button_to participant_path(participant),
                        method: :delete,
                        data: { confirm: "Tem certeza que deseja excluir este participante?" },
                        class: "btn btn-warning",
                        style: "width: -webkit-fill-available; text-align: center;",
                        form: { style: "display: contents;" } do %>
                    <i class="fa-solid fa-user-xmark"></i> Excluir
                  <% end %>
                <% end %>
              <% end %>
              <% if params[:tab] == 'pendentes' %>
                <% if current_user.admin? %>
                  <%= button_to aprovar_exclusao_participant_path(participant), method: :post, class: "btn btn-success", style: "width: -webkit-fill-available; text-align: center;", data: { confirm: "Deseja realmente aprovar a exclusão deste participante?" } do %>
                    <i class="fa-solid fa-check"></i> Aprovar Exclusão
                  <% end %>
                <% end %>
                <% is_client = current_user.client? %>
                <% label_text   = is_client ? "Cancelar solicitação" : "Reprovar Solicitação" %>
                <% confirm_text = is_client ? "Deseja cancelar sua solicitação de exclusão deste participante?"
                                            : "Deseja reprovar a solicitação de exclusão deste participante?" %>
                <%= button_to reprovar_exclusao_participant_path(participant),
                      method: :post,
                      class: "btn btn-warning",
                      style: "width: -webkit-fill-available; text-align: center;",
                      data: { confirm: confirm_text } do %>
                  <i class="fa-solid fa-ban"></i> <%= label_text %>
                <% end %>
              <% elsif participant.solicitacao_exclusao_pendente.blank? %>
                <%= button_to solicitar_exclusao_participant_path(participant), method: :post, class: "btn btn-success", style: "width: -webkit-fill-available; text-align: center;" do %>
                  <i class="fa-solid fa-paper-plane"></i> Solicitar Exclusão
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
<%= form_with url: delete_all_participants_path, method: :delete, local: true, id: "delete-all-form", style: "display: none;" do %>
  <%= hidden_field_tag :grupo_empresa_id, params[:grupo_empresa_id] %>
  <%= hidden_field_tag :sub_grupo_empresa_id, params[:sub_grupo_empresa_id] %>
  <%= hidden_field_tag :search, params[:search] %>
<% end %>
<div id="photo-modal" class="photo-modal" hidden>
  <div class="photo-modal__backdrop"></div>
  <div class="photo-modal__dialog" role="dialog" aria-modal="true" aria-label="Visualização da foto">
    <button type="button" class="photo-modal__close" title="Fechar (Esc)">×</button>
    <img id="photo-modal-img" src="" alt="" />
    <div id="photo-modal-caption" class="photo-modal__caption"></div>
    <div class="photo-modal__actions">
      <a id="photo-download"
     class="btn btn-download"
     href="#"
     download
     rel="noopener">
        <i class="fa-solid fa-download"></i> Baixar
      </a>
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const lazyImages = [].slice.call(document.querySelectorAll("img.lazy"));

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            const img = entry.target;
            img.src = img.dataset.src;
            img.classList.remove("lazy");
            observer.unobserve(img);
          }
        });
      });

      lazyImages.forEach(function (img) {
        observer.observe(img);
      });
    } else {
      // Fallback para navegadores antigos
      lazyImages.forEach(function (img) {
        img.src = img.dataset.src;
      });
    }
  });

  document.addEventListener("DOMContentLoaded", function () {
    const empresaSelect = document.querySelector("select[name='grupo_empresa_id']");
    const subgrupoSelect = document.getElementById("subgrupo_filter");

    function carregarSubgrupos(grupoId, selectedId = null) {
      subgrupoSelect.innerHTML = '<option value="">Carregando...</option>';

      fetch(`/sub_grupo_empresas/por_empresa/${grupoId}`)
        .then(response => response.json())
        .then(data => {
          subgrupoSelect.innerHTML = '<option value="">TODOS</option>';
          data.forEach(sub => {
            const option = document.createElement("option");
            option.value = sub.id;
            option.textContent = sub.nome;
            if (selectedId && selectedId == sub.id) {
              option.selected = true;
            }
            subgrupoSelect.appendChild(option);
          });
        });
    }

    if (empresaSelect) {
      empresaSelect.addEventListener("change", function () {
        if (this.value) {
          carregarSubgrupos(this.value);
        } else {
          subgrupoSelect.innerHTML = '<option value="">TODOS</option>';
        }
      });

      // Se já houver empresa selecionada, carregar os subgrupos ao iniciar
      if (empresaSelect.value) {
        const selectedSubgrupo = "<%= params[:sub_grupo_empresa_id].to_s %>";
        carregarSubgrupos(empresaSelect.value, selectedSubgrupo);
      }
    }
  });




  document.addEventListener("DOMContentLoaded", function () {
  const empresaSelect = document.querySelector("select[name='grupo_empresa_id']");
  if (empresaSelect && window.Choices) {           // ✅ só usa se existir
    const choices = new Choices(empresaSelect, {
      searchEnabled: true,
      itemSelectText: '',
      placeholderValue: 'Selecione uma empresa',
      shouldSort: false
    });
    if (!empresaSelect.value) choices.setChoiceByValue('');
  }
  });







   document.addEventListener("DOMContentLoaded", function () {
    const flash = document.getElementById("notification-flash");

    if (flash) {
      const message = flash.dataset.message;
      const type = flash.dataset.type;

      Swal.fire({
        icon: type,
        title: type === "success" ? "Sucesso!" : "Atenção",
        text: message,
        timer: 4000,
        showConfirmButton: false
      });
    }
  });





  // ... (seu código anterior)



  // ✅ Só mostra o flash se Swal existir
  document.addEventListener("DOMContentLoaded", function () {
    const flash = document.getElementById("notification-flash");
    if (flash && window.Swal) {
      Swal.fire({ icon: flash.dataset.type, title: flash.dataset.type === "success" ? "Sucesso!" : "Atenção", text: flash.dataset.message, timer: 4000, showConfirmButton: false });
    }
  });

  // ✅ Kebab / Seleção em massa (com bind seguro)
  function initAprovacoesMenu(){
    const kebabBtn  = document.getElementById("aprovacoes-kebab");
    const kebabMenu = document.getElementById("aprovacoes-menu");
    if (!kebabBtn || !kebabMenu) return;

    if (kebabBtn.dataset.bound === "1") return; // evita bind duplicado (Turbo)
    kebabBtn.dataset.bound = "1";

    const bulkBar    = document.getElementById("bulk-toolbar");
    const selectAll  = document.getElementById("select-all");
    const clearSel   = document.getElementById("clear-selection");
    const toggleSel  = document.getElementById("toggle-selection");
    const table      = document.querySelector("table.selection-table");
    const checkAll   = document.getElementById("check-all");
    const selectedCt = document.getElementById("selected-count");
    const bulkForm   = document.getElementById("bulk-form");
    const approveBtn = document.getElementById("btn-bulk-approve");
    const rejectBtn  = document.getElementById("btn-bulk-reject");
    const motivoInp  = document.getElementById("bulk-motivo");
    const approveURL = bulkBar ? bulkBar.dataset.approveUrl : null;
    const rejectURL  = bulkBar ? bulkBar.dataset.rejectUrl  : null;

    // abre/fecha o menu
    kebabBtn.addEventListener("click", (e) => {
      e.preventDefault(); e.stopPropagation();
      kebabMenu.hidden = !kebabMenu.hidden;
    });
    document.addEventListener("click", (e) => {
      if (!kebabMenu.hidden && !kebabMenu.contains(e.target) && e.target !== kebabBtn) kebabMenu.hidden = true;
    });

    const selCells  = () => table ? table.querySelectorAll(".sel-cell") : [];
    const rowChecks = () => table ? table.querySelectorAll(".row-check") : [];
    function updateCount(){ if (selectedCt) selectedCt.textContent = Array.from(rowChecks()).filter(ch=>ch.checked).length; }
    function enableSelectionMode(enable){
      selCells().forEach(td => td.style.display = enable ? "table-cell" : "none");
      if (bulkBar)  bulkBar.classList.toggle("hidden", !enable);
      if (selectAll) selectAll.classList.toggle("hidden", !enable);
      if (clearSel)  clearSel.classList.toggle("hidden", !enable);
      updateCount();
    }

    if (toggleSel) toggleSel.addEventListener("click", () => { enableSelectionMode(true); kebabMenu.hidden = true; });
    if (selectAll) selectAll.addEventListener("click", () => {
      rowChecks().forEach(ch => ch.checked = true);
      if (checkAll) checkAll.checked = true;
      updateCount(); kebabMenu.hidden = true;
    });
    if (clearSel) clearSel.addEventListener("click", () => {
      rowChecks().forEach(ch => ch.checked = false);
      if (checkAll) checkAll.checked = false;
      updateCount(); kebabMenu.hidden = true;
    });

    if (checkAll) checkAll.addEventListener("change", function(){
      rowChecks().forEach(ch => ch.checked = this.checked);
      updateCount();
    });
    if (table) table.addEventListener("change", (e) => { if (e.target.classList.contains("row-check")) updateCount(); });

    if (approveBtn) approveBtn.addEventListener("click", () => {
      if (Array.from(rowChecks()).every(ch => !ch.checked)) { window.Swal && Swal.fire({ icon:'warning', title:'Atenção', text:'Selecione pelo menos um pré-cadastro.' }); return; }
      bulkForm.setAttribute("action", approveURL); bulkForm.submit();
    });

    if (rejectBtn) rejectBtn.addEventListener("click", async () => {
      if (Array.from(rowChecks()).every(ch => !ch.checked)) { window.Swal && Swal.fire({ icon:'warning', title:'Atenção', text:'Selecione pelo menos um pré-cadastro.' }); return; }
      if (window.Swal) {
        const { value: motivo } = await Swal.fire({ title:'Motivo da reprovação', input:'text', inputPlaceholder:'Digite o motivo (opcional)', showCancelButton:true, confirmButtonText:'Reprovar', cancelButtonText:'Cancelar' });
        if (motivo === undefined) return;
        motivoInp.value = motivo || "Reprovado em massa";
      }
      bulkForm.setAttribute("action", rejectURL); bulkForm.submit();
    });
  }

  // roda com Turbo e no load normal
  document.addEventListener("turbo:load", initAprovacoesMenu);
  document.addEventListener("DOMContentLoaded", initAprovacoesMenu);
  document.addEventListener("turbo:before-cache", () => { const m = document.getElementById("aprovacoes-menu"); if (m) m.hidden = true; });


  function initAprovacoesMenu(){
    const wrapper   = document.querySelector(".kebab-wrapper");
    const kebabBtn  = document.getElementById("aprovacoes-kebab");
    const kebabMenu = document.getElementById("aprovacoes-menu");
    if (!wrapper || !kebabBtn || !kebabMenu) return;
    if (wrapper.dataset.bound === "1") return; // evita bind duplicado (Turbo)
    wrapper.dataset.bound = "1";

    const table      = document.querySelector("table.selection-table");
    const bulkBar    = document.getElementById("bulk-toolbar");
    const checkAll   = document.getElementById("check-all");
    const selectedCt = document.getElementById("selected-count");
    const bulkForm   = document.getElementById("bulk-form");
    const approveBtn = document.getElementById("btn-bulk-approve");
    const rejectBtn  = document.getElementById("btn-bulk-reject");
    const motivoInp  = document.getElementById("bulk-motivo");
    const approveURL = bulkBar?.dataset.approveUrl || "";
    const rejectURL  = bulkBar?.dataset.rejectUrl  || "";

    // ⚠️ busca pelos itens do menu por CLASSE (batendo com o HTML)
    const toggleSel = kebabMenu.querySelector(".js-toggle-selection");
    const selectAll = kebabMenu.querySelector(".js-select-all");
    const clearSel  = kebabMenu.querySelector(".js-clear-selection");

    // Abre/fecha menu
    kebabBtn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      kebabMenu.hidden = !kebabMenu.hidden;
    });
    document.addEventListener("click", (e) => {
      if (!kebabMenu.hidden && !kebabMenu.contains(e.target) && e.target !== kebabBtn) {
        kebabMenu.hidden = true;
      }
    });

    const rowChecks = () => table ? table.querySelectorAll(".row-check") : [];
    function updateCount(){
      if (!selectedCt) return;
      selectedCt.textContent = Array.from(rowChecks()).filter(ch => ch.checked).length;
    }
    function enableSelectionMode(enable){
      if (!table || !bulkBar) return;
      table.classList.toggle("table--select", !!enable);
      bulkBar.classList.toggle("hidden", !enable);
      selectAll?.classList.toggle("hidden", !enable);
      clearSel?.classList.toggle("hidden", !enable);
      updateCount();
    }

    toggleSel?.addEventListener("click", () => {
      enableSelectionMode(true);
      kebabMenu.hidden = true;
    });

    selectAll?.addEventListener("click", () => {
      rowChecks().forEach(ch => ch.checked = true);
      if (checkAll) checkAll.checked = true;
      updateCount();
      kebabMenu.hidden = true;
    });

    clearSel?.addEventListener("click", () => {
      rowChecks().forEach(ch => ch.checked = false);
      if (checkAll) checkAll.checked = false;
      updateCount();
      kebabMenu.hidden = true;
    });

    checkAll?.addEventListener("change", function(){
      rowChecks().forEach(ch => ch.checked = this.checked);
      updateCount();
    });

    table?.addEventListener("change", (e) => {
      if (e.target.classList.contains("row-check")) updateCount();
    });

    // Submit em massa
    approveBtn?.addEventListener("click", () => {
      if (Array.from(rowChecks()).every(ch => !ch.checked)) {
        window.Swal && Swal.fire({ icon:'warning', title:'Atenção', text:'Selecione pelo menos um pré-cadastro.' });
        return;
      }
      bulkForm.setAttribute("action", approveURL);
      bulkForm.requestSubmit ? bulkForm.requestSubmit() : bulkForm.submit();
    });

    rejectBtn?.addEventListener("click", async () => {
      if (Array.from(rowChecks()).every(ch => !ch.checked)) {
        window.Swal && Swal.fire({ icon:'warning', title:'Atenção', text:'Selecione pelo menos um pré-cadastro.' });
        return;
      }
      if (window.Swal) {
        const { value: motivo } = await Swal.fire({
          title:'Motivo da reprovação', input:'text',
          inputPlaceholder:'Digite o motivo (opcional)',
          showCancelButton:true, confirmButtonText:'Reprovar', cancelButtonText:'Cancelar'
        });
        if (motivo === undefined) return;
        motivoInp.value = motivo || "Reprovado em massa";
      }
      // injeta token específico de reject
      const csrfApprove = document.getElementById("bulk-csrf");
      const csrfReject  = document.getElementById("bulk-csrf-reject");
      if (csrfApprove && csrfReject) csrfApprove.value = csrfReject.value;

      bulkForm.setAttribute("action", rejectURL);
      bulkForm.requestSubmit ? bulkForm.requestSubmit() : bulkForm.submit();
    });

    // Fecha o menu antes do cache do Turbo (evita “menu travado” ao voltar)
    document.addEventListener("turbo:before-cache", () => { if (kebabMenu) kebabMenu.hidden = true; });
  }

  document.addEventListener("turbo:load", initAprovacoesMenu);
  document.addEventListener("DOMContentLoaded", initAprovacoesMenu);




  document.addEventListener("DOMContentLoaded", function () {
  const bulkForm   = document.getElementById("bulk-form");
  const bulkBar    = document.getElementById("bulk-toolbar");
  const approveURL = bulkBar?.dataset.approveUrl;
  const rejectURL  = bulkBar?.dataset.rejectUrl;
  const motivoInp  = document.getElementById("bulk-motivo");

  function submitOne(id, url, motivo, isReject = false) {
  const bulkForm   = document.getElementById("bulk-form");
  const motivoInp  = document.getElementById("bulk-motivo");
  const csrfInput  = document.getElementById("bulk-csrf");

  // ids[]
  const tmp = document.createElement("input");
  tmp.type = "hidden";
  tmp.name = "ids[]";
  tmp.value = id;
  bulkForm.appendChild(tmp);

  if (motivo !== undefined) motivoInp.value = motivo || "";

  // ✅ se for reject, troca o token pelo específico da action de reject
  if (isReject) {
    const rejectToken = document.getElementById("bulk-csrf-reject").value;
    csrfInput.value = rejectToken;
  }

  bulkForm.setAttribute("action", url);

  // use requestSubmit para simular submit "real"
  if (bulkForm.requestSubmit) {
    bulkForm.requestSubmit();
  } else {
    bulkForm.submit();
  }
  }


  document.addEventListener("click", async (e) => {
    const btn = e.target.closest(".js-approve-one, .js-reject-one");
    if (!btn) return;

    const id = btn.dataset.id;

    if (btn.classList.contains("js-approve-one")) {
      // confirmar (opcional)
      if (window.Swal) {
        const ok = await Swal.fire({title:"Aprovar?", text:"Aprovar este pré-cadastro e criar o participante?", icon:"question", showCancelButton:true})
          .then(r=>r.isConfirmed);
        if (!ok) return;
      }
      submitOne(id, approveURL);
    } else {
      // Reprovar com motivo (opcional)
      let motivo = btn.dataset.defaultMotivo || "Reprovado";
      if (window.Swal) {
        const res = await Swal.fire({title:"Motivo da reprovação", input:"text", inputValue: motivo, showCancelButton:true});
        if (!res.isConfirmed) return;
        motivo = res.value || motivo;
      }
      submitOne(id, rejectURL, motivo, true);
    }
  });
  });

  // script do modal da foto

  (function(){
  function bindPhotoModal(){
    const modal   = document.getElementById('photo-modal');
    const imgEl   = document.getElementById('photo-modal-img');
    const caption = document.getElementById('photo-modal-caption');


    if (!modal || !imgEl || !caption) return;

    document.addEventListener('click', function(e){
      const a = e.target.closest('.js-show-photo');
  if (!a) return;
  e.preventDefault();

  const src = a.dataset.src;
  const alt = a.dataset.alt && a.dataset.alt.trim() !== '' ? a.dataset.alt : 'Foto';
  if (!src) return;

  imgEl.src = src;
  imgEl.alt = alt;
  caption.textContent = alt;

  // 👉 atualiza o botão de download com a URL/arquivo corretos
  const dl = document.getElementById('photo-download');
  if (dl) {
    const dlHref = a.dataset.download || src;
    const dlName = a.dataset.filename || 'foto.jpg';
    dl.href = dlHref;
    dl.setAttribute('download', dlName);
  }

  modal.hidden = false;
  document.documentElement.style.overflow = 'hidden';
  });

    modal.addEventListener('click', function(e){
      if (e.target.classList.contains('photo-modal__backdrop') ||
          e.target.classList.contains('photo-modal__close')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    function closeModal(){
      modal.hidden = true;
      imgEl.src = '';
      document.documentElement.style.overflow = '';
    }
  }

  document.addEventListener('DOMContentLoaded', bindPhotoModal);
  document.addEventListener('turbo:load', bindPhotoModal);
  })()


  document.addEventListener('click', (e) => {
  const a = e.target.closest('.js-show-photo');
  if (a) { console.log('CLICOU NA MINIATURA', a.dataset.src); }
  });


  // responsividade das tabelas //

  (function(){
  const COL_RE = /^(hide-(xs|sm|md|lg|xl)|keep-sm)$/;

  function applyResponsiveHiding(table){
    const head = table.tHead;
    if (!head || !head.rows.length) return;

    const thRow = head.rows[0];
    const colClasses = Array.from(thRow.cells).map(th => {
      const fromClass = Array.from(th.classList).filter(c => COL_RE.test(c));
      const fromData  = (th.dataset.hide || "")
        .split(/\s+/).filter(Boolean)
        .map(bp => `hide-${bp}`)
        .filter(c => COL_RE.test(c));
      return Array.from(new Set([...fromClass, ...fromData]));
    });

    Array.from(table.tBodies).forEach(tbody => {
      Array.from(tbody.rows).forEach(tr => {
        colClasses.forEach((classes, idx) => {
          if (!classes.length) return;
          const cell = tr.cells[idx];
          if (cell) cell.classList.add(...classes);
        });
      });
    });
  }

  function init(){
    document.querySelectorAll('table.rtable').forEach(applyResponsiveHiding);
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('turbo:load', init);
  })();
</script>
