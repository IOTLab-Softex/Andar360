  document.addEventListener("DOMContentLoaded", function () {
  const bulkForm   = document.getElementById("bulk-form");
  const bulkBar    = document.getElementById("bulk-toolbar");
  const approveURL = bulkBar?.dataset.approveUrl;
  const rejectURL  = bulkBar?.dataset.rejectUrl;
  const motivoInp  = document.getElementById("bulk-motivo");

  function submitOne(id, url, motivo, isReject = false) {
  const bulkForm   = document.getElementById("bulk-form");
  const motivoInp  = document.getElementById("bulk-motivo");
  const csrfInput  = document.getElementById("bulk-csrf");

  // ids[]
  const tmp = document.createElement("input");
  tmp.type = "hidden";
  tmp.name = "ids[]";
  tmp.value = id;
  bulkForm.appendChild(tmp);

  if (motivo !== undefined) motivoInp.value = motivo || "";

  // ✅ se for reject, troca o token pelo específico da action de reject
  if (isReject) {
    const rejectToken = document.getElementById("bulk-csrf-reject").value;
    csrfInput.value = rejectToken;
  }

  bulkForm.setAttribute("action", url);

  // use requestSubmit para simular submit "real"
  if (bulkForm.requestSubmit) {
    bulkForm.requestSubmit();
  } else {
    bulkForm.submit();
  }
  }


  document.addEventListener("click", async (e) => {
    const btn = e.target.closest(".js-approve-one, .js-reject-one");
    if (!btn) return;

    const id = btn.dataset.id;

    if (btn.classList.contains("js-approve-one")) {
      // confirmar (opcional)
      if (window.Swal) {
        const ok = await Swal.fire({title:"Aprovar?", text:"Aprovar este pré-cadastro e criar o participante?", icon:"question", showCancelButton:true})
          .then(r=>r.isConfirmed);
        if (!ok) return;
      }
      submitOne(id, approveURL);
    } else {
      // Reprovar com motivo (opcional)
      let motivo = btn.dataset.defaultMotivo || "Reprovado";
      if (window.Swal) {
        const res = await Swal.fire({title:"Motivo da reprovação", input:"text", inputValue: motivo, showCancelButton:true});
        if (!res.isConfirmed) return;
        motivo = res.value || motivo;
      }
      submitOne(id, rejectURL, motivo, true);
    }
  });
  });

  // script do modal da foto

  (function(){
  function bindPhotoModal(){
    const modal   = document.getElementById('photo-modal');
    const imgEl   = document.getElementById('photo-modal-img');
    const caption = document.getElementById('photo-modal-caption');


    if (!modal || !imgEl || !caption) return;

    document.addEventListener('click', function(e){
      const a = e.target.closest('.js-show-photo');
  if (!a) return;
  e.preventDefault();

  const src = a.dataset.src;
  const alt = a.dataset.alt && a.dataset.alt.trim() !== '' ? a.dataset.alt : 'Foto';
  if (!src) return;

  imgEl.src = src;
  imgEl.alt = alt;
  caption.textContent = alt;

  // 👉 atualiza o botão de download com a URL/arquivo corretos
  const dl = document.getElementById('photo-download');
  if (dl) {
    const dlHref = a.dataset.download || src;
    const dlName = a.dataset.filename || 'foto.jpg';
    dl.href = dlHref;
    dl.setAttribute('download', dlName);
  }

  modal.hidden = false;
  document.documentElement.style.overflow = 'hidden';
  });

    modal.addEventListener('click', function(e){
      if (e.target.classList.contains('photo-modal__backdrop') ||
          e.target.classList.contains('photo-modal__close')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    function closeModal(){
      modal.hidden = true;
      imgEl.src = '';
      document.documentElement.style.overflow = '';
    }
  }

  document.addEventListener('DOMContentLoaded', bindPhotoModal);
  document.addEventListener('turbo:load', bindPhotoModal);
  })()


  document.addEventListener('click', (e) => {
  const a = e.target.closest('.js-show-photo');
  if (a) { console.log('CLICOU NA MINIATURA', a.dataset.src); }
  });


  // responsividade das tabelas //

  (function(){
  const COL_RE = /^(hide-(xs|sm|md|lg|xl)|keep-sm)$/;

  function applyResponsiveHiding(table){
    const head = table.tHead;
    if (!head || !head.rows.length) return;

    const thRow = head.rows[0];
    const colClasses = Array.from(thRow.cells).map(th => {
      const fromClass = Array.from(th.classList).filter(c => COL_RE.test(c));
      const fromData  = (th.dataset.hide || "")
        .split(/\s+/).filter(Boolean)
        .map(bp => `hide-${bp}`)
        .filter(c => COL_RE.test(c));
      return Array.from(new Set([...fromClass, ...fromData]));
    });

    Array.from(table.tBodies).forEach(tbody => {
      Array.from(tbody.rows).forEach(tr => {
        colClasses.forEach((classes, idx) => {
          if (!classes.length) return;
          const cell = tr.cells[idx];
          if (cell) cell.classList.add(...classes);
        });
      });
    });
  }

  function init(){
    document.querySelectorAll('table.rtable').forEach(applyResponsiveHiding);
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('turbo:load', init);
  })();


  function initFiltroParticipantsCollapse(){
  const toggle = document.getElementById('filtro-toggle');
  const filtros = document.getElementById('filtros-participants');
  if (!toggle || !filtros) return;

  const STORAGE_KEY = 'ui:filtros-participants-collapsed';

  // evita bind duplicado (Turbo)
  if (toggle.dataset.bound === "1") return;
  toggle.dataset.bound = "1";

  const saved = localStorage.getItem(STORAGE_KEY);
  const startCollapsed = saved === '1';

  function setCollapsed(collapsed, save = true) {
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function markDone(e){
    if (e && e.propertyName && e.propertyName !== 'max-height') return;
    filtros.classList.add('is-collapsed-done');
    filtros.removeEventListener('transitionend', markDone);
  }

  if (collapsed) {
    // antes de animar, garante que o conteúdo existe
    filtros.classList.remove('is-collapsed-done');

    const curH = filtros.scrollHeight;
    filtros.style.maxHeight = curH + 'px';
    filtros.offsetHeight;

    filtros.classList.add('collapsed');

    if (prefersReduced) {
      filtros.style.maxHeight = '0px';
      filtros.classList.add('is-collapsed-done');
    } else {
      filtros.style.maxHeight = '0px';
      filtros.addEventListener('transitionend', markDone);
    }

    toggle.setAttribute('aria-expanded', 'false');
    filtros.setAttribute('aria-hidden', 'true');
    if (save) localStorage.setItem(STORAGE_KEY, '1');

  } else {
    // abrindo: precisa remover o done pra voltar padding/border e mostrar row
    filtros.classList.remove('collapsed');
    filtros.classList.remove('is-collapsed-done');

    filtros.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');

    const targetH = filtros.scrollHeight;

    if (prefersReduced) {
      filtros.style.maxHeight = '';
    } else {
      filtros.style.maxHeight = '0px';
      filtros.offsetHeight;
      filtros.style.maxHeight = targetH + 'px';

      const cleanup = (e) => {
        if (e && e.propertyName && e.propertyName !== 'max-height') return;
        filtros.style.maxHeight = '';
        filtros.removeEventListener('transitionend', cleanup);
      };
      filtros.addEventListener('transitionend', cleanup);
    }

    if (save) localStorage.removeItem(STORAGE_KEY);
  }
}



  // estado inicial
if (startCollapsed) {
  filtros.classList.add('collapsed');
  filtros.classList.add('is-collapsed-done'); // ✅ sem ponto
  filtros.setAttribute('aria-hidden', 'true');
  toggle.setAttribute('aria-expanded', 'false');
  filtros.style.maxHeight = '0px';
} else {
  filtros.classList.remove('collapsed');
  filtros.classList.remove('is-collapsed-done');
  filtros.setAttribute('aria-hidden', 'false');
  toggle.setAttribute('aria-expanded', 'true');
  filtros.style.maxHeight = '';
}


  toggle.addEventListener('click', (ev) => {
    ev.preventDefault();
    setCollapsed(!filtros.classList.contains('collapsed'), true);
  });

  function isOpen() {
  return toggle.getAttribute('aria-expanded') === 'true';
}

function openIfClosed() {
  if (!filtros.classList.contains('collapsed')) return; // já aberto, não mexe
  setCollapsed(false, false);
}

// abre só quando clicar/focar DENTRO do filtro (sem ser o botão)
filtros.addEventListener('focusin', (e) => {
  // se o foco veio de um clique no botão toggle, ignora
  if (e.target.closest('#filtro-toggle')) return;
  openIfClosed();
});

}

document.addEventListener('DOMContentLoaded', initFiltroParticipantsCollapse);
document.addEventListener('turbo:load', initFiltroParticipantsCollapse);
document.addEventListener('turbo:before-cache', () => {
  const toggle = document.getElementById('filtro-toggle');
  if (toggle) toggle.dataset.bound = "";
});

document.addEventListener("submit", async function(e) {
  const form = e.target;
  if (!form.dataset.confirmResetLink) return;

  e.preventDefault();

  const btn = e.submitter;
  const nome = (btn && btn.dataset.recordName) || form.dataset.recordName || "este usuario";

  if (window.Swal) {
    const res = await Swal.fire({
      title: "Enviar link de redefinicao?",
      html: `Deseja realmente enviar o link de redefinicao para <b>${nome}</b>?`,
      icon: "question",
      showCancelButton: true,
      confirmButtonText: "Sim, enviar",
      cancelButtonText: "Cancelar",
      reverseButtons: true,
      focusCancel: true
    });
    if (res.isConfirmed) form.submit();
  } else if (confirm(`Deseja realmente enviar o link de redefinicao para ${nome}?`)) {
    form.submit();
  }
});

</script>





