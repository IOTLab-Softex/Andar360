    };

    new Choices(empresaSelect, searchableSelectOptions);
    const subgrupoChoices = new Choices(subgrupoSelect, searchableSelectOptions);

    function setSubgrupoOptions(items, selectedId = "") {
      subgrupoChoices.clearStore();
      subgrupoChoices.setChoices(items, "value", "label", true);
      subgrupoChoices.setChoiceByValue(String(selectedId || ""));
    }

    function loadSearchableSubgrupos(grupoId, selectedId = "") {
      setSubgrupoOptions([{ value: "", label: "Carregando..." }]);

      if (!grupoId) {
        setSubgrupoOptions([{ value: "", label: "TODOS" }]);
        return;
      }

      fetch(`/sub_grupo_empresas/por_empresa/${grupoId}`)
        .then(response => response.json())
        .then(data => {
          const items = [{ value: "", label: "TODOS" }].concat(
            data.map(sub => ({ value: String(sub.id), label: sub.nome }))
          );
          setSubgrupoOptions(items, selectedId);
        })
        .catch(() => setSubgrupoOptions([{ value: "", label: "TODOS" }]));
    }

    empresaSelect.addEventListener("change", function () {
