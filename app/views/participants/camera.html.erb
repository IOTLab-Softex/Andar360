<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Captura de Foto</title>
  <style>
    body {
      margin: 0;
      background: #111;
      color: white;
      text-align: center;
      font-family: Arial, sans-serif;
    }

    #videoContainer {
      position: relative;
      display: inline-block;
      border: 2px solid #fff;
      border-radius: 10px;
      overflow: hidden;
    }

    #video, #canvas {
      width: 500px;
      height: 400px;
      display: block;
      border-radius: 10px;
    }

    #canvas {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;
    }

    #video {
      z-index: 1;
    }

    h2 {
      margin: 20px;
      font-weight: normal;
      color: #f0f0f0;
    }

    #captureBtn {
      margin-top: 15px;
      padding: 12px 25px;
      background-color: #28a745;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
      color: white;
      cursor: pointer;
      transition: background-color 0.3s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }

    #captureBtn:hover:enabled {
      background-color: #218838;
    }

    #captureBtn:disabled {
      background-color: #555;
      cursor: not-allowed;
      opacity: 0.6;
    }


@keyframes pulseHint { 0%{transform:translateX(-50%) scale(1)}
  50%{transform:translateX(-50%) scale(1.05)} 100%{transform:translateX(-50%) scale(1)} }
#lookHint{ animation:pulseHint 1.2s ease-in-out infinite; }

  </style>
</head>
<body>
  <h2 id="faceStatus">Detectando rosto...</h2>

  <div id="videoContainer">
    <video id="video" autoplay muted playsinline></video>
    <canvas id="canvas"></canvas>
    <div id="countdown"
     style="position:absolute; right:22px; top:10px; width:52px; height:52px; border-radius:50%;
            background:rgba(0,0,0,.55); display:none; color:#fff; font-weight:700;
            line-height:52px; text-align:center; font-size:20px; z-index:3;">
  8
</div>
<div id="lookHint"
     style="position:absolute; left:50%; top:10px; transform:translateX(-50%);
            background:rgba(0,0,0,.6); color:#fff; padding:8px 12px; border-radius:10px;
            font-weight:900; display:none; z-index:3; letter-spacing:.2px;">
  Olhe para a câmera 👀
</div>

  </div>

  <br>
  <button id="captureBtn" onclick="capturePhoto()" disabled>Sem rosto...</button>

  <script defer src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>

  <script>
    const video = document.getElementById("video");
    const canvas = document.getElementById("canvas");
    const captureBtn = document.getElementById("captureBtn");
    const faceStatus = document.getElementById("faceStatus");
    let lastDetection = null;
let countdownStart = null;   // quando a contagem começou
let autoShotTimeout = null;  // timeout da captura automática
const COUNTDOWN_SECONDS = 8; // ⏱️ ajuste aqui
const lookHint = document.getElementById('lookHint');

    async function startVideo() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true });
        video.srcObject = stream;
      } catch (err) {
        alert("Erro ao acessar a câmera: " + err.message);
      }
    }

      function resetCountdown() {
    if (autoShotTimeout) {
      clearTimeout(autoShotTimeout);
      autoShotTimeout = null;
    }
    countdownStart = null;
    const cd = document.getElementById('countdown');
    if (cd) cd.style.display = 'none';
    // volta o texto do botão, mas mantém habilitado/desabilitado pelo loop
    captureBtn.textContent = "📸 Capturar";
     if (lookHint) lookHint.style.display = 'none';   // 👈 esconde o aviso
  }

    async function loadModels() {
      await faceapi.nets.tinyFaceDetector.loadFromUri('/models/tiny_face_detector');
      checkFaceLoop();
    }

    function checkFaceLoop() {
      video.addEventListener('play', () => {
        const displaySize = { width: video.videoWidth, height: video.videoHeight };
        faceapi.matchDimensions(canvas, displaySize);

        setInterval(async () => {
          // onde você chama detectSingleFace:
const detection = await faceapi.detectSingleFace(
  video,
  new faceapi.TinyFaceDetectorOptions({ inputSize: 416, scoreThreshold: 0.5 })
);

          const ctx = canvas.getContext("2d");
ctx.clearRect(0, 0, canvas.width, canvas.height);

const cd = document.getElementById('countdown');

if (detection && detection.box) {
  lastDetection = detection.box;

  const displaySize = { width: video.videoWidth, height: video.videoHeight };
  const { width, height } = detection.box;
  const faceWidthRatio  = width  / displaySize.width;
  const faceHeightRatio = height / displaySize.height;

  // limites de enquadramento (ajuste se quiser)
  const MIN_RATIO = 0.40; // muito distante abaixo disso
  const MAX_RATIO = 0.70; // muito perto acima disso
  const ratio = Math.max(faceWidthRatio, faceHeightRatio);

  // (opcional) exigir "confiança" mínima do detector para chamar de nítido
  const goodScore = (detection.score ?? 1) >= 0.6;

  if (ratio > MAX_RATIO) {
    // muito perto → zera contagem
    resetCountdown();
    captureBtn.disabled = true;
    captureBtn.textContent = "Muito perto!";
    faceStatus.textContent = "Rosto muito próximo, afaste-se levemente.";
     if (lookHint) lookHint.style.display = 'none';   // 👈
  } else if (ratio >= MIN_RATIO && goodScore) {
    // enquadramento ok → habilita e inicia/atualiza contagem
    captureBtn.disabled = false;

    if (!countdownStart) {
      countdownStart = performance.now();
      // agenda captura automática
      autoShotTimeout = setTimeout(() => {
        capturePhoto();
        resetCountdown();
      }, COUNTDOWN_SECONDS * 1000);
      if (cd) cd.style.display = 'block';

       if (lookHint) {
      lookHint.style.display = 'block';
      lookHint.textContent = "Olhe para a câmera 👀";
    }

    }

    // atualiza UI da contagem
    const elapsed = (performance.now() - countdownStart) / 1000;
    const left = Math.max(0, Math.ceil(COUNTDOWN_SECONDS - elapsed));
    captureBtn.textContent = `📸 Capturar (auto em ${left}s)`;
    faceStatus.textContent = "Rosto detectado com boa nitidez.";
    if (cd) cd.textContent = left.toString();
     if (lookHint) {
    lookHint.style.display = 'block';
    lookHint.textContent = "Olhe para a câmera 👀";
  }
  } else {
    // distante ou score baixo → zera contagem
    resetCountdown();
    captureBtn.disabled = true;
    captureBtn.textContent = "Aproxime o rosto...";
    faceStatus.textContent = goodScore
      ? "Muito distante, aproxime-se da câmera."
      : "Iluminação/posição ruim. Ajuste e aproxime-se.";
       if (lookHint) lookHint.style.display = 'none';
  }

  // desenha a detecção
  const resized = faceapi.resizeResults(detection, displaySize);
  faceapi.draw.drawDetections(canvas, resized);

} else {
  // sem rosto → zera contagem
  lastDetection = null;
  resetCountdown();
  captureBtn.disabled = true;
  captureBtn.textContent = "Sem rosto...";
  faceStatus.textContent = "Nenhum rosto detectado.";
   if (lookHint) lookHint.style.display = 'none';   // 👈
}

        }, 700);
      });
    }

    function capturePhoto() {
  if (autoShotTimeout) { clearTimeout(autoShotTimeout); autoShotTimeout = null; }
  countdownStart = null;
  const cd = document.getElementById('countdown');
  if (cd) cd.style.display = 'none';
  if (lookHint) lookHint.style.display = 'none';   // 👈

  const ctx = canvas.getContext("2d");
  const canvasWidth = 150, canvasHeight = 300;
  canvas.width = canvasWidth; canvas.height = canvasHeight;
  ctx.drawImage(video, 0, 0, canvasWidth, canvasHeight);
  const base64 = canvas.toDataURL("image/png");
  parent.postMessage({ photoBase64: base64 }, "*");
}

    

    startVideo().then(loadModels);
  </script>
</body>
</html>
