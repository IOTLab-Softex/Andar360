<p style="color: green"><%= notice %></p>

<!-- DADOS DA MANUTENÇÃO -->
<div class="chamado-section section-box">
  <div class="section-header">
    <h5>
      <i class="fa-solid fa-circle-info"></i>
      Dados da manutenção
    </h5>
  </div>

  <div class="section-body chamado-grid">
    <div class="chamado-field">
      <span class="label">Título:</span>
      <span class="value"><%= @manutencao_programada.titulo %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Exibir no App:</span>
      <span class="value"><%= @manutencao_programada.exibir_no_app ? "Sim" : "Não" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Categoria:</span>
      <span class="value"><%= @manutencao_programada.categoria %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Local:</span>
      <span class="value"><%= @manutencao_programada.local %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Responsável:</span>
      <span class="value"><%= @manutencao_programada.responsavel %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Periodicidade:</span>
      <span class="value"><%= @manutencao_programada.periodicidade %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Data prevista:</span>
      <span class="value">
        <%= l(@manutencao_programada.data_prevista) if @manutencao_programada.data_prevista %>
      </span>
    </div>

    <div class="chamado-field">
      <span class="label">Dias p/ aviso:</span>
      <span class="value"><%= @manutencao_programada.dias_para_aviso %></span>
    </div>

    <div class="chamado-field chamado-observacao">
      <span class="label">Observação:</span>
      <div class="value">
        <%= simple_format(@manutencao_programada.observacao.presence || "—") %>
      </div>
    </div>
  </div>
</div>

<!-- CHECKLIST -->
<div class="section-box">
  <div class="section-header">
    <h5><i class="fa fa-list-ul"></i> Checklist</h5>
  </div>
  <div class="section-body" id="checklist-itens">
    <% if @manutencao_programada.checklist_items.any? %>
      <% @manutencao_programada.checklist_items.each do |item| %>
        <div class="anexo-item">
          <div class="anexo-info"><%= item.descricao %></div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted text-center">Nenhum item no checklist.</p>
    <% end %>
  </div>
</div>

<!-- ANEXOS -->
<div class="section-box">
  <div class="section-header">
    <h5><i class="fa fa-paperclip"></i> Anexos</h5>
  </div>
  <div class="section-body lista-anexos">
    <% any = false %>

    <% @manutencao_programada.arquivos.each do |arquivo| %>
      <% any = true %>
      <div class="anexo-item">
        <div class="anexo-info">
          <%= link_to url_for(arquivo), target: "_blank", class: "anexo-link" do %>
            <i class="fa fa-download"></i> <%= arquivo.filename.to_s %>
          <% end %>
          <% if arquivo.content_type&.start_with?("video/") %>
            <div class="mt-2">
              <%= video_tag url_for(arquivo),
                            controls: true,
                            preload: "metadata",
                            playsinline: true,
                            style: "width:100%; max-width:420px; border-radius:10px; background:#000;" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% @manutencao_programada.arquivo_anexos.each do |anexo| %>
      <% any = true %>
      <div class="anexo-item">
        <div class="anexo-info">
          <%= link_to url_for(anexo.arquivo), target: "_blank", class: "anexo-link" do %>
            <i class="fa fa-download"></i> <%= anexo.nome %>
          <% end %>
          <% if anexo.arquivo.content_type&.start_with?("video/") %>
            <div class="mt-2">
              <%= video_tag url_for(anexo.arquivo),
                            controls: true,
                            preload: "metadata",
                            playsinline: true,
                            style: "width:100%; max-width:420px; border-radius:10px; background:#000;" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% processed_blob_ids = @manutencao_programada.arquivo_anexos.map { |a| a.arquivo.blob.id } %>
    <% @manutencao_programada.ocorrencias.order(created_at: :desc).each do |oc| %>
      <% next unless oc.arquivos.attached? %>
      <% arquivos_nao_processados = oc.arquivos.reject { |b| processed_blob_ids.include?(b.id) } %>
      <% next if arquivos_nao_processados.empty? %>
      <% any = true %>

      <div class="subsection-header">
        <small><i class="fa fa-history"></i> Ocorrência em <%= oc.data_ocorrencia.strftime("%d/%m/%Y") %></small>
      </div>

      <% arquivos_nao_processados.each do |blob| %>
        <div class="anexo-item">
          <div class="anexo-info">
            <%= link_to url_for(blob), target: "_blank", class: "anexo-link" do %>
              <i class="fa fa-download"></i> <%= blob.filename.to_s %>
            <% end %>
            <% if blob.content_type&.start_with?("video/") %>
              <div class="mt-2">
                <%= video_tag url_for(blob),
                              controls: true,
                              preload: "metadata",
                              playsinline: true,
                              style: "width:100%; max-width:420px; border-radius:10px; background:#000;" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% unless any %>
      <p class="text-muted text-center">Nenhum anexo encontrado.</p>
    <% end %>
  </div>
</div>

<!-- HISTÓRICO DE OCORRÊNCIAS -->
<div class="section-box">
  <div class="section-header">
    <h5><i class="fa fa-clock-rotate-left"></i> Histórico de ocorrências</h5>
  </div>
  <div class="section-body">
    <%= render 'ocorrencias/ocorrencia_section',
               parent: @manutencao_programada,
               somente_visualizacao: true %>
  </div>
</div>


<style>
/* Adicione este CSS à sua página ou arquivo .css */



.lista-anexos {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.anexo-item {
  display: flex;
  align-items: center;
  background-color: #3b6ea5;
  padding: 0.5rem 1rem;
  border-radius: 5px;
  color: #fff;
  justify-content: space-between;
  margin-bottom: 10px;
}

.anexo-link {
  color: white;
  text-decoration: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.5rem; /* espaço entre ícone e texto */
}

.anexo-link i {
  font-size: 1rem;
}

.anexo-remover {
  background: none;
  border: none;
  color: #fff;
  font-size: 1.1rem;
  padding-left: 1rem; /* GAP do botão em relação ao nome */
  cursor: pointer;
}

.anexo-remover i {
  color: #f88;
}


.modal-custom {
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background-color: rgba(0,0,0,0.4);
}
.modal-dialog {
  background: #fff;
  margin: 10% auto;
  padding: 20px;
  width: 400px;
  border-radius: 6px;
  color: var(--color-btn--text);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
</style>
