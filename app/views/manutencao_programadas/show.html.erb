<p style="color: green"><%= notice %></p>

<div class="device-form" style="display: flex; flex-wrap: wrap; gap: 0px;">
  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Título:</strong><br>
    <%= @manutencao_programada.titulo %>
  </div>

  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Exibir no App:</strong><br>
    <%= @manutencao_programada.exibir_no_app ? "Sim" : "Não" %>
  </div>

  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Categoria:</strong><br>
    <%= @manutencao_programada.categoria %>
  </div>

  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Local:</strong><br>
    <%= @manutencao_programada.local %>
  </div>

  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Responsável:</strong><br>
    <%= @manutencao_programada.responsavel %>
  </div>

  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Periodicidade:</strong><br>
    <%= @manutencao_programada.periodicidade %>
  </div>

  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Data Prevista:</strong><br>
    <%= l(@manutencao_programada.data_prevista) if @manutencao_programada.data_prevista %>
  </div>

  <div class="form-group" style="flex: 1 1 30%;">
    <strong>Dias p/ Aviso:</strong><br>
    <%= @manutencao_programada.dias_para_aviso %>
  </div>

  <div class="form-group" style="flex: 1 1 100%;">
    <strong>Observação:</strong><br>
    <%= simple_format(@manutencao_programada.observacao) %>
  </div>
</div>

<hr>

<!-- Checklist -->
<div class="form-group">
  <div class="section-header">
    <h5><i class="fa fa-list-ul"></i> Checklist</h5>
  </div>
  <div class="section-body" id="checklist-itens">
    <% if @manutencao_programada.checklist_items.any? %>
      <% @manutencao_programada.checklist_items.each do |item| %>
        <div class="anexo-item">
          <div class="anexo-info"><%= item.descricao %></div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted text-center">Nenhum item no checklist.</p>
    <% end %>
  </div>
</div>

<!-- Anexos -->
<div class="form-group">
  <div class="section-header">
    <h5><i class="fa fa-paperclip"></i> Anexos</h5>
  </div>
  <div class="section-body lista-anexos">
    <% any = false %>

    <% @manutencao_programada.arquivos.each do |arquivo| %>
      <% any = true %>
      <div class="anexo-item">
        <div class="anexo-info">
          <%= link_to url_for(arquivo), target: "_blank", class: "anexo-link" do %>
            <i class="fa fa-download"></i> <%= arquivo.filename.to_s %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% @manutencao_programada.arquivo_anexos.each do |anexo| %>
      <% any = true %>
      <div class="anexo-item">
        <div class="anexo-info">
          <%= link_to url_for(anexo.arquivo), target: "_blank", class: "anexo-link" do %>
            <i class="fa fa-download"></i> <%= anexo.nome %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% processed_blob_ids = @manutencao_programada.arquivo_anexos.map { |a| a.arquivo.blob.id } %>
    <% @manutencao_programada.ocorrencias.order(created_at: :desc).each do |oc| %>
      <% next unless oc.arquivos.attached? %>
      <% arquivos_nao_processados = oc.arquivos.reject { |b| processed_blob_ids.include?(b.id) } %>
      <% next if arquivos_nao_processados.empty? %>
      <% any = true %>

      <div class="subsection-header">
        <small><i class="fa fa-history"></i> Ocorrência em <%= oc.data_ocorrencia.strftime("%d/%m/%Y") %></small>
      </div>

      <% arquivos_nao_processados.each do |blob| %>
        <div class="anexo-item">
          <div class="anexo-info">
            <%= link_to url_for(blob), target: "_blank", class: "anexo-link" do %>
              <i class="fa fa-download"></i> <%= blob.filename.to_s %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% unless any %>
      <p class="text-muted text-center">Nenhum anexo encontrado.</p>
    <% end %>
  </div>
</div>

<!-- Ocorrências -->
<%= render 'ocorrencias/ocorrencia_section', parent: @manutencao_programada, somente_visualizacao: true %>


<style>
/* Adicione este CSS à sua página ou arquivo .css */

.section-box {
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  margin-bottom: 2rem;
  background-color: #fcfcfc;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid #e0e0e0;
}

.section-header h5 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--color-text);
}

.section-header h5 i {
  margin-right: 0.75rem;
  color: #555;
}

.section-body {
  padding: 1.5rem;
}

.lista-anexos {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.anexo-item {
  display: flex;
  align-items: center;
  background-color: #3b6ea5;
  padding: 0.5rem 1rem;
  border-radius: 5px;
  color: #fff;
  justify-content: space-between;
  margin-bottom: 10px;
}

.anexo-link {
  color: white;
  text-decoration: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.5rem; /* espaço entre ícone e texto */
}

.anexo-link i {
  font-size: 1rem;
}

.anexo-remover {
  background: none;
  border: none;
  color: #fff;
