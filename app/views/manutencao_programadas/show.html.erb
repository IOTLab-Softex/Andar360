}


.modal-custom {
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background-color: rgba(0,0,0,0.4);
}
.modal-dialog {
  background: #fff;
  margin: 10% auto;
  padding: 20px;
  width: 400px;
  border-radius: 6px;
  color: var(--color-btn--text);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
</style>