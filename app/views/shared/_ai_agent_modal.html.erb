<div id="ai-agent-modal" class="ai-agent-modal" aria-hidden="true" style="display:none;">
  <div class="ai-agent-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ai-agent-title">
    <button type="button" class="ai-agent-modal__close" aria-label="Fechar agente IA">&times;</button>

    <header class="ai-agent-modal__header">
      <span class="ai-agent-modal__icon"><%= image_tag "icones/icons_custom/solid/estrela_icone.svg", alt: "" %></span>
      <div>
        <h3 id="ai-agent-title">Agente IA</h3>
        <p>Converse com o assistente sobre dúvidas e tarefas do sistema.</p>
        <p class="ai-agent-modal__hint">Use <strong>@</strong> para inserir salas, horários ou pessoas.</p>
      </div>
    </header>

    <div id="ai-agent-messages" class="ai-agent-chat" aria-live="polite">
      <div class="ai-agent-message ai-agent-message--bot" data-time="<%= Time.current.strftime("%H:%M") %>">
        Olá! Sou o agente IA. Me diga o que você precisa fazer e eu te ajudo a encontrar o caminho.
      </div>
    </div>

    <form id="ai-agent-form" class="ai-agent-form">
      <div class="ai-agent-input-wrap">
        <textarea id="ai-agent-input" rows="1" wrap="soft" autocomplete="off" placeholder="Digite sua mensagem..." aria-label="Mensagem para o agente IA"></textarea>
        <div id="ai-agent-mentions" class="ai-agent-mentions" hidden></div>
      </div>
      <button type="button" id="ai-agent-voice" class="ai-agent-form__voice" title="Falar" aria-label="Falar com o agente">
        <i class="fa-solid fa-microphone"></i>
      </button>
      <button type="button" id="ai-agent-conversation" class="ai-agent-form__conversation" title="Modo conversa" aria-label="Ativar modo conversa" aria-pressed="false">
        <i class="fa-solid fa-headphones"></i>
      </button>
      <button type="submit" title="Enviar" aria-label="Enviar mensagem">
        <i class="fa-solid fa-paper-plane"></i>
      </button>
    </form>
  </div>
</div>

<style>
.ai-agent-modal,
.ai-agent-fab {
  --ai-agent-surface: #1f1f24;
  --ai-agent-surface-2: #2a2a31;
  --ai-agent-text: #f5f5f5;
  --ai-agent-muted: #a1a1aa;
  --ai-agent-border: rgba(255,255,255,.14);
  --ai-agent-overlay: rgba(10,12,18,.76);
  --ai-agent-bot-bg: #2a2a31;
  --ai-agent-input-bg: #24242a;
  --ai-agent-accent: #7c3aed;
  --ai-agent-accent-hover: #6d28d9;
  --ai-agent-accent-text: #ffffff;
}

:root[data-theme="dark"] .ai-agent-modal,
:root[data-theme="dark"] .ai-agent-fab {
  --ai-agent-surface: #1f1f24;
  --ai-agent-surface-2: #2a2a31;
  --ai-agent-text: #f5f5f5;
  --ai-agent-muted: #a1a1aa;
  --ai-agent-border: rgba(255,255,255,.14);
  --ai-agent-overlay: rgba(10,12,18,.82);
  --ai-agent-bot-bg: #2a2a31;
  --ai-agent-input-bg: #24242a;
  --ai-agent-accent: #7c3aed;
  --ai-agent-accent-hover: #6d28d9;
  --ai-agent-accent-text: #ffffff;
}

.ai-agent-fab {
  --ai-agent-rainbow: conic-gradient(from 18deg, #7c4dff, #38f8ff, #14f195, #ffc107, #ff3d81, #9d6bff, #7c4dff);
  display: grid;
  place-items: center;
  width: 75px;
  height: 75px;
  border-radius: 50%;
  background: #3c1771;
  color: #fff;
  box-shadow: 0 10px 25px rgba(0,0,0,.25);
  position: relative;
  bottom: auto;
  right: auto;
  border: 0;
  cursor: pointer;
  font-size: 1.35rem;
  margin: 0;
  padding: 0;
  transform: translateY(0) scale(1);
  transform-origin: center;
  transition: transform .18s cubic-bezier(.2,.8,.2,1), box-shadow .18s cubic-bezier(.2,.8,.2,1);
  will-change: transform;
  backface-visibility: hidden;
  z-index: 10;
  isolation: isolate;
}

.ai-agent-fab::before {
  content: "";
  position: absolute;
  inset: -2px;
  z-index: 2;
  border-radius: inherit;
  background: var(--ai-agent-rainbow);
  padding: 4px;
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  mask-composite: exclude;
  animation: aiAgentBorderSpin 3.8s linear infinite;
}

.ai-agent-fab img {
  width: 42px;
  height: 42px;
  display: block;
  object-fit: contain;
  filter: brightness(0) invert(1);
  pointer-events: none;
}

.ai-agent-fab__icon {
  position: relative;
  z-index: 3;
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
}

.ai-agent-fab__icon--conversation {
  display: none;
}

.ai-agent-fab.is-quick-active .ai-agent-fab__icon--default {
  display: grid;
}

.ai-agent-fab.is-quick-active {
  background: #3c1771;
  border-radius: 50%;
  box-shadow:
    0 0 0 5px rgba(124,58,237,.16),
    0 0 24px rgba(124,58,237,.72),
    0 12px 30px rgba(0,0,0,.34);
}

.ai-agent-fab__waves {
  position: absolute;
  right: calc(100% - 24px);
  top: 50%;
  width: 205px;
  height: 56px;
  padding: 0 34px 0 22px;
  z-index: -2;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  border: 1px solid rgba(139,92,246,.78);
  border-radius: 999px 0 0 999px;
  background: rgba(27,24,36,.96);
  box-shadow:
    inset 0 0 18px rgba(124,58,237,.12),
    0 0 20px rgba(124,58,237,.3);
  opacity: 0;
  visibility: hidden;
  transform: translate(34px, -50%) scaleX(.06);
  transform-origin: right center;
  transition:
    transform .32s cubic-bezier(.22,.8,.2,1),
    opacity .2s ease,
    visibility 0s linear .32s;
  pointer-events: none;
}

.ai-agent-fab::after {
  content: "";
  position: absolute;
  inset: 4px;
  z-index: 1;
  border-radius: 50%;
  background: #3c1771;
  box-shadow: inset 0 0 18px rgba(124,58,237,.22);
  pointer-events: none;
}

.ai-agent-fab__waves::before {
  content: "Ouvindo...";
  margin-right: auto;
  color: #c084fc;
  font-size: .88rem;
  font-weight: 700;
  white-space: nowrap;
}

.ai-agent-fab__waves i {
  display: block;
  width: 3px;
  height: calc(8px + (var(--wave-level, .12) * 30px));
  border-radius: 999px;
  background: linear-gradient(180deg, #d8b4fe, #7c3aed);
  box-shadow: 0 0 12px rgba(139,92,246,.75);
  transition: height 70ms linear, opacity 70ms linear;
  opacity: calc(.48 + (var(--wave-level, .12) * .52));
}

.ai-agent-fab.is-listening .ai-agent-fab__waves,
.ai-agent-fab.is-thinking .ai-agent-fab__waves,
.ai-agent-fab.is-speaking .ai-agent-fab__waves {
  opacity: 1;
  visibility: visible;
  transform: translate(0, -50%) scaleX(1);
  transition:
    transform .34s cubic-bezier(.16,1,.3,1),
    opacity .18s ease,
    visibility 0s;
}

.ai-agent-fab.is-thinking .ai-agent-fab__waves::before {
  content: "Pensando...";
}

.ai-agent-fab.is-speaking .ai-agent-fab__waves::before {
  content: "Falando...";
}

.ai-agent-fab.is-listening .ai-agent-fab__waves i {
  animation: none;
}

.ai-agent-fab.is-thinking .ai-agent-fab__waves i {
  animation: aiAgentVoicePulse 1s ease-in-out infinite;
}

.ai-agent-fab.is-speaking .ai-agent-fab__waves i {
  animation: aiAgentQuickWave .42s ease-in-out infinite alternate;
}

.ai-agent-fab__waves i:nth-child(2) { animation-delay: -.18s !important; }
.ai-agent-fab__waves i:nth-child(3) { animation-delay: -.34s !important; }
.ai-agent-fab__waves i:nth-child(4) { animation-delay: -.1s !important; }
.ai-agent-fab__waves i:nth-child(5) { animation-delay: -.26s !important; }
.ai-agent-fab__waves i:nth-child(6) { animation-delay: -.4s !important; }
.ai-agent-fab__waves i:nth-child(7) { animation-delay: -.14s !important; }
.ai-agent-fab__waves i:nth-child(8) { animation-delay: -.32s !important; }
.ai-agent-fab__waves i:nth-child(9) { animation-delay: -.2s !important; }

.ai-agent-fab__quick-bubble {
  position: absolute;
  right: 0;
  bottom: calc(100% + 18px);
  width: min(330px, calc(100vw - 36px));
  max-height: 190px;
  overflow-y: auto;
  padding: 14px 16px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 16px 16px 5px 16px;
  background: #24242a;
  color: #f5f5f5;
  box-shadow: 0 18px 42px rgba(0,0,0,.38);
  font-size: .9rem;
  font-weight: 500;
  line-height: 1.45;
  text-align: left;
  cursor: pointer;
  z-index: 5;
}

.ai-agent-fab__quick-bubble[hidden] {
  display: none;
}

.ai-agent-fab.is-thinking .ai-agent-fab__icon--default {
  animation: aiAgentVoicePulse 1s ease-in-out infinite;
}

.ai-agent-fab__tip {
  position: absolute;
  right: 0;
  bottom: calc(100% + 14px);
  width: min(280px, calc(100vw - 38px));
  padding: 12px 14px;
  border-radius: 12px;
  background: var(--ai-agent-surface);
  border: 1px solid var(--ai-agent-border);
  color: var(--ai-agent-text);
  box-shadow: 0 16px 34px rgba(0,0,0,.24);
  font-size: .88rem;
  font-weight: 700;
  line-height: 1.35;
  text-align: left;
  opacity: 0;
  transform: translateY(8px) scale(.98);
  pointer-events: none;
  transition: opacity .18s ease, transform .18s ease;
  z-index: 5;
}

.ai-agent-fab__tip::after {
  content: "";
  position: absolute;
  right: 24px;
  top: 100%;
  border: 8px solid transparent;
  border-top-color: var(--ai-agent-surface);
}

.ai-agent-fab__tip.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.ai-agent-fab:hover {
  transform: translateY(-2px) scale(1.06);
  box-shadow: 0 14px 32px rgba(0,0,0,.30);
}

.ai-agent-fab:active {
  transform: translateY(0) scale(.98);
  box-shadow: 0 8px 20px rgba(0,0,0,.22);
}

.ai-agent-fab:focus-visible {
  outline: 3px solid rgba(255,255,255,.9);
  outline-offset: 3px;
}

.ai-agent-modal {
  position: fixed;
  inset: 0;
  z-index: 12010;
  background: var(--ai-agent-overlay);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  padding: 24px;
  overflow-y: auto;
}

.ai-agent-modal__dialog {
  width: min(860px, 96%);
  height: min(88svh, 820px);
  min-height: 620px;
  margin: clamp(18px, 5vh, 54px) auto;
  background: var(--ai-agent-surface);
  border: 1px solid var(--ai-agent-border);
  border-radius: 18px;
  color: var(--ai-agent-text);
  box-shadow: 0 24px 60px rgba(0,0,0,.35);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  color-scheme: light;
}

:root[data-theme="dark"] .ai-agent-modal__dialog {
  color-scheme: dark;
}

.ai-agent-modal__close {
  position: absolute;
  top: 18px;
  right: 20px;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1px solid var(--ai-agent-border);
  background: var(--ai-agent-bot-bg);
  color: var(--ai-agent-text);
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
}

.ai-agent-modal__header {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 16px;
  padding: 22px 76px 20px 22px;
  border-bottom: 1px solid var(--ai-agent-border);
}

.ai-agent-modal__icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: var(--ai-agent-accent);
  color: var(--ai-agent-accent-text);
  overflow: hidden;
}

.ai-agent-modal__icon img {
  width: 29px;
  height: 29px;
  display: block;
  object-fit: contain;
  filter: brightness(0) invert(1);
}

.ai-agent-modal__header h3 {
  margin: 0;
  font-size: 1.35rem;
  line-height: 1.2;
}

.ai-agent-modal__header p {
  margin: 5px 0 0;
  color: var(--ai-agent-muted);
  font-size: .96rem;
}

.ai-agent-modal__hint {
  font-size: .86rem !important;
}

.ai-agent-chat {
  padding: 36px 30px 28px;
  display: flex;
  flex-direction: column;
  gap: 28px;
  overflow-y: auto;
  min-height: 0;
  flex: 1 1 auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(124,58,237,.72) transparent;
}

.ai-agent-message {
  position: relative;
  max-width: min(72%, 570px);
  padding: 18px 20px;
  border-radius: 18px;
  font-size: 1rem;
  line-height: 1.52;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.ai-agent-message::after {
  content: attr(data-time);
  position: absolute;
  top: calc(100% + 8px);
  color: var(--ai-agent-muted);
  font-size: .76rem;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.ai-agent-message--bot {
  align-self: flex-start;
  background: var(--ai-agent-bot-bg);
  border: 1px solid var(--ai-agent-border);
  color: var(--ai-agent-text);
  margin-left: 58px;
}

.ai-agent-message--bot::before {
  content: "✦";
  position: absolute;
  right: calc(100% + 16px);
  top: 0;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--ai-agent-accent);
  color: #fff;
  font-size: 1.35rem;
  box-shadow: 0 10px 24px rgba(124,58,237,.28);
}

.ai-agent-message--bot::after {
  left: 0;
}

.ai-agent-message--user {
  align-self: flex-end;
  background: linear-gradient(135deg, #5b21b6, var(--ai-agent-accent));
  color: var(--ai-agent-accent-text);
  font-weight: 500;
  border-bottom-right-radius: 6px;
}

.ai-agent-message--user::after {
  right: 0;
}

.ai-agent-message--with-cards {
  max-width: min(96%, 560px);
  width: min(96%, 560px);
}

.ai-agent-reservation-carousel,
.ai-agent-maintenance-carousel,
.ai-agent-package-carousel,
.ai-agent-registration-carousel,
.ai-agent-item-carousel,
.ai-agent-item-movement-carousel {
  width: 100%;
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 10px 0 2px;
  scroll-snap-type: x mandatory;
}

.ai-agent-reservation-card,
.ai-agent-maintenance-card,
.ai-agent-package-card,
.ai-agent-registration-card,
.ai-agent-item-card,
.ai-agent-item-movement-card {
  flex: 0 0 min(260px, 82%);
  scroll-snap-align: start;
  background: var(--ai-agent-surface-2);
  border: 1px solid var(--ai-agent-border);
  border-radius: 8px;
  padding: 12px;
  color: var(--ai-agent-text);
}

.ai-agent-reservation-card strong,
.ai-agent-maintenance-card strong,
.ai-agent-package-card strong,
.ai-agent-registration-card strong,
.ai-agent-item-card strong,
.ai-agent-item-movement-card strong {
  display: block;
  font-size: .95rem;
  margin-bottom: 8px;
}

.ai-agent-reservation-card span,
.ai-agent-maintenance-card span,
.ai-agent-package-card span,
.ai-agent-registration-card span,
.ai-agent-item-card span,
.ai-agent-item-movement-card span {
  display: block;
  color: var(--ai-agent-muted);
  font-size: .84rem;
  line-height: 1.35;
}

.ai-agent-reservation-card button,
.ai-agent-maintenance-card button,
.ai-agent-package-card button,
.ai-agent-registration-card button,
.ai-agent-item-card button,
.ai-agent-item-movement-card button {
  margin-top: 10px;
  min-height: 34px;
  border: 0;
  border-radius: 8px;
  padding: 0 12px;
  background: var(--ai-agent-accent);
  color: var(--ai-agent-accent-text);
  font-weight: 700;
  cursor: pointer;
}

.ai-agent-room-carousel {
  width: 100%;
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 10px 0 2px;
  scroll-snap-type: x mandatory;
}

.ai-agent-room-card {
  position: relative;
  flex: 0 0 min(240px, 82%);
  min-height: 150px;
  padding: 0;
  scroll-snap-align: start;
  overflow: hidden;
  border: 1px solid var(--ai-agent-border);
  border-radius: 10px;
  background: var(--ai-agent-surface-2);
  color: #fff;
  cursor: pointer;
  text-decoration: none;
  box-shadow: 0 12px 24px rgba(0,0,0,.16);
  text-align: left;
}

.ai-agent-room-card__photo {
  position: absolute;
  inset: 0;
  background-color: #25163f;
  background-position: center;
  background-size: cover;
  transform: scale(1);
  transition: transform .18s ease;
}

.ai-agent-room-card:hover .ai-agent-room-card__photo {
  transform: scale(1.04);
}

.ai-agent-room-card__photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,.18), rgba(0,0,0,.72));
}

.ai-agent-room-card__body {
  position: absolute;
  inset: auto 0 0;
  z-index: 1;
  padding: 12px;
}

.ai-agent-room-card strong {
  display: block;
  font-size: .94rem;
  line-height: 1.25;
  text-transform: uppercase;
}

.ai-agent-room-card span {
  display: block;
  margin-top: 5px;
  color: rgba(255,255,255,.82);
  font-size: .78rem;
}

.ai-agent-room-card em {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  margin-top: 10px;
  padding: 0 8px;
  border-radius: 999px;
  background: var(--ai-agent-accent);
  color: var(--ai-agent-accent-text);
  font-size: .72rem;
  font-style: normal;
  font-weight: 800;
}

.ai-agent-form {
  display: grid;
  grid-template-columns: 1fr auto auto auto;
  align-items: center;
  gap: 12px;
  padding: 18px 22px 44px;
  border-top: 1px solid var(--ai-agent-border);
  position: relative;
  background: color-mix(in srgb, var(--ai-agent-surface) 94%, #000 6%);
}

.ai-agent-form::after {
  content: "Dica: use @ para mencionar salas, horários ou pessoas.";
  position: absolute;
  left: 22px;
  right: 22px;
  bottom: 13px;
  color: var(--ai-agent-muted);
  font-size: .76rem;
  text-align: center;
}

.ai-agent-input-wrap {
  position: relative;
  min-width: 0;
}

.ai-agent-form textarea {
  width: 100%;
  min-height: 52px;
  max-height: 120px;
  border-radius: 12px;
  border: 1px solid rgba(124,58,237,.82);
  background: var(--ai-agent-input-bg);
  color: var(--ai-agent-text);
  padding: 14px 16px;
  resize: none;
  line-height: 1.35;
  overflow-y: auto;
  box-sizing: border-box;
  font: inherit;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
  box-shadow: 0 0 0 2px rgba(124,58,237,.12);
  transition: border-color .18s ease, box-shadow .18s ease;
}

.ai-agent-form textarea:focus {
  outline: none;
  border-color: #8b5cf6;
  box-shadow: 0 0 0 3px rgba(124,58,237,.22);
}

.ai-agent-mentions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(100% + 8px);
  z-index: 2;
  max-height: 260px;
  overflow-y: auto;
  padding: 8px;
  border-radius: 10px;
  background: var(--ai-agent-surface);
  border: 1px solid var(--ai-agent-border);
  box-shadow: 0 14px 34px rgba(0,0,0,.22);
}

.ai-agent-mentions__title {
  padding: 2px 4px 8px;
  color: var(--ai-agent-muted);
  font-size: .72rem;
  font-weight: 700;
  text-transform: uppercase;
}

.ai-agent-form .ai-agent-mention-option {
  width: 100%;
  height: auto;
  min-height: 46px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 10px;
  margin: 0;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--ai-agent-text);
  text-align: left;
  cursor: pointer;
  box-shadow: none;
}

.ai-agent-form .ai-agent-mention-option:hover,
.ai-agent-form .ai-agent-mention-option.is-active {
  background: var(--ai-agent-bot-bg);
}

.ai-agent-form .ai-agent-mention-option small {
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  padding: 0 8px;
  border-radius: 999px;
  background: var(--ai-agent-surface-2);
  color: var(--ai-agent-muted);
  font-size: .72rem;
  font-weight: 600;
  flex: 0 0 auto;
}

.ai-agent-form .ai-agent-mention-option span {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: .9rem;
  font-weight: 700;
}

.ai-agent-form button {
  width: 52px;
  height: 52px;
  border: 0;
  border-radius: 12px;
  background: var(--ai-agent-accent);
  color: var(--ai-agent-accent-text);
  cursor: pointer;
  font-size: 1rem;
  transition: transform .16s ease, background-color .16s ease, border-color .16s ease;
}

.ai-agent-form button:hover {
  transform: translateY(-1px);
}

.ai-agent-form button[type="submit"]:hover {
  background: var(--ai-agent-accent-hover);
}

.ai-agent-form__voice {
  background: var(--ai-agent-bot-bg) !important;
  color: var(--ai-agent-text) !important;
  border: 1px solid var(--ai-agent-border) !important;
}

.ai-agent-form__conversation {
  background: var(--ai-agent-bot-bg) !important;
  color: var(--ai-agent-text) !important;
  border: 1px solid var(--ai-agent-border) !important;
}

.ai-agent-form__conversation.is-active {
  background: #14f195 !important;
  border-color: #14f195 !important;
  color: #102018 !important;
  box-shadow: 0 0 0 3px rgba(20,241,149,.2);
}

.ai-agent-form__voice.is-listening {
  background: #dc3545 !important;
  border-color: #dc3545 !important;
  color: #fff !important;
}

.ai-agent-form__voice.is-waiting {
  animation: aiAgentVoicePulse 1s ease-in-out infinite;
}

.ai-agent-form__voice.is-understanding {
  animation: aiAgentVoiceGlow .55s ease-in-out infinite alternate;
}

@media (max-width: 640px) {
  .ai-agent-fab {
    width: 62px;
    height: 62px;
    bottom: auto;
    right: auto;
  }

  .ai-agent-fab__waves {
    right: calc(100% - 14px);
    width: 168px;
    height: 48px;
    padding: 0 26px 0 16px;
  }

  .ai-agent-fab__waves::before {
    font-size: .76rem;
  }

  .ai-agent-fab__waves i {
    width: 3px;
  }

  .ai-agent-modal {
    padding: 8px;
  }

  .ai-agent-modal__dialog {
    width: 100%;
    height: calc(100svh - 16px);
    min-height: 0;
    margin: 0 auto;
    border-radius: 14px;
  }

  .ai-agent-modal__header {
    padding: 16px 58px 15px 16px;
    gap: 12px;
  }

  .ai-agent-modal__icon {
    width: 42px;
    height: 42px;
  }

  .ai-agent-modal__header h3 {
    font-size: 1.12rem;
  }

  .ai-agent-modal__header p {
    font-size: .82rem;
  }

  .ai-agent-chat {
    padding: 26px 14px 24px;
    gap: 26px;
  }

  .ai-agent-message {
    max-width: 82%;
    padding: 14px 15px;
    font-size: .91rem;
  }

  .ai-agent-message--bot {
    margin-left: 46px;
  }

  .ai-agent-message--bot::before {
    right: calc(100% + 10px);
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }

  .ai-agent-form {
    grid-template-columns: minmax(0, 1fr) repeat(3, 44px);
    gap: 7px;
    padding: 12px 12px 40px;
  }

  .ai-agent-form button {
    width: 44px;
    height: 44px;
  }

  .ai-agent-form textarea {
    min-height: 44px;
    padding: 11px 12px;
  }

  .ai-agent-form::after {
    left: 12px;
    right: 12px;
    bottom: 10px;
    font-size: .68rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ai-agent-fab { transition: none; animation: none; }
  .ai-agent-fab::before { animation: none; }
}

@keyframes aiAgentBorderSpin {
  to { transform: rotate(360deg); }
}

@keyframes aiAgentVoicePulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, .45); }
  50% { box-shadow: 0 0 0 7px rgba(255, 193, 7, 0); }
}

@keyframes aiAgentVoiceGlow {
  from { box-shadow: 0 0 0 2px rgba(255,255,255,.18), 0 0 10px rgba(220,53,69,.35); }
  to { box-shadow: 0 0 0 4px rgba(255,255,255,.24), 0 0 18px rgba(220,53,69,.7); }
}

@keyframes aiAgentQuickWave {
  from { height: 10px; transform: translateY(3px); opacity: .58; }
  to { height: 38px; transform: translateY(-3px); opacity: 1; }
}
</style>

<script>
(function () {
  function bindAiAgent() {
    const fab = document.getElementById("ai-agent-fab");
    const modal = document.getElementById("ai-agent-modal");
    const closeBtn = modal?.querySelector(".ai-agent-modal__close");
    const form = document.getElementById("ai-agent-form");
    const input = document.getElementById("ai-agent-input");
    const voiceBtn = document.getElementById("ai-agent-voice");
    const conversationBtn = document.getElementById("ai-agent-conversation");
    const mentions = document.getElementById("ai-agent-mentions");
    const messages = document.getElementById("ai-agent-messages");
    const fabTip = fab?.querySelector(".ai-agent-fab__tip");
    const quickBubble = fab?.querySelector(".ai-agent-fab__quick-bubble");

    if (!fab || !modal || !form || !input || !messages || fab.dataset.bound === "1") return;
    fab.dataset.bound = "1";
    const fabTipStorageKey = "andar360AiAgentFabTipSeen";

    const mentionData = {
      rooms: <%= raw(Room.where(espaco_comun: true).order(:name).limit(100).pluck(:name).to_json) %>,
      participants: <%= raw((current_user&.admin? || current_user&.operador? ? Participant.ativos.order(:name).limit(150) : Participant.ativos.where(grupo_empresa_id: current_user&.participant&.grupo_empresa_id).order(:name).limit(150)).pluck(:name).to_json) %>,
      times: ["09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00"]
    };

    const mentionCategories = [
      { key: "salas", label: "Salas", helper: "Escolher sala" },
      { key: "participantes", label: "Participantes", helper: "Adicionar pessoas" },
      { key: "horario_inicio", label: "Horario inicio", helper: "Definir inicio" },
      { key: "horario_fim", label: "Horario fim", helper: "Definir fim" },
      { key: "responsavel", label: "Responsavel", helper: "Definir responsavel" },
      { key: "solicitante", label: "Solicitante", helper: "Definir solicitante" }
    ];

    let mentionState = { start: -1, end: -1, options: [], active: 0 };

    function openModal() {
      markFabTipSeen();
      pauseQuickWakeListener();
      modal.style.display = "block";
      modal.setAttribute("aria-hidden", "false");
      setTimeout(() => input.focus(), 0);
    }

    function closeModal() {
      modal.style.display = "none";
      modal.setAttribute("aria-hidden", "true");
      setConversationMode(false);
      resetVoiceState();
      resumeQuickWakeListener();
    }

    function showFabTipIfNeeded() {
      if (!fabTip) return;

      try {
        if (window.localStorage.getItem(fabTipStorageKey) === "1") return;
      } catch (_error) {}

      window.setTimeout(() => {
        if (modal.getAttribute("aria-hidden") === "false") return;
        fabTip.classList.add("is-visible");
      }, 650);
    }

    function markFabTipSeen() {
      if (!fabTip) return;

      fabTip.classList.remove("is-visible");
      try {
        window.localStorage.setItem(fabTipStorageKey, "1");
      } catch (_error) {}
    }

    function currentMessageTime() {
      return new Intl.DateTimeFormat("pt-BR", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
      }).format(new Date());
    }

    function addMessage(text, type) {
      const message = document.createElement("div");
      message.className = `ai-agent-message ai-agent-message--${type}`;
      message.dataset.time = currentMessageTime();
      message.textContent = text;
      messages.appendChild(message);
      messages.scrollTop = messages.scrollHeight;
    }

    function normalizeMention(value) {
      return (value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9_ ]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    }

    function currentMentionToken() {
      const cursor = input.selectionStart || 0;
      const before = input.value.slice(0, cursor);
      const start = before.lastIndexOf("@");
      if (start < 0) return null;

      const token = before.slice(start + 1);
      if (token.includes("\n")) return null;

      return { start: start, end: cursor, value: token };
    }

    function categoryItems(category) {
      if (category.key === "salas") {
        return mentionData.rooms.map((name) => ({ label: name, helper: "Sala", insert: `sala ${name}` }));
      }

      if (["participantes", "responsavel", "solicitante"].includes(category.key)) {
        const prefix = category.key === "responsavel" ? "responsavel" : category.key === "solicitante" ? "solicitante" : "participante";
        return mentionData.participants.map((name) => ({ label: name, helper: category.label, insert: `${prefix} ${name}` }));
      }

      if (category.key === "horario_inicio") {
        return mentionData.times.map((time) => ({ label: time, helper: "Inicio", insert: `horario de inicio ${time}` }));
      }

      if (category.key === "horario_fim") {
        return mentionData.times.map((time) => ({ label: time, helper: "Fim", insert: `horario de fim ${time}` }));
      }

      return [];
    }

    function mentionOptions(token) {
      const raw = normalizeMention(token.value);
      const category = mentionCategories.find((item) => raw === normalizeMention(item.label) || raw.startsWith(`${normalizeMention(item.label)} `) || raw === item.key);

      if (category) {
        const remainder = raw.replace(normalizeMention(category.label), "").replace(category.key, "").trim();
        return categoryItems(category)
          .filter((item) => normalizeMention(item.label).includes(remainder))
          .slice(0, 12);
      }

      return mentionCategories
        .filter((item) => normalizeMention(item.label).includes(raw) || item.key.includes(raw))
        .map((item) => ({ label: item.label, helper: item.helper, category: item }))
        .slice(0, 12);
    }

    function hideMentions() {
      if (!mentions) return;

      mentions.hidden = true;
      mentions.innerHTML = "";
      mentionState = { start: -1, end: -1, options: [], active: 0 };
    }

    function renderMentions() {
      if (!mentions) return;

      const token = currentMentionToken();
      if (!token) {
        hideMentions();
        return;
      }

      const options = mentionOptions(token);
      if (!options.length) {
        hideMentions();
        return;
      }

      mentionState = { start: token.start, end: token.end, options: options, active: Math.min(mentionState.active || 0, options.length - 1) };
      mentions.innerHTML = "";

      const title = document.createElement("div");
      title.className = "ai-agent-mentions__title";
      title.textContent = options[0]?.category ? "Complete o comando" : "Comandos rapidos";
      mentions.appendChild(title);

      options.forEach((option, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `ai-agent-mention-option${index === mentionState.active ? " is-active" : ""}`;

        const label = document.createElement("span");
        label.textContent = option.label;

        const helper = document.createElement("small");
        helper.textContent = option.helper || "";

        button.appendChild(label);
        button.appendChild(helper);
        button.addEventListener("mousedown", (event) => {
          event.preventDefault();
          applyMentionOption(option);
        });
        mentions.appendChild(button);
      });

      mentions.hidden = false;
    }

    function applyMentionOption(option) {
      if (mentionState.start < 0) return;

      if (option.category) {
        const value = `@${option.label} `;
        input.value = `${input.value.slice(0, mentionState.start)}${value}${input.value.slice(mentionState.end)}`;
        const cursor = mentionState.start + value.length;
        input.setSelectionRange(cursor, cursor);
        resizeInput();
        renderMentions();
        input.focus();
        return;
      }

      const value = `${option.insert} `;
      input.value = `${input.value.slice(0, mentionState.start)}${value}${input.value.slice(mentionState.end)}`;
      const cursor = mentionState.start + value.length;
      input.setSelectionRange(cursor, cursor);
      resizeInput();
      hideMentions();
      input.focus();
    }

    function resizeInput() {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
    }

    function buildReservationCards(reservations) {
      if (!Array.isArray(reservations) || reservations.length === 0) return;

      const carousel = document.createElement("div");
      carousel.className = "ai-agent-reservation-carousel";

      reservations.forEach(function (reservation) {
        const card = document.createElement("div");
        card.className = "ai-agent-reservation-card";

        const room = document.createElement("strong");
        room.textContent = reservation.room || "Sala";

        const time = document.createElement("span");
        time.textContent = `${reservation.starts_at_label || reservation.starts_at} ate ${reservation.ends_at_label || reservation.ends_at}`;

        const button = document.createElement("button");
        button.type = "button";
        button.textContent = "Cancelar esta";
        button.addEventListener("click", function () {
          sendMessage(`Cancelar reserva ID ${reservation.id}`);
        });

        card.appendChild(room);
        card.appendChild(time);
        card.appendChild(button);
        carousel.appendChild(card);
      });

      return carousel;
    }

    function attachReservationCards(messageElement, reservations) {
      const carousel = buildReservationCards(reservations);
      if (!carousel || !messageElement) return;

      messageElement.classList.add("ai-agent-message--with-cards");
      messageElement.appendChild(carousel);
      messages.scrollTop = messages.scrollHeight;
    }

    function buildMaintenanceCards(maintenances) {
      if (!Array.isArray(maintenances) || maintenances.length === 0) return;

      const carousel = document.createElement("div");
      carousel.className = "ai-agent-maintenance-carousel";

      maintenances.forEach(function (maintenance) {
        const card = document.createElement("div");
        card.className = "ai-agent-maintenance-card";

        const title = document.createElement("strong");
        title.textContent = maintenance.title || "Manutencao programada";

        const date = document.createElement("span");
        date.textContent = `Data: ${maintenance.data_prevista_label || maintenance.data_prevista || "sem data"}`;

        const status = document.createElement("span");
        status.textContent = `Status: ${maintenance.status || "futura"}`;

        const details = document.createElement("span");
        details.textContent = [maintenance.categoria, maintenance.local, maintenance.responsavel].filter(Boolean).join(" - ");

        const button = document.createElement("button");
        button.type = "button";
        button.textContent = "Cancelar esta";
        button.addEventListener("click", function () {
          sendMessage(`Cancelar manutencao programada ID ${maintenance.id}`);
        });

        card.appendChild(title);
        card.appendChild(date);
        card.appendChild(status);
        if (details.textContent) card.appendChild(details);
        if (maintenance.can_cancel) card.appendChild(button);
        carousel.appendChild(card);
      });

      return carousel;
    }

    function attachMaintenanceCards(messageElement, maintenances) {
      const carousel = buildMaintenanceCards(maintenances);
      if (!carousel || !messageElement) return;

      messageElement.classList.add("ai-agent-message--with-cards");
      messageElement.appendChild(carousel);
      messages.scrollTop = messages.scrollHeight;
    }

    function buildPackageCards(packages) {
      if (!Array.isArray(packages) || packages.length === 0) return;

      const carousel = document.createElement("div");
      carousel.className = "ai-agent-package-carousel";

      packages.forEach(function (packageItem) {
        const card = document.createElement("div");
        card.className = "ai-agent-package-card";

        const code = document.createElement("strong");
        code.textContent = packageItem.codigo ? `Encomenda ${packageItem.codigo}` : "Encomenda";

        const status = document.createElement("span");
        status.textContent = `Status: ${packageItem.status || (packageItem.entregue ? "entregue" : "pendente na portaria")}`;

        const carrier = document.createElement("span");
        carrier.textContent = [packageItem.transportadora, packageItem.tipo, packageItem.tamanho].filter(Boolean).join(" - ");

        const recipient = document.createElement("span");
        recipient.textContent = [packageItem.destinatario, packageItem.unidade].filter(Boolean).join(" - ");

        const receivedAt = document.createElement("span");
        receivedAt.textContent = packageItem.entregue_em_label ? `Entregue em: ${packageItem.entregue_em_label}` : `Recebida em: ${packageItem.recebido_em_label || "-"}`;

        card.appendChild(code);
        card.appendChild(status);
        if (carrier.textContent) card.appendChild(carrier);
        if (recipient.textContent) card.appendChild(recipient);
        card.appendChild(receivedAt);
        carousel.appendChild(card);
      });

      return carousel;
    }

    function attachPackageCards(messageElement, packages) {
      const carousel = buildPackageCards(packages);
      if (!carousel || !messageElement) return;

      messageElement.classList.add("ai-agent-message--with-cards");
      messageElement.appendChild(carousel);
      messages.scrollTop = messages.scrollHeight;
    }

    function buildRegistrationCards(registrations) {
      if (!Array.isArray(registrations) || registrations.length === 0) return;

      const carousel = document.createElement("div");
      carousel.className = "ai-agent-registration-carousel";

      registrations.forEach(function (registration) {
        const card = document.createElement("div");
        card.className = "ai-agent-registration-card";

        const name = document.createElement("strong");
        name.textContent = registration.nome || "Pre-cadastro";

        const status = document.createElement("span");
        status.textContent = `Status: ${registration.status || "aguardando aprovacao"}`;

        const details = document.createElement("span");
        details.textContent = [registration.empresa, registration.cargo].filter(Boolean).join(" - ");

        const sentAt = document.createElement("span");
        sentAt.textContent = `Enviado em: ${registration.enviado_em_label || "-"}`;

        const button = document.createElement("button");
        button.type = "button";
        button.textContent = "Abrir aprovacoes";
        button.addEventListener("click", function () {
          if (registration.url) window.location.href = registration.url;
        });

        card.appendChild(name);
        card.appendChild(status);
        if (details.textContent) card.appendChild(details);
        card.appendChild(sentAt);
        if (registration.url) card.appendChild(button);
        carousel.appendChild(card);
      });

      return carousel;
    }

    function attachRegistrationCards(messageElement, registrations) {
      const carousel = buildRegistrationCards(registrations);
      if (!carousel || !messageElement) return;

      messageElement.classList.add("ai-agent-message--with-cards");
      messageElement.appendChild(carousel);
      messages.scrollTop = messages.scrollHeight;
    }

    function buildItemCards(items) {
      if (!Array.isArray(items) || items.length === 0) return;

      const carousel = document.createElement("div");
      carousel.className = "ai-agent-item-carousel";

      items.forEach(function (item) {
        const card = document.createElement("div");
        card.className = "ai-agent-item-card";

        const name = document.createElement("strong");
        name.textContent = item.nome || "Objeto";

        const status = document.createElement("span");
        status.textContent = `Status: ${item.status || "sem status"}`;

        const holder = document.createElement("span");
        holder.textContent = [item.responsavel_atual, item.empresa_atual].filter(Boolean).join(" - ");

        const movement = document.createElement("span");
        movement.textContent = item.ultima_movimentacao_em_label ? `Ultima movimentacao: ${item.ultima_movimentacao || "-"} em ${item.ultima_movimentacao_em_label}` : "";

        card.appendChild(name);
        card.appendChild(status);
        if (holder.textContent) card.appendChild(holder);
        if (movement.textContent) card.appendChild(movement);
        carousel.appendChild(card);
      });

      return carousel;
    }

    function attachItemCards(messageElement, items) {
      const carousel = buildItemCards(items);
      if (!carousel || !messageElement) return;

      messageElement.classList.add("ai-agent-message--with-cards");
      messageElement.appendChild(carousel);
      messages.scrollTop = messages.scrollHeight;
    }

    function buildItemMovementCards(movements) {
      if (!Array.isArray(movements) || movements.length === 0) return;

      const carousel = document.createElement("div");
      carousel.className = "ai-agent-item-movement-carousel";

      movements.forEach(function (movement) {
        const card = document.createElement("div");
        card.className = "ai-agent-item-movement-card";

        const type = document.createElement("strong");
        type.textContent = movement.tipo || "Movimentacao";

        const date = document.createElement("span");
        date.textContent = movement.criado_em_label ? `Data: ${movement.criado_em_label}` : "";

        const holder = document.createElement("span");
        holder.textContent = [movement.responsavel, movement.empresa].filter(Boolean).join(" - ");

        const description = document.createElement("span");
        description.textContent = movement.descricao || "";

        card.appendChild(type);
        if (date.textContent) card.appendChild(date);
        if (holder.textContent) card.appendChild(holder);
        if (description.textContent) card.appendChild(description);
        carousel.appendChild(card);
      });

      return carousel;
    }

    function attachItemMovementCards(messageElement, movements) {
      const carousel = buildItemMovementCards(movements);
      if (!carousel || !messageElement) return;

      messageElement.classList.add("ai-agent-message--with-cards");
      messageElement.appendChild(carousel);
      messages.scrollTop = messages.scrollHeight;
    }

    function buildRoomCards(rooms) {
      if (!Array.isArray(rooms) || rooms.length === 0) return;

      const carousel = document.createElement("div");
      carousel.className = "ai-agent-room-carousel";

      rooms.forEach(function (room) {
        const card = document.createElement("button");
        card.type = "button";
        card.className = "ai-agent-room-card";
        card.addEventListener("click", function () {
          selectRoomFromCard(room);
        });

        const photo = document.createElement("div");
        photo.className = "ai-agent-room-card__photo";
        if (room.photo_url) photo.style.backgroundImage = `url('${room.photo_url}')`;

        const body = document.createElement("div");
        body.className = "ai-agent-room-card__body";

        const name = document.createElement("strong");
        name.textContent = room.name || "Sala";

        const details = document.createElement("span");
        details.textContent = [room.group, room.floor && `Andar ${room.floor}`, room.capacity && `${room.capacity} pessoas`].filter(Boolean).join(" • ") || "Disponivel";

        const action = document.createElement("em");
        action.textContent = "Selecionar sala";

        body.appendChild(name);
        body.appendChild(details);
        body.appendChild(action);

        if (room.can_open_door) {
          const openBtn = document.createElement("button");
          openBtn.type = "button";
          openBtn.className = "ai-agent-room-open-btn";
          openBtn.textContent = "Abrir porta";
          openBtn.addEventListener("click", function (ev) {
            ev.stopPropagation();
            if (!room.open_door_path) return;
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || "";

            fetch(room.open_door_path, {
              method: "POST",
              credentials: "same-origin",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json",
                "X-CSRF-Token": csrfToken
              },
              body: JSON.stringify({})
            })
              .then(function (resp) {
                if (resp.ok) {
                  addMessage("Comando para abrir a porta enviado.", "bot");
                } else {
                  addMessage("Falha ao enviar comando para abrir a porta.", "bot");
                }
              })
              .catch(function () {
                addMessage("Falha ao enviar comando para abrir a porta.", "bot");
              });
          });

          body.appendChild(openBtn);
        }
        card.appendChild(photo);
        card.appendChild(body);
        carousel.appendChild(card);
      });

      return carousel;
    }

    function selectRoomFromCard(room) {
      const roomName = room?.name;
      if (!roomName) return;

      const selectedText = `sala ${roomName}`;
      const currentText = input.value.trim();
      input.value = currentText ? `${currentText}\n${selectedText}` : selectedText;
      resizeInput();
      hideMentions();
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
    }

    function attachRoomCards(messageElement, rooms) {
      const carousel = buildRoomCards(rooms);
      if (!carousel || !messageElement) return;

      messageElement.classList.add("ai-agent-message--with-cards");
      messageElement.appendChild(carousel);
      messages.scrollTop = messages.scrollHeight;
    }

    let resetVoiceState = function () {
      input.value = "";
      resizeInput();
    };
    let startVoiceCapture = function () {};
    let stopVoiceCapture = function () {};
    let conversationMode = false;
    let openAiAudio = null;
    let agentSpeaking = false;
    let waitingForAgentResponse = false;
    let stopQuickMode = function () {};
    let startQuickWakeListener = function () {};
    let pauseQuickWakeListener = function () {};
    let resumeQuickWakeListener = function () {};
    let authorizeQuickWake = function () { return Promise.resolve(false); };

    function setConversationMode(active) {
      conversationMode = active;
      conversationBtn?.classList.toggle("is-active", active);
      conversationBtn?.setAttribute("aria-pressed", active ? "true" : "false");
      conversationBtn?.setAttribute("aria-label", active ? "Desativar modo conversa" : "Ativar modo conversa");
      conversationBtn && (conversationBtn.title = active ? "Modo conversa ativo" : "Modo conversa");

      if (!active) {
        waitingForAgentResponse = false;
        resetVoiceState();
        stopAgentPlayback();
      }
    }

    function speakWithBrowser(text) {
      if (!window.speechSynthesis || !text) return;

      beginAgentSpeech();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "pt-BR";
      utterance.rate = 1;
      utterance.pitch = 1;
      utterance.onend = function () {
        endAgentSpeech();
        if (conversationMode) startVoiceCapture();
      };
      utterance.onerror = function () {
        endAgentSpeech();
      };

      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);
    }

    function speakBotMessage(text) {
      if (!conversationMode || !text) return;

      fetch("/ai_agent/speech", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "audio/mpeg",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || ""
        },
        body: JSON.stringify({ text: text })
      })
        .then((response) => {
          if (!response.ok) throw new Error("speech_failed");
          return response.blob();
        })
        .then((blob) => {
          if (!conversationMode) return;

          const url = URL.createObjectURL(blob);
          if (openAiAudio) openAiAudio.pause();

          beginAgentSpeech();
          openAiAudio = new Audio(url);
          openAiAudio.onended = function () {
            URL.revokeObjectURL(url);
            openAiAudio = null;
            endAgentSpeech();
            if (conversationMode) startVoiceCapture();
          };
          openAiAudio.onerror = function () {
            URL.revokeObjectURL(url);
            openAiAudio = null;
            endAgentSpeech();
            speakWithBrowser(text);
          };
          openAiAudio.play().catch(function () {
            URL.revokeObjectURL(url);
            openAiAudio = null;
            endAgentSpeech();
            speakWithBrowser(text);
          });
        })
        .catch(function () {
          speakWithBrowser(text);
        });
    }

    function beginAgentSpeech() {
      agentSpeaking = true;
      stopVoiceCapture();
      voiceBtn?.setAttribute("aria-label", "Interromper e falar");
      if (voiceBtn) voiceBtn.title = "Interromper e falar";
    }

    function endAgentSpeech() {
      agentSpeaking = false;
    }

    function stopAgentPlayback() {
      endAgentSpeech();
      if (openAiAudio) {
        openAiAudio.pause();
        openAiAudio = null;
      }
      if (window.speechSynthesis) window.speechSynthesis.cancel();
    }

    function sendMessage(text) {
      addMessage(text, "user");
      resetVoiceState();
      input.value = "";
      form.reset();
      resizeInput();
      waitingForAgentResponse = conversationMode;

      const pending = document.createElement("div");
      pending.className = "ai-agent-message ai-agent-message--bot";
      pending.dataset.time = currentMessageTime();
      pending.textContent = "Pensando...";
      messages.appendChild(pending);
      messages.scrollTop = messages.scrollHeight;

      fetch("/ai_agent/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || ""
        },
        body: JSON.stringify({ message: text })
      })
        .then((response) => response.json().then((data) => ({ ok: response.ok, data })))
        .then(({ ok, data }) => {
          const botText = data.message || (ok ? "Pronto." : "Não consegui concluir a solicitação.");
          pending.textContent = botText;
          attachReservationCards(pending, data.reservations);
          attachRoomCards(pending, data.rooms);
          attachMaintenanceCards(pending, data.maintenances);
          attachPackageCards(pending, data.packages);
          attachRegistrationCards(pending, data.registrations);
          attachItemCards(pending, data.items);
          attachItemMovementCards(pending, data.item_movements);
          waitingForAgentResponse = false;
          speakBotMessage(botText);
        })
        .catch(() => {
          waitingForAgentResponse = false;
          pending.textContent = "Não consegui falar com o agente agora. Tente novamente em instantes.";
        })
        .finally(() => {
          messages.scrollTop = messages.scrollHeight;
        });
    }

    function setupQuickConversation() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition || !quickBubble) return;

      const recognition = new SpeechRecognition();
      recognition.lang = "pt-BR";
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.maxAlternatives = 1;

      let active = false;
      let listening = false;
      let awaitingCommand = false;
      let quickConversationStarted = false;
      let paused = false;
      let microphoneAuthorized = false;
      let restartTimer = null;
      let quickSilenceTimer = null;
      let quickBubbleTimer = null;
      let waveStream = null;
      let waveAudioContext = null;
      let waveAnimationFrame = null;
      let waveSession = 0;
      const waveBars = Array.from(fab.querySelectorAll(".ai-agent-fab__waves i"));

      function normalizeQuickSpeech(value) {
        return (value || "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .replace(/[^\w\s]/g, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function wakePhraseMatch(value) {
        return value.match(/\b(?:ei|hey|e\s+ai|eai)\s+(?:agente|a\s+gente)\b/);
      }

      function showQuickBubble(text) {
        quickBubble.textContent = text;
        quickBubble.hidden = false;
      }

      function hideQuickBubble() {
        clearTimeout(quickBubbleTimer);
        quickBubble.hidden = true;
        quickBubble.textContent = "";
      }

      function resetWaveBars() {
        waveBars.forEach(function (bar) {
          bar.style.setProperty("--wave-level", ".12");
        });
      }

      function stopLiveWave() {
        waveSession += 1;
        if (waveAnimationFrame) cancelAnimationFrame(waveAnimationFrame);
        waveAnimationFrame = null;
        waveStream?.getTracks().forEach((track) => track.stop());
        waveStream = null;
        if (waveAudioContext && waveAudioContext.state !== "closed") waveAudioContext.close();
        waveAudioContext = null;
        resetWaveBars();
      }

      function startLiveWave() {
        if (!quickConversationStarted || waveStream || !navigator.mediaDevices?.getUserMedia) return;

        const session = ++waveSession;
        navigator.mediaDevices.getUserMedia({
          audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true
          }
        }).then(function (stream) {
          if (session !== waveSession || !quickConversationStarted) {
            stream.getTracks().forEach((track) => track.stop());
            return;
          }

          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) {
            stream.getTracks().forEach((track) => track.stop());
            return;
          }

          waveStream = stream;
          waveAudioContext = new AudioContextClass();
          const source = waveAudioContext.createMediaStreamSource(stream);
          const analyser = waveAudioContext.createAnalyser();
          analyser.fftSize = 256;
          analyser.smoothingTimeConstant = .68;
          source.connect(analyser);

          const frequencies = new Uint8Array(analyser.frequencyBinCount);
          const renderWave = function () {
            if (session !== waveSession || !waveStream || !quickConversationStarted) return;

            analyser.getByteFrequencyData(frequencies);
            const usableBins = Math.max(1, Math.floor(frequencies.length * .48));
            const center = (waveBars.length - 1) / 2;

            waveBars.forEach(function (bar, index) {
              const mirroredIndex = Math.round(Math.abs(index - center));
              const binStart = Math.floor((mirroredIndex / Math.max(center, 1)) * usableBins * .55);
              const binEnd = Math.min(usableBins, binStart + 8);
              let total = 0;
              for (let bin = binStart; bin < binEnd; bin += 1) total += frequencies[bin] || 0;
              const average = total / Math.max(1, binEnd - binStart);
              const level = Math.max(.08, Math.min(1, average / 150));
              bar.style.setProperty("--wave-level", level.toFixed(3));
            });

            waveAnimationFrame = requestAnimationFrame(renderWave);
          };

          renderWave();
        }).catch(function () {
          resetWaveBars();
        });
      }

      function clearQuickSilenceTimer() {
        clearTimeout(quickSilenceTimer);
        quickSilenceTimer = null;
      }

      function endQuickConversation(message = "Conversa rápida encerrada.") {
        clearQuickSilenceTimer();
        awaitingCommand = false;
        quickConversationStarted = false;
        setQuickState("idle");
        showQuickBubble(message);
        clearTimeout(quickBubbleTimer);
        quickBubbleTimer = setTimeout(hideQuickBubble, 1600);
        scheduleRestart(250);
      }

      function scheduleQuickSilenceTimeout() {
        clearQuickSilenceTimer();
        quickSilenceTimer = setTimeout(function () {
          if (!quickConversationStarted || waitingForAgentResponse || agentSpeaking) return;

          endQuickConversation();
        }, 12_000);
      }

      function setQuickState(state) {
        fab.classList.toggle("is-quick-active", quickConversationStarted);
        fab.classList.toggle("is-listening", quickConversationStarted && state === "listening");
        fab.classList.toggle("is-thinking", quickConversationStarted && state === "thinking");
        fab.classList.toggle("is-speaking", quickConversationStarted && state === "speaking");

        if (quickConversationStarted && state === "listening") {
          startLiveWave();
        } else {
          stopLiveWave();
        }
      }

      function scheduleRestart(delay = 300) {
        clearTimeout(restartTimer);
        if (!active || paused || agentSpeaking || waitingForAgentResponse) return;

        restartTimer = setTimeout(function () {
          if (!active || paused || listening || agentSpeaking || waitingForAgentResponse) return;
          try {
            recognition.start();
          } catch (_error) {}
        }, delay);
      }

      function finishQuickSpeech(endConversation = false) {
        agentSpeaking = false;
        if (endConversation) {
          clearQuickSilenceTimer();
          awaitingCommand = false;
          quickConversationStarted = false;
          setQuickState("idle");
          clearTimeout(quickBubbleTimer);
          quickBubbleTimer = setTimeout(hideQuickBubble, 1800);
          scheduleRestart(350);
          return;
        }

        if (quickConversationStarted) {
          awaitingCommand = true;
          setQuickState("listening");
          scheduleQuickSilenceTimeout();
        } else {
          setQuickState("idle");
        }
        scheduleRestart(350);
      }

      function speakQuickResponse(text, endConversation = false) {
        if (!active || !text) return;

        agentSpeaking = true;
        setQuickState("speaking");

        const browserSpeech = function () {
          if (!window.speechSynthesis) {
            finishQuickSpeech(endConversation);
            return;
          }

          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = "pt-BR";
          utterance.rate = 1;
          utterance.onend = function () { finishQuickSpeech(endConversation); };
          utterance.onerror = function () { finishQuickSpeech(endConversation); };
          window.speechSynthesis.cancel();
          window.speechSynthesis.speak(utterance);
        };

        fetch("/ai_agent/speech", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "audio/mpeg",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || ""
          },
          body: JSON.stringify({ text: text })
        })
          .then(function (response) {
            if (!response.ok) throw new Error("speech_failed");
            return response.blob();
          })
          .then(function (blob) {
            if (!active) return;

            const url = URL.createObjectURL(blob);
            openAiAudio = new Audio(url);
            openAiAudio.onended = function () {
              URL.revokeObjectURL(url);
              openAiAudio = null;
              finishQuickSpeech(endConversation);
            };
            openAiAudio.onerror = function () {
              URL.revokeObjectURL(url);
              openAiAudio = null;
              browserSpeech();
            };
            openAiAudio.play().catch(function () {
              URL.revokeObjectURL(url);
              openAiAudio = null;
              browserSpeech();
            });
          })
          .catch(browserSpeech);
      }

      function sendQuickMessage(text) {
        const message = text.trim();
        if (!message) {
          awaitingCommand = true;
          showQuickBubble("Estou ouvindo. O que você precisa?");
          scheduleQuickSilenceTimeout();
          scheduleRestart();
          return;
        }

        clearQuickSilenceTimer();
        addMessage(message, "user");
        awaitingCommand = false;
        waitingForAgentResponse = true;
        setQuickState("thinking");
        showQuickBubble("Pensando...");

        fetch("/ai_agent/chat", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || ""
          },
          body: JSON.stringify({ message: message, quick_mode: true })
        })
          .then((response) => response.json().then((data) => ({ ok: response.ok, data })))
          .then(function ({ ok, data }) {
            const botText = data.message || (ok ? "Pronto." : "Não consegui concluir a solicitação.");
            waitingForAgentResponse = false;
            addMessage(botText, "bot");
            if (!active) return;

            showQuickBubble(botText);
            speakQuickResponse(botText, data.end_quick_conversation === true);
          })
          .catch(function () {
            const errorText = "Não consegui falar com o agente agora. Tente novamente.";
            waitingForAgentResponse = false;
            if (!active) return;

            showQuickBubble(errorText);
            speakQuickResponse(errorText);
          });
      }

      recognition.addEventListener("start", function () {
        listening = true;
        setQuickState(awaitingCommand ? "listening" : "idle");
      });

      recognition.addEventListener("result", function (event) {
        if (modal.getAttribute("aria-hidden") === "false") return;

        const spoken = Array.from(event.results)
          .map((result) => result[0]?.transcript || "")
          .join(" ")
          .trim();
        const normalized = normalizeQuickSpeech(spoken);

        if (awaitingCommand) {
          clearQuickSilenceTimer();
          sendQuickMessage(spoken);
          return;
        }

        const wakeMatch = wakePhraseMatch(normalized);
        if (!wakeMatch) return;

        quickConversationStarted = true;
        modal.style.display = "none";
        modal.setAttribute("aria-hidden", "true");
        setConversationMode(false);

        const command = spoken
          .replace(/^.*?\b(?:ei|hey|e\s*a[ií]|eai)\s*,?\s*(?:agente|a\s+gente)\b/i, "")
          .trim();
        if (command) {
          sendQuickMessage(command);
        } else {
          awaitingCommand = true;
          setQuickState("listening");
          showQuickBubble("Estou ouvindo. O que você precisa?");
          scheduleQuickSilenceTimeout();
        }
      });

      recognition.addEventListener("end", function () {
        listening = false;
        if (active && !paused && !agentSpeaking && !waitingForAgentResponse) {
          setQuickState("idle");
          scheduleRestart();
        }
      });

      recognition.addEventListener("error", function (event) {
        listening = false;
        if (event.error === "aborted") return;

        if (["not-allowed", "service-not-allowed"].includes(event.error)) {
          active = false;
          microphoneAuthorized = false;
          setQuickState("idle");
          showQuickBubble("Permita o acesso ao microfone para usar o modo rápido.");
          return;
        }

        if (active && !paused) scheduleRestart(700);
      });

      stopQuickMode = function () {
        active = false;
        awaitingCommand = false;
        quickConversationStarted = false;
        clearQuickSilenceTimer();
        clearTimeout(quickBubbleTimer);
        clearTimeout(restartTimer);
        stopLiveWave();
        if (listening) recognition.abort();
        stopAgentPlayback();
        setQuickState("idle");
        hideQuickBubble();
        fab.title = "Falar com agente IA";
        fab.setAttribute("aria-label", "Falar com agente IA");
      };

      startQuickWakeListener = function () {
        if (active) return;
        if (!microphoneAuthorized) return;
        if (!window.isSecureContext && !["localhost", "127.0.0.1"].includes(window.location.hostname)) {
          return;
        }

        active = true;
        paused = modal.getAttribute("aria-hidden") === "false";
        awaitingCommand = false;
        quickConversationStarted = false;
        setQuickState("idle");
        hideQuickBubble();
        if (!paused) scheduleRestart(50);
      };

      authorizeQuickWake = function () {
        if (microphoneAuthorized) {
          startQuickWakeListener();
          return Promise.resolve(true);
        }

        if (!navigator.mediaDevices?.getUserMedia) return Promise.resolve(false);

        return navigator.mediaDevices.getUserMedia({ audio: true })
          .then(function (stream) {
            stream.getTracks().forEach((track) => track.stop());
            microphoneAuthorized = true;
            startQuickWakeListener();
            return true;
          })
          .catch(function () {
            return false;
          });
      };

      pauseQuickWakeListener = function () {
        paused = true;
        clearTimeout(restartTimer);
        if (listening) recognition.abort();
        fab.classList.remove("is-listening");
      };

      resumeQuickWakeListener = function () {
        if (!active) {
          startQuickWakeListener();
          return;
        }

        paused = false;
        scheduleRestart(100);
      };

      if (navigator.permissions?.query) {
        navigator.permissions.query({ name: "microphone" })
          .then(function (permission) {
            if (permission.state !== "granted") return;

            microphoneAuthorized = true;
            startQuickWakeListener();
          })
          .catch(function () {});
      }
    }

    function setupVoiceInput() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!voiceBtn || !SpeechRecognition) {
        voiceBtn?.setAttribute("hidden", "hidden");
        return;
      }

      const recognition = new SpeechRecognition();
      recognition.lang = "pt-BR";
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.maxAlternatives = 1;
      let isListening = false;
      let shouldKeepListening = false;
      let submitAfterStop = false;
      let voiceErrorVisible = false;
      let silenceTimer = null;

      function resetTranscript() {
        input.value = "";
        resizeInput();
      }

      function normalizeSpeechPart(value) {
        return (value || "").replace(/\s+/g, " ").trim();
      }

      function mergeSpeechPart(currentText, nextText) {
        const current = normalizeSpeechPart(currentText);
        const next = normalizeSpeechPart(nextText);
        if (!current) return next;
        if (!next) return current;

        const currentLower = current.toLowerCase();
        const nextLower = next.toLowerCase();
        if (nextLower.startsWith(currentLower)) return next;
        if (currentLower.endsWith(nextLower)) return current;

        const currentWords = current.split(" ");
        const nextWords = next.split(" ");
        const maxOverlap = Math.min(currentWords.length, nextWords.length);

        for (let size = maxOverlap; size > 0; size -= 1) {
          const currentTail = currentWords.slice(-size).join(" ").toLowerCase();
          const nextHead = nextWords.slice(0, size).join(" ").toLowerCase();
          if (currentTail === nextHead) {
            return `${currentWords.join(" ")} ${nextWords.slice(size).join(" ")}`.trim();
          }
        }

        return `${current} ${next}`.trim();
      }

      function mergeSpeechParts(parts) {
        return parts.reduce(function (text, part) {
          return mergeSpeechPart(text, part);
        }, "");
      }

      function clearSilenceTimer() {
        if (!silenceTimer) return;

        clearTimeout(silenceTimer);
        silenceTimer = null;
      }

      function scheduleConversationSubmit() {
        return;
      }

      function setVoiceIdle() {
        voiceBtn.classList.remove("is-listening", "is-waiting", "is-understanding");
        voiceBtn.setAttribute("aria-label", "Falar com o agente");
        voiceBtn.title = "Falar";
      }

      function setVoiceWaiting() {
        voiceBtn.classList.add("is-waiting");
        voiceBtn.classList.remove("is-understanding");
        voiceBtn.setAttribute("aria-label", "Preparando microfone");
        voiceBtn.title = "Preparando...";
      }

      function setVoiceUnderstanding() {
        voiceBtn.classList.add("is-understanding");
        voiceBtn.classList.remove("is-waiting");
        voiceBtn.title = "Entendendo...";
      }

      function startRecognition() {
        try {
          recognition.start();
        } catch (error) {
          if (error.name !== "InvalidStateError") showVoiceError("Nao consegui iniciar o microfone. Tente novamente.");
        }
      }

      function showVoiceError(message) {
        if (voiceErrorVisible) return;

        voiceErrorVisible = true;
        shouldKeepListening = false;
        submitAfterStop = false;
        setVoiceIdle();
        addMessage(message, "bot");

        setTimeout(function () {
          voiceErrorVisible = false;
        }, 2500);
      }

      function canUseMicrophone() {
        if (!window.isSecureContext && !["localhost", "127.0.0.1"].includes(window.location.hostname)) {
          showVoiceError("Para usar o microfone, acesse o sistema por HTTPS ou localhost.");
          return false;
        }

        return true;
      }

      resetVoiceState = function () {
        shouldKeepListening = false;
        submitAfterStop = false;
        clearSilenceTimer();
        resetTranscript();
        setVoiceIdle();
        if (isListening) recognition.abort();
      };

      stopVoiceCapture = function () {
        shouldKeepListening = false;
        submitAfterStop = false;
        clearSilenceTimer();
        resetTranscript();
        setVoiceIdle();
        if (isListening) recognition.abort();
      };

      startVoiceCapture = function () {
        if (agentSpeaking) return;
        if (waitingForAgentResponse) return;
        if (shouldKeepListening || isListening) return;
        if (!canUseMicrophone()) return;

        resetTranscript();
        submitAfterStop = false;
        shouldKeepListening = true;
        setVoiceWaiting();
        startRecognition();
      };

      recognition.addEventListener("start", function () {
        isListening = true;
        voiceBtn.classList.add("is-listening");
        voiceBtn.classList.remove("is-understanding");
        voiceBtn.classList.add("is-waiting");
        voiceBtn.setAttribute("aria-label", "Parar gravacao");
        voiceBtn.title = "Ouvindo...";
      });

      recognition.addEventListener("end", function () {
        isListening = false;
        if (input.value.trim()) {
          shouldKeepListening = false;
          submitAfterStop = false;
          const text = input.value.trim();
          resetTranscript();
          if (text) sendMessage(text);
          return;
        }

        if (shouldKeepListening && conversationMode && !waitingForAgentResponse && !agentSpeaking) {
          setVoiceWaiting();
          setTimeout(function () {
            if (shouldKeepListening && !isListening && conversationMode && !waitingForAgentResponse && !agentSpeaking) startRecognition();
          }, 250);
          return;
        }

        shouldKeepListening = false;
        setVoiceIdle();
        if (submitAfterStop) {
          submitAfterStop = false;
          const text = input.value.trim();
          resetTranscript();
          if (text) sendMessage(text);
        }
      });

      recognition.addEventListener("result", function (event) {
        const finalParts = [];
        let interimTranscript = "";

        for (let index = 0; index < event.results.length; index += 1) {
          const transcript = (event.results[index][0].transcript || "").trim();
          if (!transcript) continue;

          if (event.results[index].isFinal) {
            finalParts.push(transcript);
          } else {
            interimTranscript = transcript;
          }
        }

        const transcribedText = mergeSpeechParts(interimTranscript ? finalParts.concat(interimTranscript) : finalParts);
        input.value = transcribedText;
        resizeInput();
        if (input.value) {
          setVoiceUnderstanding();
          scheduleConversationSubmit();
        }
      });

      recognition.addEventListener("error", function (event) {
        if (event.error === "aborted") return;

        if (event.error === "no-speech") {
          clearSilenceTimer();
          if (conversationMode && shouldKeepListening && !waitingForAgentResponse && !agentSpeaking) {
            setVoiceWaiting();
            voiceBtn.title = "Ouvindo...";
            return;
          }

          shouldKeepListening = false;
          submitAfterStop = false;
          setVoiceIdle();
          return;
        }

        if (["not-allowed", "service-not-allowed"].includes(event.error)) {
          showVoiceError("Permita o acesso ao microfone no navegador e tente de novo.");
        } else if (event.error === "audio-capture") {
          shouldKeepListening = false;
          submitAfterStop = false;
          setVoiceIdle();
          voiceBtn.title = "Microfone indisponivel";
        } else {
          showVoiceError("Nao consegui ouvir o audio. Verifique o microfone e tente de novo.");
        }
      });

      function interruptAgentAndListen() {
        stopAgentPlayback();
        setVoiceWaiting();
        setTimeout(function () {
          startVoiceCapture();
        }, 120);
      }

      voiceBtn.addEventListener("click", async function () {
        if (agentSpeaking) {
          interruptAgentAndListen();
          return;
        }

        if (shouldKeepListening || isListening) {
          shouldKeepListening = false;
          submitAfterStop = true;
          clearSilenceTimer();
          recognition.stop();
          setVoiceIdle();
        } else {
          startVoiceCapture();
        }
      });
    }

    fab.addEventListener("click", function (event) {
      if (event.target.closest(".ai-agent-fab__quick-bubble")) {
        openModal();
        return;
      }

      authorizeQuickWake();
      openModal();
    });
    closeBtn?.addEventListener("click", closeModal);
    modal.addEventListener("click", function (event) {
      if (event.target === modal) closeModal();
    });
    showFabTipIfNeeded();

    setupQuickConversation();
    setupVoiceInput();

    conversationBtn?.addEventListener("click", function () {
      setConversationMode(!conversationMode);
      if (conversationMode) startVoiceCapture();
    });

    input.addEventListener("input", function () {
      resizeInput();
      renderMentions();
    });

    input.addEventListener("keydown", function (event) {
      const hasMentionMenu = mentions && !mentions.hidden && mentionState.options.length > 0;

      if (hasMentionMenu && event.key === "ArrowDown") {
        event.preventDefault();
        mentionState.active = (mentionState.active + 1) % mentionState.options.length;
        renderMentions();
      } else if (hasMentionMenu && event.key === "ArrowUp") {
        event.preventDefault();
        mentionState.active = (mentionState.active - 1 + mentionState.options.length) % mentionState.options.length;
        renderMentions();
      } else if (hasMentionMenu && (event.key === "Enter" || event.key === "Tab")) {
        event.preventDefault();
        applyMentionOption(mentionState.options[mentionState.active]);
      } else if (hasMentionMenu && event.key === "Escape") {
        event.preventDefault();
        hideMentions();
      } else if (event.key === "Enter" && !event.shiftKey && window.matchMedia("(pointer: fine)").matches) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    document.addEventListener("click", function (event) {
      if (!mentions || mentions.hidden) return;
      if (event.target === input || mentions.contains(event.target)) return;

      hideMentions();
    });

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      sendMessage(text);
    });
  }

  document.addEventListener("DOMContentLoaded", bindAiAgent);
  document.addEventListener("turbo:load", bindAiAgent);
})();
</script>
