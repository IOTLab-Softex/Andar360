<% if user_signed_in? %>
  <% Announcement.expire_passed! %>
  <% pending = Announcement.active
                            .in_period
                            .visible_to(current_user)
                            .where.not(id: current_user.announcement_views.select(:announcement_id))
                            .reorder(position: :asc, created_at: :asc) %>
  <% if pending.any? %>

    <style>
      #ann-overlay {
        display: flex;
        position: fixed;
        inset: 0;
        z-index: 10200;
        background: rgba(0, 0, 0, 0.75);
        align-items: center;
        justify-content: center;
        padding: 16px;
        backdrop-filter: blur(4px);
      }

      #ann-box {
        background: var(--color-card, #fff);
        color: var(--color-text, #111);
        border-radius: 20px;
        width: min(640px, 96vw);
        max-height: 92vh;
        overflow-y: auto;
        box-shadow: 0 32px 80px rgba(0, 0, 0, 0.45);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(112, 20, 241, 0.25);
        scrollbar-width: thin;
      }

      #ann-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px 12px;
        border-bottom: 1px solid rgba(128, 128, 128, 0.2);
        flex-shrink: 0;
      }

      #ann-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-accent, #7014f1);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 4px 10px;
        border-radius: 999px;
        text-transform: uppercase;
      }

      #ann-counter {
        font-size: 0.78rem;
        color: var(--color-muted, #888);
      }

      #ann-image-wrap {
        width: 100%;
        background: #000;
        flex-shrink: 0;
        position: relative;
      }

      #ann-image-wrap img,
      #ann-image-wrap video {
        width: 100%;
        max-height: 420px;
        object-fit: contain;
        display: block;
      }

      #ann-sound-btn {
        position: absolute;
        bottom: 10px;
        right: 10px;
        z-index: 2;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.52);
        color: #fff;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        transition: background 0.18s;
      }
      #ann-sound-btn:hover { background: rgba(0, 0, 0, 0.76); }

      #ann-content {
        padding: 20px 24px 8px;
        flex: 1;
      }

      #ann-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 10px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--color-text, #111);
      }

      #ann-body-text {
        font-size: 0.95rem;
        line-height: 1.65;
        color: var(--color-text, #444);
        white-space: pre-wrap;
        margin: 0;
      }

      #ann-footer {
        padding: 16px 24px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        border-top: 1px solid rgba(128, 128, 128, 0.15);
        gap: 12px;
        flex-wrap: wrap;
      }

      #ann-dots {
        display: flex;
        gap: 6px;
      }

      .ann-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(128, 128, 128, 0.35);
        transition: background 0.2s;
      }

      .ann-dot.active {
        background: var(--color-accent, #7014f1);
      }

      #ann-close-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--color-accent, #7014f1);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 9px 22px;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s;
      }

      #ann-close-btn:hover { opacity: 0.85; }

      #ann-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 22px;
        border-radius: 10px;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        color: #fff;
        background: linear-gradient(135deg, #3b0d8c, #7014f1);
        box-shadow: 0 4px 18px rgba(112,20,241,.5);
        transition: transform .15s, box-shadow .15s, opacity .15s;
        cursor: pointer;
        border: none;
        white-space: nowrap;
      }

      #ann-cta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 26px rgba(112,20,241,.65);
        opacity: .92;
        color: #fff;
        text-decoration: none;
      }

      #ann-cta-btn:active { transform: translateY(0); }
    </style>

    <div id="ann-overlay">
      <div id="ann-box">

        <div id="ann-header">
          <span id="ann-badge">
            <i class="fa-solid fa-bullhorn"></i> Anúncio
          </span>
          <span id="ann-counter"></span>
        </div>

        <div id="ann-image-wrap" style="display:none;">
          <img id="ann-image" src="" alt="Imagem do anúncio" style="display:none;">
          <video id="ann-video" autoplay muted loop playsinline style="display:none;"></video>
          <button id="ann-sound-btn" type="button" aria-label="Ativar/Desativar som" title="Ativar/Desativar som">
            <i class="fa-solid fa-volume-xmark"></i>
          </button>
        </div>

        <div id="ann-content">
          <p id="ann-title" style="display:none;"></p>
          <p id="ann-body-text" style="display:none;"></p>
        </div>

        <div id="ann-footer">
          <div id="ann-dots"></div>
          <div style="display:flex; align-items:center; gap:10px; margin-left:auto; flex-wrap:wrap; justify-content:flex-end;">
            <a id="ann-cta-btn" href="#" target="_blank" rel="noopener" style="display:none;">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
              <span id="ann-cta-label"></span>
            </a>
            <button id="ann-close-btn">
              <i class="fa-solid fa-check"></i> Entendido
            </button>
          </div>
        </div>

      </div>
    </div>

    <script>
    (function(){
      const announcements = <%= pending.map { |a|
        is_video = a.image.attached? && a.image.content_type.start_with?("video/")
        {
          id:       a.id,
          title:    a.title,
          body:     a.body,
          image:    a.image.attached? && !is_video ? url_for(a.image) : nil,
          video:    is_video ? url_for(a.image) : nil,
          ctaUrl:   a.cta_url.presence,
          ctaLabel: a.cta_label.presence || "Saiba mais",
          markUrl:  mark_viewed_announcement_path(a)
        }
      }.to_json.html_safe %>;

      let current = 0;
      const csrf      = document.querySelector('meta[name="csrf-token"]')?.content;
      const overlay   = document.getElementById('ann-overlay');
      const imageWrap = document.getElementById('ann-image-wrap');
      const imageEl   = document.getElementById('ann-image');
      const videoEl   = document.getElementById('ann-video');
      const soundBtn  = document.getElementById('ann-sound-btn');
      const titleEl   = document.getElementById('ann-title');
      const bodyEl    = document.getElementById('ann-body-text');
      const closeBtn  = document.getElementById('ann-close-btn');
      const counter   = document.getElementById('ann-counter');
      const dotsWrap  = document.getElementById('ann-dots');
      const ctaBtn    = document.getElementById('ann-cta-btn');
      const ctaLabel  = document.getElementById('ann-cta-label');

      if (soundBtn) {
        soundBtn.addEventListener('click', function() {
          if (!videoEl) return;
          videoEl.muted = !videoEl.muted;
          soundBtn.querySelector('i').className = videoEl.muted ? 'fa-solid fa-volume-xmark' : 'fa-solid fa-volume-high';
        });
      }

      // Dots
      if (announcements.length > 1) {
        announcements.forEach((_, i) => {
          const d = document.createElement('span');
          d.className = 'ann-dot' + (i === 0 ? ' active' : '');
          d.id = 'ann-dot-' + i;
          dotsWrap.appendChild(d);
        });
      }

      function render(ann) {
        const box = document.getElementById('ann-box');
        box.scrollTop = 0;

        if (ann.video) {
          imageEl.style.display = 'none';
          videoEl.src = ann.video;
          videoEl.style.display = 'block';
          videoEl.muted = true;
          videoEl.play().catch(function(){});
          if (soundBtn) { soundBtn.style.display = 'flex'; soundBtn.querySelector('i').className = 'fa-solid fa-volume-xmark'; }
          imageWrap.style.display = 'block';
        } else if (ann.image) {
          videoEl.pause(); videoEl.style.display = 'none';
          if (soundBtn) soundBtn.style.display = 'none';
          imageEl.src = ann.image;
          imageEl.style.display = 'block';
          imageWrap.style.display = 'block';
        } else {
          videoEl.pause(); videoEl.style.display = 'none';
          imageEl.style.display = 'none';
          if (soundBtn) soundBtn.style.display = 'none';
          imageWrap.style.display = 'none';
        }

        if (ann.title) {
          titleEl.innerHTML = '<i class="fa-solid fa-star" style="color:var(--color-accent,#7014f1);font-size:0.95rem;"></i> ' + ann.title;
          titleEl.style.display = 'flex';
        } else {
          titleEl.style.display = 'none';
        }

        if (ann.body) {
          bodyEl.textContent = ann.body;
          bodyEl.style.display = 'block';
        } else {
          bodyEl.style.display = 'none';
        }

        if (ctaBtn) {
          if (ann.ctaUrl) {
            ctaBtn.href = ann.ctaUrl;
            if (ctaLabel) ctaLabel.textContent = ann.ctaLabel || 'Saiba mais';
            ctaBtn.style.display = 'inline-flex';
          } else {
            ctaBtn.style.display = 'none';
          }
        }

        if (announcements.length > 1) {
          counter.textContent = (current + 1) + ' / ' + announcements.length;
          document.querySelectorAll('.ann-dot').forEach((d, i) => {
            d.classList.toggle('active', i === current);
          });
          closeBtn.innerHTML = current < announcements.length - 1
            ? '<i class="fa-solid fa-arrow-right"></i> Próximo'
            : '<i class="fa-solid fa-check"></i> Entendido';
        }
      }

      function markAndAdvance() {
        const ann = announcements[current];
        fetch(ann.markUrl, {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrf, 'Content-Type': 'application/json' }
        });
        current++;
        if (current < announcements.length) {
          render(announcements[current]);
        } else {
          overlay.style.display = 'none';
        }
      }

      closeBtn.addEventListener('click', markAndAdvance);
      render(announcements[0]);
    })();
    </script>

  <% end %>
<% end %>
