<p style="color: green"><%= notice %></p>

<!-- DADOS DA SALA -->
<div class="chamado-section section-box">
  <div class="section-header">
    <h5>
      <i class="fa-solid fa-circle-info"></i>
      Dados da sala
    </h5>
  </div>

  <div class="section-body chamado-grid">
    <div class="chamado-field">
      <span class="label">Nome da Sala:</span>
      <span class="value"><%= @room.name.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Grupo de Salas:</span>
      <span class="value"><%= @room.room_group&.name || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Virtual:</span>
      <span class="value"><%= @room.virtual? ? "Sim" : "Não" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Alugada:</span>
      <span class="value"><%= @room.alugado? ? "Sim" : "Não" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Unidade vazia:</span>
      <span class="value"><%= @room.unidade_vazia? ? "Sim" : "Não" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Ativa:</span>
      <span class="value"><%= @room.ativo? ? "Sim" : "Não" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Área (m²):</span>
      <span class="value"><%= @room.area || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Matrícula:</span>
      <span class="value"><%= @room.matricula.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Fração ideal:</span>
      <span class="value"><%= @room.fracao_ideal.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Fração extra:</span>
      <span class="value"><%= @room.fracao_extra.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Interfone:</span>
      <span class="value"><%= @room.interfone.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Vaga(s) de garagem:</span>
      <span class="value"><%= @room.vagas_garagem.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Empresa proprietária:</span>
      <span class="value"><%= @room.empresa_proprietaria.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Inquilino:</span>
      <span class="value"><%= @room.dados_do_inquilino.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Proprietário formal:</span>
      <span class="value"><%= @room.proprietario_formal.presence || "—" %></span>
    </div>

    <div class="chamado-field">
      <span class="label">Espaço comum:</span>
      <span class="value"><%= @room.espaco_comun? ? "Sim" : "Não" %></span>
    </div>

    <div class="chamado-field chamado-observacao">
      <span class="label">Observação:</span>
      <div class="value trix-content">
        <%= @room.observacao.presence || "—" %>
      </div>
    </div>

    <div class="chamado-field chamado-observacao">
      <span class="label">Regras de uso:</span>
      <div class="value trix-content">
        <%= @room.regras_de_uso.presence || "—" %>
      </div>
    </div>
  </div>
</div>

<!-- SEÇÃO ESPECÍFICA PARA ESPAÇO COMUM -->
<% if @room.espaco_comun? %>
  <div class="section-box">
    <div class="section-header">
      <h5>
        <i class="fa-solid fa-people-roof"></i>
        Detalhes do espaço comum
      </h5>
    </div>
    <div class="section-body chamado-grid">
      <div class="chamado-field">
        <span class="label">Categoria:</span>
        <span class="value"><%= @room.categoria.presence || "—" %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Capacidade:</span>
        <span class="value"><%= @room.capacidade.presence || "—" %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Taxa:</span>
        <span class="value"><%= @room.taxa.presence || "—" %></span>
      </div>

      <div class="chamado-field">
        <span class="label">Dispositivo:</span>
        <span class="value"><%= @room.device&.name || "—" %></span>
      </div>
    </div>
  </div>
<% end %>

<!-- ITENS DA SALA -->
<div class="section-box">
  <div class="section-header">
    <h5>
      <i class="fa fa-list-ul"></i>
      Itens da sala
    </h5>
  </div>
  <div class="section-body">
    <% if @room.room_items.any? %>
      <div class="lista-anexos">
        <% @room.room_items.each do |item| %>
          <div class="anexo-item">
            <div class="anexo-info">
              <%= item.name %>
            </div>
            <div>
              <span class="badge bg-secondary"><%= item.quantity %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted text-center">Nenhum item cadastrado.</p>
    <% end %>
  </div>
</div>

<!-- FOTO DA SALA -->
<div class="section-box">
  <div class="section-header">
    <h5>
      <i class="fa-solid fa-camera"></i>
      Foto da sala
    </h5>
  </div>
  <div class="section-body">
    <% if @room.photo.attached? %>
      <%= room_photo_tag(@room.photo) %>
    <% else %>
      <p class="text-muted">Nenhuma foto enviada para esta sala.</p>
    <% end %>
  </div>
</div>



