trix-toolbar .trix-button-group { border: 1px solid var(--border, #ddd); border-radius: 6px; padding: 2px; }
trix-toolbar .trix-button-row { gap: .25rem; }
trix-toolbar .trix-button { border: none; }
/* app/assets/stylesheets/application.css */
trix-editor.trix-simples:empty::before {
  content: attr(placeholder);
  color: #888;
  pointer-events: none; /* <-- importante */
}

.me-toolbar { display:flex; gap:.25rem; margin:6px 0 8px; flex-wrap:wrap; }
