<%= form_with(model: room, local: true, html: { multipart: true }, class: 'device-form') do |form| %>
  <div style="display: flex; flex-wrap: wrap; gap: 8px;">
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :name, "Nome da Sala" %>
      <%= form.text_field :name, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :room_group_id, "Grupo de Salas" %>
      <%= form.collection_select :room_group_id, RoomGroup.all, :id, :name, { prompt: "Selecione um grupo" }, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :virtual, "Virtual" %>
      <%= form.select :virtual, [["Sim", true], ["Não", false]], {}, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :alugado, "Alugado" %>
      <%= form.select :alugado, [["Sim", true], ["Não", false]], {}, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :unidade_vazia, "Unidade Vazia" %>
      <%= form.select :unidade_vazia, [["Sim", true], ["Não", false]], {}, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :ativo, "Ativo" %>
      <%= form.select :ativo, [["Sim", true], ["Não", false]], {}, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 100%;">
      <%= form.label :espaco_comun, "Espaço Comum" %>
      <%= form.select :espaco_comun, [["Sim", true], ["Não", false]], {}, class: 'form-control', id: 'espaco-comun-select' %>
      <div class="espaco-comum-fields" style="display: none; flex: 1 1 100%; flex-wrap: wrap; gap: 1rem;">
        <div class="form-group" style="flex: 1 1 30%; background: var(--color-common-space-form-group); color: black;">
          <%= form.label :categoria, "Categoria" %>
          <%= form.text_field :categoria, class: 'form-control' %>
        </div>
        <div class="form-group" style="flex: 1 1 30%; background: var(--color-common-space-form-group); color: black;">
          <%= form.label :capacidade, "Capacidade" %>
          <%= form.text_field :capacidade, class: 'form-control' %>
        </div>
        <div class="form-group" style="flex: 1 1 30%; background: var(--color-common-space-form-group); color: black;">
          <%= form.label :taxa, "Taxa" %>
          <%= form.text_field :taxa, class: 'form-control' %>
        </div>
      </div>
      <div class="form-group device-field" style="display: none; background: var(--color-common-space-form-group); color: black;">
        <%= form.label :device_id do %>
          <i class="fa-solid fa-mobile-screen-button"></i> Dispositivo
        <% end %>
        <%= form.collection_select :device_id, Device.all, :id, :name, prompt: "Selecione o dispositivo", class: "form-control" %>
      </div>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :area, "Área (m²)" %>
      <%= form.number_field :area, step: 0.01, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :matricula, "Matrícula" %>
      <%= form.text_field :matricula, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :fracao_ideal, "Fração Ideal" %>
      <%= form.text_field :fracao_ideal, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :fracao_extra, "Fração Extra" %>
      <%= form.text_field :fracao_extra, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :interfone, "Interfone" %>
      <%= form.text_field :interfone, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :vagas_garagem, "Vaga(s) de Garagem" %>
      <%= form.text_field :vagas_garagem, class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :empresa_proprietaria, "Empresa Proprietária" %>
      <%= form.select :empresa_proprietaria, options_for_select(@empresas, room.empresa_proprietaria.presence || @empresa_padrao), prompt: "Selecione uma empresa", class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :dados_do_inquilino, "Inquilino" %>
      <%= form.select :dados_do_inquilino, options_for_select(@empresas, room.dados_do_inquilino), prompt: "Selecione uma empresa", class: 'form-control' %>
    </div>
    <div class="form-group" style="flex: 1 1 30%;">
      <%= form.label :proprietario_formal, "Proprietário Formal" %>
      <%= form.select :proprietario_formal, options_for_select(@empresas, room.proprietario_formal), prompt: "Selecione uma empresa", class: 'form-control' %>
    </div>

<div class="form-group full-width" data-me>
  <%= form.label :observacao, "Observação" %>

  <div class="me-toolbar" role="toolbar">
    <button type="button" data-me-cmd="bold"><b>B</b></button>
    <button type="button" data-me-cmd="italic"><i>I</i></button>
    <button type="button" data-me-cmd="underline"><u>U</u></button>
    <button type="button" data-me-cmd="insertUnorderedList">• Lista</button>
    <button type="button" data-me-cmd="insertOrderedList">1. Lista</button>
    <button type="button" data-me-link>🔗 Link</button>
    <button type="button" data-me-clear>✖ Limpar</button>
  </div>

  <div class="me-editor"
       contenteditable="true"
       data-me-editable
       data-placeholder="Digite a descrição da sala..."></div>

  <%= form.hidden_field :observacao %>
</div>


<div class="form-group full-width" data-me>
  <%= form.label :regras_de_uso, "Regras de Uso" %>

  <div class="me-toolbar" role="toolbar">
    <button type="button" data-me-cmd="bold"><b>B</b></button>
    <button type="button" data-me-cmd="italic"><i>I</i></button>
    <button type="button" data-me-cmd="underline"><u>U</u></button>
    <button type="button" data-me-cmd="insertUnorderedList">• Lista</button>
    <button type="button" data-me-cmd="insertOrderedList">1. Lista</button>
    <button type="button" data-me-link>🔗 Link</button>
    <button type="button" data-me-clear>✖ Limpar</button>
  </div>

  <div class="me-editor"
       contenteditable="true"
       data-me-editable
       data-placeholder="Defina as regras (ex.: horários, limpeza, multa)..."></div>

  <%= form.hidden_field :regras_de_uso %>
</div>







  </div>
  <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
    <div class="form-group" style="flex: 1 1 30%;">
      <h3 style="margin-top: 2rem;">Itens da Sala</h3>
      <div id="room-items">
        <%= form.fields_for :room_items do |item_form| %>
          <div class="item-row" style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
            <%= item_form.text_field :name, placeholder: "Ex: Cadeira, TV, Cabo HDMI", class: "form-control", style: "width: 50%;" %>
            <%= item_form.number_field :quantity, min: 1, class: "form-control", placeholder: "Qtd", style: "width: 100px;" %>
            <%= item_form.hidden_field :_destroy, class: "destroy-flag" %>
            <%= link_to "#", class: "remove-item btn btn-danger" do %>
              <i class="fa-solid fa-trash"></i> Remover
            <% end %>
          </div>
        <% end %>
      </div>
      <div style="margin-bottom: 1rem;">
        <%= link_to "#", id: "add-item", class: "btn btn-secondary" do %>
          <i class="fa-solid fa-plus"></i> Adicionar Item
        <% end %>
      </div>
    </div>
  </div>
  <div class="form-group">
    <%= form.label :photo do %>
      <%= svg_icon("icones/icons_custom/solid/photo_room.svg", class: "srs-solid") %> Foto da Sala
    <% end %>
    <%= form.file_field :photo, class: 'form-control' %>
  </div>

<div class="form-actions" style="text-align: center;">
  <%= form.button type: 'submit', class: 'btn submit' do %>
    <% if room.new_record? %>
      <i class="fa-solid fa-plus"></i> Criar Sala
    <% else %>
      <i class="fa-solid fa-rotate"></i> Atualizar Sala
    <% end %>
  <% end %>
</div>
<% end %>
<% if room.errors.any? %>
  <div class="alert alert-danger">
    <h4>Erros ao salvar:</h4>
    <ul>
      <% room.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const espacoSelect = document.getElementById("espaco-comun-select");
    const camposEspacoComum = document.querySelector(".espaco-comum-fields");
    const campoDispositivo = document.querySelector(".device-field");

    function toggleCamposEspaco() {
      const isEspacoComum = espacoSelect.value === "true";

      camposEspacoComum.style.display = isEspacoComum ? "flex" : "none";
      campoDispositivo.style.display = isEspacoComum ? "block" : "none";
    }

    toggleCamposEspaco(); // Inicializa visibilidade correta
    espacoSelect.addEventListener("change", toggleCamposEspaco);
  });
    document.addEventListener("trix-file-accept", function (event) {
    event.preventDefault(); // bloqueia anexos/arrastar-imagem
  });
  document.addEventListener("trix-attachment-add", function (event) {
    event.attachment.remove(); // caso passe, remove mesmo assim
  });

  (function () {
  // guarda a seleção por editor
  const ranges = new WeakMap();

  function rootOf(node) {
    if (!node) return null;
    return (node.nodeType === 1 ? node : node.parentElement)?.closest("[data-me]") || null;
  }

  // salva a seleção sempre que mudar
  document.addEventListener("selectionchange", () => {
    const sel = document.getSelection();
    if (!sel || sel.rangeCount === 0) return;
    const r = sel.getRangeAt(0);
    const root = rootOf(r.startContainer);
    if (root) ranges.set(root, r);
  });

  function restoreRange(root) {
    const r = ranges.get(root);
    if (!r) return;
    const sel = document.getSelection();
    sel.removeAllRanges();
    sel.addRange(r);
  }

  function sync(root) {
    const editable = root.querySelector("[data-me-editable]");
    const hidden   = root.querySelector('input[type="hidden"], textarea[type="hidden"], input[name$="[observacao]"], input[name$="[regras_de_uso]"]');
    if (hidden) hidden.value = editable.innerHTML;
  }

  // inicializa conteúdo existente (se vier do servidor)
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-me]").forEach(root => {
      const editable = root.querySelector("[data-me-editable]");
      const hidden   = root.querySelector('input[type="hidden"], textarea[type="hidden"], input[name$="[observacao]"], input[name$="[regras_de_uso]"]');
      if (hidden && hidden.value) editable.innerHTML = hidden.value;
    });
  });

  // delegação dos botões
  document.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-me-cmd], [data-me-link], [data-me-clear]");
    if (!btn) return;

    const root = btn.closest("[data-me]");
    if (!root) return;

    const editable = root.querySelector("[data-me-editable]");
    editable.focus();
    restoreRange(root);

    if (btn.hasAttribute("data-me-cmd")) {
      const cmd = btn.getAttribute("data-me-cmd");
      document.execCommand("styleWithCSS", false, true); // permite negrito/itálico continuar ao digitar
      document.execCommand(cmd, false, null);
      sync(root);
      return;
    }

    if (btn.hasAttribute("data-me-link")) {
      const url = prompt("URL do link:");
      if (url) document.execCommand("createLink", false, url);
      sync(root);
      return;
    }

    if (btn.hasAttribute("data-me-clear")) {
      root.querySelector("[data-me-editable]").innerHTML = "";
      sync(root);
      return;
    }
  });

  // sincroniza ao digitar
  document.addEventListener("input", (e) => {
    const editable = e.target.closest("[data-me-editable]");
    if (!editable) return;
    sync(editable.closest("[data-me]"));
  });

  // garante sincronizar no submit de QUALQUER form
  document.addEventListener("submit", (e) => {
    e.target.querySelectorAll("[data-me]").forEach(sync);
  });
})();
</script>
<style>
.form-group.full-width { flex: 1 1 100% !important; }

.device-form trix-editor.trix-simples {
