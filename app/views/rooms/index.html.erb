<div class="form-group" style="
    display: flex;
    flex-direction: column;
    align-content: center;
    align-items: center;
">
  <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
    <% if operador_ou_admin? %>
      <button type="button" class="btn btn-success" id="open-import-modal">
        <i class="fa-solid fa-file-import"></i> Importar XLS/CSV
      </button>
    <% end %>
  </div>
  <small style="    color: var(--color-btn);">
    Importe .xls, .xlsx ou .csv, com salas ja existente.
  </small>
</div>
<button type="button" id="filtro-toggle" class="filtro-label" aria-expanded="true" aria-controls="filtros-salas">
  <i class="fa-solid fa-filter"></i>
  Filtro
  <i class="fa-solid fa-chevron-up filtro-chevron" aria-hidden="true"></i>
</button>
<br>
<div class="mb-3" id="filtros-salas">
  <input type="text" id="filtro-nome" class="form-control" placeholder="Filtrar por nome...">
  <input type="text" id="filtro-empresa" class="form-control" placeholder="Empresa proprietária...">
  <input type="text" id="filtro-inquilino" class="form-control" placeholder="Inquilino...">
  <select id="filtro-ativo" class="form-control" >
    <option value="">Ativo?</option>
    <option value="Sim">Sim</option>
    <option value="Não">Não</option>
  </select>
  <select id="filtro-virtual" class="form-control">
    <option value="">Virtual?</option>
    <option value="Sim">Sim</option>
    <option value="Não">Não</option>
  </select>
  <select id="filtro-alugado" class="form-control">
    <option value="">Alugado?</option>
    <option value="Sim">Sim</option>
    <option value="Não">Não</option>
  </select>
  <select id="filtro-comum" class="form-control">
  <option value="">Espaço comum?</option>
  <option value="Sim">Sim</option>
  <option value="Não">Não</option>
</select>
</div>
<div id="salas-section" class="rooms expanded">
  <%= form_with url: bulk_destroy_rooms_path, method: :delete, local: true, id: "rooms-bulk-form" do %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <!-- Barra de ações em massa (aparece ao ativar seleção) -->
    <div id="rooms-bulk-toolbar"
     class="hidden"
     style="display:flex;gap:.6rem;align-items:center;justify-content:space-between;background:#7014f1;color:var(--color-btn);padding:.6rem .9rem;border-radius: 10px 10px 0px 0px;margin-bottom: -1.2rem;">
      <div>
        <strong id="rooms-selected-count" style="color: #ffffffff">0</strong> selecionada(s)
      </div>
      <div style="display:flex; gap:.4rem; flex-wrap:wrap;">
        <!-- NOVO: cancelar seleção -->
        <button type="button" id="rooms-bulk-cancel" class="btn btn-success" title="Cancelar seleção">
          <i class="fa-solid fa-xmark me-1"></i> Cancelar
        </button>
        <button type="button" id="rooms-bulk-delete" class="btn btn-warning" title="Excluir selecionadas">
          <i class="fa-solid fa-trash me-1"></i> Excluir selecionadas
        </button>
        <!-- outros botões em massa aqui -->
      </div>
    </div>
    
    <table class="table table-salas selection-table" id="rooms-table">
      <thead class="table-secondary text-dark">
        <tr>
          <!-- célula de seleção (oculta até ativar modo seleção) -->
          <th class="sel-cell" style="display:none; width:36px; text-align:center;">
            <input type="checkbox" id="rooms-check-all">
          </th>
          <th>Nome</th>
          <th>Empresa Proprietária</th>
          <th>Inquilino</th>
          <th>CNPJ do Inquilino</th>
          <th>Grupo</th>
          <th>Ativo</th>
          <th>Virtual</th>
          <th>Unidade Vazia</th>
          <th>Alugado</th>
          <th class="th-actions">
            <span>Ações</span>
            <div class="kebab-wrapper">
              <button id="rooms-kebab" type="button" class="btn Mais-opções" title="Mais opções" style="padding:6px 10px;font-size:1rem;">⋮</button>
              <div id="rooms-menu" class="kebab-menu" hidden>
                <button type="button" class="menu-item js-rooms-toggle-selection">
                  <i class="fa-solid fa-square-check me-2"></i> Selecionar
                </button>
                <button type="button" class="menu-item js-rooms-select-all hidden">
                  <i class="fa-solid fa-check-double me-2"></i> Selecionar todos
                </button>
                <button type="button" class="menu-item js-rooms-clear-selection hidden">
                  <i class="fa-solid fa-eraser me-2"></i> Limpar seleção
                </button>
              </div>
            </div>
          </th>
        </tr>
      </thead>
<tbody>
  <% @rooms.each do |room| %>
    <tr data-comum="<%= room.espaco_comun? ? 'Sim' : 'Não' %>">
      <!-- checkbox por linha (oculto fora do modo seleção) -->
      <td class="sel-cell" style="display:none; text-align:center;">
        <input type="checkbox" class="rooms-row-check" name="ids[]" value="<%= room.id %>">
      </td>
      <td>
        <strong><%= room.name %></strong>
        <% if room.espaco_comun? %>
          <span class="badge bg-secondary" style="margin-left:.4rem;">Espaço comum</span>
        <% end %>
      </td>
      <td><%= room.empresa_proprietaria.presence || "-" %></td>
      <td><%= room.dados_do_inquilino.presence || "-" %></td>
      <td>
        <% cnpj = room.dados_do_inquilino[%r{\d{2}\.?\d{3}\.?\d{3}/?\d{4}-?\d{2}}] rescue nil %>
        <%= cnpj || "-" %>
      </td>
      <td><%= room.grupo.presence || "-" %></td>
      <td><%= room.ativo? ? "Sim" : "Não" %></td>
      <td><%= room.virtual? ? "Sim" : "Não" %></td>
      <td><%= room.unidade_vazia? ? "Sim" : "Não" %></td>
      <td><%= room.alugado? ? "Sim" : "Não" %></td>
      <td>
        <%= link_to room_path(room), class: "btn btn-sm btn-outline-primary btn-success" do %>
          <i class="fa-solid fa-eye"></i> <div class="hide-sm"> Ver </div>
        <% end %>
        <% if operador_ou_admin? %>
          <%= link_to edit_room_path(room), class: 'btn btn-sm edit' do %>
            <i class="fa-solid fa-pen-to-square"></i> <div class="hide-sm"> Edite </div>
          <% end %>
          <%= link_to room_path(room),
              class: "btn btn-sm btn-warning btn-excluir-sala",
              data: { turbo_method: :delete, room_name: room.name } do %>
            <i class="fa-solid fa-trash"></i> <div class="hide-sm"> Excluir </div>
          <% end %>
        <% end %>
      </td>
    </tr>
  <% end %>
    <!-- linha de "nenhum resultado" -->
  <tr id="rooms-empty" style="display:none;" class="text-center">
    <!-- colspan deve cobrir todas as colunas visíveis (ajuste se adicionar/remover colunas) -->
    <td colspan="11" style="padding:1.2rem; color:var(--color-muted);">
      Nenhuma sala encontrada.
    </td>
  </tr>
</tbody>

    </table>
  <% end %>
</div>
<% if operador_ou_admin? %>
  <div id="importRoomsModal" class="v-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="importRoomsTitle">
    <div class="v-modal__backdrop" data-close="true"></div>
    <div class="v-modal__dialog" role="document">
      <div class="v-modal__header">
        <h5 id="importRoomsTitle" class="v-modal__title">
          <i class="fa-solid fa-file-import me-2"></i>
          Importar unidades (XLS/XLSX/CSV)
        </h5>
        <button type="button" class="v-modal__close" aria-label="Fechar" data-close="true" title="Fechar">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <%= form_with url: import_rooms_path,
                method: :post,
                multipart: true,
                data: { turbo: false },
                html: { id: "import-rooms-form" } do |f| %>
        <div class="v-modal__body">
          <div class="mb-3">
            <label class="form-label">
              <i class="fa-solid fa-file-arrow-up me-2"></i>
              Selecione o arquivo
            </label>
            <%= f.file_field :file, accept: ".xlsx,.xls,.csv", class: "form-control", required: true %>
            <small class="text-muted">
              Aceita .xls, .xlsx ou .csv. Se o <em>Grupo</em> não existir, será criado em <code>room_groups</code> e vinculado à unidade.
            </small>
          </div>
        </div>
        <div class="v-modal__footer">
          <button type="submit" class="btn btn-success" id="submit-import" disabled>
            <span class="v-spinner d-none btn-success" aria-hidden="true"></span>
            <i class="fa-solid fa-file-import me-1"></i>
            Importar
          </button>
          <button type="button" class="btn btn-light" data-close="true">
            <i class="fa-solid fa-ban me-1"></i>
            Cancelar
          </button>
          <%= link_to template_rooms_path, class: "btn btn-outline-secondary", title: "Baixar modelo" do %>
            <i class="fa-solid fa-download me-1"></i> Modelo
          <% end %><br>
          <small class="text-muted">
            Baixe a planilha de exemplo para importar.
          </small>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const rows = document.querySelectorAll("#salas-section tbody tr");

    function filtrar() {
  const nome = document.getElementById('filtro-nome').value.trim().toLowerCase();
  const empresa = document.getElementById('filtro-empresa').value.trim().toLowerCase();
  const inquilino = document.getElementById('filtro-inquilino').value.trim().toLowerCase();
  const ativo = document.getElementById('filtro-ativo').value;
  const virtual = document.getElementById('filtro-virtual').value;
  const alugado = document.getElementById('filtro-alugado').value;
  const comum = document.getElementById('filtro-comum').value;

  const emptyRow = document.getElementById('rooms-empty');

  let visibleCount = 0;

  rows.forEach(row => {
    // Seleciona as colunas pelo índice real na tabela (1-based)
    // td:nth-child(1) é a sel-cell (checkbox) -> por isso o nome está em nth-child(2)
    const tdNome = row.querySelector('td:nth-child(2)');
    const tdEmpresa = row.querySelector('td:nth-child(3)');
    const tdInquilino = row.querySelector('td:nth-child(4)');
    const tdAtivo = row.querySelector('td:nth-child(7)');
    const tdVirtual = row.querySelector('td:nth-child(8)');
    const tdAlugado = row.querySelector('td:nth-child(10)');

    // Textos seguros (null-check)
    const txtNome = tdNome ? tdNome.textContent.trim().toLowerCase() : '';
    const txtEmpresa = tdEmpresa ? tdEmpresa.textContent.trim().toLowerCase() : '';
    const txtInquilino = tdInquilino ? tdInquilino.textContent.trim().toLowerCase() : '';
    const txtAtivo = tdAtivo ? tdAtivo.textContent.trim() : '';
    const txtVirtual = tdVirtual ? tdVirtual.textContent.trim() : '';
    const txtAlugado = tdAlugado ? tdAlugado.textContent.trim() : '';

    let show = true;
    if (nome && !txtNome.includes(nome)) show = false;
    if (empresa && !txtEmpresa.includes(empresa)) show = false;
    if (inquilino && !txtInquilino.includes(inquilino)) show = false;
    if (ativo && txtAtivo !== ativo) show = false;
    if (virtual && txtVirtual !== virtual) show = false;
    if (alugado && txtAlugado !== alugado) show = false;
    if (comum && (row.dataset.comum !== comum)) show = false;

    row.style.display = show ? "" : "none";
    if (show) visibleCount++;
  });

  // mostra/oculta mensagem de "nenhuma sala"
  if (emptyRow) {
    emptyRow.style.display = (visibleCount === 0) ? "" : "none";
  }
}


    document.querySelectorAll('#filtros-salas input, #filtros-salas select').forEach(el => {
      el.addEventListener('input', filtrar);
      el.addEventListener('change', filtrar);
    });
  });

  document.addEventListener("click", async (e) => {
    const link = e.target.closest(".btn-excluir-sala");
    if (!link) return;

    // Impede o GET (show) do href
    e.preventDefault();

    const nomeSala = link.dataset.roomName || "esta sala";
    const action    = link.getAttribute("href");
    let confirmado  = true;

    if (window.Swal) {
      const res = await Swal.fire({
        title: "Excluir sala?",
        html: `Tem certeza que deseja excluir <b>${nomeSala}</b> e todas as reservas associadas?`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Sim, excluir",
        cancelButtonText: "Cancelar",
        reverseButtons: true,
        focusCancel: true
      });
      confirmado = res.isConfirmed;
    } else {
      confirmado = confirm(`Tem certeza que deseja excluir ${nomeSala} e todas as reservas associadas?`);
    }
    if (!confirmado) return;

    // Cria form temporário com CSRF e _method=delete
    const token = document.querySelector('meta[name="csrf-token"]')?.content;
    const form  = document.createElement("form");
    form.method = "POST";
    form.action = action;

    const inputMethod = document.createElement("input");
    inputMethod.type  = "hidden";
    inputMethod.name  = "_method";
    inputMethod.value = "delete";

    const inputToken = document.createElement("input");
    inputToken.type  = "hidden";
    inputToken.name  = "authenticity_token";
    inputToken.value = token || "";

    form.appendChild(inputMethod);
    form.appendChild(inputToken);

    // Evita interferência do form de bulk
    document.body.appendChild(form);
    form.submit();
  });

  (function() {
    function qs(sel, root=document){ return root.querySelector(sel); }

    function openModal() {
      const modal = qs('#importRoomsModal');
      if (!modal) return;
      modal.classList.add('is-open');
      document.body.classList.add('v-no-scroll');

      // foco acessível: foca no input file
      const file = qs('#import-rooms-form input[type="file"]', modal);
      if (file) setTimeout(() => file.focus(), 50);

      // ESC fecha
      modal._escHandler = (e) => {
        if (e.key === 'Escape') closeModal();
      };
      document.addEventListener('keydown', modal._escHandler);
    }

    function closeModal() {
      const modal = qs('#importRoomsModal');
      if (!modal) return;
      modal.classList.remove('is-open');
      document.body.classList.remove('v-no-scroll');
      if (modal._escHandler) {
        document.removeEventListener('keydown', modal._escHandler);
        modal._escHandler = null;
      }
    }

    function setupImportModal() {
      const openBtn = qs('#open-import-modal');
      const modal   = qs('#importRoomsModal');
      if (!modal || !openBtn) return;

      openBtn.addEventListener('click', openModal);

      // fechar por [x], "Cancelar" ou clicar no backdrop
      modal.addEventListener('click', (e) => {
        if (e.target.matches('[data-close="true"]')) closeModal();
        if (e.target === qs('.v-modal__backdrop', modal)) closeModal();
      });

      // habilitar submit ao escolher arquivo + spinner ao enviar
      const form    = qs('#import-rooms-form', modal);
      const input   = qs('input[type="file"]', form);
      const submit  = qs('#submit-import', form);
      const spinner = qs('.v-spinner', form);

      input.addEventListener('change', () => {
        submit.disabled = !(input.files && input.files.length > 0);
      });

      form.addEventListener('submit', () => {
        submit.disabled = true;
        spinner.classList.remove('d-none');
        // fecha o modal só depois do redirect? Você pode fechar já:
        // closeModal();
      });
    }

    document.addEventListener('turbo:load', setupImportModal);
    document.addEventListener('DOMContentLoaded', setupImportModal);
  })();

  (function initRoomsSelection(){
    function once(el){ if (!el) return false; if (el.dataset.bound === "1") return false; el.dataset.bound = "1"; return true; }

    function qs(s,root=document){ return root.querySelector(s); }
    function qsa(s,root=document){ return Array.from(root.querySelectorAll(s)); }

    function updateCount(table, counterEl){
      const count = qsa('.rooms-row-check', table).filter(ch => ch.checked).length;
      if (counterEl) counterEl.textContent = count;
      return count;
    }

    function enableSelectionMode(table, toolbar, enable){
      // mostra/oculta coluna de seleção e toolbar
      qsa('.sel-cell', table).forEach(td => td.style.display = enable ? "table-cell" : "none");
      table.classList.toggle('table--select', !!enable);
      if (toolbar) toolbar.classList.toggle('hidden', !enable);
      // alterna itens do menu
      const menu = qs('#rooms-menu');
      const btnAll   = menu?.querySelector('.js-rooms-select-all');
      const btnClear = menu?.querySelector('.js-rooms-clear-selection');
      btnAll  && btnAll.classList.toggle('hidden', !enable);
      btnClear&& btnClear.classList.toggle('hidden', !enable);
    }

    function bind(){
      const wrapper  = qs('.kebab-wrapper');
      const kebabBtn = qs('#rooms-kebab');
      const menu     = qs('#rooms-menu');
      const table    = qs('#rooms-table');
      const toolbar  = qs('#rooms-bulk-toolbar');
      if (!wrapper || !kebabBtn || !menu || !table || !toolbar) return;
      if (!once(wrapper)) return;

      const checkAll   = qs('#rooms-check-all');
      const counterEl  = qs('#rooms-selected-count');
      const bulkForm   = qs('#rooms-bulk-form');
      const btnDelete  = qs('#rooms-bulk-delete');
  const btnCancel  = qs('#rooms-bulk-cancel');
      const btnToggle  = menu.querySelector('.js-rooms-toggle-selection');
      const btnAll     = menu.querySelector('.js-rooms-select-all');
      const btnClear   = menu.querySelector('.js-rooms-clear-selection');

      // abrir/fechar menu
      kebabBtn.addEventListener('click', (e)=>{ e.preventDefault(); e.stopPropagation(); menu.hidden = !menu.hidden; });
      document.addEventListener('click', (e)=>{ if (!menu.hidden && !menu.contains(e.target) && e.target !== kebabBtn) menu.hidden = true; });

      // ativar modo seleção
      btnToggle?.addEventListener('click', ()=>{ enableSelectionMode(table, toolbar, true); menu.hidden = true; updateCount(table, counterEl); });

      // selecionar todos / limpar
      btnAll?.addEventListener('click', ()=>{
        qsa('.rooms-row-check', table).forEach(ch => ch.checked = true);
        checkAll && (checkAll.checked = true);
        updateCount(table, counterEl);
        menu.hidden = true;
      });
      btnClear?.addEventListener('click', ()=>{
        qsa('.rooms-row-check', table).forEach(ch => ch.checked = false);
        checkAll && (checkAll.checked = false);
        updateCount(table, counterEl);
        menu.hidden = true;
      });
      btnCancel?.addEventListener('click', () => {
    qsa('.rooms-row-check', table).forEach(ch => ch.checked = false);
    if (checkAll) checkAll.checked = false;
    updateCount(table, counterEl);
    enableSelectionMode(table, toolbar, false); // esconde coluna + toolbar
    if (menu) menu.hidden = true;               // garante menu fechado
  });
      // cabeçalho "check-all"
      checkAll?.addEventListener('change', function(){
        qsa('.rooms-row-check', table).forEach(ch => ch.checked = this.checked);
        updateCount(table, counterEl);
      });

      // contagem por linha
      table.addEventListener('change', (e)=>{
        if (e.target.classList.contains('rooms-row-check')) {
          const total = updateCount(table, counterEl);
          if (!e.target.checked && checkAll) checkAll.checked = false;
          if (total === qsa('.rooms-row-check', table).length && checkAll) checkAll.checked = true;
        }
      });

      // exclusão em massa
      btnDelete?.addEventListener('click', async ()=>{
        const total = updateCount(table, counterEl);
        if (total === 0) {
          window.Swal && Swal.fire({ icon:'warning', title:'Atenção', text:'Selecione pelo menos uma sala.' });
          return;
        }
        let confirmed = true;
        if (window.Swal) {
          confirmed = (await Swal.fire({
            title: 'Excluir salas selecionadas?',
            text: 'Essa ação removerá as salas e reservas associadas.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sim, excluir',
            cancelButtonText: 'Cancelar',
            reverseButtons: true
          })).isConfirmed;
        } else {
          confirmed = confirm('Excluir as salas selecionadas?');
        }
        if (!confirmed) return;

        // submit “real”
        if (bulkForm.requestSubmit) bulkForm.requestSubmit();
        else bulkForm.submit();
      });

      // fecha menu antes do cache Turbo
      document.addEventListener('turbo:before-cache', ()=>{ if (menu) menu.hidden = true; });
    }

    document.addEventListener('DOMContentLoaded', bind);
    document.addEventListener('turbo:load',    bind);
  })();

  document.addEventListener('DOMContentLoaded', function () {
  const toggle = document.getElementById('filtro-toggle');
  const filtros = document.getElementById('filtros-salas');
  if (!toggle || !filtros) return;

  const STORAGE_KEY = 'ui:filtros-salas-collapsed';

  // restaura estado salvo
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved === '1') {
    filtros.classList.add('collapsed');
    toggle.setAttribute('aria-expanded', 'false');
  } else {
    filtros.classList.remove('collapsed');
    toggle.setAttribute('aria-expanded', 'true');
  }

  // função para alternar
  function setCollapsed(collapsed, save = true) {
    if (collapsed) {
      filtros.classList.add('collapsed');
      toggle.setAttribute('aria-expanded', 'false');
      if (save) localStorage.setItem(STORAGE_KEY, '1');
    } else {
      filtros.classList.remove('collapsed');
      toggle.setAttribute('aria-expanded', 'true');
      if (save) localStorage.removeItem(STORAGE_KEY);
    }
  }

  // clique no botão
  toggle.addEventListener('click', function (ev) {
    ev.preventDefault();
    const isCollapsed = filtros.classList.contains('collapsed');
    setCollapsed(!isCollapsed);
  });

  // teclado: Enter / Space
  toggle.addEventListener('keydown', function (ev) {
    if (ev.key === 'Enter' || ev.key === ' ') {
      ev.preventDefault();
      toggle.click();
    }
  });

  // opcional: fecha o filtro ao clicar fora (somente se estiver aberto)
  document.addEventListener('click', function (ev) {
    // se estiver colapsado ignore
    if (filtros.classList.contains('collapsed')) return;
    const insideToggle = ev.target.closest('#filtro-toggle');
    const insideFiltros = ev.target.closest('#filtros-salas');
    if (!insideToggle && !insideFiltros) {
      // fecha sem salvar (se quiser salvar, passe true)
      setCollapsed(true, true);
    }
  });

  // se os inputs fizerem foco, garante que o painel esteja aberto
  document.querySelectorAll('#filtros-salas input, #filtros-salas select, #filtros-salas textarea').forEach((el) => {
    el.addEventListener('focus', () => setCollapsed(false, false));
  });
});

</script>
<style>


/* <= 992px: esconder CNPJ e Grupo */
@media (max-width: 992px){
  #rooms-table th:nth-child(5), #rooms-table td:nth-child(5), /* CNPJ */
  #rooms-table th:nth-child(6), #rooms-table td:nth-child(6)  /* Grupo */
  { display: none; }
}

/* <= 768px: esconder Empresa Proprietária e Unidade Vazia */
@media (max-width: 768px){
  #rooms-table th:nth-child(3), #rooms-table td:nth-child(3), /* Empresa Proprietária */
  #rooms-table th:nth-child(9), #rooms-table td:nth-child(9)  /* Unidade Vazia */
  { display: none; }
}

/* <= 576px: esconder Inquilino e Virtual */
