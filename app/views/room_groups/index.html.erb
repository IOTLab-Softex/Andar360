<div class="form-group" style="
    display: flex;
    justify-content: center;
">
<button id="openModalBtn" class="btn btn-success">
  <i class="fa-solid fa-plus"></i> Adicionar Grupo
</button>
</div>

<div class="table-responsive">
  <table class="table-salas">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @room_groups.each do |group| %>
        <tr>
          <td><%= group.name %></td>
          <td><%= group.description %></td>
          <td>
  <%= link_to '#',
    class: "btn edit openEditModal",
    data: {
      id: group.id,
      name: group.name,
      description: group.description,
      url: room_group_path(group)
    } do %>
  <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>
  <div class="hide-sm"> Editar </div>
<% end %>


  <%= form_with url: room_group_path(group), method: :delete, data: { turbo: false }, class: "d-inline" do %>
    <%= button_tag type: "submit",
          class: "btn btn-warning",
          data: { confirm: "Tem certeza?" } do %>
      <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>
      <div class="hide-sm"> Excluir </div>
    <% end %>
  <% end %>
</td>

        </tr>
      <% end %>
    </tbody>
  </table>
</div>



<!-- Modal customizado -->
<div id="customModal" class="custom-modal">
  <div class="custom-modal-content">
    <span id="closeModalBtn" class="custom-close">&times;</span>

    <h4 id="modalTitle">Novo Grupo de Sala</h4>


    <%= form_with(model: RoomGroup.new, url: room_groups_path, local: true, id: "roomGroupForm") do |form| %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token, id: "csrfToken" %>

  <div class="form-group">
    <%= form.label :name, "Nome do Grupo" %>
    <%= form.text_field :name, id: "roomGroupName", class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Descrição" %>
    <%= form.text_area :description, id: "roomGroupDescription", class: "form-control" %>
  </div>

  <div style="margin-top: 1rem; display: flex; justify-content: flex-end; gap: 1rem;">
    <button type="button" class="btn btn-secondary" id="cancelModalBtn">Cancelar</button>
    <%= form.submit "Salvar", class: "btn btn-primary" %>
  </div>
<% end %>
  </div>
</div>
<style>
.custom-modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  justify-content: center;
  align-items: center;
}

.custom-modal-content {
  background: var(--color-header);
  padding: 2rem;
  border-radius: 10px;
  width: 100%;
  max-width: 500px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.custom-close {
  float: right;
  font-size: 24px;
  cursor: pointer;
}
textarea {
  resize: vertical; /* impede redimensionamento horizontal */
  max-width: 100%;
  box-sizing: border-box;
}


.form-control {
  
  box-sizing: border-box; /* evita ultrapassar a borda */
}

</style>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const modal = document.getElementById("customModal");
  const openBtn = document.getElementById("openModalBtn");
  const closeBtn = document.getElementById("closeModalBtn");
  const cancelBtn = document.getElementById("cancelModalBtn");

  const form = document.getElementById("roomGroupForm");
  const nameInput = document.getElementById("roomGroupName");
  const descInput = document.getElementById("roomGroupDescription");
  const modalTitle = document.getElementById("modalTitle");

  // Botão "Adicionar Grupo"
  openBtn.addEventListener("click", () => {
    modal.style.display = "flex";
    form.action = "<%= room_groups_path %>";
    modalTitle.textContent = "Novo Grupo de Sala";
    nameInput.value = "";
    descInput.value = "";

    // Remove input _method se existir (modo novo)
    form.querySelectorAll("input[name='_method']").forEach(el => el.remove());
  });

  // Botões de fechar
  closeBtn.addEventListener("click", () => modal.style.display = "none");
  cancelBtn.addEventListener("click", () => modal.style.display = "none");

  // Fecha clicando fora
  window.addEventListener("click", (e) => {
    if (e.target === modal) modal.style.display = "none";
  });

  // Modo editar
  document.querySelectorAll(".openEditModal").forEach(button => {
    button.addEventListener("click", function (e) {
      e.preventDefault();

      nameInput.value = this.dataset.name;
      descInput.value = this.dataset.description;
      modalTitle.textContent = "Editar Grupo de Sala";
      form.action = this.dataset.url;

      // Remove anteriores e adiciona o _method: patch
      form.querySelectorAll("input[name='_method']").forEach(el => el.remove());
      const methodInput = document.createElement("input");
      methodInput.type = "hidden";
      methodInput.name = "_method";
      methodInput.value = "patch";
      form.appendChild(methodInput);

      modal.style.display = "flex";
    });
  });
});
</script>

